      SUBROUTINE RLXFIE(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,NBND,
     1                  LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ,
     2                  MAXCBP,IDXGRD,ICUBPT,JCUBPT,KCUBPT,LCUB,
     3                  ISTA0,ISTA1,IEND0,IEND1,JSTA0,JSTA1,
     4                  JEND0,JEND1,KSTA0,KSTA1,KEND0,KEND1,
     3                  JUMP,CYCLES)

      INTEGER II,JJ,KK,IMX,JMX,KMX,MAXCBP,NBND,JUMP,CYCLE,CYCLES
      INTEGER IDXGRD(9),ICUBPT(MAXCBP),JCUBPT(MAXCBP),KCUBPT(MAXCBP)
      INTEGER ISTA0,ISTA1,IEND0,IEND1,JSTA0,JSTA1,
     1        JEND0,JEND1,KSTA0,KSTA1,KEND0,KEND1 

      REAL FIELD(KK,JJ,II),RHS(KK,JJ,II)
      REAL LALFAX(II),LGAMAX(II),LALFAY(JJ),LGAMAY(JJ),
     1     LALFAZ(KK),LGAMAZ(KK),LCUB(8,MAXCBP)

      DO 400 CYCLE = 1,CYCLES

C     RED POINTS

C     FALLS PERIODISCHE RANDBEDINGUNGEN: SETZEN

#ifdef _FRPER_

      DO 402 J = JSTA0,JEND0+1,JUMP
CDIR$ IVDEP
        DO 402 K = KSTA0,KEND0+1,JUMP

          FIELD(K,J,IMX-NBND+1) = FIELD(K,J,NBND+1)
          FIELD(K,J,NBND) = FIELD(K,J,IMX-NBND+1-JUMP)

402   CONTINUE
#endif

#ifdef _RIPER_

      DO 403 I = ISTA0,IEND0+1,JUMP
CDIR$ IVDEP
        DO 403 K = KSTA0,KEND0+1,JUMP

          FIELD(K,JMX-NBND+1,I) = FIELD(K,NBND+1,I)
          FIELD(K,NBND,I) = FIELD(K,JMX-NBND+1-JUMP,I)

403   CONTINUE
#endif

C     GRID(0,0,0)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA0,IEND0,JSTA0,JEND0,KSTA0,KEND0,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     GRID(0,1,1)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA1,IEND1,JSTA1,JEND1,KSTA0,KEND0,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)


C     GRID(1,0,1)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA1,IEND1,JSTA0,JEND0,KSTA1,KEND1,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     GRID(1,1,0)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA0,IEND0,JSTA1,JEND1,KSTA1,KEND1,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     RED-SCHRITT ABGESCHLOSSEN - KORREKTUR DER WERTE UM EINBAU 

      DO IDX = IDXGRD(1)+1,IDXGRD(5)
	I = ICUBPT(IDX)
	J = JCUBPT(IDX)
	K = KCUBPT(IDX)

	FIELD(K,J,I) = 
     1      (FIELD(K,J,MAX(NBND,I-JUMP)) * LCUB(1,IDX) +
     2       FIELD(K,J,MIN(II-NBND+1,I+JUMP)) * LCUB(2,IDX) +
     3       FIELD(K,MAX(NBND,J-JUMP),I) * LCUB(3,IDX) +
     4       FIELD(K,MIN(JMX-NBND+1,J+JUMP),I) * LCUB(4,IDX) +
     5       FIELD(MAX(NBND,K-JUMP),J,I) * LCUB(5,IDX) +
     6       FIELD(MIN(KMX-NBND+1,K+JUMP),J,I) * LCUB(6,IDX) -
     7       RHS(K,J,I) ) /
     8      (LCUB(1,IDX) + LCUB(2,IDX) +
     9       LCUB(3,IDX) + LCUB(4,IDX) +
     A       LCUB(5,IDX) + LCUB(6,IDX))
      ENDDO

C     CALL OUTPUT(II,JJ,KK,FIELD,10)

C     FALLS PERIODISCHE RANDBEDINGUNGEN: SETZEN

#ifdef _FRPER_

      DO 404 J = JSTA0,JEND0+1,JUMP
CDIR$ IVDEP
        DO 404 K = KSTA0,KEND0+1,JUMP

          FIELD(K,J,IMX-NBND+1) = FIELD(K,J,NBND+1)
          FIELD(K,J,NBND) = FIELD(K,J,IMX-NBND+1-JUMP)

404   CONTINUE
#endif

#ifdef _RIPER_

      DO 405 I = ISTA0,IEND0+1,JUMP
CDIR$ IVDEP
        DO 405 K = KSTA0,KEND0+1,JUMP

          FIELD(K,JMX-NBND+1,I) = FIELD(K,NBND+1,I)
          FIELD(K,NBND,I) = FIELD(K,JMX-NBND+1-JUMP,I)

405   CONTINUE
#endif


C     BLACK POINTS !
C     GRID(1,0,0)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA0,IEND0,JSTA0,JEND0,KSTA1,KEND1,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     GRID(1,1,1)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA1,IEND1,JSTA1,JEND1,KSTA1,KEND1,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     GRID(0,0,1)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA1,IEND1,JSTA0,JEND0,KSTA0,KEND0,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)


C     GRID(0,1,0)

      CALL VRLXGD(KK,JJ,II,KMX,JMX,IMX,FIELD,RHS,JUMP,NBND,
     1            ISTA0,IEND0,JSTA1,JEND1,KSTA0,KEND0,
     2            LALFAX,LGAMAX,LALFAY,LGAMAY,LALFAZ,LGAMAZ)

C     BLACK-SCHRITT ABGESCHLOSSEN - KORREKTUR DER WERTE UM EINBAU 

      DO IDX = IDXGRD(5)+1,IDXGRD(9)
        I = ICUBPT(IDX)
	J = JCUBPT(IDX)
	K = KCUBPT(IDX)

	FIELD(K,J,I) = 
     1      (FIELD(K,J,MAX(NBND,I-JUMP)) * LCUB(1,IDX) +
     2       FIELD(K,J,MIN(IMX-NBND+1,I+JUMP)) * LCUB(2,IDX) +
     3       FIELD(K,MAX(NBND,J-JUMP),I) * LCUB(3,IDX) +
     4       FIELD(K,MIN(JMX-NBND+1,J+JUMP),I) * LCUB(4,IDX) +
     5       FIELD(MAX(NBND,K-JUMP),J,I) * LCUB(5,IDX) +
     6       FIELD(MIN(KMX-NBND+1,K+JUMP),J,I) * LCUB(6,IDX) -
     7       RHS(K,J,I) ) /
     8      (LCUB(1,IDX) + LCUB(2,IDX) +
     9       LCUB(3,IDX) + LCUB(4,IDX) +
     A       LCUB(5,IDX) + LCUB(6,IDX))
      ENDDO


C     FALLS PERIODISCHE RANDBEDINGUNGEN: SETZEN

#ifdef _FRPER_

      DO 406 J = JSTA0,JEND0+1,JUMP
CDIR$ IVDEP
        DO 406 K = KSTA0,KEND0+1,JUMP

          FIELD(K,J,IMX-NBND+1) = FIELD(K,J,NBND+1)
          FIELD(K,J,NBND) = FIELD(K,J,IMX-NBND+1-JUMP)

406   CONTINUE
#endif

#ifdef _RIPER_

      DO 407 I = ISTA0,IEND0+1,JUMP
CDIR$ IVDEP
        DO 407 K = KSTA0,KEND0+1,JUMP

          FIELD(K,JMX-NBND+1,I) = FIELD(K,NBND+1,I)
          FIELD(K,NBND,I) = FIELD(K,JMX-NBND+1-JUMP,I)

407   CONTINUE
#endif

C     CALL OUTPUT(II,JJ,KK,FIELD,10)

400   CONTINUE

      RETURN
      END
C23456
