      SUBROUTINE FMGOUT(IDIM,JDIM,KDIM,RESID,RES0,ITER)

      REAL RESID,RES0,KR
      INTEGER IDIM,JDIM,KDIM,ITER

      KR = (RESID / RES0) ** (1.0 / MAX(1,ITER))
      WRITE(31,*)
      WRITE (31,*) 'ITERATION:  ',ITER
C     WRITE (11,*) 'ITERATION:  ',ITER
      WRITE (31,*) 'GITTER:    ',IDIM,JDIM,KDIM
C     WRITE (11,*) 'GITTER:    ',IDIM,JDIM,KDIM
      WRITE (31,*) 'RESIDUUM:  ',RESID,' QUOTIENT ',RESID/RES0,KR
      WRITE(31,*)
C     WRITE (11,1501) 'RESIDUUM:  ',RESID,RESID/RES0,KR
C     WRITE (11,*)
C1501  FORMAT(A11,2F16.5)

      RETURN
      END
