      SUBROUTINE PREPROC_FIELD_WCOMP(kk,jj,ii,PHI,H3D1,H3D2,H3D3,H3D4,
     $           H3D5,DDZ,KON)

C..... Prerpocessing the field to achieve better resolution
C      26.07.04
C      by Florian Schwertfirm
C..........................................................

      IMPLICIT NONE
      integer i,j,k
      integer kk,jj,ii
      

      logical KON
      real PHI(kk,jj,ii),H3D1(kk,jj,ii),H3D2(kk,jj,ii),H3D3(kk,jj,ii),
     $     H3D4(kk,jj,ii),H3D5(kk,jj,ii)
      real DDZ(kk)
      real a1,b1,a2,b2

      if(KON) THEN
      a1 = 9.0/140.0+sqrt(265.0)/140.0
      b1 = 23.0/35.0
      a2 = -21.0/92.0+sqrt(265.0)*7.0/276.0
      b2 = 4.0/6.0

C       a1 = 1.0/6.0
C       b1 = 4.0/6.0
C       a2 = a1
C       b2 = b1
c..... x-direction
Cc..... first filter step
C  
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D1(k,j,i) = a1*PHI(k,j,i-1) + b1*PHI(k,j,i) + 
     $               a1*PHI(k,j,i+1)
        enddo
      enddo
      enddo

C---- Preiodic boundary in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
Cc.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo

c     write(6,*)'PR: ',H3D1(65,70,60)

c..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D2(k,j,i) = a2*H3D1(k,j,i-1) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k,j,i+1)
        enddo
       enddo
      enddo

CC---- Preiodic boundary in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
Cc.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo

c      write(6,*)'PR: ',H3D2(65,70,60)

c..... deconvolution
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
        H3D3(k,j,i)= 3.*PHI(k,j,i) 
     $            - 3.*H3D1(k,j,i) + H3D2(k,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D3(k,j,ii-1) = H3D3(k,j,3)
        H3D3(k,j,2) = H3D3(k,j,ii-2)
       enddo
      enddo
Cc.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D3(k,jj-1,i) = H3D3(k,3,i)
        H3D3(k,2,i) = H3D3(k,jj-2,i)
       enddo
      enddo
Cc..... y-direction
C
Cc..... first filter step
C
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D1(k,j,i) = a1*PHI(k,j-1,i) + b1*PHI(k,j,i) +
     $                  a1*PHI(k,j+1,i)
        enddo
       enddo
      enddo
C
c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
Cc.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo

c..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D2(k,j,i) = a2*H3D1(k,j-1,i) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k,j+1,i)
        enddo
       enddo
      enddo
c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo

c..... deconvolution
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
        H3D4(k,j,i)= 3.*PHI(k,j,i) 
     $               - 3.*H3D1(k,j,i) + H3D2(k,j,i)
        enddo
       enddo
      enddo
c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D4(k,j,ii-1) = H3D4(k,j,3)
        H3D4(k,j,2) = H3D4(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D4(k,jj-1,i) = H3D4(k,3,i)
        H3D4(k,2,i) = H3D4(k,jj-2,i)
       enddo
      enddo
c...................................................................... z-direction
c       a1 = 1.0/6.0
c       b1 = 4.0/6.0
c       a2 = 1.0/6.0
c       b2 = 4.0/6.0
c      do i=1,ii
c       do j=1,jj
c        H3D2(1,j,i) = -PHI(3,j,i)
cc        H3D2(2,j,i) = -PHI(3,j,i)
c        H3D2(kk-1,j,i) = -PHI(kk-3,j,i)
cc       H3D2(kk,j,i) = -PHI(kk-2,j,i)
c       enddo
c      enddo
c..... first filter step

      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
C       H3D1(k,j,i) = 1.0/3.0/(DDZ(k)/DDZ(k+1) + 1)  *PHI(k-1,j,i)
C     $             + 2.0/3.0*PHI(k,j,i)
C     $             + 1.0/3.0*DDZ(k)/(DDZ(k)+DDZ(k+1))*PHI(k+1,j,i)
       H3D1(k,j,i) = a1*PHI(k-1,j,i) + b1*PHI(k,j,i) +
     $                  a1*PHI(k+1,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo
Cc..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
C       H3D2(k,j,i) = 1.0/3.0/(DDZ(k)/DDZ(k+1) + 1)  *H3D1(k-1,j,i)
C     $             + 2.0/3.0*H3D1(k,j,i)
C     $             + 1.0/3.0*DDZ(k)/(DDZ(k)+DDZ(k+1))*H3D1(k+1,j,i)
       H3D2(k,j,i) = a2*H3D1(k-1,j,i) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k+1,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo
Cc..... deconvolution
      do i=2,ii-1
       do j=2,jj-1
        do k=3,kk-3
C        H3D5(k,j,i)= 3.*PHI(k,j,i)
C     $               - 3.*H3D1(k,j,i) + H3D2(k,j,i)
         H3D5(k,j,i)=PHI(k,j,i)
        enddo
       enddo
      enddo


c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D5(k,j,ii-1) = H3D5(k,j,3)
        H3D5(k,j,2) = H3D5(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D5(k,jj-1,i) = H3D5(k,3,i)
        H3D5(k,2,i) = H3D5(k,jj-2,i)
       enddo
      enddo
CC.......................................................................
CC............ Here the same for diffusive term .........................
CC.......................................................................
      else
      a1 = 23.0/780+1.0/260*sqrt(345.0)
      b1 = 161.0/195.0
      a2 = -13.0/168.0+13.0/1288.0*sqrt(345.0)
      b2 = 10.0/12.0

C       a1 = 1.0/12.0
C       b1 = 10.0/12.0
C       a2 = 1.0/12.0
C       b2 = 10.0/12.0
c..... x-direction
c..... first filter step
  
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D1(k,j,i) = a1*PHI(k,j,i-1) + b1*PHI(k,j,i) + 
     $               a1*PHI(k,j,i+1)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo

c..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D2(k,j,i) = a2*H3D1(k,j,i-1) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k,j,i+1)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo

c..... deconvolution
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
        H3D3(k,j,i)= 3.*PHI(k,j,i) 
     $            - 3.*H3D1(k,j,i) + H3D2(k,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D3(k,j,ii-1) = H3D3(k,j,3)
        H3D3(k,j,2) = H3D3(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D3(k,jj-1,i) = H3D3(k,3,i)
        H3D3(k,2,i) = H3D3(k,jj-2,i)
       enddo
      enddo
Cc 
Cc..... y-direction
C
Cc..... first filter step
C
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D1(k,j,i) = a1*PHI(k,j-1,i) + b1*PHI(k,j,i) +
     $                  a1*PHI(k,j+1,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo
Cc..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
       H3D2(k,j,i) = a2*H3D1(k,j-1,i) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k,j+1,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo

c..... deconvolution
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
        H3D4(k,j,i)= 3.*PHI(k,j,i) 
     $               - 3.*H3D1(k,j,i) + H3D2(k,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D4(k,j,ii-1) = H3D4(k,j,3)
        H3D4(k,j,2) = H3D4(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D4(k,jj-1,i) = H3D4(k,3,i)
        H3D4(k,2,i) = H3D4(k,jj-2,i)
       enddo
      enddo

c..... z-direction
c..... first filter step

      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
C       H3D1(k,j,i) = 1.0/6.0/(DDZ(k)/DDZ(k+1) + 1)  *PHI(k-1,j,i)
C     $             + 10.0/12.0*PHI(k,j,i)
C     $             + 1.0/6.0*DDZ(k)/(DDZ(k)+DDZ(k+1))*PHI(k+1,j,i)
       H3D1(k,j,i) = a1*PHI(k-1,j,i) + b1*PHI(k,j,i) +
     $                  a1*PHI(k+1,j,i)
        enddo
       enddo
      enddo

c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D1(k,j,ii-1) = H3D1(k,j,3)
        H3D1(k,j,2) = H3D1(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D1(k,jj-1,i) = H3D1(k,3,i)
        H3D1(k,2,i) = H3D1(k,jj-2,i)
       enddo
      enddo
Cc..... second filter step
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
C      H3D2(k,j,i) = DDZ(k+1)/(6.0*(DDZ(k+1) + DDZ(k)))*H3D1(k-1,j,i) +
C     $               10.0/12.0*H3D1(k,j,i) +
C     $               1.0/(6.0*(DDZ(k+1)/DDZ(k)+1.0))*H3D1(k+1,j,i)
       H3D2(k,j,i) = a2*H3D1(k-1,j,i) + b2*H3D1(k,j,i) +
     $                  a2*H3D1(k+1,j,i)
        enddo
       enddo
      enddo
c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D2(k,j,ii-1) = H3D2(k,j,3)
        H3D2(k,j,2) = H3D2(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D2(k,jj-1,i) = H3D2(k,3,i)
        H3D2(k,2,i) = H3D2(k,jj-2,i)
       enddo
      enddo

Cc..... deconvolution
      do i=3,ii-2
       do j=3,jj-2
        do k=3,kk-3
C        H3D5(k,j,i)= 3.*PHI(k,j,i)
C     $               - 3.*H3D1(k,j,i) + H3D2(k,j,i)
         H3D5(k,j,i)=PHI(k,j,i)
        enddo
       enddo
      enddo
c..... periodic in x
      do j=1,jj
       do k=1,kk
        H3D5(k,j,ii-1) = H3D5(k,j,3)
        H3D5(k,j,2) = H3D5(k,j,ii-2)
       enddo
      enddo
c.... Preiodic boundary in y
      do i=1,ii
       do k=1,kk
        H3D5(k,jj-1,i) = H3D5(k,3,i)
        H3D5(k,2,i) = H3D5(k,jj-2,i)
       enddo
      enddo

      endif
      return
      end

