C                                 VORBELEGUNG DES SUMMATIONSFELDES
C                                 FUER DIE MOMENTANWERTE VON  T.
C
      IF(ISELEP(1,505) .GE. 1) THEN
            CALL DPHI0   (KKA,JJA,IIA,KMXA,JMXA,IMXA,ST     )
      ENDIF
