      IF(ISELEP(1,504) .GE. 1) THEN
         IF(ISAMPA(504) .EQ. 0  ) THEN
C
C                                 ZUNAECHST WIRD DAS GESAMTE AT-FELD
C                                 MIT 0.0 VORBELEGT
C
            CALL DPHI0   (KKA,JJA,IIA,KMXA,JMXA,IMXA,AT     )
C
C                                 GALILEI-RUECKTRANSFORMATION USED FOR
C                                 INITIALISING HILF BY T
C
            CALL GALIRT  (KK,JJ,II,KMX,JMX,IMX,
     $                    UGRID,T,HILF,B,'   T',NFRO,NRGT,NBOT
     $                                         ,NBAC,NLFT,NTOP)
C
C
C                                 SETZEN DER RANDBEDINGUNGEN
C
C           CALL BF1ALL  (KK,JJ,II,KMX,JMX,IMX,DDX,DDY,DDZ,DX,DY,DZ,
C    $                    X,Y,Z,HILF   ,IB1,IB2,JB1,JB2,KB,'T     ')
C
C                                 BILDUNG EINES LINIEN/FLAECHENMITTEL-
C                                 WERTES UND SUMMATION IN DAS (MIT 0.0)
C                                 VORBELEGTE AT-FELD
C
            CALL AREAM   (KK,JJ,II,KKA,JJA,IIA,KMX,JMX,IMX,
     $                    KMXA,JMXA,IMXA,HILF   ,AT     ,
     $                    XHOMOG,YHOMOG,ZHOMOG)
         ENDIF
      ENDIF
