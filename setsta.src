            CALL PHIFLU  (KK,JJ,II,KKA,JJA,IIA,KMX,JMX,IMX,
     $                    KMXA,JMXA,IMXA,UGRID,
     $                    HILF   ,O2FG   ,AO2    ,' UVW',
     $                 XHOMOG,YHOMOG,ZHOMOG,NFRO,NRGT)
