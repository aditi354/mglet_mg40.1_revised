       SUBROUTINE ICOMGRID  ()


C*STARLET***************************************************************
C        I C O M G R I D     INITIALISIEREN DES COMMON-BLOCKES
C                            COMGRID
C*STARLET***************************************************************
C
C
C VERS:   1. 4.93 (MM)  : ORIGINAL
C
C
C*STARLET***************************************************************
C
#include "mgpar.h"
#include "comgrid.h"
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
      NGRID   = 0
      NGRDOLD = 0
      NGRDSET = 0
      NGRDDFD = 0
      NAUFP   = 0
      NAUFOLD = 0

      DO IGRID = 1, MAXGRIDS

         KMX(IGRID) = 0
         JMX(IGRID) = 0
         IMX(IGRID) = 0

        KMXA(IGRID) = 0
        JMXA(IGRID) = 0
        IMXA(IGRID) = 0

        IP3D(IGRID) = 0
        IP2D(IGRID) = 0
        IP1D(IGRID) = 0
        IPBB(IGRID) = 0
        IPB3(IGRID) = 0
        IPBU(IGRID) = 0

         IPA(IGRID) = 0
        IP1L(IGRID) = 0
        IP2L(IGRID) = 0

         IC1(IGRID) = 0
         IC2(IGRID) = 0
         JC1(IGRID) = 0
         JC2(IGRID) = 0
         KC1(IGRID) = 0
         KC2(IGRID) = 0

      ENDDO

        NOF3D = 0
        NOF2D = 0
        NOF1D = 0
        NOFBB = 0
        NOFB3 = 0
        NOFBU = 0

        NOFA  = 0
        NOF1L = 0
        NOF2L = 0

C
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

      RETURN
      END
