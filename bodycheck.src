      SUBROUTINE BODYCHECK
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C     19. 5.93 (MM) : ORIGINAL
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

#include "mgpar.h"
#include "costrles.h"
#include "comgrid.h"
#include "cogrdpro.h"
#include "cobodold.h"
#include "cobody.h"

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

      WRITE (6,*) 
     $'WARNUNG: BODYCHECK NOCH NICHT IMPLEMENTIERT'

#ifndef _FRED_BODY_
      IF (DCONT) THEN

      NBODY = NBODOLD
      WRITE(*,*) 'KOERPER AUS VORHERIGEM LAUF'

      DO I = 1,NBODY
      CTYP(I) =CTYPO(I)
      IB1(I)  =IB1O(I)
      IB2(I)  =IB2O(I)
      JB1(I)  =JB1O(I)
      JB2(I)  =JB2O(I)
      KB1(I)  =KB1O(I)
      KB2(I)  =KB2O(I)
      XB2(I)  =XB2O(I)
      XB2(I)  =XB2O(I)
      YB1(I)  =YB1O(I)
      YB2(I)  =YB2O(I)
      ZB1(I)  =ZB1O(I)
      ZB1(I)  =ZB1O(I)
      NCOUN(I)=NCOUNO(I)
      XMIT(I) =XMITO(I)
      HEIGHT(I)=HEIGHTO(I)
      ALPHA(I)=ALPHAO(I)
      CDIR(I) =CDIRO(I)

      ENDDO

      ELSE

      WRITE(*,*) 'KOERPER WIRD NEU ERZEUGT'

      ENDIF
#endif

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
      RETURN
      END
