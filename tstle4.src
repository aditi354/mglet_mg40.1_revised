      SUBROUTINE TSTLE4  (KK,JJ,II,KMX,JMX,IMX,
     $                    X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                    RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                    U,V,W,UO,VO,WO,
     $                    WCU,WCV,WCW,P,G,B,
#ifdef _FRED_BODY_
     $                    BP,BU,BV,BW,
#endif
     $                    DT,GRADPX,ZTOT,NBUF,ITSTEP,
     $                    WPHI,WKON,WDIF,WSOR,IDUZ,
     $                    IC1,IC2,JC1,JC2,KC1,KC2,
     $                    NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                    RSGS3,FAKTOR,
     $                    FUI,FVI,FWI,
     $                    FUJ,FVJ,FWJ,
     $                    FUK,FVK,FWK,
     $                    COEFFX,COEFFY,COEFFZ,COEFDX,COEFDY,COEFDZ,
     $                    LCOL,DIAG,RCOL,UZ,RSP,
     $                    GI,GJ,GK
#if defined _TAU_NN_ | defined _INC1_ | defined _INC2_
     $        ,TAU11,TAU12,TAU13
     $        ,TAU21,TAU22,TAU23
     $        ,TAU31,TAU32,TAU33
#endif
CC#if defined _PREPROC_
C     $        ,HPX
C#endif
     $                    )

C*STARLET***************************************************************
C        T S T L E 1      TIMESTEP - TURBULENT - ALLE VERFAHREN - LES
C*STARLET***************************************************************
C
C PARAM: KK, JJ, II     - ARRAYDIMENSIONEN
C        KMX, JMX, IMX  - GRENZEN DES BERECHNUNGSGEBIETES (MIT BOUND)
C        DX,DY,DZ       - ABSTAND DER GITTERPUNKTE
C        DDX,DDY,DDZ    - KANTENLAENGEN DER KONTROLLVOLUMINA
C        U(KK,JJ,II)    - NEUES GESCHWINDIGKEITSFELD
C        V(KK,JJ,II)    - NEUES GESCHWINDIGKEITSFELD
C        W(KK,JJ,II)    - NEUES GESCHWINDIGKEITSFELD
C        UO(KK,JJ,II)   + ALTES GESCHWINDIGKEITSFELD (FELD WIRD F.
C                         IDUZ = 1 UND IDUZ = 2 VERAENDERT !!)
C        VO(KK,JJ,II)   + ALTES GESCHWINDIGKEITSFELD (  "    "  "    "
C        WO(KK,JJ,II)   + ALTES GESCHWINDIGKEITSFELD (  "    "  "    "
C        P(KK,JJ,II)    - ALTES DRUCKFELD
C        G(KK,JJ,II)    - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        GMOL           - MOLEKULARE DYNAMISCHE VISKOSITAET
C        DT             - ZEITSCHRITT
C        RHO            - DICHTE (= CONST)
C        UGRID          - GESCHWINDIGKEIT DES KOORDINATENSYSTEMS IN
C                         X-RICHTUNG (GALILEI-TRANSFORMATION)
C        WCU(KK,JJ)     + WANDKORREKTUR F. U-KOMP. (DIFFUSIVER IMPULSVER
C                                                   LUST INFOLGE REIBUNG
C        WCV(KK,JJ)     + WANDKORREKTUR F. V-KOMP.           ""
C        WCW(KK,JJ)     + WANDKORREKTUR F. W-KOMP.           ""
C        GRADPX         - DRUCKGRADIENT IN X-RICHTUNG
C        ZTOT           - SENKRECHTER ABSTAND DER KANALWAENDE
C        MTURB          - SCHALTER: 0 = LAMINAR,  1 = TURBULENT
C        NBUF           - ANZAHL DER PUFFERSCHICHTEN (F. QUICK: NBUF=3)
C        ITSTEP         - ZEITSCHRITTZAEHLER
C        WPHI           - WICHTUNGSFAKTOR FUER DEN PUNKTWERT
C        WKON           -         "        "   DIE KONVEKTIVEN TERME
C        WDIF           -         "        "   DIE DIFFUSIVEN TERME
C        WSOR           -         "        "   DEN QUELLTERM
C        IDUZ           - FUER DEN ZEITSCHRITT 2. ORDNUNG MUSS DER ZEIT-
C                         SCHRITT ZWEIMAL DURCHLAUFEN WERDEN. FUER IDUZ
C                         = 1 WERDEN GESCHW.KOMP VOM AELTESTEN ZEIT-
C                         NIVEAU UEBERGEBEN; FUER IDUZ = 2 DIE DES
C                         AKTUELLEREN ZEITNIVEAUS
C        IC1,JC1,KC1    - LINKE  RAENDER DER BOUNDING BOX
C        IC2,JC2,KC2    - RECHTE RAENDER DER BOUNDING BOX
C
C        FUI,FVI,FWI    - ERGEBNIS (INT/ABL) IN I-RICHTUNG           
C        FUJ,FVJ,FWJ    - ERGEBNIS (INT/ABL) IN J-RICHTUNG           
C        FUK,FVK,FWK    - ERGEBNIS (INT/ABL) IN K-RICHTUNG           
C
C                  X    - X-KOORDINATE DES ZELLMITTELPUNKTES            
C
C DEFINE DIREKTIVEN     : ZEN, UPW, QUD, EULER, LEAPF, ADBA,
C                         FRPER, RIPER
C UPROG                 : SWCLE1
C
C      10.03.03 (SE,FS) : Original von TSTLE2 abgeleitet
C      30.06.04 (FS)    : von TSTLE3 abgeleitet, fuer RK
C*STARLET***************************************************************
C
#include "konsta.h"
#include "cophyspar.h"

      INTEGER    KK,JJ,II,KMX,JMX,IMX,K,J,I,NBUF,ITSTEP,
     $           IC1,IC2,JC1,JC2,KC1,KC2,
     $           KSTART,KSTOP,JSTART,JSTOP,ISTART,ISTOP,
     $           KSTARTM,KSTOPM,
     $           NBU,NFU,NRV,NBW,NTW,NLV,
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $           NXPER,NYPER,NZPER,
     $           IDUZ,ICOM,IST8,IEND8,MTURB

      REAL        X(II),         Y(JJ),         Z(KK),
     &           DX(II),        DY(JJ),        DZ(KK),
     &          DDX(II),       DDY(JJ),       DDZ(KK),
     &        RDX(II),RDY(JJ),RDZ(KK),RDDX(II),RDDY(JJ),RDDZ(KK)

      REAL       U  (KK,JJ,II),V  (KK,JJ,II),W  (KK,JJ,II),
     $           P  (KK,JJ,II),G  (KK,JJ,II),B  (KK,JJ,II),
     $           UO (KK,JJ,II),VO (KK,JJ,II),WO (KK,JJ,II),
     $           GI (KK,JJ,II),GJ (KK,JJ,II),GK (KK,JJ,II),
     $           WCU(KK,JJ,II),WCV(KK,JJ,II),WCW(KK,JJ,II)

      REAL  QKUW,QKUE,QKUT,QKUB,QKUN,QKUS,FKDTU,FKDTV,FKDTW,
     $      QKVW,QKVE,QKVT,QKVB,QKVN,QKVS,FDDTU,FDDTV,FDDTW,
     $      QKWW,QKWE,QKWT,QKWB,QKWN,QKWS,
     $      QDUW,QDUE,QDUT,QDUB,QDUN,QDUS,QDUC,
     $      QDVW,QDVE,QDVT,QDVB,QDVN,QDVS,QDVC,
     $      QDWW,QDWE,QDWT,QDWB,QDWN,QDWS,QDWC,
     $      GUW, GUE, GUT, GUB, GUN, GUS,
     $      GVW, GVE, GVT, GVB, GVN, GVS,
     $      GWW, GWE, GWT, GWB, GWN, GWS,
     $      FUW, FUE, FUT, FUB, FUN, FUS, AUX,  AUY,  AUZ,
     $      FVW, FVE, FVT, FVB, FVN, FVS, AVX,  AVY,  AVZ,
     $      FWW, FWE, FWT, FWB, FWN, FWS, AWX,  AWY,  AWZ

      REAL   DXI, DXIM, DXIP, DDXI, DDXIM, DDXIP,
     $       DYJ, DYJM, DYJP, DDYJ, DDYJM, DDYJP,
     $       DZK, DZKM, DZKP, DDZK, DDZKM, DDZKP,DDZKPP,DZKMM,
     $      RDXI,RDXIM,RDXIP,RDDXI,RDDXIM,RDDXIP,
     $      RDYJ,RDYJM,RDYJP,RDDYJ,RDDYJM,RDDYJP,
     $      RDZK,RDZKM,RDZKP,RDDZK,RDDZKM,RDDZKP

      REAL  WSOR,WKON,WPHI,WDIF,HP,HN,WF,ZERONE,DT,ZTOT,DELTA,
     $      GRADPX,PRESET,UFRFREQ,SMAONE,GREAT,SMALL,RINDEF,
     $      XPER,YPER,ZPER,XREF,FFF
#ifdef _UPWARDS_
      REAL        GRADP(KK)
#else
      REAL        GRADP(II)
#endif

#if defined _TAU_NN_ | defined _INC1_ | defined _INC2_
      REAL      TAU11(KK,JJ,II), TAU12(KK,JJ,II), TAU13(KK,JJ,II),
     $          TAU21(KK,JJ,II), TAU22(KK,JJ,II), TAU23(KK,JJ,II),
     $          TAU31(KK,JJ,II), TAU32(KK,JJ,II), TAU33(KK,JJ,II)
#endif

C                             FELDER FUER DIE INTERPOLIERTEN WERTE
C                             FUER DAS KOMPAKTVERFAHREN


#ifdef _FRED_BODY_
      REAL  BU(KK,JJ,II),BV(KK,JJ,II),BW(KK,JJ,II),BP(KK,JJ,II)
#endif

#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_ | defined _PREPROC_
      REAL FUI(KK,JJ,II),FVI(KK,JJ,II),FWI(KK,JJ,II)
#else
      REAL  FUI(1),FVI(1),FWI(1)
#endif
#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | \
      defined _ZEN4O_ | defined _PREPROC_
      REAL FUJ(KK,JJ,II),FVJ(KK,JJ,II),FWJ(KK,JJ,II)
#else
      REAL FUJ(1),FVJ(1),FWJ(1)
#endif
#if defined _KOMZK_ | defined _PREPROC_
      REAL FUK(KK,JJ,II),FVK(KK,JJ,II),FWK(KK,JJ,II)
#else
      REAL FUK(1),FVK(1),FWK(1)
#endif
C#if defined _PREPROC_
C      REAL HPX(KK,JJ,II)
C#endif



#ifdef _ZEN_
C                                  *************************************
C                                  ZEN ZEN ZEN ZEN ZEN ZEN ZEN ZEN ZEN
C                                  *************************************

              WF(FFF)  = 0.5*ABS(FFF)+MIN(FFF,0.0)
#endif

#ifdef _UPW_
C                                  *************************************
C                                  UPW UPW UPW UPW UPW UPW UPW UPW UPW
C                                  *************************************

              WF(FFF)  = MIN(FFF,0.0)
#endif

#ifdef _QUD_
C                                  *************************************
C                                  QUD QUD QUD QUD QUD QUD QUD QUD QUD
C                                  *************************************

      QIN(V1,V2,V3,S2S1,S3S2,SS2) = (V1*(SS2*(SS2-S3S2)*S3S2)
     $                          -V2*((SS2+S2S1)*(SS2-S3S2)*(S2S1+S3S2))
     $                          +V3*((SS2+S2S1)*SS2*S2S1)) * 0.5
     $                          /(S2S1*S3S2*(S2S1+S3S2))
#endif


              KSTART = 3
              JSTART = 2
              ISTART = 2
              KSTOP = KMX - 2
              JSTOP = JMX - 2
              ISTOP = IMX - 2

      HP    =  0.5
      HN    = -0.5


C
C                                 BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 UND BEI GITTERKOPPLUNG
C                                 SOWIE BEI AUSFLUSSBEDINGUNG
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      NBU = 0
      IF ((NBAC.EQ.1).OR.(NBAC.EQ.7))  NBU = 1
      IF ((NBAC.EQ.3).OR.(NBAC.EQ.4).OR. (NBAC.EQ.13))  NBU = 1
#ifndef _BAPAR_FIXED_
      IF (NBAC.EQ.8)  NBU = 1
#endif
      NLV = 0
      IF ((NLFT.EQ.1).OR.(NLFT.EQ.7).OR.(NLFT.EQ.8))  NLV = 1
      IF ((NLFT.EQ.3).OR.(NLFT.EQ.4))  NLV = 1
      NTW = 0
      IF ((NTOP.EQ.1).OR.(NTOP.EQ.7).OR.(NTOP.EQ.3))  NTW = 1
#ifndef _TOPAR_FIXED_
      IF (NTOP.EQ.8)  NTW = 1
#endif

C                                 BEI LOKAL VERFEINERTEM GITTER
C                                 WIRD DIE NORMALKOMPONENTE DER ERSTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      NFU = 0
      IF ( NFRO .EQ. 8 .OR. NFRO .EQ. 3 ) NFU = 1
      NRV = 0
      IF ( NRGT .EQ. 8 .OR. NRGT .EQ. 3 ) NRV = 1
      NBW = 0
      IF ( NBOT .EQ. 8 .OR. NBOT .EQ. 3 ) NBW = 1
C***********************************************************************
C*     DECONVOLUTION OF FIELD FOR IMPROVED RESOLUTION KONVEKTIVE TERM  *
C***********************************************************************
#if defined _PREPROC_
      CALL PREPROC_FIELD(KK,JJ,II,U,GI,GJ,FUI,FUJ,FUK,DZ,.TRUE.)
      CALL PREPROC_FIELD(KK,JJ,II,V,GI,GJ,FVI,FVJ,FVK,DZ,.TRUE.)
      CALL PREPROC_FIELD_WCOMP(KK,JJ,II,W,GI,GJ,FWI,FWJ,FWK,DZ,.TRUE.)
#endif
C***********************************************************************
C           HIER KOMPAKTVERFAHREN VIERTER ORDNUNG IN X-RICHTUNG        *
C***********************************************************************

#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_

      IF (NFRO .EQ.1) THEN
CC                                PERIODISCHE RANDBEDINGUNGEN 
CC                                NUR AEQUIDISTANTE GITTER !!
         CALL INTERUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RSGS3,U,FUI,LCOL,DIAG,RCOL,UZ,RSP)

         CALL INTERUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RSGS3,V,FVI,LCOL,DIAG,RCOL,UZ,RSP)

         CALL INTERUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RSGS3,W,FWI,LCOL,DIAG,RCOL,UZ,RSP)

      ELSE
C                                NICHT-PERIODISCHE RANDBED.
C                                BERECHNUNG DER INTERPOLIERTEN GESCH.

#if defined _KOMXK6O_ | defined _KOMXK8O_
         write(6,*)'Interpolation 6ter Ordnung nur für Periodisch'
         stop
#endif

         CALL INTERPOLATEUX  (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFX,RSGS3,FAKTOR,U,FUI,
     $        NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        )

         CALL INTERPOLATEVWX (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFX,RSGS3,FAKTOR,V,FVI,
     $        NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )

         CALL INTERPOLATEVWX (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFX,RSGS3,FAKTOR,W,FWI,
     $        NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
      ENDIF
#endif

#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | defined _ZEN4O_
      
      IF (NRGT .EQ.1) THEN

CC                                PERIODISCHE RANDBEDINGUNGEN 
CC                                NUR AEQUIDISTANTE GITTER !!

      CALL INTERVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,RSGS3,U,FUJ,LCOL,DIAG,RCOL,UZ,RSP)

      CALL INTERVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,RSGS3,V,FVJ,LCOL,DIAG,RCOL,UZ,RSP)

      CALL INTERVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,RSGS3,W,FWJ,LCOL,DIAG,RCOL,UZ,RSP)

      ELSE
#if defined _KOMYK6O_ | defined _KOMYK8O_
         write(6,*)'Interpolation 6ter Ordnung nur für Periodisch'
         stop
#endif
         CALL INTERPOLATEUWY (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFY,RSGS3,FAKTOR,U,FUJ,
     $        NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        )

         CALL INTERPOLATEVY (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFY,RSGS3,FAKTOR,V,FVJ,
     $        NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )
         CALL INTERPOLATEUWY (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,COEFFY,RSGS3,FAKTOR,W,FWJ,
     $        NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
      ENDIF
#endif

#if defined _KOMZK_

CC                                 BERECHNUNG DER INTERPOLIERTEN GESCH.
 
      CALL INTERPOLATEUVZ(KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,COEFFZ,RSGS3,FAKTOR,U,FUK,
     $     NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        )
      CALL INTERPOLATEUVZ(KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,COEFFZ,RSGS3,FAKTOR,V,FVK,
     $     NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )
      CALL INTERPOLATEWZ (KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,COEFFZ,RSGS3,FAKTOR,W,FWK,
     $     NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
#endif

#ifdef _PREPROC_PRE_
      DO J=JSTART-1,JSTOP+1
       DO K=KSTART-1,KSTOP+1
        P(K,J,1)=P(K,J,ISTOP-1)
        P(K,J,ISTOP+2)=P(K,J,ISTART+2)
       ENDDO
      ENDDO
#endif

      IF(ABS(WKON) .LE. SMALL) GOTO 2200

C***********************************************************************
C                                 10 10 10 10 10 10 10 10 10 10 10 10 10

      DO  10  I = ISTART, ISTOP


C                                  GEOMETRISCHE KONSTANTEN (I)
                DXI   =  DX(I)
                DXIM  =  DX(I-1)
#ifdef _QUD_
                DXIMM =  DX(I-2)
               DDXIPP = DDX(I+2)
#endif
                DXIP  =  DX(I+1)
               DDXI   = DDX(I)
               DDXIM  = DDX(I-1)
               DDXIP  = DDX(I+1)

               RDXI   =  RDX(I)
               RDXIM  =  RDX(I-1)
               RDXIP  =  RDX(I+1)
              RDDXI   = RDDX(I)
              RDDXIM  = RDDX(I-1)
              RDDXIP  = RDDX(I+1)

C                                 20 20 20 20 20 20 20 20 20 20 20 20 20
      DO  20  J = JSTART, JSTOP
C                                  GEOMETRISCHE KONTANTEN (J)
                DYJ   =  DY(J)
                DYJM  =  DY(J-1)
#ifdef _QUD_
                DYJMM =  DY(J-2)
               DDYJPP = DDY(J+2)
#endif
                DYJP  =  DY(J+1)
               DDYJ   = DDY(J)
               DDYJM  = DDY(J-1)
               DDYJP  = DDY(J+1)

               RDYJ   =  RDY(J)
               RDYJM  =  RDY(J-1)
               RDYJP  =  RDY(J+1)
              RDDYJ   = RDDY(J)
              RDDYJM  = RDDY(J-1)
              RDDYJP  = RDDY(J+1)

              AUZ   =  DXI*DDYJ
                AVZ   = DDXI* DYJ
                AWZ   = DDXI*DDYJ


C                                 **************************************
C                                 KONVEKTIVE TERME   KONVEKTIVE TERME
C                                 **************************************

C                             KOEFFIZIENTEN BEIM KONVEKTIVEN ZEITSCHRITT


#ifdef _RUNGEKUTTA3_
                FKDTU = -1.0*RDDY(J)* RDX(I)*WKON
                FKDTV = -1.0*RDDX(I)* RDY(J)*WKON
                FKDTW = -1.0*RDDX(I)*RDDY(J)*WKON
#endif

#ifdef _LEAPF_
                FKDTU = -1.0*DT*RDDY(J)* RDX(I)*WKON
                FKDTV = -1.0*DT*RDDX(I)* RDY(J)*WKON
                FKDTW = -1.0*DT*RDDX(I)*RDDY(J)*WKON
#endif



C                                 UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
C                                 --------------------------------------
C
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 UND BEI GITTERKOPPLUNG
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NBU.EQ.0).AND.(I .EQ. ISTOP))  GOTO 2110
      IF ((NFU.EQ.0).AND.(I .EQ. ISTART)) GOTO 2110
      IF ( J .EQ. JSTART ) GOTO 2110



      DO 100  K = KSTART, KSTOP
C                                  GEOMETRISCHE KONSTANTEN (K)
                DZK   =  DZ(K)
                DZKM  =  DZ(K-1)
                DZKMM =  DZ(K-2)
                DZKP  =  DZ(K+1)
               DDZK   =  DDZ(K)
              RDDZK   = RDDZ(K)

                AUX   = DDYJ*DDZK
                AUY   =  DXI*DDZK
#if !defined _KOMXK_

#if defined _PREPROC_ && defined _TRANSPORTING_
      FUE  =  AUX*(FUI(K,J,I)  +(FUI(K,J,I+1)-FUI(K,J,I)  )
     $        *0.5*DXI /DDXIP)
      FUW  =  AUX*(FUI(K,J,I-1)+(FUI(K,J,I)  -FUI(K,J,I-1))
     $        *0.5*DXIM/DDXI)
      FUN  =  AUY*(FVI(K,J,I)  + FVI(K,J,I+1)  )         *0.5
      FUS  =  AUY*(FVI(K,J-1,I)+ FVI(K,J-1,I+1))         *0.5
      FUT  =  AUZ*(FWI(K,J,I)  + FWI(K,J,I+1)  )         *0.5
      FUB  =  AUZ*(FWI(K-1,J,I)+ FWI(K-1,J,I+1))         *0.5
#else
      FUE  =  AUX*(U(K,J,I)  +(U(K,J,I+1)-U(K,J,I)  )*0.5*DXI /DDXIP)
      FUW  =  AUX*(U(K,J,I-1)+(U(K,J,I)  -U(K,J,I-1))*0.5*DXIM/DDXI)
      FUN  =  AUY*(V(K,J,I)  + V(K,J,I+1)  )         *0.5
      FUS  =  AUY*(V(K,J-1,I)+ V(K,J-1,I+1))         *0.5
      FUT  =  AUZ*(W(K,J,I)  + W(K,J,I+1)  )         *0.5
      FUB  =  AUZ*(W(K-1,J,I)+ W(K-1,J,I+1))         *0.5
#endif
#else

#if defined _TRANSPORTING_

      FUE  =  AUX*FUI(K,J,I+1)
      FUW  =  AUX*FUI(K,J,I  )
      FUN  =  AUY*FVI(K,J  ,I+1)
      FUS  =  AUY*FVI(K,J-1,I+1)
      FUT  =  AUZ*FWI(K  ,J,I+1)
      FUB  =  AUZ*FWI(K-1,J,I+1)

#elif defined _TRANSPORTING4_

      FUE  =  AUX*FUI(K,J,I+1)
      FUW  =  AUX*FUI(K,J,I  )
      FUN =  AUY*( 
     $    0.75*( V(K,J,I) + V(K,J,I+1) )
     $   -0.125*( FVI(K,J,I+2)-2.0*FVI(K,J,I+1)+FVI(K,J,I) )
     $   -0.125*(FVJ(K,J,I)+FVJ(K,J,I+1)+FVJ(K,J+1,I+1)+FVJ(K,J+1,I)))
      FUS =  AUY*( 
     $    0.75*      ( V(K,J-1,I) + V(K,J-1,I+1) ) 
     $   -0.125*( FVI(K,J-1,I+2)-2.0*FVI(K,J-1,I+1)+FVI(K,J-1,I) )
     $   -0.125*(FVJ(K,J-1,I)+FVJ(K,J-1,I+1)+FVJ(K,J,I+1)+FVJ(K,J,I)))
     
#if defined _KOMZK_


      FUT  =  AUZ*( 
     $           0.75*( W(K,J,I) + W(K,J,I+1) ) 
     $    -0.125*( FWI(K,J,I+2)-2.0*FWI(K,J,I+1)+FWI(K,J,I) )
     $    -0.125*( FWK(K,J,I)+FWK(K,J,I+1)+FWK(K+1,J,I+1)+FWK(K+1,J,I)))

      FUB  =  AUZ*( 
     $           0.75*( W(K-1,J,I) + W(K-1,J,I+1) ) 
     $  -0.125*( FWI(K-1,J,I+2)-2.0*FWI(K-1,J,I+1)+FWI(K-1,J,I) )
     $  -0.125*( FWK(K-1,J,I)+FWK(K-1,J,I+1)+FWK(K,J,I+1)+FWK(K,J,I))) 

C-------------wall correction for 4O transporting
        IF (K .EQ. KSTART ) THEN
      	    FUB = 0.0
	ELSEIF (K .EQ. KSTOP ) THEN
	    FUT = 0.0
        ENDIF
	
     
#else     
      FUT  =  AUZ*(W(K,J,I)  + W(K,J,I+1)  )         *0.5
      FUB  =  AUZ*(W(K-1,J,I)+ W(K-1,J,I+1))         *0.5
#endif	

#else
      FUE  =  AUX*(U(K,J,I)  +(U(K,J,I+1)-U(K,J,I)  )*0.5*DXI /DDXIP)
      FUW  =  AUX*(U(K,J,I-1)+(U(K,J,I)  -U(K,J,I-1))*0.5*DXIM/DDXI)
      FUN  =  AUY*(V(K,J,I)  + V(K,J,I+1)  )         *0.5
      FUS  =  AUY*(V(K,J-1,I)+ V(K,J-1,I+1))         *0.5
      FUT  =  AUZ*(W(K,J,I)  + W(K,J,I+1)  )         *0.5
      FUB  =  AUZ*(W(K-1,J,I)+ W(K-1,J,I+1))         *0.5
#endif
#endif 





C                                 JETZT KOMPAKTE INTERPOLATION
C                                 U IN I,J UND K-RICHTUNG
#if defined _PREPROC_

      QKUE = FUE*(FUI(K,J,I)  +  
     $        (FUI(K,J,I+1)-FUI(K,J,I)  )*0.5*DXI /DDXIP)
      QKUW = FUW*(FUI(K,J,I-1)+
     $        (FUI(K,J,I)  -FUI(K,J,I-1))*0.5*DXIM/DDXI)
      QKUN = 0.5*FUN*(FUJ(K,J,I)   + FUJ(K,J+1,I))
      QKUS = 0.5*FUS*(FUJ(K,J-1,I) + FUJ(K,J,I)  )
      QKUT = 0.5*FUT*(FUK(K,J,I)   + FUK(K+1,J,I)) 
      QKUB = 0.5*FUB*(FUK(K-1,J,I) + FUK(K,J,I)  )

#else
#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_
      QKUE = FUE*FUI(K,J,I+1)
      QKUW = FUW*FUI(K,J,I)
#else
       QKUE =FUE*(U(K,J,I)+(U(K,J,I+1)-U(K,J,I)  )*0.5*DXI /DDXIP)
       QKUW =FUW*(U(K,J,I-1)+(U(K,J,I)-U(K,J,I-1))*0.5*DXIM/DDXI)
#endif

#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | defined _ZEN4O_
      QKUN = FUN*FUJ(K,J+1,I)
      QKUS = FUS*FUJ(K,J,I)
#else
      QKUN = 0.5*FUN*(U(K,J,I)   + U(K,J+1,I))
      QKUS = 0.5*FUS*(U(K,J-1,I) + U(K,J,I)  )
#endif

#if defined _KOMZK_
      QKUT = FUT*FUK(K+1,J,I)
      QKUB = FUB*FUK(K,J,I)
#else
      QKUT = 0.5*FUT*(U(K,J,I)   + U(K+1,J,I)) 
      QKUB = 0.5*FUB*(U(K-1,J,I) + U(K,J,I)  )
#endif
#endif

#ifdef _UPW_
C                                 JETZT STANDARDINTERPOLATION

      QKUE = FUE*U(K,J,I)   + (U(K,J,I+1)-U(K,J,I)  )*WF(FUE)
      QKUW = FUW*U(K,J,I-1) + (U(K,J,I)  -U(K,J,I-1))*WF(FUW)
      QKUN = FUN*U(K,J,I)   + (U(K,J+1,I)-U(K,J,I)  )*WF(FUN)
      QKUS = FUS*U(K,J-1,I) + (U(K,J,I)  -U(K,J-1,I))*WF(FUS)
      QKUT = FUT*U(K,J,I)   + (U(K+1,J,I)-U(K,J,I)  )*WF(FUT)
      QKUB = FUB*U(K-1,J,I) + (U(K,J,I)  -U(K-1,J,I))*WF(FUB)
#endif

#ifdef _QUD_
C                                  JETZT QUADRATISCH INTERPOLIEREN

      UWP  = QIN(U(K,J,I-2),U(K,J,I-1),U(K,J,I)  ,DDXIM ,DDXI  ,DXIM*HP)
      UWN  = QIN(U(K,J,I-1),U(K,J,I)  ,U(K,J,I+1),DDXI  ,DDXIP ,DXI *HN)
      UEP  = QIN(U(K,J,I-1),U(K,J,I)  ,U(K,J,I+1),DDXI  ,DDXIP ,DXI *HP)
      UEN  = QIN(U(K,J,I)  ,U(K,J,I+1),U(K,J,I+2),DDXIP ,DDXIPP,DXIP*HN)
      USP  = QIN(U(K,J-2,I),U(K,J-1,I),U(K,J,I)  , DYJMM, DYJM ,DYJM*HP)
      USN  = QIN(U(K,J-1,I),U(K,J,I)  ,U(K,J+1,I), DYJM , DYJ  ,DYJM*HN)
      UNP  = QIN(U(K,J-1,I),U(K,J,I)  ,U(K,J+1,I), DYJM , DYJ  ,DYJ *HP)
      UNN  = QIN(U(K,J,I)  ,U(K,J+1,I),U(K,J+2,I), DYJ  , DYJP ,DYJ *HN)
      UBP  = QIN(U(K-2,J,I),U(K-1,J,I),U(K,J,I)  , DZKMM, DZKM ,DZKM*HP)
      UBN  = QIN(U(K-1,J,I),U(K,J,I)  ,U(K+1,J,I), DZKM , DZK  ,DZKM*HN)
      UTP  = QIN(U(K-1,J,I),U(K,J,I)  ,U(K+1,J,I), DZKM , DZK  ,DZK *HP)
      UTN  = QIN(U(K,J,I)  ,U(K+1,J,I),U(K+2,J,I), DZK  , DZKP ,DZK *HN)

      QKUE = FUE*(UEP+UEN)+ABS(FUE)*(UEP-UEN)
      QKUW = FUW*(UWP+UWN)+ABS(FUW)*(UWP-UWN)
      QKUN = FUN*(UNP+UNN)+ABS(FUN)*(UNP-UNN)
      QKUS = FUS*(USP+USN)+ABS(FUS)*(USP-USN)
      QKUT = FUT*(UTP+UTN)+ABS(FUT)*(UTP-UTN)
      QKUB = FUB*(UBP+UBN)+ABS(FUB)*(UBP-UBN)
#endif

C                                 ZEITSCHRITT

#ifdef _RUNGEKUTTA3_

      UO(K,J,I) = FKDTU * RDDZK * (QKUE-QKUW+QKUN-QKUS+QKUT-QKUB)

#endif

#ifdef _LEAPF_

      UO(K,J,I) =  UO(K,J,I) +
     $ FKDTU * RDDZK * (QKUE-QKUW+QKUN-QKUS+QKUT-QKUB)

#endif

  100 CONTINUE

 2110 CONTINUE

C                                 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
C                                 --------------------------------------
C
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NLV.EQ.0).AND.(J .EQ. JSTOP))  GOTO 2120
      IF ((NRV.EQ.0).AND.(J .EQ. JSTART)) GOTO 2120
      IF ( I .EQ. ISTART ) GOTO 2120



      DO 110  K = KSTART, KSTOP
C                                  GEOMETRISCHE KONSTANTEN (K)
                DZK   =  DZ(K)
                DZKM  =  DZ(K-1)
                DZKMM =  DZ(K-2)
                DZKP  =  DZ(K+1)
               DDZK   =  DDZ(K)
              RDDZK   = RDDZ(K)

                AVX   =  DYJ*DDZK
                AVY   = DDXI*DDZK

C                                 KONVEKTIVE F-TERME
#if !defined _KOMYK_
#if defined _PREPROC_ && defined _TRANSPORTING_
      FVE  =     AVX*(FUJ(K,J,I)  + FUJ(K,J+1,I))  *0.5
      FVW  =     AVX*(FUJ(K,J,I-1)+ FUJ(K,J+1,I-1))*0.5    
      FVN  =     AVY*(FVJ(K,J,I)+(FVJ(K,J+1,I)-FVJ(K,J,I) ) 
     $           *0.5*DYJ/DDYJP)
      FVS  =     AVY*(FVJ(K,J-1,I)+(FVJ(K,J,I)-FVJ(K,J-1,I))
     $           *0.5*DYJM/DDYJ )
      FVT  =     AVZ*(FWJ(K,J,I)  + FWJ(K,J+1,I)  )*0.5
      FVB  =     AVZ*(FWJ(K-1,J,I)+ FWJ(K-1,J+1,I))*0.5
#else
      FVE  =     AVX*(U(K,J,I)  + U(K,J+1,I)  )         *0.5
      FVW  =     AVX*(U(K,J,I-1)+ U(K,J+1,I-1))         *0.5
      FVN  =     AVY*(V(K,J,I)  +(V(K,J+1,I)-V(K,J,I) ) *0.5*DYJ /DDYJP)
      FVS  =     AVY*(V(K,J-1,I)+(V(K,J,I)  -V(K,J-1,I))*0.5*DYJM/DDYJ )
      FVT  =     AVZ*(W(K,J,I)  + W(K,J+1,I)  )         *0.5
      FVB  =     AVZ*(W(K-1,J,I)+ W(K-1,J+1,I))         *0.5
#endif

#else
#if defined _TRANSPORTING_

      FVE =  AVX*FUJ(K,J+1,I)
      FVW =  AVX*FUJ(K,J+1,I-1)
      FVN =  AVY*FVJ(K,J+1,I)
      FVS =  AVY*FVJ(K,J  ,I)
      FVT =  AVZ*FWJ(K,J+1,I)
      FVB =  AVZ*FWJ(K-1,J+1,I)

#elif defined _TRANSPORTING4_

      FVE =  AVX*( 
     $ 0.750*( U(K,J,I) + U(K,J+1,I) )-
     $ 0.125*( FUJ(K,J+2,I)-2.0*FUJ(K,J+1,I)+FUJ(K,J,I) )-
     $ 0.125*( FUI(K,J,I)+FUI(K,J,I+1)+FUI(K,J+1,I+1)+FUI(K,J+1,I)))

      FVW =  AVX*( 
     $    0.75*      ( U(K,J,I-1) + U(K,J+1,I-1) ) 
     $   -0.125*( FUJ(K,J+2,I-1)-2.0*FUJ(K,J+1,I-1)+FUJ(K,J,I-1) )
     $   -0.125*(FUI(K,J,I-1)+FUI(K,J,I)+FUI(K,J+1,I)+FUI(K,J+1,I-1)))


      FVN =  AVY*FVJ(K,J+1,I)
      FVS =  AVY*FVJ(K,J  ,I)

#if defined _KOMZK_

      FVT =  AVZ*( 
     $ 0.750*( W(K,J,I) + W(K,J+1,I) )-
     $ 0.125*( FWJ(K,J+2,I)-2.0*FWJ(K,J+1,I)+FWJ(K,J,I) )-
     $ 0.125*( FWK(K,J,I)+FWK(K,J+1,I)+FWK(K+1,J+1,I)+FWK(K+1,J,I)))

      FVB =  AVZ*( 
     $ 0.750*( W(K-1,J,I) + W(K-1,J+1,I) )-
     $ 0.125*( FWJ(K-1,J+2,I)-2.0*FWJ(K-1,J+1,I)+FWJ(K-1,J,I) )-
     $ 0.125*( FWK(K-1,J,I)+FWK(K-1,J+1,I)+FWK(K,J+1,I)+FWK(K,J,I)))

C-----------wall correction for 4O order
	IF (K .EQ. KSTART ) THEN
	    FVB = 0.0
	ELSEIF (K .EQ. KSTOP ) THEN
	    FVT = 0.0
	ENDIF

#else
C 2nd-order
      FVT  =     AVZ*(W(K,J,I)  + W(K,J+1,I)  )         *0.5
      FVB  =     AVZ*(W(K-1,J,I)+ W(K-1,J+1,I))         *0.5
#endif
      
#else
      FVE  =     AVX*(U(K,J,I)  + U(K,J+1,I)  )         *0.5
      FVW  =     AVX*(U(K,J,I-1)+ U(K,J+1,I-1))         *0.5
      FVN  =     AVY*(V(K,J,I)  +(V(K,J+1,I)-V(K,J,I) ) *0.5*DYJ /DDYJP)
      FVS  =     AVY*(V(K,J-1,I)+(V(K,J,I)  -V(K,J-1,I))*0.5*DYJM/DDYJ )
      FVT  =     AVZ*(W(K,J,I)  + W(K,J+1,I)  )         *0.5
      FVB  =     AVZ*(W(K-1,J,I)+ W(K-1,J+1,I))         *0.5
#endif
#endif




C




C                                 JETZT KOMPAKTE INTERPOLATION
C                                 V IN I,J UND K-RICHTUNG
#if defined _PREPROC_
      QKVE = 0.5*FVE*(FVI(K,J,I)   + FVI(K,J,I+1))
      QKVW = 0.5*FVW*(FVI(K,J,I-1) + FVI(K,J,I)  )
      QKVN = FVN*(FVJ(K,J,I)  +
     $           (FVJ(K,J+1,I)-FVJ(K,J,I) ) *0.5*DYJ /DDYJP)
      QKVS = FVS*(FVJ(K,J-1,I)+
     $           (FVJ(K,J,I)  -FVJ(K,J-1,I))*0.5*DYJM/DDYJ )
      QKVT = 0.5*FVT*(FVK(K,J,I)   + FVK(K+1,J,I))
      QKVB = 0.5*FVB*(FVK(K-1,J,I) + FVK(K,J,I)  )
#else
#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_
      QKVE = FVE*FVI(K,J,I+1)                  
      QKVW = FVW*FVI(K,J,I)                 
#else
      QKVE = 0.5*FVE*(V(K,J,I)   + V(K,J,I+1))
      QKVW = 0.5*FVW*(V(K,J,I-1) + V(K,J,I)  )
#endif

#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | defined _ZEN4O_
      QKVN = FVN*FVJ(K,J+1,I)
      QKVS = FVS*FVJ(K,J,I)
#else
       QKVN =FVN*(V(K,J,I) +(V(K,J+1,I)-V(K,J,I) ) *0.5*DYJ /DDYJP)
       QKVS =FVS*(V(K,J-1,I)+(V(K,J,I) -V(K,J-1,I))*0.5*DYJM/DDYJ )
#endif

#if defined _KOMZK_
      QKVT = FVT*FVK(K+1,J,I)
      QKVB = FVB*FVK(K,J,I)
#else
      QKVT = 0.5*FVT*(V(K,J,I)   + V(K+1,J,I))
      QKVB = 0.5*FVB*(V(K-1,J,I) + V(K,J,I)  )
#endif
#endif

#ifdef _UPW_
C                                 JETZT STANDARDINTERPOLATION

      QKVE = FVE*V(K,J,I)   + (V(K,J,I+1)-V(K,J,I)  )*WF(FVE)
      QKVW = FVW*V(K,J,I-1) + (V(K,J,I)  -V(K,J,I-1))*WF(FVW)
      QKVN = FVN*V(K,J,I)   + (V(K,J+1,I)-V(K,J,I)  )*WF(FVN)
      QKVS = FVS*V(K,J-1,I) + (V(K,J,I)  -V(K,J-1,I))*WF(FVS)
      QKVT = FVT*V(K,J,I)   + (V(K+1,J,I)-V(K,J,I)  )*WF(FVT)
      QKVB = FVB*V(K-1,J,I) + (V(K,J,I)  -V(K-1,J,I))*WF(FVB)

#endif

#ifdef _QUD_
C                                 JETZT QUADRATISCH INTERPOLIEREN

      VWP  = QIN(V(K,J,I-2),V(K,J,I-1),V(K,J,I)  , DXIMM, DXIM ,DXIM*HP)
      VWN  = QIN(V(K,J,I-1),V(K,J,I)  ,V(K,J,I+1), DXIM , DXI  ,DXIM*HN)
      VEP  = QIN(V(K,J,I-1),V(K,J,I)  ,V(K,J,I+1), DXIM , DXI  ,DXI *HP)
      VEN  = QIN(V(K,J,I)  ,V(K,J,I+1),V(K,J,I+2), DXI  , DXIP ,DXI *HN)
      VSP  = QIN(V(K,J-2,I),V(K,J-1,I),V(K,J,I)  ,DDYJM ,DDYJ  ,DYJM*HP)
      VSN  = QIN(V(K,J-1,I),V(K,J,I)  ,V(K,J+1,I),DDYJ  ,DDYJP ,DYJ *HN)
      VNP  = QIN(V(K,J-1,I),V(K,J,I)  ,V(K,J+1,I),DDYJ  ,DDYJP ,DYJ *HP)
      VNN  = QIN(V(K,J,I)  ,V(K,J+1,I),V(K,J+2,I),DDYJP ,DDYJPP,DYJP*HN)
      VBP  = QIN(V(K-2,J,I),V(K-1,J,I),V(K,J,I)  , DZKMM, DZKM ,DZKM*HP)
      VBN  = QIN(V(K-1,J,I),V(K,J,I)  ,V(K+1,J,I), DZKM , DZK  ,DZKM*HN)
      VTP  = QIN(V(K-1,J,I),V(K,J,I)  ,V(K+1,J,I), DZKM , DZK  ,DZK *HP)
      VTN  = QIN(V(K,J,I)  ,V(K+1,J,I),V(K+2,J,I), DZK  , DZKP ,DZK *HN)

      QKVE = FVE*(VEP+VEN)+ABS(FVE)*(VEP-VEN)
      QKVW = FVW*(VWP+VWN)+ABS(FVW)*(VWP-VWN)
      QKVN = FVN*(VNP+VNN)+ABS(FVN)*(VNP-VNN)
      QKVS = FVS*(VSP+VSN)+ABS(FVS)*(VSP-VSN)
      QKVT = FVT*(VTP+VTN)+ABS(FVT)*(VTP-VTN)
      QKVB = FVB*(VBP+VBN)+ABS(FVB)*(VBP-VBN)
#endif

C                                 ZEITSCHRITT

#ifdef _RUNGEKUTTA3_

      VO(K,J,I) =  FKDTV * RDDZK * (QKVE-QKVW+QKVN-QKVS+QKVT-QKVB)

#endif

#ifdef _LEAPF_

      VO(K,J,I) =   VO(K,J,I) +
     $  FKDTV * RDDZK * (QKVE-QKVW+QKVN-QKVS+QKVT-QKVB)

#endif 

  110 CONTINUE

 2120 CONTINUE

C                                 WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW
C                                 --------------------------------------

      IF ( I .EQ. ISTART ) GOTO 2130
      IF ( J .EQ. JSTART ) GOTO 2130

      KSTOPM = KSTOP - 1 + NTW
      KSTARTM= KSTART - NBW

      DO 120  K = KSTARTM, KSTOPM
C                                  GEOMETRISCHE KONSTANTEN (K)
                DZK   =  DZ(K)
               RDZK   = RDZ(K)
                DZKM  =  DZ(K-1)
                DZKMM =  DZ(K-2)
                DZKP  =  DZ(K+1)
               DDZK   = DDZ(K)
               DDZKM  = DDZ(K-1)
               DDZKP  = DDZ(K+1)
               DDZKPP = DDZ(K+2)

                AWX   = DDYJ*DZK
                AWY   = DDXI*DZK

C                                 KONVEKTIVE F-TERME
#if !defined _KOMZK_
#if defined _PREPROC_ && defined _TRANSPORTING_
      FWE  =     AWX*(FUK(K,J,I)  + FUK(K+1,J,I)  )         *0.5
      FWW  =     AWX*(FUK(K,J,I-1)+ FUK(K+1,J,I-1))         *0.5
      FWN  =     AWY*(FVK(K,J,I)  + FVK(K+1,J,I)  )         *0.5
      FWS  =     AWY*(FVK(K,J-1,I)+ FVK(K+1,J-1,I))         *0.5
      FWT  =     AWZ*(FWK(K,J,I)  +(FWK(K+1,J,I)-FWK(K,J,I)  )
     $           *0.5*DZK /DDZKP)
      FWB  =     AWZ*(FWK(K-1,J,I)+(FWK(K,J,I)  -FWK(K-1,J,I))
     $           *0.5*DZKM/DDZK )
#else 
      FWE  =     AWX*(U(K,J,I)  + U(K+1,J,I)  )         *0.5
      FWW  =     AWX*(U(K,J,I-1)+ U(K+1,J,I-1))         *0.5
      FWN  =     AWY*(V(K,J,I)  + V(K+1,J,I)  )         *0.5
      FWS  =     AWY*(V(K,J-1,I)+ V(K+1,J-1,I))         *0.5
      FWT  =     AWZ*(W(K,J,I)  +(W(K+1,J,I)-W(K,J,I)  )*0.5*DZK /DDZKP)
      FWB  =     AWZ*(W(K-1,J,I)+(W(K,J,I)  -W(K-1,J,I))*0.5*DZKM/DDZK )
#endif
#else
#if defined _TRANSPORTING4_

      FWE =  AWX*( 
     $ 0.750*( U(K+1,J,I) + U(K,J,I) )-
     $ 0.125*( FUK(K+2,J,I)-2.0*FUK(K+1,J,I)+FUK(K,J,I) )-
     $ 0.125*( FUI(K,J,I)+FUI(K,J,I+1)+FUI(K+1,J,I+1)+FUI(K+1,J,I)))

      FWW =  AWX*( 
     $ 0.750*( U(K+1,J,I-1) + U(K,J,I) )-
     $ 0.125*( FUK(K+2,J,I-1)-2.0*FUK(K+1,J,I-1)+FUK(K,J,I-1) )-
     $ 0.125*( FUI(K,J,I-1)+FUI(K,J,I)+FUI(K+1,J,I)+FUI(K+1,J,I-1)))
     
     
      FWN =  AWY*( 
     $  0.750*( V(K+1,J,I) + V(K,J,I) )
     $ -0.125*( FVK(K+2,J,I)-2.0*FVK(K+1,J,I)+FVK(K,J,I) )
     $ -0.125*( FVJ(K,J,I)+FVJ(K,J+1,I)+FVJ(K+1,J+1,I)+FVJ(K+1,J,I)))
      FWS =  AWY*( 
     $  0.750*( V(K+1,J-1,I) + V(K,J-1,I) )
     $ -0.125*( FVK(K+2,J-1,I)-2.0*FVK(K+1,J-1,I)+FVK(K,J-1,I) )
     $ -0.125*( FVJ(K,J-1,I)+FVJ(K,J,I)+FVJ(K+1,J,I)+FVJ(K+1,J-1,I)))
     
     
      FWT  =     AWZ*FWK(K+1,J,I)
      FWB  =     AWZ*FWK(K  ,J,I)
#elif defined _TRANSPORTING_      

      FWE  =     AWX*FUK(K+1,J,I  )
      FWW  =     AWX*FUK(K+1,J,I-1)
      FWN  =     AWY*FVK(K+1,J  ,I)
      FWS  =     AWY*FVK(K+1,J-1,I)
      FWT  =     AWZ*FWK(K+1,J,I)
      FWB  =     AWZ*FWK(K  ,J,I)

#else
      FUE  =  AUX*(U(K,J,I)  +(U(K,J,I+1)-U(K,J,I)  )*0.5*DXI /DDXIP)
      FUW  =  AUX*(U(K,J,I-1)+(U(K,J,I)  -U(K,J,I-1))*0.5*DXIM/DDXI)
      FUN  =  AUY*(V(K,J,I)  + V(K,J,I+1)  )         *0.5
      FUS  =  AUY*(V(K,J-1,I)+ V(K,J-1,I+1))         *0.5
      FUT  =  AUZ*(W(K,J,I)  + W(K,J,I+1)  )         *0.5
      FUB  =  AUZ*(W(K-1,J,I)+ W(K-1,J,I+1))         *0.5

#endif
#endif
C                                 JETZT KOMPAKTE INTERPOLATION
C                                 W IN I,J UND K-RICHTUNG
#if defined _PREPROC_
      QKWE = 0.5*FWE*(FWI(K,J,I)   + FWI(K,J,I+1))
      QKWW = 0.5*FWW*(FWI(K,J,I-1) + FWI(K,J,I)  )
      QKWN = 0.5*FWN*(FWJ(K,J,I)   + FWJ(K,J+1,I))
      QKWS = 0.5*FWS*(FWJ(K,J-1,I) + FWJ(K,J,I)  )
      QKWT = FWT*(FWK(K,J,I) 
     $              +(FWK(K+1,J,I)-FWK(K,J,I)  )*0.5*DZK /DDZKP)
      QKWB = FWB*(FWK(K-1,J,I)+
     $               (FWK(K,J,I)  -FWK(K-1,J,I))*0.5*DZKM/DDZK )
#else
#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_
      QKWE = FWE*FWI(K,J,I+1)
      QKWW = FWW*FWI(K,J,I)
#else
      QKWE = 0.5*FWE*(W(K,J,I)   + W(K,J,I+1))
      QKWW = 0.5*FWW*(W(K,J,I-1) + W(K,J,I)  )
#endif

#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | defined _ZEN4O_
      QKWN = FWN*FWJ(K,J+1,I)
      QKWS = FWS*FWJ(K,J,I)
#else
      QKWN = 0.5*FWN*(W(K,J,I)   + W(K,J+1,I))
      QKWS = 0.5*FWS*(W(K,J-1,I) + W(K,J,I)  )
#endif

#if defined _KOMZK_
      QKWT = FWT*FWK(K+1,J,I)
      QKWB = FWB*FWK(K,J,I)
#else
       QKWT =FWT*(W(K,J,I)+(W(K+1,J,I)-W(K,J,I)  )*0.5*DZK /DDZKP)
       QKWB =FWB*(W(K-1,J,I)+(W(K,J,I)-W(K-1,J,I))*0.5*DZKM/DDZK )
#endif
#endif

#ifdef _UPW_
C                                 JETZT STANDARDINTERPOLATION

      QKWE = FWE*W(K,J,I)   + (W(K,J,I+1)-W(K,J,I)  )*WF(FWE)
      QKWW = FWW*W(K,J,I-1) + (W(K,J,I)  -W(K,J,I-1))*WF(FWW)
      QKWN = FWN*W(K,J,I)   + (W(K,J+1,I)-W(K,J,I)  )*WF(FWN)
      QKWS = FWS*W(K,J-1,I) + (W(K,J,I)  -W(K,J-1,I))*WF(FWS)
      QKWT = FWT*W(K,J,I)   + (W(K+1,J,I)-W(K,J,I)  )*WF(FWT)
      QKWB = FWB*W(K-1,J,I) + (W(K,J,I)  -W(K-1,J,I))*WF(FWB)

#endif
#ifdef _QUD_
C                                 JETZT QUADRATISCH INTERPOLIEREN

      WWP  = QIN(W(K,J,I-2),W(K,J,I-1),W(K,J,I)  , DXIMM, DXIM ,DXIM*HP)
      WWN  = QIN(W(K,J,I-1),W(K,J,I)  ,W(K,J,I+1), DXIM , DXI  ,DXIM*HN)
      WEP  = QIN(W(K,J,I-1),W(K,J,I)  ,W(K,J,I+1), DXIM , DXI  ,DXI *HP)
      WEN  = QIN(W(K,J,I)  ,W(K,J,I+1),W(K,J,I+2), DXI  , DXIP ,DXI *HN)
      WSP  = QIN(W(K,J-2,I),W(K,J-1,I),W(K,J,I)  , DYJMM, DYJM ,DYJM*HP)
      WSN  = QIN(W(K,J-1,I),W(K,J,I)  ,W(K,J+1,I), DYJM , DYJ  ,DYJM*HN)
      WNP  = QIN(W(K,J-1,I),W(K,J,I)  ,W(K,J+1,I), DYJM , DYJ  ,DYJ *HP)
      WNN  = QIN(W(K,J,I)  ,W(K,J+1,I),W(K,J+2,I), DYJ  , DYJP ,DYJ *HN)
      WBP  = QIN(W(K-2,J,I),W(K-1,J,I),W(K,J,I)  ,DDZKM ,DDZK  ,DZKM*HP)
      WBN  = QIN(W(K-1,J,I),W(K,J,I)  ,W(K+1,J,I),DDZK  ,DDZKP ,DZK *HN)
      WTP  = QIN(W(K-1,J,I),W(K,J,I)  ,W(K+1,J,I),DDZK  ,DDZKP ,DZK *HP)
      WTN  = QIN(W(K,J,I)  ,W(K+1,J,I),W(K+2,J,I),DDZKP ,DDZKPP,DZKP*HN)


      QKWE = FWE*(WEP+WEN)+ABS(FWE)*(WEP-WEN)
      QKWW = FWW*(WWP+WWN)+ABS(FWW)*(WWP-WWN)
      QKWN = FWN*(WNP+WNN)+ABS(FWN)*(WNP-WNN)
      QKWS = FWS*(WSP+WSN)+ABS(FWS)*(WSP-WSN)
      QKWT = FWT*(WTP+WTN)+ABS(FWT)*(WTP-WTN)
      QKWB = FWB*(WBP+WBN)+ABS(FWB)*(WBP-WBN)
#endif

C                                 ZEITSCHRITT

#ifdef _RUNGEKUTTA3_

      WO(K,J,I) =  FKDTW * RDZK  * (QKWE-QKWW+QKWN-QKWS+QKWT-QKWB)

#endif

#ifdef _LEAPF_

      WO(K,J,I) =   WO(K,J,I) +
     $   FKDTW * RDZK  * (QKWE-QKWW+QKWN-QKWS+QKWT-QKWB)

#endif

  120 CONTINUE

 2130 CONTINUE

   20 CONTINUE
   10 CONTINUE
C                                 20 20 20 20 20 20 20 20 20 20 20 20 20
C                                 10 10 10 10 10 10 10 10 10 10 10 10 10

c 2200  IF(ABS(WDIF) .LE. SMALL) GOTO 2300
 2200  CONTINUE

C                                 **************************************
C                                 DIFFUSIVE TERME   DIFFUSIVE TERME   DI
C                                 **************************************
#if defined _PREPROC_
      CALL PREPROC_FIELD(KK,JJ,II,U,GI,GJ,FUI,FUJ,FUK,DZ,.FALSE.)
      CALL PREPROC_FIELD(KK,JJ,II,V,GI,GJ,FVI,FVJ,FVK,DZ,.FALSE.)
      CALL PREPROC_FIELD_WCOMP(KK,JJ,II,W,GI,GJ,FWI,FWJ,FWK,DDZ,.FALSE.)
C      CALL PREPROC_PRESSURE(KK,JJ,II,P,GI,GJ,HPX)
#endif
#if defined _KOMXK_ | defined _KOMXD6O_ | defined _KOMXD8O_

      IF(ABS(WDIF) .GT. SMALL) THEN

         IF (NFRO .EQ. 1 ) THEN
            CALL FDERFOUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDX,RDDX,U,FUI,
     $           LCOL,DIAG,RCOL,UZ,RSP)                      
 
            CALL FDERFOUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDX,RDDX,V,FVI,
     $           LCOL,DIAG,RCOL,UZ,RSP)                      
 
            CALL FDERFOUX_PER (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDX,RDDX,W,FWI,
     $           LCOL,DIAG,RCOL,UZ,RSP)                      

        ELSE

           CALL FDERFOUX (KK,JJ,II,KSTART,JSTART,ISTART,
     $          KSTOP,JSTOP,ISTOP,RDX,RDDX,COEFDX,RSGS3,FAKTOR,
     $          U,FUI,FUI,NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        ) 
           CALL FDERFOVWX(KK,JJ,II,KSTART,JSTART,ISTART,
     $          KSTOP,JSTOP,ISTOP,RDX,RDDX,COEFDX,RSGS3,FAKTOR,
     $          V,FVI,FVI,NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )
           CALL FDERFOVWX(KK,JJ,II,KSTART,JSTART,ISTART,
     $          KSTOP,JSTOP,ISTOP,RDX,RDDX,COEFDX,RSGS3,FAKTOR,
     $          W,FWI,FWI,NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
        ENDIF

      ENDIF
#endif

#if defined _KOMYK_ | defined _KOMYD6O_ | defined _KOMYD8O_ | defined _ZEN4O_

      IF(ABS(WDIF) .GT. SMALL) THEN
         IF (NLFT .EQ. 1 ) THEN
            CALL FDERFOVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDY,RDDY,U,FUJ,
     $           LCOL,DIAG,RCOL,UZ,RSP)

            CALL FDERFOVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDY,RDDY,V,FVJ,
     $           LCOL,DIAG,RCOL,UZ,RSP)

            CALL FDERFOVY_PER  (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RSGS3,RDY,RDDY,W,FWJ,
     $           LCOL,DIAG,RCOL,UZ,RSP)
         ELSE
            CALL FDERFOUWY (KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RDY,RDDY,COEFDY,RSGS3,FAKTOR,
     $           U,FUJ,FUJ,NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        ) 
            CALL FDERFOVY(KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RDY,RDDY,COEFDY,RSGS3,FAKTOR,
     $           V,FVJ,FVJ,NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )
            CALL FDERFOUWY(KK,JJ,II,KSTART,JSTART,ISTART,
     $           KSTOP,JSTOP,ISTOP,RDY,RDDY,COEFDY,RSGS3,FAKTOR,
     $           W,FWJ,FWJ,NRGT,NLFT,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
         ENDIF
         
      ENDIF
#endif
#if defined _KOMZK_

      IF(ABS(WDIF) .GT. SMALL) THEN

         CALL FDERFOUVZ (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RDZ,RDDZ,COEFDZ,RSGS3,FAKTOR,
     $        U,FUK,FUK,NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BU,GI,GJ,GK
#endif
     $        )
         CALL FDERFOUVZ (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RDZ,RDDZ,COEFDZ,RSGS3,FAKTOR,
     $        V,FVK,FVK,NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BV,GI,GJ,GK
#endif
     $        )
         CALL FDERFOWZ (KK,JJ,II,KSTART,JSTART,ISTART,
     $        KSTOP,JSTOP,ISTOP,RDZ,RDDZ,COEFDZ,RSGS3,FAKTOR,
     $        W,FWK,FWK,NBOT,NTOP,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $        ,BW,GI,GJ,GK
#endif
     $        )
      ENDIF

#endif

C                                  WALL KORRECTION FUER U,V,W
      IF(ABS(WDIF) .GT. SMALL) THEN

        CALL SWCLE3D  (KK,JJ,II,KMX,JMX,IMX,DX,DY,DZ,DDX,DDY,DDZ,
     $                 U,V,W,P,G,B,WCU,WCV,WCW,
     $                 GMOL,RHO,UGRID,MTURB,ZTOT,GRADPX,
     $                 IC1,IC2,JC1,JC2,KC1,KC2,
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                 FUK,FVK,FUJ,FWJ,FVI,FWI,
     $                 RDDX,RDDY,RDDZ)
      ENDIF

      DO I = 1,II-1
         DO J = 1,JJ-1
            DO K = 1,KK-1
               GI(k,j,i) = G(k,j,i)*G(k,j,i+1)/(G(k,j,i)+G(k,j,i+1))
               GJ(k,j,i) = G(k,j,i)*G(k,j+1,i)/(G(k,j,i)+G(k,j+1,i))
               GK(k,j,i) = G(k,j,i)*G(k+1,j,i)/(G(k,j,i)+G(k+1,j,i))
            enddo
         enddo
      enddo

C***********************************************************************
C                                 11 11 11 11 11 11 11 11 11 11 11 11 11

      DO  11  I = ISTART, ISTOP

C                            BERECHNUNG DER DRUCKGRADIENTEN IN Z-RICHTUNG


C                                  GEOMETRISCHE KONSTANTEN (I)
                DXI   =  DX(I)
                DXIM  =  DX(I-1)
#ifdef _QUD_
                DXIMM =  DX(I-2)
               DDXIPP = DDX(I+2)
#endif
                DXIP  =  DX(I+1)
               DDXI   = DDX(I)
               DDXIM  = DDX(I-1)
               DDXIP  = DDX(I+1)

               RDXI   =  RDX(I)
               RDXIM  =  RDX(I-1)
               RDXIP  =  RDX(I+1)
              RDDXI   = RDDX(I)
              RDDXIM  = RDDX(I-1)
              RDDXIP  = RDDX(I+1)


C                                 22 22 22 22 22 22 22 22 22 22 22 22 22

      DO  22  J = JSTART, JSTOP
         
C                                  GEOMETRISCHE KONTANTEN (J)
                DYJ   =  DY(J)
                DYJM  =  DY(J-1)
#ifdef _QUD_
                DYJMM =  DY(J-2)
               DDYJPP = DDY(J+2)
#endif
                DYJP  =  DY(J+1)
               DDYJ   = DDY(J)
               DDYJM  = DDY(J-1)
               DDYJP  = DDY(J+1)

               RDYJ   =  RDY(J)
               RDYJM  =  RDY(J-1)
               RDYJP  =  RDY(J+1)
              RDDYJ   = RDDY(J)
              RDDYJM  = RDDY(J-1)
              RDDYJP  = RDDY(J+1)

                AUZ   =  DXI*DDYJ
                AVZ   = DDXI* DYJ
                AWZ   = DDXI*DDYJ

       IF(ABS(WDIF) .LE. SMALL) GOTO 2300

C                             KOEFFIZIENTEN BEIM DIFFUSIVEN ZEITSCHRITT


#ifdef _RUNGEKUTTA3_
                FDDTU = -1.0/RHO*RDDY(J)* RDX(I)*WDIF
                FDDTV = -1.0/RHO*RDDX(I)* RDY(J)*WDIF
                FDDTW = -1.0/RHO*RDDX(I)*RDDY(J)*WDIF
#endif

#ifdef _LEAPF_
                FDDTU = -1.0*DT/RHO*RDDY(J)* RDX(I)*WDIF
                FDDTV = -1.0*DT/RHO*RDDX(I)* RDY(J)*WDIF
                FDDTW = -1.0*DT/RHO*RDDX(I)*RDDY(J)*WDIF
#endif

C
C                                 UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
C                                 --------------------------------------
C
C
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NBU.EQ.0).AND.(I .EQ. ISTOP))  GOTO 2210
      IF ((NFU.EQ.0).AND.(I .EQ. ISTART)) GOTO 2210
      IF ( J .EQ. JSTART ) GOTO 2210


      DO 200  K = KSTART, KSTOP
C                                  GEOMETRISCHE KONSTANTEN (K)
               RDZK   =  RDZ(K)
               RDZKM  =  RDZ(K-1)
               DDZK   =  DDZ(K)
              RDDZK   = RDDZ(K)

                AUX   = DDYJ*DDZK
                AUY   =  DXI*DDZK

C                                 DIFFUSIVE D-TERME MIT
C                                 TRANSPORTKOEFFIZIENTEN

      GUE  = G(K,J,I+1)
      GUW  = G(K,J,I)
      GUN  = GJ(k  ,j  ,i)+GJ(k  ,j  ,i+1)
      GUS  = GJ(k  ,j-1,i)+GJ(k  ,j-1,i+1)
      GUT  = GK(k  ,j  ,i)+GK(k  ,j  ,i+1)
      GUB  = GK(k-1,j  ,i)+GK(k-1,j  ,i+1)


C      GUE  = G(K,J,I+1)
C      GUW  = G(K,J,I)
C      GUN  = G(K,J,I)  *G(K,J+1,I)   / (G(K,J,I)  +G(K,J+1,I)  )
C     $     + G(K,J,I+1)*G(K,J+1,I+1) / (G(K,J,I+1)+G(K,J+1,I+1))
C      GUS  = G(K,J,I)  *G(K,J-1,I)   / (G(K,J,I)  +G(K,J-1,I)  )
C     $     + G(K,J,I+1)*G(K,J-1,I+1) / (G(K,J,I+1)+G(K,J-1,I+1))
C      GUT  = G(K,J,I)  *G(K+1,J,I)   / (G(K,J,I)  +G(K+1,J,I)  )
C     $     + G(K,J,I+1)*G(K+1,J,I+1) / (G(K,J,I+1)+G(K+1,J,I+1))
C      GUB  = G(K,J,I)  *G(K-1,J,I)   / (G(K,J,I)  +G(K-1,J,I)  )
C     $     + G(K,J,I+1)*G(K-1,J,I+1) / (G(K,J,I+1)+G(K-1,J,I+1))


C                                     HIER KOMPAKTE BERECHNUNG
C                                     DER ERSTEN ABLEITUNG U
#ifdef _PREPROC_
      QDUE = -GUE * AUX*RDDXIP * (FUI(K,J,I+1) - FUI(K,J,I))
      QDUW = -GUW * AUX*RDDXI  * (FUI(K,J,I)   - FUI(K,J,I-1))

      QDUN = -GUN * AUY*RDYJ   * (FUJ(K,J+1,I) - FUJ(K,J,I))
      QDUS = -GUS * AUY*RDYJM  * (FUJ(K,J,I)   - FUJ(K,J-1,I))
      QDUT = -GUT * AUZ*RDZK   * (FUK(K+1,J,I) - FUK(K,J,I))
      QDUB = -GUB * AUZ*RDZKM  * (FUK(K,J,I)   - FUK(K-1,J,I))
#else
#if defined _KOMXK_ | defined _KOMXD6O_ | defined _KOMXD8O_
      QDUE = -GUE * AUX*FUI(K,J,I+1)
      QDUW = -GUW * AUX*FUI(K,J,I)
#else
      QDUE = -GUE * AUX*RDDXIP * (U(K,J,I+1) - U(K,J,I))
      QDUW = -GUW * AUX*RDDXI  * (U(K,J,I)   - U(K,J,I-1))
#endif

#if defined _KOMYK_ | defined _KOMYD6O_ | defined _KOMYD8O_ | defined _ZEN4O_
      QDUN = -GUN * AUY*FUJ(K,J+1,I)
      QDUS = -GUS * AUY*FUJ(K,J,I)
#else
      QDUN = -GUN * AUY*RDYJ   * (U(K,J+1,I) - U(K,J,I))
      QDUS = -GUS * AUY*RDYJM  * (U(K,J,I)   - U(K,J-1,I))
#endif

#if defined _KOMZK_
      QDUT = -GUT * AUZ*FUK(K+1,J,I)
      QDUB = -GUB * AUZ*FUK(K,J,I)
#else
      QDUT = -GUT * AUZ*RDZK   * (U(K+1,J,I) - U(K,J,I))
      QDUB = -GUB * AUZ*RDZKM  * (U(K,J,I)   - U(K-1,J,I))
#endif
#endif

#ifdef _DNS_
      QDUC = WCU(K,J,I)
#else

      STU  = ((GUE*(U(K,J,I+1)  -U(K,J,I)  )*RDDXIP  )
     $     -  (GUW*(U(K,J,I)    -U(K,J,I-1))*RDDXI   ))*AUX
     $     + ((GUN*(V(K,J,I+1)  -V(K,J,I)  )         )
     $     -  (GUS*(V(K,J-1,I+1)-V(K,J-1,I))         ))*DDZK
     $     + ((GUT*(W(K,J,I+1)  -W(K,J,I)  )         )
     $     -  (GUB*(W(K-1,J,I+1)-W(K-1,J,I))         ))*DDYJ

      QDUC = WCU(K,J,I) + STU*FLOAT(MTURB)
#endif

#if defined _INC1_ | defined _INC2_
      WRITE(6,*)'NONE FINAL VERSION OF INC-MODEL'
      STOP'STOP IN TSTLE3'
#endif

#ifdef _TAU_NN_

C                              ADDITTION DER NICHT-NEWTON''SCHEN SPANNUNGEN

      QDUE = QDUE - AUX*TAU11(K,J,I+1)
      QDUW = QDUW - AUX*TAU11(K,J,I)
      QDUN = QDUN - (
     $       AUY*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I+1))   )
      QDUS = QDUS - (
     $       AUY*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
     $     +       TAU12(K,J-1,I)+TAU12(K,J-1,I+1))   )
      QDUT = QDUT - (
     $       AUZ*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I+1))   )
      QDUB = QDUB - (
     $       AUZ*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
     $     +       TAU13(K-1,J,I)+TAU13(K-1,J,I+1))   )
 
c Vorzeichen anders fuer Feinstrukturmodell
c aus tstle3...
c      QDUE = QDUE + AUX*TAU11(K,J,I+1)
c      QDUW = QDUW + AUX*TAU11(K,J,I)
c      QDUN = QDUN
c     $     + AUY*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
c     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I+1))
c      QDUS = QDUS
c     $     + AUY*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
c     $     +       TAU12(K,J-1,I)+TAU12(K,J-1,I+1))
c      QDUT = QDUT
c     $     + AUZ*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
c     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I+1))
c      QDUB = QDUB
c     $     + AUZ*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
c     $     +       TAU13(K-1,J,I)+TAU13(K-1,J,I+1))



#endif

C                                 ZEITSCHRITT

      UO(K,J,I) = UO(K,J,I) 
     $            + FDDTU * RDDZK * (QDUE-QDUW+QDUN-QDUS+QDUT-QDUB-QDUC)

  200 CONTINUE

 2210 CONTINUE


C                                 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
C                                 --------------------------------------
C
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NLV.EQ.0).AND.(J .EQ. JSTOP))  GOTO 2220
      IF ((NRV.EQ.0).AND.(J .EQ. JSTART)) GOTO 2220
      IF ( I .EQ. ISTART ) GOTO 2220


      DO 210  K = KSTART, KSTOP
C                                  GEOMETRISCHE KONSTANTEN (K)
                RDZK   =  RDZ(K)
                RDZKM  =  RDZ(K-1)
               DDZK   = DDZ(K)
              RDDZK   =RDDZ(K)

                AVX   =  DYJ*DDZK
                AVY   = DDXI*DDZK

C                                 DIFFUSIVE D-TERME MIT
C                                 TRANSPORTKOEFFIZIENTEN

       GVE  = GI(k  ,j  ,i  )+GI(k  ,j+1,i  )
       GVW  = GI(k  ,j  ,i-1)+GI(k  ,j+1,i-1)
       GVN  = G (K  ,J+1,I  )
       GVS  = G (K  ,J  ,I  )
       GVT  = GK(k  ,j  ,i  )+GK(k  ,j+1,i  )
       GVB  = GK(k-1,j  ,i  )+GK(k-1,j+1,i  )

C      GVE  = G(K,J,I)  *G(K,J,I+1)   / (G(K,J,I)+  G(K,J,I+1)  )
C     $     + G(K,J+1,I)*G(K,J+1,I+1) / (G(K,J+1,I)+G(K,J+1,I+1))
C      GVW  = G(K,J,I)  *G(K,J,I-1)   / (G(K,J,I)  +G(K,J,I-1)  )
C     $     + G(K,J+1,I)*G(K,J+1,I-1) / (G(K,J+1,I)+G(K,J+1,I-1))
C      GVN  = G(K,J+1,I)
C      GVS  = G(K,J,I)
C      GVT  = G(K,J,I)  *G(K+1,J,I)   / (G(K,J,I)  +G(K+1,J,I)  )
C     $     + G(K,J+1,I)*G(K+1,J+1,I) / (G(K,J+1,I)+G(K+1,J+1,I))
C      GVB  = G(K,J,I)  *G(K-1,J,I)   / (G(K,J,I)  +G(K-1,J,I)  )
C     $     + G(K,J+1,I)*G(K-1,J+1,I) / (G(K,J+1,I)+G(K-1,J+1,I))


C                                     HIER KOMPAKTE BERECHNUNG
C                                     DER ERSTEN ABLEITUNG V
#ifdef _PREPROC_
      QDVE = -GVE * AVX*RDXI   * (FVI(K,J,I+1) - FVI(K,J,I))
      QDVW = -GVW * AVX*RDXIM  * (FVI(K,J,I)   - FVI(K,J,I-1))

      QDVN = -GVN * AVY*RDDYJP * (FVJ(K,J+1,I) - FVJ(K,J,I))
      QDVS = -GVS * AVY*RDDYJ  * (FVJ(K,J,I)   - FVJ(K,J-1,I))

      QDVT = -GVT * AVZ*RDZK   * (FVK(K+1,J,I) - FVK(K,J,I))
      QDVB = -GVB * AVZ*RDZKM  * (FVK(K,J,I)   - FVK(K-1,J,I))
#else
#if defined _KOMXK_ | defined _KOMXD6O_ | defined _KOMXD8O_
      QDVE = -GVE * AVX*FVI(K,J,I+1)
      QDVW = -GVW * AVX*FVI(K,J,I)
#else
      QDVE = -GVE * AVX*RDXI   * (V(K,J,I+1) - V(K,J,I))
      QDVW = -GVW * AVX*RDXIM  * (V(K,J,I)   - V(K,J,I-1))
#endif

#if defined _KOMYK_ | defined _KOMYD6O_ | defined _KOMYD8O_ | defined _ZEN4O_
      QDVN = -GVN * AVY*FVJ(K,J+1,I)
      QDVS = -GVS * AVY*FVJ(K,J,I)
#else
      QDVN = -GVN * AVY*RDDYJP * (V(K,J+1,I) - V(K,J,I))
      QDVS = -GVS * AVY*RDDYJ  * (V(K,J,I)   - V(K,J-1,I))
#endif

#if defined _KOMZK_
      QDVT = -GVT * AVZ*FVK(K+1,J,I)
      QDVB = -GVB * AVZ*FVK(K,J,I)
#else
      QDVT = -GVT * AVZ*RDZK   * (V(K+1,J,I) - V(K,J,I))
      QDVB = -GVB * AVZ*RDZKM  * (V(K,J,I)   - V(K-1,J,I))
#endif
#endif

#ifdef _DNS_
      QDVC =  WCV(K,J,I)
#else
      STV  = ((GVE*(U(K,J+1,I)  -U(K,J,I)  )          )
     $     -  (GVW*(U(K,J+1,I-1)-U(K,J,I-1))          ))*DDZK
     $     + ((GVN*(V(K,J+1,I)  -V(K,J,I)  )*RDDYJP   )
     $     -  (GVS*(V(K,J,I)    -V(K,J-1,I))*RDDYJ    ))*AVY
     $     + ((GVT*(W(K,J+1,I)  -W(K,J,I)  )          )
     $     -  (GVB*(W(K-1,J+1,I)-W(K-1,J,I))          ))*DDXI

      QDVC =  WCV(K,J,I) + STV*FLOAT(MTURB)
#endif

#ifdef _TAU_NN_
C                              ADDITTION DER NICHT-NEWTON''SCHEN SPANNUNGEN

      QDVE = QDVE - (
     $       AVX*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I+1))   )
      QDVW = QDVW - (
     $       AVX*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I-1)
     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I-1))   )

      QDVN = QDVN - AVY*TAU22(K,J+1,I)
      QDVS = QDVS - AVY*TAU22(K,J  ,I)

      QDVT = QDVT - (
     $       AVZ*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
     $     +       TAU23(K+1,J,I)+TAU23(K+1,J+1,I))   )
      QDVB = QDVB - (
     $       AVZ*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
     $     +       TAU23(K-1,J,I)+TAU23(K-1,J+1,I))   )


c Vorzeichen anders fuer Feinstrukturmodel
c      QDVE = QDVE
c     $     + AVX*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I+1)
c     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I+1))
c      QDVW = QDVW
c     $     + AVX*0.25*(TAU12(K,J  ,I)+TAU12(K,J  ,I-1)
c     $     +       TAU12(K,J+1,I)+TAU12(K,J+1,I-1))
c
c      QDVN = QDVN + AVY*TAU22(K,J+1,I)
c      QDVS = QDVS + AVY*TAU22(K,J  ,I)
c
c      QDVT = QDVT
c     $     + AVZ*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
c     $     +       TAU23(K+1,J,I)+TAU23(K+1,J+1,I))
c      QDVB = QDVB
c     $     + AVZ*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
c     $     +       TAU23(K-1,J,I)+TAU23(K-1,J+1,I))



#endif

C                                  ZEITSCHRITT

      VO(K,J,I) = VO(K,J,I) 
     $            + FDDTV * RDDZK * (QDVE-QDVW+QDVN-QDVS+QDVT-QDVB-QDVC)

  210 CONTINUE

 2220 CONTINUE

C                                 WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW
C                                 --------------------------------------

      IF ( I .EQ. ISTART ) GOTO 2230
      IF ( J .EQ. JSTART ) GOTO 2230

      KSTOPM = KSTOP - 1 + NTW
      KSTARTM= KSTART - NBW

      DO 220  K = KSTARTM, KSTOPM
C                                  GEOMETRISCHE KONSTANTEN (K)
                DZK   =   DZ(K)
               RDZK   =  RDZ(K)
              RDDZK   = RDDZ(K)
              RDDZKP  = RDDZ(K+1)

                AWX   = DDYJ*DZK
                AWY   = DDXI*DZK

C                                 DIFFUSIVE D-TERME MIT
C                                 TRANSPORTKOEFFIZIENTEN


       GWE  = GI(k,j  ,i  )+GI(k+1,j  ,i  )
       GWW  = GI(k,j  ,i-1)+GI(k+1,j  ,i-1)
       GWN  = GJ(k,j  ,i  )+GJ(k+1,j  ,i  )
       GWS  = GJ(k,j-1,i  )+GJ(k+1,j-1,i  )
       GWT  = G(K+1,J,I)
       GWB  = G(K,J,I)

C      GWE  = G(K,J,I)  *G(K,J,I+1)   / (G(K,J,I)  +G(K,J,I+1)  )
C     $     + G(K+1,J,I)*G(K+1,J,I+1) / (G(K+1,J,I)+G(K+1,J,I+1))
C      GWW  = G(K,J,I)  *G(K,J,I-1)   / (G(K,J,I)  +G(K,J,I-1)  )
C     $     + G(K+1,J,I)*G(K+1,J,I-1) / (G(K+1,J,I)+G(K+1,J,I-1))
C      GWN  = G(K,J,I)  *G(K,J+1,I)   / (G(K,J,I)  +G(K,J+1,I)  )
C     $     + G(K+1,J,I)*G(K+1,J+1,I) / (G(K+1,J,I)+G(K+1,J+1,I))
C      GWS  = G(K,J,I)  *G(K,J-1,I)   / (G(K,J,I)  +G(K,J-1,I)  )
C     $     + G(K+1,J,I)*G(K+1,J-1,I) / (G(K+1,J,I)+G(K+1,J-1,I))
C      GWT  = G(K+1,J,I)
C      GWB  = G(K,J,I)


C                                     HIER KOMPAKTE BERECHNUNG
C                                     DER ERSTEN ABLEITUNG W
#ifdef _PREPROC_
      QDWE = -GWE * AWX*RDXI   * (FWI(K,J,I+1) - FWI(K,J,I))
      QDWW = -GWW * AWX*RDXIM  * (FWI(K,J,I)   - FWI(K,J,I-1))

      QDWN = -GWN * AWY*RDYJ   * (FWJ(K,J+1,I) - FWJ(K,J,I))
      QDWS = -GWS * AWY*RDYJM  * (FWJ(K,J,I)   - FWJ(K,J-1,I))

      QDWT = -GWT * AWZ*RDDZKP * (FWK(K+1,J,I) - FWK(K,J,I))
      QDWB = -GWB * AWZ*RDDZK  * (FWK(K,J,I)   - FWK(K-1,J,I))
#else
#if defined _KOMXK_ | defined _KOMXD6O_ | defined _KOMXD8O_
      QDWE = -GWE * AWX*FWI(K,J,I+1)
      QDWW = -GWW * AWX*FWI(K,J,I)
#else
      QDWE = -GWE * AWX*RDXI   * (W(K,J,I+1) - W(K,J,I))
      QDWW = -GWW * AWX*RDXIM  * (W(K,J,I)   - W(K,J,I-1))
#endif

#if defined _KOMYK_ | defined _KOMYD6O_ | defined _KOMYD8O_ | defined _ZEN4O_
      QDWN = -GWN * AWY*FWJ(K,J+1,I)
      QDWS = -GWS * AWY*FWJ(K,J,I)
#else
      QDWN = -GWN * AWY*RDYJ   * (W(K,J+1,I) - W(K,J,I))
      QDWS = -GWS * AWY*RDYJM  * (W(K,J,I)   - W(K,J-1,I))
#endif

#if defined _KOMZK_
      QDWT = -GWT * AWZ*FWK(K+1,J,I)
      QDWB = -GWB * AWZ*FWK(K,J,I)
#else
      QDWT = -GWT * AWZ*RDDZKP * (W(K+1,J,I) - W(K,J,I))
      QDWB = -GWB * AWZ*RDDZK  * (W(K,J,I)   - W(K-1,J,I))
#endif
#endif
#ifdef _DNS_
      QDWC = WCW(K,J,I)
#else
      STW  = ((GWE*(U(K+1,J,I)  -U(K,J,I)  )          )
     $     - ( GWW*(U(K+1,J,I-1)-U(K,J,I-1))          ))*DDYJ
     $     + ((GWN*(V(K+1,J,I)  -V(K,J,I)  )          )
     $     -  (GWS*(V(K+1,J-1,I)-V(K,J-1,I))          ))*DDXI
     $     + ((GWT*(W(K+1,J,I)  -W(K,J,I)  )*RDDZKP   )
     $     -  (GWB*(W(K,J,I)    -W(K-1,J,I))*RDDZK    ))*AWZ

      QDWC = WCW(K,J,I) + STW*FLOAT(MTURB)
#endif

#ifdef _TAU_NN_
C                              ADDITTION DER NICHT-NEWTON''SCHEN SPANNUNGEN

      QDWE = QDWE - (
     $       AWX*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I+1))   )
      QDWW = QDWW - (
     $       AWX*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I-1)
     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I-1))   )

      QDWN = QDWN - (
     $       AWY*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
     $     +       TAU23(K+1,J,I)+TAU23(K+1,J+1,I))   )
      QDWS = QDWS - (
     $       AWY*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J-1,I)
     $     +       TAU23(K+1,J,I)+TAU23(K+1,J-1,I))   )

c Vorzeichen anders fuer Feinstrukturmodel
c     QDWE = QDWE
c     $     + AWX*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I+1)
c     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I+1))
c      QDWW = QDWW
c     $     + AWX*0.25*(TAU13(K  ,J,I)+TAU13(K  ,J,I-1)
c     $     +       TAU13(K+1,J,I)+TAU13(K+1,J,I-1))
c
c      QDWN = QDWN
c     $     + AWY*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J+1,I)
c     $     +       TAU23(K+1,J,I)+TAU23(K+1,J+1,I))
c      QDWS = QDWS
c     $     + AWY*0.25*(TAU23(K  ,J,I)+TAU23(K  ,J-1,I)
c     $     +       TAU23(K+1,J,I)+TAU23(K+1,J-1,I))


      QDWT = QDWT - AWZ*TAU33(K+1,J,I)
      QDWB = QDWB - AWZ*TAU33(K  ,J,I)


#endif


C                                 ZEITSCHRITT
      WO(K,J,I) = WO(K,J,I) 
     $            + FDDTW * RDZK  * (QDWE-QDWW+QDWN-QDWS+QDWT-QDWB-QDWC)

  220 CONTINUE

 2230 CONTINUE

 2300 IF(IDUZ .EQ. 1) GOTO 2400

C                                 **************************************
C                                 QUELL-TERME   QUELL-TERME   QUELL-TERM
C                                 **************************************
C
C                                 UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
C     
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NBU.EQ.0).AND.(I .EQ. ISTOP))  GOTO 2310
      IF ((NFU.EQ.0).AND.(I .EQ. ISTART)) GOTO 2310
      IF ( J .EQ. JSTART ) GOTO 2310


C                                 ACHTUNG: IN X-RICHTUNG KANN EIN
C                                 MITTLERER DRUCKGRADIENT VORGEGEBEN
C                                 WERDEN
C
C                                 ZEITSCHRITT
C

#ifdef _RUNGEKUTTA3_

      DO K = KSTART, KSTOP
         UO(K,J,I) = UO(K,J,I) - 1.0/(RHO*DXI) * WSOR
#ifndef _UPWARDS_
#if defined _PREPROC_PRE4_
     $ *(27.0/24.0*(P(K,J,I+1)-P(K,J,I))
     $ -1.0/24.0*(P(K,J,I+2)-P(K,J,I-1))+GRADPX*DXI) 
#else
     $        * (P(K,J,I+1)-P(K,J,I) + GRADPX*DXI)
#endif
#else
     $        * (P(K,J,I+1)-P(K,J,I))
#endif
      ENDDO

#endif


#ifdef _LEAPF_

      DO K = KSTART, KSTOP
         UO(K,J,I) = UO(K,J,I) - DT/(RHO*DXI) * WSOR
     $        * (P(K,J,I+1)-P(K,J,I) + GRADPX*DXI)
      ENDDO

#endif



 2310 CONTINUE

C                                 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
C                                 --------------------------------------
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NLV.EQ.0).AND.(J .EQ. JSTOP))  GOTO 2320
      IF ((NRV.EQ.0).AND.(J .EQ. JSTART)) GOTO 2320
      IF (I .EQ. ISTART) GOTO 2320


C                                  ZEITSCHRITT

#ifdef _RUNGEKUTTA3_

      DO K = KSTART, KSTOP
         VO(K,J,I) = VO(K,J,I) - 1.0/(RHO*DYJ) * WSOR
     $        * (P(K,J+1,I)-P(K,J,I))
      ENDDO

#endif

#ifdef _LEAPF_

      DO K = KSTART, KSTOP
         VO(K,J,I) = VO(K,J,I) - DT/(RHO*DYJ) * WSOR
     $        * (P(K,J+1,I)-P(K,J,I))
      ENDDO

#endif

 2320 CONTINUE

C                                 WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW
C                                 --------------------------------------

      IF (I .EQ. ISTART) GOTO 2400
      IF (J .EQ. JSTART) GOTO 2400

      KSTOPM = KSTOP - 1 + NTW
      KSTARTM= KSTART - NBW

C                                 ZEITSCHRITT

#ifdef _RUNGEKUTTA3_
#ifdef _PREPROC_PRE4_
      DO K = KSTARTM+1, KSTOPM-1
#else
      DO K = KSTARTM,KSTOPM
#endif
         WO(K,J,I) = WO(K,J,I) - 1.0/(RHO*DZ(K)) * WSOR
#if defined  _UPWARDS_ 
     $             * (P(K+1,J,I)-P(K,J,I) + GRADPX*DZ(K))
#else
#if defined _PREPROC_PRE4_
     $ *(27.0/24.0*(P(K+1,J,I)-P(K,J,I))
     $ -1.0/24.0*(P(K+2,J,I)-P(K-1,J,I)))
#else
     $             * (P(K+1,J,I)-P(K,J,I))
#endif
#endif
      ENDDO

#endif
#if defined _PREPROC_PRE4_
      K = KSTARTM
              WO(K,J,I) = WO(K,J,I) - 1.0/(RHO*DZ(K)) * WSOR
     $ *( ( 13.0*P(K+1,J,I)-0.5*( P(K+2,J,I)+P(K,J,I) ) )/12.0
     $       -(  ( P(K,J,I) )  ) )
C
C
      K = KSTOPM
              WO(K,J,I) = WO(K,J,I) - 1.0/(RHO*DZ(K)) * WSOR
     $ *( ( ( P(K+1,J,I) ))
     $     -( 13.0*P(K,J,I)-0.5*( P(K+1,J,I)+P(K-1,J,I) ) )/12.0)



#endif

#ifdef _LEAPF_

      DO K = KSTARTM, KSTOPM
         WO(K,J,I) = WO(K,J,I) - DT/(RHO*DZ(K)) * WSOR
     $             * (P(K+1,J,I)-P(K,J,I))
      ENDDO

#endif


 2400 CONTINUE
 

#ifdef _LEAPF_

      IF(ABS(WPHI) .LE. SMALL) GOTO 2500

C                                 **************************************
C                                 ANTEIL DER PUNKTWERTE   ANTEIL DER PUN
C                                 **************************************
C
C                                 UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
C                                 --------------------------------------
C
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NBU.EQ.0).AND.(I .EQ. ISTOP))  GOTO 2410
      IF ((NFU.EQ.0).AND.(I .EQ. ISTART)) GOTO 2410
      IF ( J .EQ. JSTART ) GOTO 2410


C                                 ZEITSCHRITT
      DO K = KSTART, KSTOP
         UO(K,J,I) = UO(K,J,I) + WPHI * U(K,J,I) 
      END DO

 2410 CONTINUE

C                                 VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV
C                                 --------------------------------------
C                                 NUR BEI PERIODISCHEN RANDBEDINGUNGEN
C                                 WIRD DIE NORMALKOMPONENTE DER LETZTEN
C                                 ZELLE BERECHNET, ANSONSTEN WIRD SIE IN
C                                 BOUNDMG GESETZT

      IF ((NLV.EQ.0).AND.(J .EQ. JSTOP))  GOTO 2420
      IF ((NRV.EQ.0).AND.(J .EQ. JSTART)) GOTO 2420
      IF (I .EQ. ISTART) GOTO 2420


C                                 ZEITSCHRITT
      DO K = KSTART, KSTOP
         VO(K,J,I) = VO(K,J,I) + WPHI * V(K,J,I)
      END DO

 2420 CONTINUE

C                                 WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW
C                                 --------------------------------------

      IF (I .EQ. ISTART) GOTO 2500
      IF (J .EQ. JSTART) GOTO 2500
      KSTOPM = KSTOP - 1 + NTW
      KSTARTM= KSTART - NBW


C                                 ZEITSCHRITT
      DO K = KSTARTM, KSTOPM
         WO(K,J,I) = WO(K,J,I) + WPHI * W(K,J,I)
      END DO

 2500 CONTINUE

#endif 

   22 CONTINUE
   11 CONTINUE

      RETURN
      END
