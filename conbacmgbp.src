      SUBROUTINE CONBACMGBP
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $     BP,
     $              NGRIDS,LOFGRIDS)

C*MGLET***************************************************************
C    C O N B A C M G BP   SETZEN DER RANDBEDINGUNGEN FUER DAS
C                         BP-FELD.
C                         (LARGE-EDDY-SIMULATION)
C*MGLET***************************************************************
C 
C  KREUZINGER UND MANHART TURBULENZ GmbH
C  JK      11. 8.2005
C  aus CONBACMG
C 
C PARAM: KK, JJ, II     - ARRAYDIMENSIONEN
C        KMX, JMX, IMX  - GRENZEN DES BERECHNUNGSGEBIETES (MIT BOUND)
C        X, Y, Z        - KOORDINATEN DER ZELLDEFINITIONSPUNKTE
C        DX,DY,DZ       - ABSTAND DER GITTERPUNKTE
C        DDX,DDY,DDZ    - KANTENLAENGEN DER KONTROLLVOLUMINA
C        BP             - BP-FELD
C
C
C*MGLET***************************************************************
C
#include "mgpar.h"
#include "comgrid.h"
#include "cobound.h"
#include "colevel.h"
#ifdef _MPI_
#include "compi.h"
#include "mpif.h"
C       DOUBLE PRECISION MPI_WTIME,TIME1, TIME2
#endif
C
      REAL        X(IDIM1D),         Y(IDIM1D),         Z(IDIM1D),
     $           DX(IDIM1D),        DY(IDIM1D),        DZ(IDIM1D),
     $          DDX(IDIM1D),       DDY(IDIM1D),       DDZ(IDIM1D),
     $          BP( IDIM3D )
C
      INTEGER NGRIDS,LOFGRIDS(NGRIDS)
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
CTEST
        DO IST=1,2
        DO I=IST,NGRIDS,2
CTEST      DO I = 1,NG

           IGRID = LOFGRIDS(I)

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72

       CALL MGDIMS  (KK,JJ,II,IGRID)
       CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
      DO IBOCOND = 1,NBOCONDS( 2 , IGRID )

         JSTART = LARBOCONDS( 3 , IBOCOND , 2 , IGRID )
         JSTOP  = LARBOCONDS( 4 , IBOCOND , 2 , IGRID )
         KSTART = LARBOCONDS( 5 , IBOCOND , 2 , IGRID )
         KSTOP  = LARBOCONDS( 6 , IBOCOND , 2 , IGRID )


         ITYPBC = ITYPBOCONDS( IBOCOND , 2 , IGRID )

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72 


         IF ( ITYPBC .EQ. 7 ) THEN

              INBR = LBOGRIDS      (IBOCOND,  2 ,IGRID)
              IPOS = LPOSBOGRIDS( 1,IBOCOND,  2 ,IGRID)
              JPOS = LPOSBOGRIDS( 2,IBOCOND,  2 ,IGRID)
              KPOS = LPOSBOGRIDS( 3,IBOCOND,  2 ,IGRID)
           write(*,*) 'CONBACMGBP:I,IGRID,INBR',I,IGRID,INBR
#ifdef _MPI_
C
C                            NUR BETEILIGTE PROZESSOREN RUFEN BBACON AUF
C
              IPROCNBR = IDPROCOFGRD(INBR)
              IPROC   = IDPROCOFGRD(IGRID)
              IF ((MYID .EQ. IPROC) .OR. (MYID .EQ. IPROCNBR)) THEN
#endif

              CALL MGDPB (KKN,JJN,IIN,IP3N,IP2N,IP1N,IBBN,IBUN,
     $              NFRON,NBACN,NRGTN,NLFTN,NBOTN,NTOPN,NCUBN,INBR)

              CALL BBACONBP (KK,JJ,II,
     $                     BP(IP3),
     $                     KKN,JJN,IIN,
     $                     BP(IP3N),
     $                     JSTART,JSTOP,KSTART,KSTOP,
     $                     IPOS,JPOS,KPOS,
     $                     IPROC,IPROCNBR)


#ifdef _MPI_
              ENDIF
#endif
         ELSEIF ( ITYPBC .EQ. 8 ) THEN

C
C                             IS DONE IN PARBOTMG NOW!!!!!!!!!!!!
C

         ENDIF



        ENDDO

      ENDDO
      ENDDO

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72

      RETURN
      END

