      SUBROUTINE BBOTMG  
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VRI,HILF,
     $              ITYP,IGRID,IRB,JRB,KRB,
     $              TIMEPH,UBO,VBO,WBO
#ifdef _TSCAL_
     $              ,T,TBO
#endif
     $             )      

C*STARLET***************************************************************
C        B B O T M G      SETZEN DER RANDBEDINGUNGEN FUER DIE
C                         GESCHWINDIGKEITSFELDER  AND SCALAR T.
C                         (LARGE-EDDY-SIMULATION)
C*STARLET***************************************************************
C
C PARAM: KK, JJ, II     - ARRAYDIMENSIONEN
C        KMX, JMX, IMX  - GRENZEN DES BERECHNUNGSGEBIETES (MIT BOUND)
C        X, Y, Z        - KOORDINATEN DER ZELLDEFINITIONSPUNKTE
C        DX,DY,DZ       - ABSTAND DER GITTERPUNKTE
C        DDX,DDY,DDZ    - KANTENLAENGEN DER KONTROLLVOLUMINA
C        U(KK,JJ,II)    + GESCHWINDIGKEITSFELD
C        V(KK,JJ,II)    + GESCHWINDIGKEITSFELD
C        W(KK,JJ,II)    + GESCHWINDIGKEITSFELD
C        T(KK,JJ,II)    + SCALAR T FIELD
C        P(KK,JJ,II)    - DRUCKFELD
C        G(KK,JJ,II)    - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        TK(KK,JJ,II)   - TURBULENZENERGIE
C        UFR(KK,JJ, 2)  - ENTHAELT DIE I=1 U. I=2 EBENEN DES U-PROFILS
C        VRI(KK, 2,II)  -    "      "  J=1 U. J=2    "    "  V-PROFILS
C        WBO( 2,JJ,II)  -    "      "  K=1 U. K=2    "    "  W-PROFILS
C        GMOL           - MOLEKULARE DYNAMISCHE VISKOSITAET
C        RHO            - DICHTE (= CONST)
C        UGRID          - GESCHWINDIGKEIT DES KOORDINATENSYSTEMS IN
C                         X-RICHTUNG (GALILEI-TRANSFORMATION)
C        XTOT           - LAENGE DES BERECHNUNGSGEBIETES IN X-RICHTUNG
C        YTOT           -    "    "           ""          IN Y-RICHTUNG
C        ZTOT           -    "    "                     IN Z-RICHTUNG
C        MTURB          - SCHALTER: 0 = LAMINAR; 1 = TURBULENT
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:  18.03.86 (HW)  : ORIGINAL
C VERS:   5. 3.92 (MM)  : BEINHALTET BFROL UND BFOLI, 
C                         VOELLIG NEUE VERSION
C                         SCHLEIFEN LAUFEN GRUNDSAETZLICH UEBER GANZES
C                         BERECHNUNGSGEBIET
C VERS:  28.09.95 (AO)  : BOUNDARY CONDITION FOR BLOWING/SUCTION INTRODUCED
C        28.02.03 (TB)  : SCALAR BOUNDARY TREATMENT IMPLEMENTED
C
C DEFINE-DIREKTIVEN     : QUD, BAPER, FRFIX, FRPER
C
C*STARLET***************************************************************
C
#include "mgpar.h"
#include "comgrid.h"
#include "cobound.h"
C
      CHARACTER (LEN=1)  ITYP
      CHARACTER (LEN=16) FLOWT
C
      REAL        X(IDIM1D),         Y(IDIM1D),         Z(IDIM1D),
     $           DX(IDIM1D),        DY(IDIM1D),        DZ(IDIM1D),
     $          DDX(IDIM1D),       DDY(IDIM1D),       DDZ(IDIM1D),
     $          U( IDIM3D ),       V( IDIM3D ),       W( IDIM3D ),
     $          P( IDIM3D ),       G( IDIM3D ),       B( IDIM3D ),
     $        UFR(IDIM2D,2),     VRI(IDIM2D,2),     
     $        UBO(IDIM2D*2),     VBO(IDIM2D*2),      WBO(IDIM2D*2),
     $       HILF( IDIM3D )
C
#ifdef _TSCAL_
      REAL     T( IDIM3D ), TBO(IDIM2D*2)
#endif
C
       REAL WAVENUM
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72

       CALL MGDIMS  (KK,JJ,II,IGRID)
       CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
      DO IBOCOND = 1,NBOCONDS( 5 , IGRID )

         ISTART = LARBOCONDS( 1 , IBOCOND , 5 , IGRID )
         ISTOP  = LARBOCONDS( 2 , IBOCOND , 5 , IGRID )
         JSTART = LARBOCONDS( 3 , IBOCOND , 5 , IGRID )
         JSTOP  = LARBOCONDS( 4 , IBOCOND , 5 , IGRID )
         KSTART = LARBOCONDS( 5 , IBOCOND , 5 , IGRID )
         KSTOP  = LARBOCONDS( 6 , IBOCOND , 5 , IGRID )

         IF (IRB.EQ.1) THEN
            ISTOP = MIN(ISTOP,II/2)
         ELSEIF (IRB.EQ.2) THEN
            ISTART = MAX(ISTART,II/2+1)
         ENDIF
         
         IF (JRB.EQ.1) THEN
            JSTOP = MIN(JSTOP,JJ/2)
         ELSEIF (JRB.EQ.2) THEN
            JSTART = MAX(JSTART,JJ/2+1)
         ENDIF
         

         ITYPBC = ITYPBOCONDS( IBOCOND , 5 , IGRID )

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72 


         IF (     ITYPBC .EQ. 2 .OR. ITYPBC .EQ. 11   
     $       .OR. ITYPBC .EQ. 12                     ) THEN

              CALL BBOFIX (KK,JJ,II,
     $                      U(IP3),V(IP3),W(IP3),P(IP3),G(IP3),
     $                      UBO(IBB),VBO(IBB),WBO(IBB),
     $                      ISTART,ISTOP,JSTART,JSTOP,ITYP
#ifdef _TSCAL_
     $                      ,T(IP3),TBO(IBB)
#endif
     $                    )       

         ELSEIF ( ITYPBC .EQ. 3 ) THEN

              CALL BBOOP1 (KK,JJ,II,
     $                      U(IP3),V(IP3),W(IP3),P(IP3),G(IP3),
     $                      ISTART,ISTOP,JSTART,JSTOP,ITYP
#ifdef _TSCAL_
     $                      ,T(IP3)
#endif
     $                    )       


         ELSEIF ( ITYPBC .EQ. 5 ) THEN

              CALL BBONOS (KK,JJ,II,
     $                      U(IP3),V(IP3),W(IP3),P(IP3),G(IP3),
     $                      ISTART,ISTOP,JSTART,JSTOP,ITYP)

         ELSEIF ( ITYPBC .EQ. 6 ) THEN

              CALL BBOSLI (KK,JJ,II,
     $                      U(IP3),V(IP3),W(IP3),P(IP3),G(IP3),
     $                      ISTART,ISTOP,JSTART,JSTOP,ITYP
#ifdef _TSCAL_
     $                      ,T(IP3)
#endif
     $                    )     

         ELSEIF ( ITYPBC .EQ. 8 ) THEN
C
C                                     BBOPAR IS CALLED BY CONBOTMG
C
         ELSEIF ( ITYPBC .EQ. 9 ) THEN


                   FREQ =   FREQB(IBOCOND,5,IGRID)
                     AU =   AUB(IBOCOND,5,IGRID)
                     AV =   AVB(IBOCOND,5,IGRID)
                     AW =   AWB(IBOCOND,5,IGRID)
                   ANIV =   ANIVEAU(IBOCOND,5,IGRID)
		  FLOWT =   FLOWTYP(IBOCOND,5,IGRID)
                WAVENUM =   WAVENUMBER(IBOCOND,5,IGRID)
                   PHAS =   PHASE(IBOCOND,5,IGRID)
#ifdef _TSCAL_
                TSCABLO =   TSCA(IBOCOND,5,IGRID)
#endif
C----------- OPTIMIERUNG ------------------------------------------
      IF(LOPT(IBOCOND,IGRID).EQ.1) THEN
C        WRITE(6,*) 'OPTF: BBOTMG: FREQUENZ NUN=',FREQOPT
         FREQ = FREQOPT
         IF(NTOPT1(IBOCOND,IGRID).EQ.ITALT) THEN
C                    WRITE(6,*) 'OPTF: BBOTMG: RANDOM!!!'
                     FLOWT='RANDOM'
                     AU =   2.0*AUB(IBOCOND,5,IGRID)
                     AV =   2.0*AVB(IBOCOND,5,IGRID)
                     AW =   2.0*AWB(IBOCOND,5,IGRID)
         ENDIF
      ENDIF
C----------- OPTIMIERUNG ------------------------------------------

C             WRITE(6,*)'BBOTMG:',TIMEPH,AU,AW,FREQ,FLOWT
              CALL BBOBLO (KK,JJ,II,
     $                      U(IP3),V(IP3),W(IP3),P(IP3),G(IP3),
     $                      ISTART,ISTOP,JSTART,JSTOP,KSTART,KSTOP,
     $                     FREQ,AU,AV,AW,ANIV,TIMEPH,
     $                     X(IP1),Y(IP1),Z(IP1),FLOWT,
     $                     UBO(IBB),VBO(IBB),WBO(IBB),
     $                     WAVENUM,RANNUM,PHAS
#ifdef _TSCAL_
     $                      ,T(IP3),TSCABLO
#endif
     $                     )     
     
#ifdef _TSCAL_
CTBC  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
CTBC  IBOCOND(BBOBLO) > IBOCOND(BBOSCA), BBOBLO MUST BE SET LAST!!!
CTBC  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
         ELSEIF ( ITYPBC .EQ. 15 ) THEN

C           FIXED GRADIENT/FLUX CONDITION DIRECTLY IMPLEMENTED IN        	
C           SCALAR TRANSPORT WALL CORRECTION (SWCLESCA)         	

         ELSEIF ( ITYPBC .EQ. 16 ) THEN  

            TSCABO = TSCA(IBOCOND,5,IGRID)         	 
            CALL BBOSCA (KK,JJ,II,T(IP3),TSCABO,
     $                   ISTART,ISTOP,JSTART,JSTOP,ITYP)            	      	

#endif     

         ELSE

            CALL ERRR (711,' BBOTMG ')

         ENDIF


      ENDDO

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72


      RETURN
      END

