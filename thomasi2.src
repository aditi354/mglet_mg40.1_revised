      SUBROUTINE THOMASI2(KK,JJ,II,KL,KU,JL,JU,IL,IU,LCOL,DIAG,
     &                   RCOL,RSGS,FAKTOR,FOUTP2,BP,GI,GJ,GK)
C*MGLET***************************************************************
C        T H O M A S I   DAS UNTERPROGRAMM THOMAS LOEST EIN TRIDIAGONA-
C                        LES LINEARES GLEICHUNGSSYSTEM NACH DEM
C                        THOMAS - ALGORITHMUS
C*MGLET***************************************************************
C  PARAM:  IMX         - MAXIMALE ANZAHL DER GITTERPUNKTE EINSCHLIESS-
C                        LICH DER RANDSCHICHTEN
C          LCOL        - ENTHAELT KOEFFIZIENTEN DER "LINKEN SPALTE"
C                        PARALLEL ZUR HAUPTDIAGONALEN
C          DIAG        - ENTHAELT KOEFFIZIENTEN DER HAUPTDIAGONALEN
C          RCOL        - ENTHAELT KOEFFIZIENTEN DER "RECHTEN SPALTE"
C                        PARALLEL ZUR HAUPTDIAGONALEN
C          RSGS        - ENTHAELT  WERTE DES KONSTANTEN VEKTORS
C                        AUF DER RECHTEN SEITE DES GL.SYSTEMS
C          FOUTP       - ENTHAELT  DIE LOESUNG DES GL.SYSTEMS   
C
C  DEFINE DIREKTIVEN   : KEINE
C
C  UPROG               : KEINE
C
C     15.10.96 (AM)    : ORIGINAL
C     22.10.03 (NP)    : FRED BODY DEFINE DIREKTIVE 
C
C*MGLET***************************************************************
C
      IMPLICIT NONE
      INTEGER KK,JJ,II,K,J,I,KL,KU,JL,JU,IL,IU,LP,N

      REAL     LCOL(II), DIAG(II), RCOL(II),RSGS(KK,JJ,II), 
#ifdef _FRED_BODY_
     $         FAKTOR(KK,JJ,II),
#else
     $         FAKTOR(II),
#endif
     $         FOUTP2(KK,JJ,II),BP(KK,JJ,II),
     $         GI(KK,JJ,II),GJ(KK,JJ,II),GK(KK,JJ,II)

c bis hier ok...
c#ifdef test
C
C                                 BILDUNG DER OBEREN DREIECKSMATRIX
C

 
      LP = IL+1

#ifndef _FRED_BODY_

      DO 100  I = LP,IU
         FAKTOR(I) = LCOL(I) / DIAG(I-1)
         DIAG(I) = DIAG(I) - (FAKTOR(I) * RCOL(I-1))
  100 CONTINUE

#else



C Definition      
C      GI(K,J,I) = LCOL(I) = COEFFX(I,1)
C      GJ(K,J,I) = DIAG(I) = COEFFX(I,2)
C      GK(K,J,I) = RCOL(I) = COEFFX(I,3)

      DO I = LP,IU
         DO J = JL,JU 
            DO K = KL,KU
               FAKTOR(K,J,I) = GI(K,J,I) / GJ(K,J,I-1) 
               GJ(K,J,I)     = GJ(K,J,I) - (FAKTOR(K,J,I) * GK(K,J,I-1))
            END DO
         END DO
      END DO

#endif

c bis hier ok...
c#ifdef test
      DO I = LP,IU

      DO 300  J = JL,JU
      DO 200  K = KL,KU
         FOUTP2(K,J,IL) = RSGS(K,J,IL)
c in dieser Richtung ok...
c          RSGS(K,J,IL) = FOUTP(K,J,IL)
c         RSGS = 0.0 ???? Warum ???
c         write(60,*) 'th2',RSGS(K,J,IL)
  200 CONTINUE
  300 CONTINUE
 
      END DO
c hier nich mehr ok... Randwerte überschrieben
c Feld FUI wird scheinbar analog zu FOUTP geschrieben
c gleicher Speicherbereich???

c      stop

c#ifdef test

       DO 10  I = IL+1,IU
       DO 40  J = JL,JU
       DO 50  K = KL,KU


#ifndef _FRED_BODY_
         FOUTP(K,J,I) = RSGS(K,J,I) - FAKTOR(I) * FOUTP(K,J,I-1)
#else
         FOUTP2(K,J,I) = RSGS(K,J,I) - FAKTOR(K,J,I) * FOUTP2(K,J,I-1) 
#endif

   50 CONTINUE
   40 CONTINUE
   10 CONTINUE

c hier nicht mehr ok...
c#ifdef test

C
C                                 RUECKSUBSTITUTION
C

      DO 500  J = JL,JU
      DO 400  K = KL,KU

#ifndef _FRED_BODY_
         FOUTP(K,J,IU) = FOUTP(K,J,IU)/DIAG(IU)
#else
         FOUTP2(K,J,IU) = FOUTP2(K,J,IU)/GJ(K,J,IU)
#endif

  400 CONTINUE
  500 CONTINUE


      DO 70  N = LP,IU
      I = IU-N+IL
C
      DO 80  J = JL,JU
      DO 90  K = KL,KU

#ifndef _FRED_BODY_
      FOUTP(K,J,I) = (FOUTP(K,J,I) - RCOL(I) * FOUTP(K,J,I+1))/DIAG(I)
#else
      FOUTP2(K,J,I) = (FOUTP2(K,J,I) - GK(K,J,I) *
     $                FOUTP2(K,J,I+1)) / GJ(K,J,I)   
#endif

   90 CONTINUE
   80 CONTINUE
   70 CONTINUE

      write(*,*) KK,JJ,II,K,J,I,KL,KU,JL,JU,IL,IU,LP,N

CC    WRITE (44,*) 'THOMAS ERFOLGREICH DURCHLAUFEN!!'

c#endif

      RETURN
      END
