C#ifdef _TSCAL_
         SUBROUTINE INITSCA
     $             (CIDENT,IIDENT,RIDENT,
     $              DDX,DDY,DDZ,DX,DY,DZ,X,Y,Z,
     $              T,
     $              ITSTEP,ITTOT,TIMEPH,
     $              IDIMF,NGRP1, NGRP3, IGRHF, GRX0, GRX1, HILF,
     $              IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,IDIMA,IDIM1L,IDIM2L,
     $              IGRID,CONV1S)
C--MGLET----------------------------------------------------------------
C
C                   SCALAR FIELD INITIALISATION
C
C
C        10.02.03 (TB)  : NEW VERSION BASED ON INIGRID
C
C--MGLET----------------------------------------------------------------


#include "mgpar.h"
#include "comgrid.h"
#include "colevel.h"
#include "cogrdpro.h"
#include "cobound.h"
#include "costrles.h"
#include "cophyspar.h"
#include "cobody.h"
#include "cogrdcon.h"
#ifdef _MPI_
C
C               MPI-INCLUDE
C
#include "compi.h"
#include "mpif.h"
#endif

C
      CHARACTER (LEN=8)    CIDENT(10)
C
      INTEGER IIDENT(100),
     $        IGRHF(IDIMF,NGRP1)
C
C
C
C
      REAL    RIDENT(100),
     $            X(IDIM1D),     Y(IDIM1D),     Z(IDIM1D),
     $           DX(IDIM1D),    DY(IDIM1D),    DZ(IDIM1D),
     $          DDX(IDIM1D),   DDY(IDIM1D),   DDZ(IDIM1D),
     $          T( IDIM3D )
C
C          SUBGRIDSCALE CONSTANT CONV1S DEPENDENT OF X
      REAL    CONV1S(IDIM1D)    
#ifdef _MPI_
C
C                 MPI-VARIABLEN
C
      INTEGER ISTATUS(MPI_STATUS_SIZE)
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                 MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C                 
C     CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
C     CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
C
#endif
C
C
C                                  EINSTROEMBUFFER EXISTIEREN NUR
C                                  EINMAL
C
C         IPI =   1 


CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
      DO ISUB = 1,MAX(1,NOFSLCHILDS(IGRID))

        IF (LSLICE(IGRID)) THEN
         I = IGRDOFSLCHILD(ISUB,IGRID)
        ELSE
         I = IGRID
        ENDIF

#ifdef _MPI_
             IPROC  = IDPROCOFGRD(I)
             IPPAR  = IDPROCOFGRD(IPARENT(I))
#else
             MYID   = 0
             IPROC  = 0
             IPPAR  = 0
#endif

C                                 BEREITSTELLUNG DER DIMENSIONIERUNG
C                                 BASIS-RANDBEDINGUNGEN
C
             WRITE(6,*)'I In INITSCA:',I


       CALL MGDIMS  (KK,JJ,II,I)
       CALL MGBASB  (NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
C
C                                          POINTER
#ifdef _MPI_
       IF(MYID .EQ. IPROC) CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,I)
#else
       CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,I)       
#endif
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C                               INITIALISATION OF T
C
       write(6,*)'lchild: ',LCHILD(I)
C       IF (LCHILD(I)) THEN
C
C
C#ifdef _MPI_
C         IF ( (MYID .EQ. IPROC) .OR. (MYID .EQ. IPPAR)) THEN
C#endif
CC                               VARIABLE WERDEN AUS PARENT-GITTER
CC                               INTERPOLIERT ("PROLONGIERT")
CC                                          POINTER
CC
C
C       CALL MGDIMS  (KKC,JJC,IIC,IPARENT(I))
C       CALL MGBASB  (NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,
C     $               IPARENT(I))
C       IF(MYID .EQ. IPPAR) CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,
C     $               IBUC,IPARENT(I))
C
C              CALL MGCTOF (KK,JJ,II,DX(IP1),DY(IP1),DZ(IP1),
C     &                     DDX(IP1),DDY(IP1),DDZ(IP1),T(IP3),
C     &                     KKC,JJC,IIC,DX(IP1C),DY(IP1C),DZ(IP1C),
C     &                     DDX(IP1C),DDY(IP1C),DDZ(IP1C),T(IP3C),
C     &               IPOSITION(I),JPOSITION(I),KPOSITION(I),
C     &                     'T',IPROC,IPPAR)
C
C#ifdef _MPI_
C         ENDIF
C#endif
C       ELSE

#ifdef _MPI_
         IF (MYID .EQ. IPROC) THEN
#endif
#ifdef _UPWARDS_
CTBA1 100203: UPWARDS NOT YET IMPLEMENTED FOR SCALAR TRANSPORT
C      STOP 'UPWARDS not yet implemented for Scalar Transport'
#else

              CALL SVLE1SCA  (KK,JJ,II,KK,JJ,II,
     &                        T(IP3),
     &                        X(IP1),  Y(IP1),  Z(IP1),
     &                       DX(IP1), DY(IP1), DZ(IP1),
     &                      DDX(IP1),DDY(IP1),DDZ(IP1),IGRID)   


#endif
C

#ifdef _MPI_
       ENDIF
#endif

C       ENDIF
C
       ENDDO

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

      RETURN
      END
C#endif

