C#ifdef _TSCAL_
      SUBROUTINE BRISCA (KMX,JMX,IMX,
     $                    T,TSCARI,
     $                    ISTART,ISTOP,KSTART,KSTOP,ITYP)
C*STARLET***************************************************************
C        B R I S C A     SETTING SCALAR BOUNDARY CONDITION FIXED-SCALAR
C*STARLET***************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        T(KMX,JMX,IMX) + SCALAR T FIELD
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:  28.02.03 (TB)  : ORIGINAL
C
C DEFINE-DIREKTIVEN     : QUD 
C
C*STARLET***************************************************************
C
#include "konsta.h"
C
      CHARACTER (LEN=1)  ITYP
C
      REAL      T(KMX,JMX,IMX)
C
C
      JM1 = JMX-1
      JM2 = JMX-2
      JM3 = JMX-3
C
C                                 **************************************
C                                 FIXED SCALAR-CONDITION AT RIGHT
C                                 **************************************
C
C
C                                 FUER ZEITSCHRITT
      IF (ITYP.EQ.'T') THEN

         DO I=ISTART,ISTOP
         DO K=KSTART,KSTOP

            T(K,  2,I) = TSCARI

         ENDDO
         ENDDO


#ifdef _QUD_

         DO I=ISTART,ISTOP
         DO K=KSTART,KSTOP

            T(K,  1,I) = TSCARI

         ENDDO
         ENDDO

#endif
      ENDIF
      END
C#endif

