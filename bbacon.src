      SUBROUTINE BBACON (
#ifdef _TSCAL_
     $                   KMX,JMX,IMX,U,V,W,T,P,G,
     $                   KMXN,JMXN,IMXN,UN,VN,WN,TN,PN,GN,
#else
     $                   KMX,JMX,IMX,U,V,W,P,G,
     $                   KMXN,JMXN,IMXN,UN,VN,WN,PN,GN,
#endif      
     $                   JSTA,JSTO,KSTA,KSTO,
     $                   IPOS,JPOS,KPOS,ITYP,IRB,JRB,KRB,
     $                   IPROC,IPROCNBR)
C*MGLET*****************************************************************
C        B B A C O N    SETZEN DER RANDBEDINGUNGEN FUER DIE
C                         GESCHWINDIGKEITSFELDER. AUS NACHBARN
C*MGLET*****************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        V(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        W(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        T(KMX,JMX,IMX) + SCALAR T FIELD
C        P(KMX,JMX,IMX) - DRUCKFELD
C        G(KMX,JMX,IMX) - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        ...N           - ENTSPRECHENDE GROESSE AUS DEM NACHBARGITTER
C        JSTART,JSTOP
C        KSTART,KSTOP   - BEREICH IN DEM RANDBEDINGUNG GESETZT WIRD
C        IPOS,JPOS,KPOS - POSITION IM NACHBARGITTER, AUF DER DER PUNKT
C                         MIT DEN INDIZES (3,3,3) ZU LIEGEN KOMMT
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C                         'S' BEFORE SIP/GAUS-SEIDEL PRESSURE CORRECTION
C        IRB            - INTEGER-KENNZAHL I-RICHTUNG RED-BLACK
C        JRB            - INTEGER-KENNZAHL J-RICHTUNG RED-BLACK
C        KRB            - INTEGER-KENNZAHL K-RICHTUNG RED-BLACK
C        IGRID          - GITTER, FUER DAS DIE RANDBEDINGUNG GESETZT WIRD
C        INBR           - GITTER, AUS DEM DIE RANDBEDINGUNG KOMMT
C
C VERS:  19.12.93 (MM)  : ORIGINAL AUS BBAPER ABGELEITET
C        11.05.95 (MM,AO): EINFUEHRUNG DER KOMMUNIKATION UNTER MPI
C        28.02.03 (TB)  : SCALAR TRANSPORT IMPLEMENTED
C        11.08.03 (TB)  : SIP/GAUS-SEIDEL SUPPORT IMPLEMENTED
C        
C
C DEFINE-DIREKTIVEN     : QUD 
C
C*STARLET***************************************************************
C
#ifdef _MPI_
C
C               MPI-INCLUDE
C
#include "mgpar.h"
#include "colevel.h"
#include "compi.h"
#include "mpif.h"
#endif
C
C#ifdef _IRIS_
      CHARACTER (LEN=1)  ITYP
C#else
C      CHARACTER (LEN=1) ITYP
C#endif
C
      REAL
     $    U(KMX,JMX,IMX),   V(KMX,JMX,IMX),   W(KMX,JMX,IMX),
     $    P(KMX,JMX,IMX),   G(KMX,JMX,IMX)
      REAL
     $    UN(KMXN,JMXN,IMXN), VN(KMXN,JMXN,IMXN),  WN(KMXN,JMXN,IMXN),
     $    PN(KMXN,JMXN,IMXN),  GN(KMXN,JMXN,IMXN)
#ifdef _TSCAL_
      REAL T(KMX,JMX,IMX), TN(KMXN,JMXN,IMXN)
#endif     
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
#ifdef _MPI_
C
C                 MPI-VARIABLEN
C
      INTEGER ISTATUS(MPI_STATUS_SIZE)
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                 MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C                 
C     CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
C     CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
C
      ISEND = IPROCNBR
      IRECV = IPROC

C
#endif
CRED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-
C
      IF (IRB .EQ. 0) THEN
         ISTART = 1
         ISTOP  = IMX
         ISTRIDE = 1
         IP      = 0
      ELSEIF (IRB .EQ. 1) THEN
          IF (ITYP.EQ.'P') RETURN
      ELSEIF (IRB .EQ. 2) THEN
         ISTART = IMX/2 + 1
         ISTOP  = IMX -   2 
      ELSE
         CALL ERRR (504,'IRB BBACON')
      ENDIF   
C
C
      IF (JRB .EQ. 0) THEN
         JSTART = 1
         JSTOP  = JMX
      ELSEIF (JRB .EQ. 1) THEN
         JSTART =   2  + 1
         JSTOP  = JMX/2
      ELSEIF (JRB .EQ. 2) THEN
         JSTART = JMX/2 + 1
         JSTOP  = JMX -   2 
      ELSE
         CALL ERRR (504,'JRB BBACON')
      ENDIF   
C
C
      IF (KRB .EQ. 0) THEN
         KSTRIDE = 1
         KP      = 0
      ELSEIF (KRB .EQ. 1) THEN
         KSTRIDE = 2
         KP      = 0
      ELSEIF (KRB .EQ. 2) THEN
         KSTRIDE = 2
         KP      = 1
      ELSE
         CALL ERRR (504,'KRB BBACON')
      ENDIF   
C
CRED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-
C
      IM1 = IMX-1
      IM2 = IMX-2
      IM3 = IMX-3
C
C      IN = IM1 + IPOS - IM2
      IN = IPOS +1

#ifdef _MPI_
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC BEI MESSAGE-PASSING WIRD ABGEPRUEFT,
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC OB GITTER AUF EINEM PROZESSOR
        IF (IPROC .EQ. IPROCNBR) THEN
C       IF (ISEND .EQ. IRECV) THEN
C
C           ZU TESTZWECKEN SOLL ISEND NORMALE BELEGUNG DURCHLAUFEN 
C        IF (MYID .EQ. ISEND) THEN
C
C                                    GITTER LIEGEN AUF EINEM PROZESSOR
C
#endif

C
C                                 FUER ZEITSCHRITT
C                                 NORMALKOMPONENTE WIRD EINEN INDEX
C                                 AUSSERHALB  GESETZT
      IF (ITYP.EQ.'T') THEN

         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               U(K,J,IM1) = UN(KN,JN,IN)
               V(K,J,IM1) = VN(KN,JN,IN)
               W(K,J,IM1) = WN(KN,JN,IN)
               P(K,J,IM1) = PN(KN,JN,IN)
               G(K,J,IM1) = GN(KN,JN,IN)
#ifdef _TSCAL_
               T(K,J,IM1) = TN(KN,JN,IN)
#endif               
#if defined _QUD_ | defined _INC1_ | defined _INC2_ | defined _ADM_

C                                   FALLS QUADRATIC UPSTREAM
C
               U(K,J,IMX) = UN(KN,JN,IN+1)
               V(K,J,IMX) = VN(KN,JN,IN+1)
               W(K,J,IMX) = WN(KN,JN,IN+1)
               P(K,J,IMX) = PN(KN,JN,IN+1)
               G(K,J,IMX) = GN(KN,JN,IN+1)
#ifdef _TSCAL_
               T(K,J,IMX) = TN(KN,JN,IN+1)
#endif                
#endif
#ifdef _FRED_BODY_
C jk 18.7.2005

C                                   FALLS FREDBODY
C
               U(K,J,IMX) = UN(KN,JN,IN+1)
               V(K,J,IMX) = VN(KN,JN,IN+1)
               W(K,J,IMX) = WN(KN,JN,IN+1)
               P(K,J,IMX) = PN(KN,JN,IN+1)
               G(K,J,IMX) = GN(KN,JN,IN+1)
#ifdef _TSCAL_
               T(K,J,IMX) = TN(KN,JN,IN+1)
#endif                
#endif

         ENDDO
         ENDDO
C
C                                 FUER DRUCKKORREKTUR
C                                 NUR NORMALKOMPONENTE MUSS GESETZT
C                                 WERDEN
       ELSEIF (ITYP.EQ.'P') THEN


         DO J=JSTART,JSTOP
         DO K=KSTA+KP,KSTO,KSTRIDE

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               U(K,J,IM2) = UN(KN,JN,IN-1)

         ENDDO
         ENDDO
C
C
C                    FUER DRUCKKORREKTUR GAUS_SEIDEL ODER SIP

       ELSEIF (ITYP.EQ.'S') THEN
          
C          WRITE(6,*)'JSTA,JSTO: ',JSTA,JSTO,KSTA,KSTO

         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               P(K,J,IM1) = PN(KN,JN,IN)

         ENDDO
         ENDDO

       ELSE
       	       WRITE(6,*)'ITYP:',ITYP
                CALL ERRR (501,' BBACON')
       ENDIF

#ifdef _MPI_

C                                  BIS HIER NUR SENDER
C       ENDIF

        ELSE
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                 ARE THE GRIDS ON DIFFERENT PROCESSORS THE MESSAGE HAS 
C                 TO BE SENT BY MPI
C 
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C                                 FUER ZEITSCHRITT
      IF (ITYP.EQ.'T') THEN

C---N.Peller.130803
#if defined _FRED_BODY_
           DO IPLANE = 0,1
#else
              IPLANE = 0
#endif
C---N.Peller.130803

CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC SEND-BUFFER
      IF (MYID .EQ. ISEND) THEN

         ICOUNT = 0

         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3


               SENDBUF(ICOUNT+1) = UN(KN,JN,IN+IPLANE)
               SENDBUF(ICOUNT+2) = VN(KN,JN,IN+IPLANE)
               SENDBUF(ICOUNT+3) = WN(KN,JN,IN+IPLANE)
#ifdef _TSCAL_
               SENDBUF(ICOUNT+4) = TN(KN,JN,IN+IPLANE)
               SENDBUF(ICOUNT+5) = PN(KN,JN,IN+IPLANE)
               SENDBUF(ICOUNT+6) = GN(KN,JN,IN+IPLANE)

               ICOUNT = ICOUNT+6
#else
               SENDBUF(ICOUNT+4) = PN(KN,JN,IN+IPLANE)
               SENDBUF(ICOUNT+5) = GN(KN,JN,IN+IPLANE)

               ICOUNT = ICOUNT+5
#endif               

          ENDDO
          ENDDO

      CALL MPI_SEND    ( SENDBUF , ICOUNT , 
     $ MPI_DOUBLE_PRECISION ,
     $                 IRECV , ISEND ,
     $                 MPI_COMM_WORLD , IERR)

      ENDIF

      IF (MYID .EQ. IRECV) THEN

      CALL MPI_RECV    ( RECVBUF , IDIM_MG_BUFS , 
     $ MPI_DOUBLE_PRECISION ,
     $                 ISEND , ISEND ,
     $                 MPI_COMM_WORLD , ISTATUS ,IERR)
C
C                                    BELEGUNG DES RECV-BUFFERS
C
         ICOUNT = 0
         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               U(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+1)
               V(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+2)
               W(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+3)
#ifdef _TSCAL_
               T(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+4)
               P(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+5)
               G(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+6)

               ICOUNT = ICOUNT+6
#else
               P(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+4)
               G(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+5)

               ICOUNT = ICOUNT + 5
#endif                

         ENDDO
         ENDDO

        ENDIF

C---N.Peller.130803
#if defined _FRED_BODY_

            ENDDO

#endif
C---N.Peller.130803

C
C                                 FUER DRUCKKORREKTUR
C                                 NUR NORMALKOMPONENTE MUSS GESETZT
C                                 WERDEN
       ELSEIF (ITYP.EQ.'P') THEN


         IF (MYID .EQ. ISEND) THEN
C
C                                    BELEGUNG DES SEND-BUFFERS
C
         ICOUNT = 0

         DO J=JSTART,JSTOP
         DO K=KSTA+KP,KSTO,KSTRIDE

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               ICOUNT = ICOUNT+1

               SENDBUF(ICOUNT) = UN(KN,JN,IN-1)

         ENDDO
         ENDDO


      CALL MPI_SEND    ( SENDBUF , ICOUNT , 
     $ MPI_DOUBLE_PRECISION ,
     $                 IRECV , ISEND ,
     $                 MPI_COMM_WORLD , IERR)

      ENDIF


      IF (MYID .EQ. IRECV) THEN

      CALL MPI_RECV    ( RECVBUF , IDIM_MG_BUFS , 
     $ MPI_DOUBLE_PRECISION ,
     $                 ISEND , ISEND ,
     $                 MPI_COMM_WORLD , ISTATUS ,IERR)
C
C                                    BELEGUNG DES RECV-BUFFERS
C
         ICOUNT = 0

         DO J=JSTART,JSTOP
         DO K=KSTA+KP,KSTO,KSTRIDE

               JN = J + JPOS - 3

               ICOUNT = ICOUNT+1

               U(K,J,IM2) = RECVBUF(ICOUNT)

         ENDDO
         ENDDO

       ENDIF

C
C                  FUER DRUCKKORREKTUR GAUS_SEIDEL ODER SIP

       ELSEIF (ITYP.EQ.'S') THEN


         IF (MYID .EQ. ISEND) THEN
C
C                                    BELEGUNG DES SEND-BUFFERS
C
         ICOUNT = 0

         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               ICOUNT = ICOUNT+1

               SENDBUF(ICOUNT) = PN(KN,JN,IN)

         ENDDO
         ENDDO


      CALL MPI_SEND    ( SENDBUF , ICOUNT , MPI_DOUBLE_PRECISION ,
     $                 IRECV , ISEND , MPI_COMM_WORLD , IERR)

      ENDIF


      IF (MYID .EQ. IRECV) THEN

      CALL MPI_RECV    ( RECVBUF , IDIM_MG_BUFS , MPI_DOUBLE_PRECISION ,
     $                 ISEND , ISEND , MPI_COMM_WORLD , ISTATUS ,IERR)
C
C                                    BELEGUNG DES RECV-BUFFERS
C
         ICOUNT = 0

         DO J=JSTA,JSTO
         DO K=KSTA,KSTO

               ICOUNT = ICOUNT+1

               P(K,J,IM1) = RECVBUF(ICOUNT)

         ENDDO
         ENDDO

       ENDIF

       ELSE
          WRITE(6,*)'ITYP:',ITYP
                CALL ERRR (501,' BBACON')

      ENDIF
       ENDIF
#endif

      RETURN
      END

