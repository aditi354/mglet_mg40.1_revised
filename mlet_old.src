       IF (LSCAI(ILEVEL)) THEN
          NGRIDPERLEVEL = NOFSCAI(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFSCAI(I,ILEVEL)
        ENDDO
       ELSE
          NGRIDPERLEVEL = NOFTST(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFTST(I,ILEVEL)
        ENDDO
       ENDIF
