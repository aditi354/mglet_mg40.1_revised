               ENDIF
               IF(IPRINT_WNS .EQ. 1) THEN
                CALL WNSINT(KK,JJ,II,NBND,
     $                    DX(IP1),DY(IP1),DZ(IP1),
     $                    DDX(IP1),DDY(IP1),DDZ(IP1),
     $                    P(IP3),G(IP3),
     $                    WNSX(IGRID),WNSY(IGRID),WNSZ(IGRID),
     $                    GMOL,RHO,UGRID,IC1(IGRID),IC2(IGRID),
