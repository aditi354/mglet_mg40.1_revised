CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
#ifdef _MPI_
       ENDIF
#endif
        ENDDO
      ENDDO
C
C
      IF (MTURB .EQ. 1) THEN
C                                 VORBELEGUNG DER STATISTIK

      DO ILEVEL = MINLEVEL,MAXLEVEL
C----------------------------------------------------------------------
       IF (LSCAI(ILEVEL)) THEN 
          NGRIDPERLEVEL = NOFSCAI(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFSCAI(I,ILEVEL)
        ENDDO
       ELSE
          NGRIDPERLEVEL = NOFTST(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFTST(I,ILEVEL)
        ENDDO
       ENDIF
C----------------------------------------------------------------------
        DO I = 1,NGRIDPERLEVEL
           IGRID = NOFTHISGRID(I)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                                NUR, FALLS GITTER NICHT GEBIETSZERLEGT
C
          IF ( .NOT. LSLICE(IGRID) ) THEN
             
             CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $            NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
             CALL MGDIMA  (KKA,JJA,IIA,IGRID)
             CALL MGPOINA (IAV,I2L,I1L,IGRID)
C
C                                 STATISTIK WIRD AUF REGULAEREN GITTERN 
C                                 GEMACHT
C
C
             CALL SETSTA  (KPP,JPP,IPP,IC1(IGRID),IC2(IGRID),JC1(IGRID),
     $                    JC2(IGRID),KC1(IGRID),KC2(IGRID),
     $                          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                        XHOMOG(IGRID),YHOMOG(IGRID),ZHOMOG(IGRID),
#ifdef _TSCAL_
     $           GMOL,RHO,PRMOL,PRTURB,UGRID,DDX(IP1),DDY(IP1),DDZ(IP1),
#else
     $                 GMOL,RHO,UGRID,DDX(IP1),DDY(IP1),DDZ(IP1),
#endif
     $                 DX(IP1),DY(IP1),DZ(IP1),X(IP1),Y(IP1),Z(IP1),
     $                 RDX(IP1),RDY(IP1),RDZ(IP1),
     $                 RDDX(IP1),RDDY(IP1),RDDZ(IP1),
#include "cstmga.h"
 
            CALL SETST1  (HILFL,KKML,RKOMXP,RKOMXA,
#include "cstmg1.h"

C

         ENDIF
#ifdef _MPI_
       ENDIF
#endif

        ENDDO
       ENDDO

      ENDIF
C
C                               ENDE DER GITTERSPEZIFISCHEN VORBELEGUNG
C
C
C
      IF(DREAD) THEN
                    CLOSE(1)
                    CLOSE(3)
      ENDIF
C
C                                                 KONTROLLAUSDRUCK
C


      IF(ITPRIN.EQ.0) THEN
        IPG = IPRGRID
        IP3 = IP3D(IPG)
        IP1 = IP1D(IPG)
      CALL PRLE3M (1,1,4,'J',KMX(IPG),JMX(IPG),IMX(IPG),
#ifdef _TSCAL_
     $             U(IP3),1,V(IP3),1,W(IP3),1,T(IP3),1,P(IP3),1,
#else
     $             U(IP3),1,V(IP3),1,W(IP3),1,P(IP3),1,
#endif
     $             G(IP3),1,B(IP3),0,DIV(IP3),0,  1,  1,  4,  1,  1,  4,
     $             DX(IP1),DY(IP1),DZ(IP1),X(IP1),Y(IP1),Z(IP1),
     $             KANPR,ITSTEP)
      ENDIF
C
C
C                                 ZUERST WIRD EIN DIVERGENZFREIES FELD
C                                 ERZEUGT !!
C
                               OMBETA = OMG*RHO/(-2.0*DT)
                               WSOR = 1.0



#ifdef _POISSONITER_
        CALL MGPOISL1    (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                    X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                    RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                    U,V,W,P,DP,G,B,DIV,RES,
     $                    UFR,VFR,WFR,
     $                    UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                    WSOR,RHO,DIVG,IPRGRID,
     $                    MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                    UBA,VBA,WBA,PBA,GBA,UBO,VBO,WBO,
     $                    PFR,GFR,
     $                    GSAW,GSAE,GSAN,GSAS,GSAT,GSAB,
     $                    BP,BU,BV,BW,SDIV
#ifdef _SIP_ITER_
     $                   ,GEOVP,SIPLW,SIPLS,
     $                    SIPLB,SIPLPR,SIPUE,SIPUN,SIPUT
#else
     $                   ,GSRAP
#endif
#ifdef _TSCAL_
     $                   ,T,TFR,TBA,TTO,TBO
#endif
     $                   )
#else

         CALL MGVPL1 (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                FPSFAK,FCOSMY,FCOSNY,
     $                IFFTX,IPERMUX,RFFTX,IFFTY,IPERMUY,RFFTY,   
     $                U,V,W,P,DP,G,B,BP,BU,BV,BW,SDIV,
     $                DIV,UFR,VFR,WFR,
     $                UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
     $                WSOR,RHO,DIVG,IPRGRID,
     $                MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                UBA,VBA,WBA,PBA,GBA,GEOVP,UBO,VBO,WBO,
     $                PFR,GFR
#ifdef _HITACHI_
     $                ,CXY,CTB,CWK,CHILF
#endif
#ifdef _TSCAL_
     $                ,T,TFR,TBA,TTO,TBO
#endif
     $                     )

#endif    
C
#ifdef _TAYLOR_VORT_
                   CALL PRINTVEL(KK,JJ,II,
     &                         U(IP3), V(IP3),  W(IP3), P(IP3),
     &                         X(IP1), Y(IP1),  Z(IP1) ,TIMEPH)
        write (6,*) '-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o-o'

#endif
C
C               REDUZIERUNG DES DRUCKNIVEAUS FUER GEWUENSCHTE GITTER
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (LPLEVEL(IGRID)) THEN
           CALL MGDIMS  (KK,JJ,II,IGRID)
           CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)
           CALL MGBASB  (NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
#ifdef _FRED_BODY_
           CALL PLEVEL  (KK,JJ,II,KK,JJ,II,P(IP3),BP(IP3),
     $             DDX(IP1), DDY(IP1), DDZ(IP1),NFRO,NRGT,NBOT)
#else
           CALL PLEVEL  (KK,JJ,II,KK,JJ,II,P(IP3),B(IP3),
     $             DDX(IP1), DDY(IP1), DDZ(IP1),NFRO,NRGT,NBOT)
#endif

        ENDIF
#ifdef _MPI_
       ENDIF
#endif
        ENDDO
      ENDDO

C                                 **************************************
C                                 ENDE DER INITIALISIERUNGSPHASE
C                                 **************************************
C

      DO ILEVEL = MINLEVEL,MAXLEVEL
C----------------------------------------------------------------------
       IF (LSCAI(ILEVEL)) THEN
          NGRIDPERLEVEL = NOFSCAI(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFSCAI(I,ILEVEL)
        ENDDO
       ELSE
          NGRIDPERLEVEL = NOFTST(ILEVEL)
        DO I=1,NGRIDPERLEVEL
          NOFTHISGRID(I) = IGRDOFTST(I,ILEVEL)
        ENDDO
       ENDIF
C----------------------------------------------------------------------

        DO I = 1,NGRIDPERLEVEL
           IGRID = NOFTHISGRID(I)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

               CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $                     NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C         CALL WRITE3DDIAGY(KK,JJ,II,W(IP3),33,3)
C         CALL WRITE3DDIAGY(KK,JJ,II,U(IP3),43,4)
               IF (LPOISSONDIR(IGRID)) THEN
#ifdef _FRED_BODY_
                  CALL DIVCAL
     $                 (KK,JJ,II,KK,JJ,II,
     $                 RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                 U(IP3),V(IP3),W(IP3),BP(IP3),DIV(IP3),
     $                 1.0,-2,DIVGMX(IGRID),BU(IP3),BV(IP3),
     $                 BW(IP3),SDIV(IP3))
#else
                  CALL DIVCAL
     $                 (KK,JJ,II,KK,JJ,II,
     $                 RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                 U(IP3),V(IP3),W(IP3),B(IP3),DIV(IP3),
     $                 1.0,-2,DIVGMX(IGRID),BU(IP3),BV(IP3),
     $                 BW(IP3),SDIV(IP3))
#endif
               ENDIF

                  
               IF(IPRINT_WSS .EQ. 1) THEN              	
                  CALL WSSINT(KK,JJ,II,NBND,
     $                 DX(IP1),DY(IP1),DZ(IP1),
     $                 DDX(IP1),DDY(IP1),DDZ(IP1),
     $                 U(IP3),V(IP3),W(IP3),G(IP3),
     $                 WSSX(IGRID),WSSY(IGRID),WSSZ(IGRID),
     $                 GMOL,RHO,UGRID,IC1(IGRID),IC2(IGRID),
     $                 JC1(IGRID),JC2(IGRID),KC1(IGRID),KC2(IGRID),
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP)
               ENDIF
               IF(IPRINT_WNS .EQ. 1) THEN
                  CALL WNSINT(KK,JJ,II,NBND,
     $                 DX(IP1),DY(IP1),DZ(IP1),
     $                 DDX(IP1),DDY(IP1),DDZ(IP1),
     $                 P(IP3),G(IP3),
     $                 WNSX(IGRID),WNSY(IGRID),WNSZ(IGRID),
     $                 GMOL,RHO,UGRID,IC1(IGRID),IC2(IGRID),
     $                 JC1(IGRID),JC2(IGRID),KC1(IGRID),KC2(IGRID),
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP)
               ENDIF
#ifdef _CHANNEL_DIAGNOSE_
               CALL CHANNELD(KK,JJ,II,NBND,
     $              DX(IP1),DY(IP1),DZ(IP1),
     $              DDX(IP1),DDY(IP1),DDZ(IP1),
     $              U(IP3),V(IP3),W(IP3),
     $              WALLSSX(1,IGRID),WALLSSY(1,IGRID),WALLSSZ(1,IGRID),
     $              GMOL,RHO,UGRID,NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,IGRID
#ifdef _TSCAL_
     $              ,NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,NTOPSCA
     $              ,WALLQX(1,IGRID),T(IP3)
#endif
     $              )


               CALL CAL_UBULK(KK,JJ,II,NBND,DDX(IP1),
     $              DDY(IP1),DDZ(IP1),U(IP3),W(IP3),B(IP3),
     $              UGRID,UBULK(IGRID),BP(IP3))
#endif 
               IF(MTURB .EQ. 0) THEN
                 CALL ERNORM(KK,JJ,II,KK,JJ,II,NBND,
     $                       U(IP3),UO(IP3),EPSU(IGRID))
                 CALL ERNORM(KK,JJ,II,KK,JJ,II,NBND,
     $                       V(IP3),VO(IP3),EPSV(IGRID))
                 CALL ERNORM(KK,JJ,II,KK,JJ,II,NBND,
     $                       W(IP3),WO(IP3),EPSW(IGRID))
               ELSE
#ifdef _ORRSOMMER_
               CALL FLUCTUATIONS(KK,JJ,II,U(IP3),V(IP3),W(IP3),
     $                           H3D1(IP3),H3D2(IP3),H3D3(IP3),
     $                           UOLD(IP3),VOLD(IP3),WOLD(IP3),DREAD,
     $                           DZ(IP1),Z(IP1))

                 CALL ENERFG  (KK,JJ,II,KK,JJ,II,
     $           DDX(IP1),DDY(IP1),DDZ(IP1),DX(IP1), DY(IP1), DZ(IP1),
     $             X(IP1),  Y(IP1),  Z(IP1),
     $           H3D1(IP3),H3D2(IP3),H3D3(IP3),
     $           HILF(IP3),ESUMG(IGRID),
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,1,GRADPX(IGRID))
#else

                 CALL ENERFG  (KK,JJ,II,KK,JJ,II,
     $           DDX(IP1),DDY(IP1),DDZ(IP1),DX(IP1), DY(IP1), DZ(IP1),
     $             X(IP1),  Y(IP1),  Z(IP1),U(IP3),V(IP3),W(IP3),
     $           HILF(IP3),ESUMG(IGRID),
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,1,GRADPX(IGRID))
#endif
#ifndef _DNS_
                 CALL ENERFS  (KK,JJ,II,KK,JJ,II,
     $           DDX(IP1),DDY(IP1),DDZ(IP1),DX(IP1), DY(IP1), DZ(IP1),
     $             X(IP1),  Y(IP1),  Z(IP1),B(IP3),G(IP3),GMOL,RHO,
     $           HILF(IP3),ESUMS(IGRID),IC1,IC2,JC1,JC2,KC1,KC2,
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,1,CONV1S(IP1))
#endif
             ENDIF
CTBA4 070503
#ifdef _TSCAL_
               CALL DTMXCAL (KK,JJ,II,KK,JJ,II,X(IP1),Y(IP1),Z(IP1),
     $                   T(IP3),TO(IP3),B(IP3),DTMAX(IGRID),TMAX(IGRID),
     $                   ITMAX(IGRID),JTMAX(IGRID),KTMAX(IGRID),
     $                   XTMAX(IGRID),YTMAX(IGRID),ZTMAX(IGRID),IGRID,
     $                   IC1(IGRID),IC2(IGRID),
     $                   JC1(IGRID),JC2(IGRID),
     $                   KC1(IGRID),KC2(IGRID),
     $                   DIV(IP3),DIVGMX(IGRID),TSCA(1,1,IGRID),
     $                   IDIVMAX(IGRID),JDIVMAX(IGRID),KDIVMAX(IGRID),
     $                   XDIVMAX(IGRID),YDIVMAX(IGRID),ZDIVMAX(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3),
     $                 DDSMAX(IGRID),SMMAX(IGRID),SPMAX(IGRID),
     $                 ISPMAX(IGRID),JSPMAX(IGRID),KSPMAX(IGRID),
     $                 XSPMAX(IGRID),YSPMAX(IGRID),ZSPMAX(IGRID)     
                       
#endif      
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,QCTE(IP3),QCTW(IP3),QCTN(IP3),QCTS(IP3),
     $                 QCTT(IP3),QCTB(IP3),QDTE(IP3),QDTW(IP3),
     $                 QDTN(IP3),QDTS(IP3),QDTT(IP3),QDTB(IP3),QDTC(IP3)
     $                ,QCE(IGRID),QCW(IGRID),QCN(IGRID),QCS(IGRID),
     $                 QCT(IGRID),QCB(IGRID),QDE(IGRID),QDW(IGRID),
     $                 QDN(IGRID),QDS(IGRID),QDT(IGRID),QDB(IGRID),
     $                 QDC(IGRID)              
#endif
#ifdef _FRED_BODY_
     $                 ,BP(IP3)
#endif
     $                      )

#ifdef _SCALAR_DIAG1_
         OPEN (23,FORM="UNFORMATTED",POSITION="APPEND")
         OPEN (22,FORM="UNFORMATTED")
         CALL WRITEKOORD(KK,JJ,II,X(IP1),22)
         CLOSE(22)
#endif

#endif         
         
#ifdef _MPI_
       ENDIF
#endif
        ENDDO
      ENDDO
#if defined _MPI_ | defined _MPI_PARTICLES_
       IF (MYID .EQ. 0) THEN
          WTIME =  MPI_WTIME()
          WRITE (6,*)'ITSTEP, WTIME:',ITSTEP, WTIME-MPI_STARTTIME
       ENDIF
#endif

       DO IGRID = 1,NGRID
          IF (LSLICE(IGRID)) THEN
          	            
             CALL ITSAMPLE (IGRID,IPCGES,DIVGMX,EPSU,EPSV,EPSW,
     $            ESUMG,ESUMS,WSSX,WSSY,WSSZ,WNSX,WNSY,WNSZ,
     $            UBULK,WALLSSX,WALLSSY,WALLSSZ
     $    ,IDIVMAX,JDIVMAX,KDIVMAX,XDIVMAX,YDIVMAX,ZDIVMAX,GRDIVMAX       
#ifdef _TSCAL_
     $    ,DTMAX,TMAX,ITMAX,JTMAX,KTMAX,XTMAX,YTMAX,ZTMAX,GRDTMAX,ITSTEP
     $    ,PRTMAX,XPRTMAX,YPRTMAX,ZPRTMAX,PRTMIN,XPRTMIN,YPRTMIN,ZPRTMIN
#ifdef _SCALGRIDDIAGNOSE_
     $    ,DDSMAX,SMMAX,SPMAX,ISPMAX,JSPMAX,KSPMAX,XSPMAX,YSPMAX,ZSPMAX,
     $     GRDSMAX         
#endif            
#ifdef _SCALTRANSDIAGNOSE_   
     $    ,QCE,QCW,QCN,QCS,QCT,QCB,QDE,QDW,QDN,QDS,QDT,QDB,QDC                          
#endif
#endif
     $                     )                  
          ENDIF

#if defined _MPI_ | defined _MPI_PARTICLES_
          IF (MYID .EQ. 0)  THEN
#endif

      
             CALL ITINF (ITTOT,TIMEPH,IPCGES(IGRID),DIVGMX(IGRID),IGRID,
     $            CPSEC,MTURB,EPSU(IGRID),EPSV(IGRID),EPSW(IGRID),
     $            ESUMG(IGRID),ESUMS(IGRID),
     $            IPRINT_WSS,WSSX(IGRID),WSSY(IGRID),WSSZ(IGRID),
     $            IPRINT_WNS,WNSX(IGRID),WNSY(IGRID),WNSZ(IGRID)
     $            ,UBULK(IGRID),GRADPX(IGRID),
     $            WALLSSX(1,IGRID),WALLSSY(1,IGRID),WALLSSZ(1,IGRID)
     $            ,IDIVMAX(IGRID),JDIVMAX(IGRID),KDIVMAX(IGRID)
     $            ,XDIVMAX(IGRID),YDIVMAX(IGRID),ZDIVMAX(IGRID)
     $            ,GRDIVMAX(IGRID)      
#ifdef _TSCAL_
     $       ,DTMAX(IGRID),ITMAX(IGRID),JTMAX(IGRID),KTMAX(IGRID)
     $       ,XTMAX(IGRID),YTMAX(IGRID),ZTMAX(IGRID), TMAX(IGRID)    
     $       ,GRDTMAX(IGRID),ITSTEP,WALLQX(1,IGRID)
     $       ,PRTMAX(IGRID),XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID)
     $       ,PRTMIN(IGRID),XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $       ,DDSMAX(IGRID),SMMAX(IGRID),SPMAX(IGRID),ISPMAX(IGRID),
     $        JSPMAX(IGRID),KSPMAX(IGRID),XSPMAX(IGRID),YSPMAX(IGRID),
     $        ZSPMAX(IGRID),GRDSMAX(IGRID)
#endif      
#ifdef _SCALTRANSDIAGNOSE_  
     $       ,QCE(IGRID),QCW(IGRID),QCN(IGRID),QCS(IGRID),QCT(IGRID)
     $       ,QCB(IGRID),QDE(IGRID),QDW(IGRID),QDN(IGRID),QDS(IGRID)
     $       ,QDT(IGRID),QDB(IGRID),QDC(IGRID)              
#endif           
#endif
     $                 )
          
#if defined _MPI_ | defined _MPI_PARTICLES_
          ENDIF
#endif
      ENDDO

C#ifdef _MPI_
C                       EINLESEN FUER FREQUENZOPTIMIERUNG (Jens Neumann)
C      CALL READVAROPT(VAROPT,IDIM2D,NDIMVAROPT)
C        IF (MYID .EQ. 0) THEN
C      WRITE(6,*)'OPTF: READ: TIMEOPT,FREQOPT',TIMEALT,FREQOPT
C        ENDIF
C#else
C      CALL READVAROPT(VAROPT,IDIM2D,NDIMVAROPT)
C      WRITE(6,*)'OPTF: READ: TIMEOPT,FREQOPT',TIMEALT,FREQOPT
C#endif

    
C 
C                                 **************************************
C                                 BEGINN DER ZEITITERATIONEN 
C                                 **************************************
C

CCCCCCCCCCC ******** Read the PARAMETERS from printdata.dat ******** CCCCCCC

      INUNIT = 1000
      OPEN(UNIT=INUNIT,FILE='printdata.dat',FORM='FORMATTED')

      DO i = 1, numxloc
        READ(INUNIT,*)x_loc_temp(i)
      END DO

      DO i = 1, numzloc
        READ(INUNIT,*)z_loc(i)
      END DO

      req_xloc = 0 
      DO i = 1, numxloc
        READ(INUNIT,*)MYID_temp
        if (MYID_temp .NE. 999) then
          req_xloc = req_xloc + 1
          MYID_loc(req_xloc) = MYID_temp 
          x_loc(req_xloc) = x_loc_temp(i)
      end if
      END DO

      READ(INUNIT,*)yloc_stream

      DO I = 1, numzloc_stream
        READ(INUNIT,*)zloc_stream(I)
      END DO

      CLOSE(INUNIT)

      DO 2000 ISTEP=1,MTSTEP
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  TESTWEISE VOR AUFRUF ALLER ZEITSCHRITT-
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  UND RANDBED.-ROUTINEN GESCHALTET
#ifndef _RUNGEKUTTA3_ 
      TIMEPH     = TIMEPH + DT
#endif      

#ifdef _ADJUST_DPDX_
C      DO ILEVEL = MINLEVEL,MAXLEVEL
C         DO I = 1,NOFTST(ILEVEL)
C            IGRID = IGRDOFTST(I,ILEVEL)
      DO I=1,NGRID
         DO ISUB=1,MAX (1,NOFSLCHILDS(I))
            IF (LSLICE(I)) THEN
               IGRID = IGRDOFSLCHILD(ISUB,I)
            ELSE
               IGRID = I
            ENDIF
#ifdef _MPI_
            IPROC = IDPROCOFGRD(IGRID)
C		write (0,*)'adjdpdx fur Gitter',igrid,'von Proc',iproc
            IF (MYID .EQ. IPROC)  THEN
#endif

               CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
     
               CALL ADJDPDX(KK,JJ,II,NBND,ITSTEP,ITMIT,
     $              X(IP1),Y(IP1),Z(IP1),
     $              DX(IP1),DY(IP1),DZ(IP1),
     $              DDX(IP1),DDY(IP1),DDZ(IP1),
     $              U(IP3),V(IP3),W(IP3),UO(IP3),VO(IP3),WO(IP3),B(IP3),
     $              WALLSSX(1,IGRID),WALLSSY(1,IGRID),WALLSSZ(1,IGRID),
     $              GRADPX(IGRID),UBULK(IGRID),UBULKX(IGRID),
     $              GMOL,RHO,UGRID,DT,NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,
     $              BP(IP3),GRADPXOLD(IGRID))
#ifdef _MPI_
            ENDIF
            IF (IPROC .NE. 0) THEN
            IF (MYID .EQ. IPROC) THEN
               CALL MPI_SSEND (GRADPX(IGRID), 1, 
     $ MPI_DOUBLE_PRECISION, 
     $              0, IGRID, MPI_COMM_WORLD , IERR)
            ENDIF
            IF (MYID .EQ. 0) THEN
               CALL MPI_RECV  (GRADPX(IGRID), 1, 
     $ MPI_DOUBLE_PRECISION,
     $              IPROC, IGRID, MPI_COMM_WORLD, ISTATUS,IERR)
            ENDIF
            ENDIF
#endif
         ENDDO
         IF (LSLICE(I)) THEN
            
            GRADPX(I) = 0
            GFAK = 1./FLOAT(NOFSLCHILDS(I))

C            DO ISUB=1,NOFSLCHILDS(I)
C               IGRID=IGRDOFSLCHILD(ISUB,I)
C               write (0,*) 'igrid',igrid,gradpx(igrid),GFAK
C            ENDDO
            
            DO ISUB=1,NOFSLCHILDS(I)
               IGRID=IGRDOFSLCHILD(ISUB,I)

               GRADPX(I)=GRADPX(I) + GRADPX(IGRID)*GFAK
            ENDDO
C               write (0,*) 'i',i,gradpx(i)
            DO ISUB=1,NOFSLCHILDS(I)
               IGRID=IGRDOFSLCHILD(ISUB,I)

               GRADPX(IGRID)=GRADPX(I)
            ENDDO
         ENDIF
#ifdef _MPI_
         CALL MPI_BCAST(GRADPX,NOFSLCHILDS(I),
     $        
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
#endif
      ENDDO
#endif

#if defined _MPI_ | defined _MPI_PARTICLES_
       WTIME1 = MPI_WTIME()
#endif

CCCCCCCCCCCCCCCCCCCCCCC RANDOME ZAHL PRO ZEITSCHRITT
#ifdef _MPI_
      IF (IPROC .EQ. 0) THEN
#endif
      RANNUM= RANF()
#ifdef _MPI_
      ENDIF
      CALL MPI_BCAST(RANNUM,1,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
#endif
CCCCCCCCCCCCCCCCCCCCCCC


      DO ILEVEL = MINLEVEL,MAXLEVEL
Cifdef _MPI_
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
Cendif

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C
C
C
C                                 BELEGUNG DER UO, VO, WO -FELDER MIT
C                                 DEN WERTEN DER U, V, W -FELDER
#ifdef _FRED_BODY_
c        write(0,*) 'before boundmg    myid = ', myid
c        stop
         CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'X',IGRID,0,0,0,
     $              TIMEPH,UBA,VBA,WBA,PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )      

#ifdef _ZERO_FLUX_
 
         call outflux(kk,jj,ii,u(ip3),v(ip3),w(ip3),bp(ip3),bp(ip3),
     $           stot,badflux,ddx(ip1),ddy(ip1),ddz(ip1),rdx(ip1),
     $           rdy(ip1),rdz(ip1),0,corr,gflux)
            if (stot.ne.0) then
            corr = -badflux/stot
c           write(*,*) 'before correction : ', badflux
            else
            corr = 0.0
            end if
#ifdef _MPI_
            call mpi_reduce(badflux,badfluxtot,1,
     $ MPI_DOUBLE_PRECISION,MPI_SUM,
     $                      0,MPI_COMM_WORLD, IERR)
            call mpi_reduce(stot,stottot,1,
     $ MPI_DOUBLE_PRECISION,MPI_SUM,
     $                      0,MPI_COMM_WORLD, IERR)
           if (myid.eq.0) then
              if (stottot.ne.0) then
              corr = -(badfluxtot-gflux)/stottot
              else
              corr = 0.0
              end if
c             write(*,*) 'before correction : ',badfluxtot
           end if
           call mpi_bcast(corr,1,
     $ MPI_DOUBLE_PRECISION, 0, MPI_COMM_WORLD,IERR)
#endif
       call outflux(kk,jj,ii,u(ip3),v(ip3),w(ip3),bp(ip3),bp(ip3),
     $           stot,badflux,ddx(ip1),ddy(ip1),ddz(ip1),rdx(ip1),
     $           rdy(ip1),rdz(ip1),1,corr,gflux)

#endif

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'Z',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )       
      
c        write(0,*) 'after first boundmg with Z  myid=', myid
c        stop
#endif
C

#ifdef _MPI_
       ENDIF
#endif
        ENDDO
      ENDDO
#ifdef _RUNGEKUTTA3_
#ifndef _RUNGEKUTTA3SCA_
           STOP 'RUNGEKUTTA3 MUST GO WITH RUNGEKUTTA3SCA'
           CALL ERRR (501,'MLET')       
#endif

           CALL  TST3RK 
     $                   (IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                         X,     Y,     Z,
     $                        DX,    DY,    DZ,    DDX,    DDY,    DDZ,
