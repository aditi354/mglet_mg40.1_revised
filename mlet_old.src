     $             ,XDIVMAX(IGRID),YDIVMAX(IGRID),ZDIVMAX(IGRID)
     $             ,GRDIVMAX(IGRID)      
#ifdef _TSCAL_
     $       ,DTMAX(IGRID),ITMAX(IGRID),JTMAX(IGRID),KTMAX(IGRID)
     $       ,XTMAX(IGRID),YTMAX(IGRID),ZTMAX(IGRID), TMAX(IGRID)     
