     $                     NFRO,NBAC,NRGT,NLFT,NBOT,NTOP)
               ENDIF       
#ifdef _TAYLOR_VORT_
               CALL PRINTVEL(KK,JJ,II,
     &                         U(IP3), V(IP3),  W(IP3), P(IP3),
     &                         X(IP1), Y(IP1),  Z(IP1) ,TIMEPH)
