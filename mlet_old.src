     $  mvy(IDIM2D),mvz(IDIM2D),mwz(IDIM2D),
     $  fa11(IDIM2D),fa12(IDIM2D),fa13(IDIM2D),
     $  fa21(IDIM2D),fa22(IDIM2D),fa23(IDIM2D),
     $  fa31(IDIM2D),fa32(IDIM2D),fa33(IDIM2D)

      real 
     $ dudx3(IDIM2D*3),dudy3(IDIM2D*3),dudz3(IDIM2D*3),
     $ dvdx3(IDIM2D*3),dvdy3(IDIM2D*3),dvdz3(IDIM2D*3),
     $ dwdx3(IDIM2D*3),dwdy3(IDIM2D*3),dwdz3(IDIM2D*3),
     $ norms(IDIM2D*3),
     $ sdudx3(IDIM2D*3),sdudy3(IDIM2D*3),sdudz3(IDIM2D*3),
     $ sdvdy3(IDIM2D*3),sdvdz3(IDIM2D*3),sdwdz3(IDIM2D*3),
     $ uc(IDIM2D*3),vc(IDIM2D*3),wc(IDIM2D*3),
     $ uuc(IDIM2D*3),uvc(IDIM2D*3),uwc(IDIM2D*3),
     $ vvc(IDIM2D*3),vwc(IDIM2D*3),wwc(IDIM2D*3)
                           
#else
 
      real  cdelta(1)

      real
     $  hilf0(1),hilf1(1),hilf2(1),
     $  hilf3(1),hilf4(1),hilf5(1),
     $  hilf6(1),
     $  lux(1),luy(1),luz(1),
     $  lvy(1),lvz(1),lwz(1),
     $  mux(1),muy(1),muz(1),
     $  mvy(1),mvz(1),mwz(1),
     $  fa11(1),fa12(1),fa13(1),
     $  fa21(1),fa22(1),fa23(1),
     $  fa31(1),fa32(1),fa33(1)

      real
     $ dudx3(1),dudy3(1),dudz3(1),
     $ dvdx3(1),dvdy3(1),dvdz3(1),
     $ dwdx3(1),dwdy3(1),dwdz3(1),
     $ norms(1),
     $ sdudx3(1),sdudy3(1),sdudz3(1),
     $ sdvdy3(1),sdvdz3(1),sdwdz3(1),
     $ uc(1),vc(1),wc(1),
     $ uuc(1),uvc(1),uwc(1),
     $ vvc(1),vwc(1),wwc(1)

#endif


C                                 ARRAYDIMENSIONIERUNG FUER DEN
C                                 GITTERGENERATOR  G R D F M I
C
#ifdef _NO_GRDFMI_
	  INTEGER IGRHF(IDIMF,1)
#else
      INTEGER IGRHF(IDIMF,NGRP1)
#endif
C
C
      REAL    GRX0(IDIMF),     GRX1(IDIMF)
#ifdef _NO_GRDFMI_
      REAL GRHF(IDIMF,100)
#else
      REAL GRHF(IDIMF,NGRP3)
#endif
C
C                                 FELDER FUER DEN DIREKTEN POISSONLOESER
C
      REAL
     $           FPSFAK(IDIM2D),FCOSMY(IDIM1D),FCOSNY(IDIM1D)
C
C                                 FELDER FUER DIE FOURIERTRANSFORMATION
C
      INTEGER IFFTX(19,MAXGRIDS),IFFTY(19,MAXGRIDS)
      INTEGER IPERMUX(IDIM1D)	     ,IPERMUY(IDIM1D)
      REAL    RFFTX(IDIM1D*2)     ,RFFTY(IDIM1D*2)  
C
C                                 DIE FOLGENDEN FELDER WERDEN ZUR
C                                 AUSWERTUNG FUER DIE LARGE-EDDY-
C                                 SIMULATION BENOETIGT
C
      INTEGER  ISELEA (2,752)      , ISELEP (2,752),
     $         ISAMPA (752,MAXGRIDS),ISAMPP (752,MAXGRIDS),
     $         ISLINP (ISLIDI)     , ISLINA (ISLIDI),
     $         ISLINI (ISLIDI)

#ifdef _POISSONDIR_
      REAL     HILF   (2* IDIM3D     ),    HILFL  (KKML,JJ2L,ILIMXP ),
#else
      REAL     HILF   (   IDIM3D     ),    HILFL  (KKML,JJ2L,ILIMXP ),
#endif
     $         FVT     (0:IDIMF),          HVK    (KLASS,JJ2L)

#ifdef _RUNGEKUTTA3_
      REAL       FELD1(IDIM3D),FELD2(IDIM3D),FELD3(IDIM3D)
#ifdef _TSCAL_
      REAL       FELDT(IDIM3D)
#endif     
#endif 

#ifdef _NEWSTAT_
      REAL       HILF3D1(IDIM3D),HILF3D2(IDIM3D),HILF3D3(IDIM3D)
#endif

#ifdef _HITACHI_
      COMPLEX*16    CXY(IDIM3D),CTB(IDIM1D),CWK(IDIM2D),CHILF(IDIM2D)
#endif

C-------------------------------- FELDER FUER DECONVOLVE SCA -TEST by FLORIAN 24.11.2003
#ifdef _DECONVOLVESCA_
      REAL     HILF3D4(IDIM3D),HILF3D5(IDIM3D),
     $         TFX(IDIM1D),TFY(IDIM1D)
#endif
C---------------------------------------------------------------------------------------


C                                 FUER DIE KONTROLLE DES RECHENVORGANGES
C
      REAL     EPSU(MAXGRIDS),  EPSV(MAXGRIDS),  EPSW(MAXGRIDS)
      REAL     ESUMG(MAXGRIDS),  ESUMS(MAXGRIDS)
      REAL     WSSX(MAXGRIDS),  WSSY(MAXGRIDS),  WSSZ(MAXGRIDS)
      REAL     WNSX(MAXGRIDS),  WNSY(MAXGRIDS),  WNSZ(MAXGRIDS)
      REAL     WALLSSX(6,MAXGRIDS),
     $         WALLSSY(6,MAXGRIDS),
     $         WALLSSZ(6,MAXGRIDS)
      REAL     UBULK(MAXGRIDS)
#ifdef _TSCAL_
      REAL     WALLQX(6,MAXGRIDS)
#endif

C
C
#if defined _STAT0_
#include  "stat0.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT1_
#include  "stat1.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT2_
#include  "stat2.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT3_
#include  "stat3.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT4_
#include  "stat4.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT5_
#include  "stat5.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT6_
#include  "stat6.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT7_
#include  "stat7.h"
#define _STATISTIK_LEVEL_DEFINED_

#elif defined _STAT8_
#include  "stat8.h"
#define _STATISTIK_LEVEL_DEFINED_
