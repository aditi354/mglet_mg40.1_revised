c     $x(ip1),y(ip1),z(ip1),dx(ip1),dy(ip1),dz(ip1),timeph
c     $,myid,ddx(ip1),ddy(ip1),ddz(ip1),1,numprocs)
c         CALL MPI_BARRIER(MPI_COMM_WORLD,IERR)
c      else
c         CALL MPI_BARRIER(MPI_COMM_WORLD,IERR)
c      end if
c
c#else
c      call solint (kk,jj,ii,u(ip3),v(ip3),w(ip3),p(ip3),BP(ip3),
c     $x(ip1),y(ip1),z(ip1),dx(ip1),dy(ip1),dz(ip1),timeph
c     $,myid,ddx(ip1),ddy(ip1),ddz(ip1),1,numprocs)
c#endif
c
