CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                     RAUSSCHREIBEN VON GESCHWINDIGKEITSRECORDS
C
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
         IF (LREC) THEN
         IF (MOD(ITTOT,ITREC).EQ.0) THEN
C
         DO IREC = 1,NVREC

         IGRID = NGREC(IREC)
#ifdef _MPI_
         IF (LSLICE(IGRID)) THEN
             WRITE (6,*)' WRITING RECORDS OUT OF SLICED GRIDS IS NOT'
             WRITE (6,*)' ALLOWED, IF MESSAGE-PASSING IS USED'
             WRITE (6,*)' PLEASE WRITE RECORDS OF THE SUB-GRIDS!'
             CALL ERRR (767,' MLET ')
         ENDIF

       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
         IF (LSLICE(IGRID)) 
     $       CALL COMPOSEGRD (U,V,W,P,G,B,HILF,IDIM3D,IGRID,NBND)

          CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

        WRITE(44,*)'AUFRUF VON DOBRST BEI ZEITSCHRITT',ITSTEP
        CALL DOBREC (NMREC,NVREC,ITREC,MAXREC,LREC,NTREC,
     +                    CIDREC,CIDRE2,
     +                    IVEREC,IVOREC,KANREC,KANGEO,
     +                    INXREC,INYREC,INZREC,
     +                    IARREC,JARREC,KARREC,
     +                    XREC,YREC,ZREC,
     +                    NPREC,
     +                    RTREC,TIMEPH,
     +                    U(IP3),V(IP3),W(IP3),P(IP3),
#ifdef _TSCAL_
     +                    T(IP3),
#endif
     +                    UFG(IP3),VFG(IP3),WFG(IP3),PFG(IP3),
     +                    AU(IP3),AV(IP3),AW(IP3),AP(IP3),
     +                    OX(IP3),OY(IP3),OZ(IP3),
     +                    OXFG(IP3),OYFG(IP3),OZFG(IP3),
     +                    HILF(IP3),H3D(IP3),
     +                    KK,JJ,II,
     +                    DX(IP1),DY(IP1),DZ(IP1),
     +                    DDX(IP1),DDY(IP1),DDZ(IP1),IREC)

         IF (LSLICE(IGRID)) 
     $       CALL SLICEGRD (U,V,W,P,G,B,HILF,IDIM3D,IGRID)

#ifdef _MPI_
       ENDIF
#endif
        ENDDO
