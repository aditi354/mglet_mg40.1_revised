     $       ,PRTMAX(IGRID),XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID)
     $       ,PRTMIN(IGRID),XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $       ,DDSMAX(IGRID),SMMAX(IGRID),SPMAX(IGRID),ISPMAX(IGRID),
     $        JSPMAX(IGRID),KSPMAX(IGRID),XSPMAX(IGRID),YSPMAX(IGRID),
