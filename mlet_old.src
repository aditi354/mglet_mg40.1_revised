CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C             SCHLEIFE 1010 UEBER ALLE TV ZUM ABPRUEFEN, OB SCHON
C             ALLE TV DEN ANSCHLAG ERREICHT HABEN

	  IREADY = 0

	  DO 1010 IREC=1,NVREC
        IF (NTREC(IREC).GE.MAXREC) IREADY = IREADY + 1
 1010     CONTINUE

	  IF (IREADY.EQ.NVREC) LREC=.FALSE.



        ENDIF
