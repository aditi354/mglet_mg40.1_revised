     $                 DDSMAX(IGRID),SMMAX(IGRID),SPMAX(IGRID),
     $                 ISPMAX(IGRID),JSPMAX(IGRID),KSPMAX(IGRID),
     $                 XSPMAX(IGRID),YSPMAX(IGRID),ZSPMAX(IGRID)     
      
#endif      
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,QCTE(IP3),QCTW(IP3),QCTN(IP3),QCTS(IP3),
     $                 QCTT(IP3),QCTB(IP3),QDTE(IP3),QDTW(IP3),
     $                 QDTN(IP3),QDTS(IP3),QDTT(IP3),QDTB(IP3),QDTC(IP3)
