!!!!     HERE WE CAN EXTRACT A PART OF THE SOLUTION AND INTERPOLATE ON ANOTHER GRID

c      DO ILEVEL = MINLEVEL,MAXLEVEL
c        DO I = 1,NOFTST(ILEVEL)
c           IGRID = IGRDOFTST(I,ILEVEL)
c#ifdef _MPI_
c       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
