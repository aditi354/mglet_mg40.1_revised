c
c Neue Statistik
c

#ifdef _NEWSTAT_
#if defined _STAT0_ || ! defined _STATISTIK_LEVEL_DEFINED_
c Include stat1.h
#include  "stat1.h"
#endif
#define _STATISTIK_LEVEL_DEFINED_
#endif

#ifdef _STAT11_
#include  "stat11.h"
c Included stat11.h
#endif

#ifdef _STAT12_
#include  "stat12.h"
c Included stat12.h
#endif

#ifdef _STAT13_
#include  "stat13.h"
c Included stat13.h
#endif

