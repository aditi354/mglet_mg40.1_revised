#endif       
#ifdef _SCALTRANSDIAGNOSE_  
     $       ,QCE(IGRID),QCW(IGRID),QCN(IGRID),QCS(IGRID),QCT(IGRID)
     $       ,QCB(IGRID),QDE(IGRID),QDW(IGRID),QDN(IGRID),QDS(IGRID)
     $       ,QDT(IGRID),QDB(IGRID),QDC(IGRID)              
