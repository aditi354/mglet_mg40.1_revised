        READ(57,*,END=1189) TSTOP
        CLOSE(57)
        CALL NEXTSCHEDSTOP(nxtstp)
        IF((GETSEC(0).GE.TSTOP).OR.(nxtstp(6).LE.45)) THEN
           WRITE(6,2301) TSTOP, GETSEC(0)
#else
C         OPEN(57,file='fort.57')
C         REWIND(57)
C         READ(57,*,END=1189) TSTOP
C        WRITE(6,*)TSTOP
         OPEN(57,file="fort.57")
         READ(57,*,iostat=IO57) TSTOP
         CLOSE(57)

#ifdef _LINUX_
         IF((GETSEC(0)-CPSEC .GE. TSTOP).AND.(IO57.EQ.0)) THEN
           WRITE(6,*) TSTOP, GETSEC(0)-CPSEC
#else
         IF(GETSEC(0) .GE. TSTOP) THEN
           WRITE(6,2301) TSTOP, GETSEC(0)
