     $           HILF(IP3),ESUMS(IGRID),IC1,IC2,JC1,JC2,KC1,KC2,
     $           NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,1,CONV1S(IP1))
#endif
               ENDIF 
CTBA4 070503
#ifdef _TSCAL_
               CALL DTMXCAL (KK,JJ,II,KK,JJ,II,X(IP1),Y(IP1),Z(IP1),
     $                   T(IP3),TO(IP3),B(IP3),DTMAX(IGRID),TMAX(IGRID),
     $                   ITMAX(IGRID),JTMAX(IGRID),KTMAX(IGRID),
     $                   XTMAX(IGRID),YTMAX(IGRID),ZTMAX(IGRID),IGRID,
     $                   IC1(IGRID),IC2(IGRID),
