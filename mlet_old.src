      IF(ITPRIN.GT.0) THEN
      IF(MOD(ITTOT,ITPRIN) .EQ. 0) THEN
        IPG = IPRGRID
        IP3 = IP3D(IPG)
        IP1 = IP1D(IPG)
      CALL PRLE3M (1,1,4,'J',KMX(IPG),JMX(IPG),IMX(IPG),
#ifdef _TSCAL_
     $             U(IP3),1,V(IP3),1,W(IP3),1,T(IP3),1,P(IP3),1,
