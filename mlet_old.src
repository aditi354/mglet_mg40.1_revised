 2301      FORMAT(1H1,10X,'TSTOP =',F10.2,'Processor time =',F10.2)

#if defined _MPI_ | defined _MPI_PARTICLES_
           ISTOP = 1
         ENDIF
         ENDIF
 1189    CONTINUE

         CALL MPI_BCAST(ISTOP,1,MPI_INTEGER,0,MPI_COMM_WORLD,IERR)
