            CALL ITINF (ITTOT,TIMEPH,IPCGES(IGRID),DIVGMX(IGRID),IGRID,
     $              CPSEC,MTURB,EPSU(IGRID),EPSV(IGRID),EPSW(IGRID),
     $                  ESUMG(IGRID),ESUMS(IGRID),
     $                 IPRINT_WSS,WSSX(IGRID),WSSY(IGRID),WSSZ(IGRID),
