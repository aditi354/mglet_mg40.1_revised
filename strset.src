      SUBROUTINE STRSET
     $ (IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,IDIMA,IDIM1L,IDIM2L,IDIMF,IIDENT,
     $  X,Y,Z,ISAMPA)
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C     27. 5.95 (MM) : ORIGINAL
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

#include "mgpar.h"
#include "costrles.h"
#include "comgrid.h"
#include "cogrdpro.h"
#include "cogrddef.h"
#include "cogrdold.h"
#include "cobodold.h"

C
      REAL X(IDIM1D), Y(IDIM1D), Z(IDIM1D)

      INTEGER ISAMPA (752,MAXGRIDS)
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                           CHECK THE GRID-PARAMETERS

      CALL STRCHECK (IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,
     $               IDIMA,IDIM1L,IDIM2L,IDIMF,IIDENT)

C
C                           GITTER FUER GEBIETSZERLEGUNG
C
      DO IGRID= 1,NGRDDFD

         IF (LSLICE(IGRID)) THEN

           CALL SETSLICE (IGRID,IDIM3D,IDIM2D,IDIM1D,
     $                    NBUF,NBND,IDIMA,IDIM1L,IDIM2L,IDIMF,X,Y,Z,
     $                    ISAMPA)

         ENDIF

      ENDDO

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                           SET THE IDENTIFICATION OF THE BOUNDARY-COND.

      DO IGRID= 1,NGRDSET

         CALL SETCOBOUND  (IGRID,IGRID)

      ENDDO

      DO IGRID=1,NGRDSET

         ITST = 0
         IF (LTST(IGRID)) THEN
            IF (.NOT.LSLICE(IGRID)) ITST=1
         ENDIF

         IVPIT = 0
         IF (LVP(IGRID)) THEN
            IF (.NOT.LSLICE(IGRID)) IVPIT=1
         ENDIF
         ISCAIT = 0
         IF (LSCAI(IGRID)) THEN
            IF (.NOT.LSLICE(IGRID)) ISCAIT=1
         ENDIF

         IF (     LSLICE(IGRID)) ISLCED=1
         IF (.NOT.LSLICE(IGRID)) ISLCED=0

         IPSDIR=0
         IF (LPOISSONDIR(IGRID)) THEN
             IPSDIR=1
             IVPIT =0
         ENDIF

         CALL SETCOLEVEL 
     $       (IGRID,LEVEL(IGRID),IVPIT,ITST,ISCAIT,ISLCED,0,IPSDIR)

      ENDDO

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                            SET THE PROCESSORS

      CALL SETMPI

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                            SET THE POINTER

      DO IGRID= 1,NGRDSET
      
            CALL SETCOMGRID (IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,
     $                       IDIMA,IDIM1L,IDIM2L,IDIMF,
     $                       IGRID,0,0,0,0)

      ENDDO

C

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                            

      RETURN
      END
