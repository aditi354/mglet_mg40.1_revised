      SUBROUTINE DIBCA1  (KANAL,MODUS,HILFL,KKML,ILIMX ,
#include "cstac1.h"
C*STARLET***************************************************************
C        D I B C A 1      EINLESEN VON FELDERN, DIE IM WESENTLICHEN
C                         ENSEMBLE-MITTELWERTE VON KORRELATIONSFUNKTIO-
C                         NEN, -KOEFFIZIENTEN, LEISTUNGSDICHTESPEKTREN
C                         UND HAEUFIGKEITSVERTEILUNGEN ENTHALTEN AUF
C                         KANAL 'KANAL'.
C        A C H T U N G    DIESES UNTERPROGRAMM MUSS ERWEITERT WERDEN,
C                         WENN DIE STATIST. AUSWERTUNG UMFANGREICHER
C                         WIRD !
C                         DIE NEU HINZUKOMMENDEN FELDER SIND GEMAESS
C                         DER ORDNUNG IM ISELEP-FELD EINZUREIHEN.
C*STARLET***************************************************************
C
C PARAM: KANAL                    - DIE DATEN WERDEN UEBER DIESEN KANAL
C                                   EINGELESEN
C        MODUS                    - CHARACTER-VARIABLE:
C                                   'BINAER  ' : DATEN WERDEN UNFORMA-
C                                                TIERT GESCHRIEBEN
C                                   'CODIERT ' : DATEN WERDEN FORMA-
C                                                TIERT GESCHRIEBEN
C        HILFL (KKML,JJ2L,ILIMXP) + HILFSFELD UM BEIM EINLESEN NICHT
C                                   BENOETIGTE FELDER ZU UEBERSPRINGEN
C        KKML                     - ARRAYDIMENSION (MAXIMALE ANZ. IN
C                                   K-RICHTUNG EINES "LINIEN-FELDES")
C        ILIMX                    - ANZAHL DER AUFPUNKTE + 1 DES MOMEN-
C                                   TANEN LAUFES
#include "cstap1.h"
C
C UPROG                 : DIBC
C
C DEFINE-DIREKTIVEN     : KEINE
C
C        09.12.88 (HW)  : ORIGINAL AUS DIBCA ABGELEITET
C
C*STARLET***************************************************************
C
      CHARACTER (LEN=8)   MODUS
      CHARACTER (LEN=80)  CT,  CH1680
C
      REAL           HILFL (KKML,JJ2L,ILIMXP)
#include "cstad1.h"
C
C                                 EINLESEN DER FELDER, DIE ENSEMBLE-
C                                 MITTELWERTE ENTHALTEN.
C
C                                 STATIST. GROESSEN DER U-KOMPONENTE
C                                 ----------------------------------
C
      IF(ISELEA(1, 14) .EQ. 1  .OR.  ISELEA(1, 14) .EQ. 2) THEN
         CT = CH1680 (' R_U"U"(X)      ')
C
C                                 DAS FELD WURDE IM VORANGEGANGENEN LAUF
C                                 AUSGEWERTET UND MUSS DAHER GELESEN
C                                 WERDEN
C
         IF(ISELEP(1, 14) .EQ. 1  .OR.  ISELEP(1, 14) .EQ. 2) THEN
C
C                                 DAS FELD WIRD AUCH WAEHREND DES MOMEN-
C                                 TANEN LAUFES BENOETIGT UND WIRD DAHER
C                                 IN DAS VORGESEHENE A-FELD EINGELESEN
C
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARXUU  ,CT)
         ELSE
C
C                                 DAS FELD WIRD WAEHREND DES MOMEN-
C                                 TANEN LAUFES NICHT BENOETIGT UND
C                                 WIRD DAHER IN DAS HILF -FELD GE-
C                                 LESEN (TAPE1 WIRD KORREKT POSITI-
C                                 ONIERT !)
C
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 16) .EQ. 1  .OR.  ISELEA(1, 16) .EQ. 2) THEN
         CT = CH1680 (' R_U"U"(Y)      ')
         IF(ISELEP(1, 16) .EQ. 1  .OR.  ISELEP(1, 16) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYUU  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 18) .EQ. 1  .OR.  ISELEA(1, 18) .EQ. 2) THEN
         CT = CH1680 (' R_U"U"(Z)      ')
         IF(ISELEP(1, 18) .EQ. 1  .OR.  ISELEP(1, 18) .EQ. 2) THEN
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARZUU  ,CT)
         ELSE
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 20) .EQ. 1  .OR.  ISELEA(1, 20) .EQ. 2) THEN
         CT = CH1680 (' S_U"U"(K_X)    ')
         IF(ISELEP(1, 20) .EQ. 1  .OR.  ISELEP(1, 20) .EQ. 2) THEN
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASXUU  ,CT)
         ELSE
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 22) .EQ. 1  .OR.  ISELEA(1, 22) .EQ. 2) THEN
         CT = CH1680 (' S_U"U"(K_Y)    ')
         IF(ISELEP(1, 22) .EQ. 1  .OR.  ISELEP(1, 22) .EQ. 2) THEN
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASYUU  ,CT)
         ELSE
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 24) .EQ. 1  .OR.  ISELEA(1, 24) .EQ. 2) THEN
         CT = CH1680 (' S_U"U"(K_Z)    ')
         IF(ISELEP(1, 24) .EQ. 1  .OR.  ISELEP(1, 24) .EQ. 2) THEN
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASZUU  ,CT)
         ELSE
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
C
C                                 STATIST. GROESSEN DER V-KOMPONENTE
C                                 ----------------------------------
C
      IF(ISELEA(1, 39) .EQ. 1  .OR.  ISELEA(1, 39) .EQ. 2) THEN
         CT = CH1680 (' R_V"V"(X)      ')
         IF(ISELEP(1, 39) .EQ. 1  .OR.  ISELEP(1, 39) .EQ. 2) THEN
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARXVV  ,CT)
         ELSE
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 41) .EQ. 1  .OR.  ISELEA(1, 41) .EQ. 2) THEN
         CT = CH1680 (' R_V"V"(Y)      ')
         IF(ISELEP(1, 41) .EQ. 1  .OR.  ISELEP(1, 41) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYVV  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 43) .EQ. 1  .OR.  ISELEA(1, 43) .EQ. 2) THEN
         CT = CH1680 (' R_V"V"(Z)      ')
         IF(ISELEP(1, 43) .EQ. 1  .OR.  ISELEP(1, 43) .EQ. 2) THEN
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARZVV  ,CT)
         ELSE
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 45) .EQ. 1  .OR.  ISELEA(1, 45) .EQ. 2) THEN
         CT = CH1680 (' S_V"V"(K_X)    ')
         IF(ISELEP(1, 45) .EQ. 1  .OR.  ISELEP(1, 45) .EQ. 2) THEN
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASXVV  ,CT)
         ELSE
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 47) .EQ. 1  .OR.  ISELEA(1, 47) .EQ. 2) THEN
         CT = CH1680 (' S_V"V"(K_Y)    ')
         IF(ISELEP(1, 47) .EQ. 1  .OR.  ISELEP(1, 47) .EQ. 2) THEN
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASYVV  ,CT)
         ELSE
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 49) .EQ. 1  .OR.  ISELEA(1, 49) .EQ. 2) THEN
         CT = CH1680 (' S_V"V"(K_Z)    ')
         IF(ISELEP(1, 49) .EQ. 1  .OR.  ISELEP(1, 49) .EQ. 2) THEN
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASZVV  ,CT)
         ELSE
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
C
C                                 STATIST. GROESSEN DER W-KOMPONENTE
C                                 ----------------------------------
C
      IF(ISELEA(1, 64) .EQ. 1  .OR.  ISELEA(1, 64) .EQ. 2) THEN
         CT = CH1680 (' R_W"W"(X)      ')
         IF(ISELEP(1, 64) .EQ. 1  .OR.  ISELEP(1, 64) .EQ. 2) THEN
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARXWW  ,CT)
         ELSE
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 66) .EQ. 1  .OR.  ISELEA(1, 66) .EQ. 2) THEN
         CT = CH1680 (' R_W"W"(Y)      ')
         IF(ISELEP(1, 66) .EQ. 1  .OR.  ISELEP(1, 66) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYWW  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 68) .EQ. 1  .OR.  ISELEA(1, 68) .EQ. 2) THEN
         CT = CH1680 (' R_W"W"(Z)      ')
         IF(ISELEP(1, 68) .EQ. 1  .OR.  ISELEP(1, 68) .EQ. 2) THEN
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARZWW  ,CT)
         ELSE
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 70) .EQ. 1  .OR.  ISELEA(1, 70) .EQ. 2) THEN
         CT = CH1680 (' S_W"W"(K_X)    ')
         IF(ISELEP(1, 70) .EQ. 1  .OR.  ISELEP(1, 70) .EQ. 2) THEN
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASXWW  ,CT)
         ELSE
            CALL DIBC   (KSXL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 72) .EQ. 1  .OR.  ISELEA(1, 72) .EQ. 2) THEN
         CT = CH1680 (' S_W"W"(K_Y)    ')
         IF(ISELEP(1, 72) .EQ. 1  .OR.  ISELEP(1, 72) .EQ. 2) THEN
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASYWW  ,CT)
         ELSE
            CALL DIBC   (KSYL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1, 74) .EQ. 1  .OR.  ISELEA(1, 74) .EQ. 2) THEN
         CT = CH1680 (' S_W"W"(K_Z)    ')
         IF(ISELEP(1, 74) .EQ. 1  .OR.  ISELEP(1, 74) .EQ. 2) THEN
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ASZWW  ,CT)
         ELSE
            CALL DIBC   (KSZL,JJ1L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
C
C                                  HIER: KREUZKORRELATIONSFUNKTIONEN
C                                  ---------------------------------
C
      IF(ISELEA(1,210) .EQ. 1  .OR.  ISELEA(1,210) .EQ. 2) THEN
         CT = CH1680 (' R_U"V"(X)      ')
         IF(ISELEP(1,210) .EQ. 1  .OR.  ISELEP(1,210) .EQ. 2) THEN
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARXUV  ,CT)
         ELSE
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1,212) .EQ. 1  .OR.  ISELEA(1,212) .EQ. 2) THEN
         CT = CH1680 (' R_U"V"(Y)      ')
         IF(ISELEP(1,212) .EQ. 1  .OR.  ISELEP(1,212) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYUV  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1,216) .EQ. 1  .OR.  ISELEA(1,216) .EQ. 2) THEN
         CT = CH1680 (' R_U"W"(X)      ')
         IF(ISELEP(1,216) .EQ. 1  .OR.  ISELEP(1,216) .EQ. 2) THEN
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARXUW  ,CT)
         ELSE
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1,218) .EQ. 1  .OR.  ISELEA(1,218) .EQ. 2) THEN
         CT = CH1680 (' R_U"W"(Y)      ')
         IF(ISELEP(1,218) .EQ. 1  .OR.  ISELEP(1,218) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYUW  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1,224) .EQ. 1  .OR.  ISELEA(1,224) .EQ. 2) THEN
         CT = CH1680 (' R_V"W"(Y)      ')
         IF(ISELEP(1,224) .EQ. 1  .OR.  ISELEP(1,224) .EQ. 2) THEN
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ARYVW  ,CT)
         ELSE
            CALL DIBC   (KKYL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
C
C                                  HIER: KORRELATIONSKOEFFIZIENTEN
C                                  -------------------------------
C
      IF(ISELEA(1,234) .EQ. 1  .OR.  ISELEA(1,234) .EQ. 2) THEN
         CT = CH1680 (' RC_U"W"(X)     ')
         IF(ISELEP(1,234) .EQ. 1  .OR.  ISELEP(1,234) .EQ. 2) THEN
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ACXUW  ,CT)
         ELSE
            CALL DIBC   (KKXL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
      IF(ISELEA(1,238) .EQ. 1  .OR.  ISELEA(1,238) .EQ. 2) THEN
         CT = CH1680 (' RC_U"W"(Z)     ')
         IF(ISELEP(1,238) .EQ. 1  .OR.  ISELEP(1,238) .EQ. 2) THEN
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   ACZUW  ,CT)
         ELSE
            CALL DIBC   (KKZL,JJ2L,ILIMXP,KSTAG,JSTAG,ISTAG,KANAL,MODUS,
     $                   ZSLM,ZELM,YSLM,YELM,XSLM,XELM,TSEM,TEEM,DTEM,
     $                   HILFL  ,CT)
         ENDIF
      ENDIF
C
C                                  OBERE DREIECKSMATRIX DES TENSORS
C                                  DER KORRELATIONSFUNKTIONEN DER
C                                  FLUKTUATIONEN DER VORTICITY
C                                  --------------------------------
C
