	SUBROUTINE READ_PARTICLES (CHANNEL, NPART, NFAM, CONF, XPART)
C----------------------------------------------------------
C
C	READS POSITION AND ORIENTATION OF PARTICLES
C
C	1. 8. 1999 (MM): ORIGINAL
C
C----------------------------------------------------------

	INTEGER CHANNEL, NPART, NFAM
        REAL CONF( NFAM, NPART, 3), XPART( NFAM, 3)
C
#ifdef _MPI_PARTICLES_
#include "mpif.h"
      INTEGER ISTATUS(MPI_STATUS_SIZE)

C
      CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
      CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
C
      write (6,*)
      write (6,*) 'read_particles: nfam, npart,numprocs:',
     $                             nfam, npart,numprocs
      write (6,*)
      write (6,*)
      write (6,*)
      write (6,*)
      DO IPROC = NUMPROCS-1,0,-1
C
      IF (MYID .EQ. 0) THEN
#endif

           READ (CHANNEL, ERR=2000) CONF
           READ (CHANNEL, ERR=2000) XPART

        write (6,*) 'READ_PARTICLES',nfam,npart
        write (6,*) 'READ_PARTICLES',conf(1,1,1),conf(1,1,2),conf(1,1,3)
        write (6,*) 'READ_PARTICLES',xpart(1,1),xpart(1,2),xpart(1,3)
#ifdef _MPI_PARTICLES_

        IF (IPROC .NE. 0) THEN
      
        CALL MPI_SEND (CONF, NFAM*NPART*3, 
     $ MPI_DOUBLE_PRECISION, 
     $                 IPROC, IPROC, MPI_COMM_WORLD, IERR)	 
        CALL MPI_SEND (XPART, NFAM*3, 
     $ MPI_DOUBLE_PRECISION, 
     $                 IPROC, IPROC, MPI_COMM_WORLD, IERR)	 

        ENDIF

       ELSE

        IF (MYID .EQ. IPROC ) THEN
               CALL MPI_RECV  (CONF, NFAM*NPART*3, 
     $ MPI_DOUBLE_PRECISION, 
     $                 0, IPROC, MPI_COMM_WORLD, ISTATUS, IERR)
               CALL MPI_RECV  (XPART, NFAM*3, 
     $ MPI_DOUBLE_PRECISION, 
     $                 0, IPROC, MPI_COMM_WORLD, ISTATUS, IERR)

	ENDIF
       ENDIF

      ENDDO

#endif

	RETURN

 1000	FORMAT (I8, 6(1X,E12.5E3))

 2000	CALL ERRR (501,' READ_PART')

	END
