      SUBROUTINE INTERCOEF3(II,I,DX,DDX,LCOL,DIAG,RCOL,
     $                      RSIDE1,RSIDE2,RSIDE3)         
C*MGLET*****************************************************************
C              I N T E R C O E F 3
C*MGLET*****************************************************************
C
C     BERECHNUNG DER KOEFFIZIENTEN FUER DIE KOMPAKTE BERECHNUNG
C     DER     E R S T E N     A B L E I T U N G 
C             V I E R T E R   O R D N U N G ! !
C
C     DIESER ANSATZ ENTHAELT  D R E I  UNBEKANNTE AUF DER RECHTEN
C     SEITE (Modifizierter Ansatz nach A D A M )
C
C   ! ACHTUNG : DIESE FORMULIERUNG IST NUR FUER M G L E T                
C   !           (GESTAEGERT -------> NICHTGESTAEGERT)
C
C*MGLET*****************************************************************
C
C
C DEFINE DIREKTIVEN     : KEINE
C
C UPROG                 : KEINE
C
C 03.10.1996            : ADNAN MERI (ORIGINAL)
C
C*MGLET*****************************************************************
C
      IMPLICIT NONE
      REAL LCOL,RCOL,DIAG,RSIDE1, RSIDE2,RSIDE3,ALFA,BETA,
     $     GAMA,LAMDA,PHI,
     $     s,k,a,b,c,d,e,f,g,p,h,q,l,m,n

      INTEGER I,II
      REAL DX(II),DDX(II)


#if !defined _6TH_KOBAYASHI_ 
#if !defined _4TH_KOBAYASHI_

      s = (DX(I)/DX(I-1))
      k = (DX(I-1)/DDX(I))
      
      a = s + 1.0
      c = s**2 - 1.0           
      e = s**3 + 1.0    
      b = - k * s * ((1./8.)*s +0.5)
      d = - k * s * ((1./24.)*s**2 - 0.5)
      f = - k * s * ((1./64.)*s**3 + 0.5)

      g = a*d - b*c 
      p = a*f - b*e                   
      h = -(3./8.)*k*c - (11./24.)*k*a	
      q = -(3./8.)*k*e + (31./64.)*k*a	

      PHI  = ((e-a)*g -(c+a)*p)/(q*g-p*h)
      GAMA = (c+a -h*PHI)/(a*d -b*c) 
      LAMDA= -GAMA - PHI
      BETA = (-1.0 -(3./8.)*k*PHI -b*GAMA)/a
      ALFA = -1.0 -BETA -0.5*k*(PHI - s*GAMA)

c
c
c*************BILDUNG DER MATRIX************************************
c
      LCOL=ALFA
      DIAG=1.0
      RCOL=BETA
      RSIDE1=GAMA
      RSIDE2=LAMDA
      RSIDE3=PHI
c 
c*******************************************************************
c 

#else


C----------Treat the interpolated value as 4th order accurate
	a = -DX(I-1)
	b = DX(I)
	l = 5.0*(a-b)**3.0
	m = a*a
	n = b*b
	
	LCOL   = (b*(3.0*m-7.0*n))/l
	DIAG   = 1.0
	RCOL   = (a*(7.0*m-3.0*n))/l
	RSIDE1 = 12.0*b*(a+2.0*b)*(3.0*a-b)/(l*a)
	RSIDE3 = ( 2.0*(1.0+LCOL+RCOL)-a*RSIDE1)/b
	RSIDE2 = -(RSIDE1+RSIDE3)
	
       
C----------Treat the interpolated value as exact
C	LCOL   = b**2*(3*a-4*b)/(8*a**2-19*a*b+8*b**2)/(-b+a)
C	DIAG   =  1.0
C	RCOL   = a**2*(4*a-3*b)/(8*a**2-19*a*b+8*b**2)/(-b+a)
C	RSIDE1 = 12*(5*a-2*b)*b**2/(8*a**2-19*a*b+8*b**2)/(-b+a)/a
C      RSIDE3 = 12*a**2*(-5*b+2*a)/b/(-8*b**3+27*b**2*a+8*a**3-27*a**2*b)
C      RSIDE2 = -12/a*(2*a**3-3*a**2*b-3*b**2*a+2*b**3)/(8*a**2-19*a*b+8*
C     &          b**2)/b

C--------Use 3rd order omitting the use of the interpolated value


C        l      = a**3-b**3-4.0*a**2*b+4.0*b**2*a
	
C	LCOL   = -b*(a**2-a*b-b**2)/l
C	DIAG   = 1.0
C	RCOL   = -(a**2+a*b-b**2)*a/l
C	RSIDE1 = -12.0*a*b/l
C	RSIDE3 = 12.0*a*b/l
C	RSIDE2 = 0.0















#endif
#endif



      RETURN
      END

