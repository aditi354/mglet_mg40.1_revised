       DOUBLE PRECISION WT1,WT2,MT1,MT2

#endif
C
C
C
      REAL        RDDX(IDIM1D),     RDDY(IDIM1D),     RDDZ(IDIM1D),
     $             RDX(IDIM1D),      RDY(IDIM1D),      RDZ(IDIM1D),
     $             DDX(IDIM1D),      DDY(IDIM1D),      DDZ(IDIM1D),
     $              DX(IDIM1D),       DY(IDIM1D),       DZ(IDIM1D),
     $               X(IDIM1D),        Y(IDIM1D),        Z(IDIM1D)

      REAL      CONV1S(IDIM1D)

#ifdef _TAU_NN_
C                             NICHT-NEWTONSCHER SPANNUNGSTENSOR
      REAL    TAU11( IDIM3D ), TAU12( IDIM3D ), TAU13( IDIM3D ),
     $        TAU21( IDIM3D ), TAU22( IDIM3D ), TAU23( IDIM3D ),
     $        TAU31( IDIM3D ), TAU32( IDIM3D ), TAU33( IDIM3D )
#else
      REAL    TAU11( 1 ), TAU12( 1 ), TAU13( 1 ),
     $        TAU21( 1 ), TAU22( 1 ), TAU23( 1 ),
     $        TAU31( 1 ), TAU32( 1 ), TAU33( 1 )
#endif

#ifdef _LPART_ORIENTATION_
#include "copart.h"
#endif
c#ifdef _PASSIVE_PARTICLE_
c#include "copart2.h"
c#endif

#if defined _FASTBUTBIGMEM_ | defined _POISSONITER_
      REAL        GEOVP(IDIM3D)
#endif

      REAL        U (   IDIM3D  ), V (   IDIM3D  ), W (   IDIM3D  ),
     $            UO(   IDIM3D  ), VO(   IDIM3D  ), WO(   IDIM3D  ),
     $            P (   IDIM3D  ), DP(   IDIM3D  ), G (   IDIM3D  ),
     $            B (   IDIM3D  ),
     $            H3D1(   IDIM3D ),H3D2(   IDIM3D  ), H3D3(   IDIM3D  ),
     $           WCU(  IDIM3D   ),WCV(   IDIM3D  ),WCW(   IDIM3D  )

#ifdef _TSCAL_
      REAL        T (   IDIM3D  ), TO (   IDIM3D  ), TOLD (   IDIM3D  ),
     $            TFR(IDIM2D*2),TBA(IDIM2D*2),TBO(IDIM2D*2),AT(IDIMA),
     $            WCT( IDIM3D ),
     $            BT(   IDIM3D  ),PRTMAX(MAXGRIDS),PRTMIN(MAXGRIDS),
     $            XPRTMAX(MAXGRIDS),YPRTMAX(MAXGRIDS),ZPRTMAX(MAXGRIDS),
     $            XPRTMIN(MAXGRIDS),YPRTMIN(MAXGRIDS),ZPRTMIN(MAXGRIDS)
#ifdef _SCALGRIDDIAGNOSE_
      REAL        DDSPLUS( IDIM3D ),SMPLUS( IDIM3D ),SPLUS( IDIM3D )
#endif            
#ifdef _SCALTRANSDIAGNOSE_
      REAL QCTE( IDIM3D ),QCTW( IDIM3D ),QCTN( IDIM3D ),
     $     QCTS( IDIM3D ),QCTT( IDIM3D ),QCTB( IDIM3D ),
     $     QDTE( IDIM3D ),QDTW( IDIM3D ),QDTN( IDIM3D ),
     $     QDTS( IDIM3D ),QDTT( IDIM3D ),QDTB( IDIM3D ),QDTC( IDIM3D ) 
      REAL FCTE( IDIM3D ),FCTW( IDIM3D ),FCTN( IDIM3D ),               
     $     FCTS( IDIM3D ),FCTT( IDIM3D ),FCTB( IDIM3D ),               
     $     FDTE( IDIM3D ),FDTW( IDIM3D ),FDTN( IDIM3D ),
     $     FDTS( IDIM3D ),FDTT( IDIM3D ),FDTB( IDIM3D ),FDTC( IDIM3D ) 
      REAL OCTE( IDIM3D ),OCTW( IDIM3D ),OCTN( IDIM3D ),               
     $     OCTS( IDIM3D ),OCTT( IDIM3D ),OCTB( IDIM3D ),               
     $     ODTE( IDIM3D ),ODTW( IDIM3D ),ODTN( IDIM3D ),               
     $     ODTS( IDIM3D ),ODTT( IDIM3D ),ODTB( IDIM3D ),ODTC( IDIM3D )
#endif
#ifdef _DECONVOLVESCA_
      REAL HILF3D4(IDIM3D),HILF3D5(IDIM3D),TFX(IDIM1D),TFY(IDIM1D)
#endif 
#endif
#ifdef _STAT1_
      REAL      AU  (   IDIMA   ),AV (   IDIMA   ),AW (   IDIMA   )
#else
      REAL      AU (1), AV(1), AW(1)
#endif

      REAL        UI1(IDIM2D*2),  VI1(IDIM2D*2),  WI1(IDIM2D*2),
     $            UI2(IDIM2D*2),  VI2(IDIM2D*2),  WI2(IDIM2D*2),
     $            GI1(IDIM2D),    GI2(IDIM2D),
     $            UFR(IDIM2D*2), VFR(IDIM2D*2), WFR(IDIM2D*2),
     $            PFR(IDIM2D*2), GFR(IDIM2D*2),
     $            UBACK(IDIM2D*2),  VBACK(IDIM2D*2),  WBACK(IDIM2D*2),
     $            VRI(IDIM2D*2),  
     $            UBO(IDIM2D*2),VBO(IDIM2D*2),WBO(IDIM2D*2),
     $            PBO(IDIM2D*2),GBO(IDIM2D*2),
     $            UBA(IDIM2D*2), VBA(IDIM2D*2), WBA(IDIM2D*2),
     $            BP(   IDIM3D  ),BU(   IDIM3D  ), 
     $            BV(   IDIM3D  ), BW(   IDIM3D), SDIV(   IDIM3D  )
          
C                                 FELDER FUER DEN DIREKTEN POISSONLOESER
C
      REAL
     $           FPSFAK(IDIM2D),FCOSMY(IDIM1D),FCOSNY(IDIM1D)
C
c                                 MATRIX FUER ITERATIVE VERFAHREN
#ifdef _POISSONITER_
      REAL GSAB( IDIM1D ), GSAT( IDIM1D ), GSAW( IDIM1D ),
     $     GSAE( IDIM1D ), GSAS( IDIM1D ), GSAN( IDIM1D )
#ifdef _SIP_ITER_
      REAL RES  ( IDIM3D ), SIPLB ( IDIM3D ), SIPUT( IDIM3D ),
     $     SIPLW( IDIM3D ), SIPUE ( IDIM3D ), SIPLS( IDIM3D ),
     $     SIPUN( IDIM3D ), SIPLPR( IDIM3D )
#else
      REAL RES(1)
      REAL GSRAP( IDIM3D )
#endif
#endif
C                             FELDER FUER KOEFFIZENTEN DES KOMPAKTVER.

#if  defined _KOMXK_  | defined _KOMYK_ | defined _KOMZK_

#ifndef _FRED_BODY_

      REAL COEFFX(IDIM2D), COEFFY(IDIM2D), COEFFZ(IDIM2D),
     &     COEFDX(IDIM2D), COEFDY(IDIM2D), COEFDZ(IDIM2D),
     &     FAKTOR(IDIM1D), LCOL  (IDIM1D), DIAG  (IDIM1D),
     &     RCOL  (IDIM1D), UZ    (IDIM1D), RSP   (IDIM1D),
     &     RSGS3 (IDIM3D)
#ifdef _TSCAL_
      REAL COEFTX(IDIM2D),COEFTY(IDIM2D),COEFTZ(IDIM2D)
#endif
#else

      REAL COEFFX(IDIM1D*12*3),COEFFY(IDIM1D*12*3),
     $     COEFFZ(IDIM1D*12*3),COEFDX(IDIM1D*12*3),
     $     COEFDY(IDIM1D*12*3),COEFDZ(IDIM1D*12*3),
     &     FAKTOR(IDIM3D), LCOL  (IDIM1D), DIAG  (IDIM1D),
     &     RCOL  (IDIM1D), UZ    (IDIM1D), RSP   (IDIM1D),
     &     RSGS3 (IDIM3D)
#ifdef _TSCAL_
      REAL COEFTX(IDIM1D*12*3),COEFTY(IDIM1D*12*3),COEFTZ(IDIM1D*12*3)
#endif
#endif

#else
      REAL COEFFX(1),     COEFFY(1),     COEFFZ(1),
     &     COEFDX(1),     COEFDY(1),     COEFDZ(1),
     &     LCOL  (1),     DIAG  (1),     RCOL(1),
     &     FAKTOR(1),     UZ    (1),     RSP (1),
     &     RSGS3 (1)
#ifdef _TSCAL_
      REAL COEFTX(1),COEFTY(1),COEFTZ(1)
#endif
#endif



#if defined _KOMXK_ | defined _KOMXK6O_ | defined _KOMXK8O_ | defined _PREPROC_
      REAL FUI(IDIM3D),FVI(IDIM3D),FWI(IDIM3D)
#if defined _TSCAL_ | defined _PREPROC_
      REAL FTI(IDIM3D)
#endif
#else
      REAL  FUI(1),FVI(1),FWI(1)
#ifdef _TSCAL_
      REAL FTI(1)
#endif
#endif
#if defined _KOMYK_ | defined _KOMYK6O_  | defined _KOMYK8O_ | \
    defined _ZEN4O_ | defined _PREPROC_
      REAL FUJ(IDIM3D),FVJ(IDIM3D),FWJ(IDIM3D)
#if defined _TSCAL_ | defined _PREPROC_
      REAL FTJ(IDIM3D)
#endif
#else
      REAL FUJ(1),FVJ(1),FWJ(1)
#ifdef _TSCAL_
      REAL FTJ(1)
#endif
#endif
#if defined _KOMZK_ | defined _PREPROC_
      REAL FUK(IDIM3D),FVK(IDIM3D),FWK(IDIM3D)
#if defined _TSCAL_ | defined _PREPROC_
      REAL FTK(IDIM3D)
#endif
#else
      REAL FUK(1),FVK(1),FWK(1)
#ifdef _TSCAL_
      REAL FTK(1)
#endif
#endif
C#if defined _PREPROC_
C      REAL HPX(IDIM3D)
C#endif
C
C
C                                 FELDER FUER DIE FOURIERTRANSFORMATION
C
      INTEGER IFFTX(19,MAXGRIDS),IFFTY(19,MAXGRIDS)
      INTEGER IPERMUX(IDIM1D)	     ,IPERMUY(IDIM1D)
      REAL    RFFTX(IDIM1D*2)     ,RFFTY(IDIM1D*2)
C
C
      REAL     HILF( IDIM3D ), DIV( IDIM3D ),DIVG(IDIM2D)
C
C
C                                 FUER DIE KONTROLLE DES RECHENVORGANGES
C
      REAL     EPSU(MAXGRIDS),  EPSV(MAXGRIDS),  EPSW(MAXGRIDS)
C
C
C                                 HILFSFELDER FUER EFVISC
C
      REAL        DUDY(IDIM2D),  DUDZ(IDIM2D),
     $            DVDX(IDIM2D),  DVDZ(IDIM2D),
     $            DWDX(IDIM2D),  DWDY(IDIM2D)
C
#ifdef _DYNSGSM_

      real  cdelta(IDIM1D)
                           
      real
     $  hilf0(IDIM2D),hilf1(IDIM2D),hilf2(IDIM2D),
     $  hilf3(IDIM2D),hilf4(IDIM2D),hilf5(IDIM2D),
     $  hilf6(IDIM2D),
     $  lux(IDIM2D),luy(IDIM2D),luz(IDIM2D),
     $  lvy(IDIM2D),lvz(IDIM2D),lwz(IDIM2D),
     $  mux(IDIM2D),muy(IDIM2D),muz(IDIM2D),
     $  mvy(IDIM2D),mvz(IDIM2D),mwz(IDIM2D),
     $  fa11(IDIM2D),fa12(IDIM2D),fa13(IDIM2D),
     $  fa21(IDIM2D),fa22(IDIM2D),fa23(IDIM2D),
     $  fa31(IDIM2D),fa32(IDIM2D),fa33(IDIM2D)

      real 
     $ dudx3(IDIM2D*3),dudy3(IDIM2D*3),dudz3(IDIM2D*3),
     $ dvdx3(IDIM2D*3),dvdy3(IDIM2D*3),dvdz3(IDIM2D*3),
     $ dwdx3(IDIM2D*3),dwdy3(IDIM2D*3),dwdz3(IDIM2D*3),
     $ norms(IDIM2D*3),
     $ sdudx3(IDIM2D*3),sdudy3(IDIM2D*3),sdudz3(IDIM2D*3),
     $ sdvdy3(IDIM2D*3),sdvdz3(IDIM2D*3),sdwdz3(IDIM2D*3),
     $ uc(IDIM2D*3),vc(IDIM2D*3),wc(IDIM2D*3),
     $ uuc(IDIM2D*3),uvc(IDIM2D*3),uwc(IDIM2D*3),
     $ vvc(IDIM2D*3),vwc(IDIM2D*3),wwc(IDIM2D*3)
#else

      real  cdelta(1)

      real
     $  hilf0(1),hilf1(1),hilf2(1),
     $  hilf3(1),hilf4(1),hilf5(1),
     $  hilf6(1),
     $  lux(1),luy(1),luz(1),
     $  lvy(1),lvz(1),lwz(1),
     $  mux(1),muy(1),muz(1),
     $  mvy(1),mvz(1),mwz(1),
     $  fa11(1),fa12(1),fa13(1),
     $  fa21(1),fa22(1),fa23(1),
     $  fa31(1),fa32(1),fa33(1)

      real
     $ dudx3(1),dudy3(1),dudz3(1),
     $ dvdx3(1),dvdy3(1),dvdz3(1),
     $ dwdx3(1),dwdy3(1),dwdz3(1),
     $ norms(1),
     $ sdudx3(1),sdudy3(1),sdudz3(1),
     $ sdvdy3(1),sdvdz3(1),sdwdz3(1),
     $ uc(1),vc(1),wc(1),
     $ uuc(1),uvc(1),uwc(1),
     $ vvc(1),vwc(1),wwc(1)

#endif

CTBC  ATTENTION: CHANGED ACCORDING TO SE/FS
#ifdef _IRIS_
      CHARACTER (LEN=8) CIDEND(10)
#else
      CHARACTER (LEN=8) CIDEND(10)
#endif
C      CHARACTER (LEN=8)      CIDEND(10)

      INTEGER          IIDEND(100)
      REAL             RIDEND(100)

CCCCCCCCCC Gewichtungsfaktoren Runge Kutta
CC    Low-Storage: FELD1,.. und UO,VO,.. werden als
CC    Hilfsfelder verwendet

      REAL             M0, M01, M1, M2, TIMERK, DTHELP
      REAL       FELD1(IDIM3D),FELD2(IDIM3D),FELD3(IDIM3D)
#ifdef _TSCAL_
      REAL       FELDT(IDIM3D)
#endif

C
      DATA       KANPR               /  8  /

      DTHELP = DT
#ifdef _MPI_
C
C                 MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C                 
C     CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
C     CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
#endif

C                          RUNGE KUTTA ZEITSCHRITT UEBER ALLE GITTER
C
C
#ifdef _MPI_WRITE_TIMES_
       WT1 = MPI_WTIME()
       MT1 = FLOAT(MCLOCK())/100.
#endif 
C---------------------------- TRANPORT OF PARTICLE-ORIENTATIONS...
#ifdef _LPART_ORIENTATION_
       CALL MGTSTPART (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                U,V,W,P,G,B,DP,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
     $                TIMEPH,ITSTEP,ITTOT,
     $                TAU11,TAU12,TAU13,
     $                TAU21,TAU22,TAU23,
     $                TAU31,TAU32,TAU33)
#endif
#ifdef _PASSIVE_PARTICLE_
        CALL PASSPART (IDIM3D,IDIM2D,IDIM1D,IDIMA,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                U,V,W,P,G,B,DP,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
#ifdef _STAT1_
     $        AU,AV,AW,
     $        FELD1,FELD2,FELD3,
#endif
#ifdef _TSCAL_
     $         T,
#endif
#ifdef _FRED_BODY_
     $         BP,
#endif         
     $                TIMEPH,ITSTEP,ITTOT)
#endif
C---------------------------- END OF TRANPORT OF PARTICLE-ORIENTATIONS...
C
C                                 **************************************
C                                             ZEITSCHRITT
C                                 **************************************
C
#ifndef _DNS_

      IF (MTURB .EQ. 1) THEN

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif      
     $              VFR,WFR,PFR,GFR, 
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

C
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             ) 
#ifdef _MPI_
       ENDIF
#endif         
        ENDDO
      ENDDO
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

C
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
           CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C                                 GEWAEHRLEISTET SICHERES MIGRIEREN DER
C                                 RANDWERTE AUF NACHBARGITTER
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
C                                 BESTIMMUNG DES G-FELDES (INCL. R.B.)
#ifdef _DYNSGSM_
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))
#else	
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))     
#endif
#else
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))
#else
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))

#endif	
#endif
C
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO


CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           

C                                 SETZEN DER RANDBEDINGUNGEN
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO

      ENDIF

#endif

CCCCCCCCCCCCCCCCCCC ende #ifndef DNS

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN      	
#endif
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

C
C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
#ifdef _TAU_NN_
         CALL TAUNN(KK, JJ, II,
     $        X(IP1),Y(IP1),Z(IP1),
     $        DX(IP1),DY(IP1),DZ(IP1),
     $        DDX(IP1),DDY(IP1),DDZ(IP1),
     $        RDX(IP1),RDY(IP1),RDZ(IP1),
     $        RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $        U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $        DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $        DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $        TAU11(IP3),TAU12(IP3),TAU13(IP3),
     $        TAU21(IP3),TAU22(IP3),TAU23(IP3),
     $        TAU31(IP3),TAU32(IP3),TAU33(IP3))
#endif
C
C
CTBC               PRESET ALL FIELDS BY ZERO
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,UO(IP3)) 
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,VO(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,WO(IP3))
#ifdef _TSCAL_
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,TO(IP3))
#ifdef _SCALTRANSDIAGNOSE_
CTBC  INITIALIZE FIELDS FOR SCALAR CONVECTION AND DIFFUSION TERMS
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QCTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,QDTC(IP3)) 
                   
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FCTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FDTC(IP3)) 
                   
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTE(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTW(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTN(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTS(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTT(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTB(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTC(IP3))        
#endif
#endif                   
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD1(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD2(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD3(IP3))
#ifdef _TSCAL_
CTBC               STORE T IN TOLD FOR LATER DTMX CALCULATION
                   CALL COP3D(KK,JJ,II,T(IP3),TOLD(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELDT(IP3))
#endif
                   IDUZ = 2

                   CALL WIFAK  (ITSTEP,ITMIT,WPHI,WKON,WDIF,WSOR,IDUZ)
                   CALL TSTLE4 (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                           U(IP3), V(IP3), W(IP3),
     $                          UO(IP3),VO(IP3),WO(IP3),
     $                          WCU(IP3),WCV(IP3),WCW(IP3),
     $                          P(IP3),G(IP3),B(IP3),
#ifdef _FRED_BODY_
     $                          BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                          DT,
     $                          GRADPX(IGRID),ZTOT,NBUF,ITSTEP,
     $                          WPHI,WKON,WDIF,WSOR,IDUZ,
     $                          IC1(IGRID),IC2(IGRID),
     $                          JC1(IGRID),JC2(IGRID),
     $                          KC1(IGRID),KC2(IGRID),
     $                          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                       RSGS3(IP3),
#ifdef _FRED_BODY_
     $                       FAKTOR(IP3),
#else
     $                       FAKTOR(IP1),
#endif
     $                       FUI(IP3),FVI(IP3),FWI(IP3),
     $                       FUJ(IP3),FVJ(IP3),FWJ(IP3),
     $                       FUK(IP3),FVK(IP3),FWK(IP3),
#ifndef _FRED_BODY_
     $                       COEFFX(IP2),COEFFY(IP2),COEFFZ(IP2),
     $                       COEFDX(IP2),COEFDY(IP2),COEFDZ(IP2),
#else
     $                       COEFFX(CIP1),COEFFY(CIP1),
     $                       COEFFZ(CIP1),COEFDX(CIP1),
     $                       COEFDY(CIP1),COEFDZ(CIP1),
#endif
     $                       LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                       UZ(IP1),RSP(IP1),
     $                       H3D1(IP3),H3D2(IP3),H3D3(IP3)
#ifdef _TAU_NN_
     $        ,TAU11(IP3),TAU12(IP3),TAU13(IP3)
     $        ,TAU21(IP3),TAU22(IP3),TAU23(IP3)
     $        ,TAU31(IP3),TAU32(IP3),TAU33(IP3)
#endif
C#if defined _PREPROC_
C     $        ,HPX(IP3)
C#endif
     $                       )

#ifdef _TSCAL_
CTBC        STORE OLD U,V,W IN FELD1,FELD2,FELD3 FOR 
CTBC        FIRST SCALAR RUNGE KUTTA TIME STEP
            CALL COP3D(KK,JJ,II,U(IP3),FELD1(IP3)) 
            CALL COP3D(KK,JJ,II,V(IP3),FELD2(IP3))
            CALL COP3D(KK,JJ,II,W(IP3),FELD3(IP3)) 
#endif

            M0 = 0.0
            M01 = 1.0
            M1 = (1.0/3.0)*DT
CTBC        ADD M01*U,V,W + M1*UO,VO,WO TO U,V,W
            CALL PHIADD (KK,JJ,II,U(IP3),UO(IP3),U(IP3),M0,M01,M1)
            CALL PHIADD (KK,JJ,II,V(IP3),VO(IP3),V(IP3),M0,M01,M1)
            CALL PHIADD (KK,JJ,II,W(IP3),WO(IP3),W(IP3),M0,M01,M1)
            TIMERK = TIMEPH + M1
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
C                             BELEGEN DES FRONT-BUFFERS
C

C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN
CTBC                   HERE APPLIED TO U,V,W ONLY
      CALL SETBACKOLD   (KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                  U(IP3),V(IP3),W(IP3)
#ifdef _TSCAL_
     $                  ,TBA(IBB),T(IP3),0
#endif   
     $                  )     

C
C
C
C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN


             IF(LDIEIB) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (UNFOR-
C                                 MATIERT AUF KANAL 11)
C
                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
             END IF
             IF(LDIEIC) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (FORMATIERT
C                                 AUF KANAL 13)
C

                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
             END IF
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPR (KK,JJ, 2,KK,JJ, 2,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),
     $                     GFR(IBB),Y(IP1),Z(IP1),DZ(IP1),VCON,WCON,
     $                     YBANF(1,1,IGRID),YBEND(1,1,IGRID),
     $                     ZBANF(1,1,IGRID),ZBEND(1,1,IGRID),
     $                     FREQB(1,1,IGRID),ANIVEAU(1,1,IGRID),
     $                     AUB(1,1,IGRID),AVB(1,1,IGRID),AWB(1,1,IGRID),
     $                     TIMERK,DT,UBO,VBO,WBO)
             ENDIF

           ENDIF
        ENDIF
#ifdef _MPI_
       ENDIF
#endif        

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
#ifdef _TSCAL_
     $                   ,T,AT,TFR,0
#endif
     $                   )     
            
         ENDIF

#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
                  CALL SV3D (JJ,II, 2,JJ,II, 2,
     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
     $                 GBO(IBB),HILF(IBB),
     $                   Z(IP1),  X(IP1),  Y(IP1),
     $                  DZ(IP1), DX(IP1), DY(IP1),
     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
     $                 VCON,WCON,
     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
     $                 TIMERK,DT,0)
             ENDIF
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif
         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NBOT)
            
         ENDIF

      ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFVPIT(ILEVEL)
           IGRID = IGRDOFVPIT(I,ILEVEL)
           IF (IPARENT(IGRID) .NE. 0) THEN
	   IPROCF = 0
	   IPROCC = 0
#ifdef _MPI_
           IPROCF = IDPROCOFGRD(IGRID)
           IPROCC = IDPROCOFGRD(IPARENT(IGRID))
       IF (MYID .EQ. IPROCF .OR. MYID .EQ. IPROCC)  THEN
#endif

          CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $         NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C
          IF ( LCHILD(IGRID) ) THEN
C
C                                 FRONT BUFFER
C
                  IF (      NFRO .EQ. 2 
     $                 .OR. NFRO .EQ. 11 
     $                 .OR. NFRO .EQ. 12 ) THEN

C                                 BEREITSTELLUNG DER POINTER
C                                 DIMENSIONIERUNGEN DES FEINGITTERS

                CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
                CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,
     $                        IBUC,IPARENT(IGRID))
                
                
                CALL MGBFTC (KK,JJ, 2 ,DX(IP1),DY(IP1),DZ(IP1),
     &               DDX(IP1),DDY(IP1),DDZ(IP1),UFR(IBB),
     &               KKC,JJC, 2 ,DX(IP1C),DY(IP1C),DZ(IP1C),
     &               DDX(IP1C),DDY(IP1C),DDZ(IP1C),UFR(IBBC),
     &               KPOSITION(IGRID),JPOSITION(IGRID),
     &               IPOSITION(IGRID),'U',IPROCF,IPROCC)

             END IF
C
C                                BOTTOM BUFFER
C
             IF (            NBOT .EQ. 2 
     $                  .OR. NBOT .EQ. 11 
     $                  .OR. NBOT .EQ. 12) THEN
          CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
          CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,IBUC,IPARENT(IGRID))
                CALL MGBFTC (JJ,II, 2 ,DZ(IP1),DX(IP1),DY(IP1),
     &               DDZ(IP1),DDX(IP1),DDY(IP1),WBO(IBB),
     &               JJC,IIC, 2 ,DZ(IP1C),DX(IP1C),DY(IP1C),
     &               DDZ(IP1C),DDX(IP1C),DDY(IP1C),WBO(IBBC),
     &               JPOSITION(IGRID),IPOSITION(IGRID),
     &               KPOSITION(IGRID),'U',IPROCF,IPROCC)
             ENDIF
          ENDIF
#ifdef _MPI_
       ENDIF
#endif
      ENDIF
      ENDDO
      ENDDO
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  Ende erster Runge Kutta Zwischenschritt
C                                 IMPLIZITER TEIL UEBER ALLE GITTER
C                                 DRUCKKORREKTUR
C  

#ifdef _FRED_BODY_
c*************TEST*****************+
      DO ILEVEL = MINLEVEL,MAXLEVEL
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

         CALL COP3DZERO(KK,JJ,II,U(IP3),V(IP3),W(IP3),
     $        U(IP3),V(IP3),W(IP3),P(IP3),BP(IP3)
#ifdef _TSCAL_
     $        ,T(IP3)
#endif
     $        )

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'Y',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )


#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
#endif
c*********************TEST**************************



      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR, 
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

C
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMERK,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     
#ifdef _MPI_
       ENDIF
#endif 
        ENDDO
      ENDDO 

                               DT = M1
                               WSOR = 1.0
#ifdef _POISSONITER_
         CALL MGPOISL1    (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                    X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                    RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                    U,V,W,P,DP,G,B,DIV,RES,
     $                    UFR,VFR,WFR,
     $                    UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                    WSOR,RHO,DIVG,IPRGRID,
     $                    MINLEVEL,MAXLEVEL,MAXLEVEL,TIMERK,
     $                    UBA,VBA,WBA,PBA,GBA,UBO,VBO,WBO,
     $                    PFR,GFR,
     $                    GSAW,GSAE,GSAN,GSAS,GSAT,GSAB,
     $                    BP,BU,BV,BW,SDIV
#ifdef _SIP_ITER_
     $                    ,GEOVP,SIPLW,SIPLS,
     $                    SIPLB,SIPLPR,SIPUE,SIPUN,SIPUT
#else
     $                    ,GSRAP
#endif
#ifdef _TSCAL_
     $                    ,T,TFR,TBA,TTO,TBO
#endif
     $                    )
#else
         CALL MGVPL1 (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                FPSFAK,FCOSMY,FCOSNY,
     $                IFFTX,IPERMUX,RFFTX,IFFTY,IPERMUY,RFFTY,     
     $                U,V,W,P,DP,G,B,BP,BU,BV,BW,SDIV,
     $                DIV,UFR,VFR,WFR,
     $                UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
     $                WSOR,RHO,DIVG,IPRGRID,
     $                MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                UBA,VBA,WBA,PBA,GBA,GEOVP,UBO,VBO,WBO,
     $                PFR,GFR
#ifdef _HITACHI_
     $   ,CXY,CTB,CWK,CHILF
#endif
#ifdef _TSCAL_
     $               ,T,TFR,TBA,TTO,TBO
#endif
     $                )     
C
#endif
                              DT = DTHELP                              
C                              
#ifdef _TSCAL_
C                              
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CTBA  SCALAR TRANSPORT FIRST INTERMEDIATE RUNGE KUTTA TIME STEP CCCCCCCC
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
C         CALL CONNECTMG
C     $             (IDIM3D,IDIM2D,IDIM1D,
C     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
C     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
C     $              VFR,WFR,PFR,GFR,
C     $              'T',ILEVEL,0,0,0,
C     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN      	
#endif
           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C          GET ITYP OF SCALAR BOUNDARY CONDITION
           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID) 
    
#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

#ifdef _RUNGEKUTTA3SCADELAYED_
C          SET NEW BOUNDARY CONDITIONS
           CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
     $             ,T,TFR,TBA,TTO,TBO
     $             )
CTBC       STORE NEW U,V,W IN FELD1,FELD2,FELD3 FOR 
CTBC       DELAYED FIRST SCALAR RUNGE KUTTA TIME STEP
           CALL COP3D(KK,JJ,II,U(IP3),FELD1(IP3)) 
           CALL COP3D(KK,JJ,II,V(IP3),FELD2(IP3))
           CALL COP3D(KK,JJ,II,W(IP3),FELD3(IP3))
#endif                
           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
CTBC                    OLD/NEW U,V,W STORED IN FELD1, FELD2, FELD3    
     $                  FELD1(IP3),FELD2(IP3),FELD3(IP3),T(IP3),TO(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3),
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART,TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif                 
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,OCTE(IP3),OCTW(IP3),OCTN(IP3),OCTS(IP3),
     $                 OCTT(IP3),OCTB(IP3),ODTE(IP3),ODTW(IP3),
     $                 ODTN(IP3),ODTS(IP3),ODTT(IP3),ODTB(IP3),ODTC(IP3)
#endif 
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))
CTBC        SET T= M01*T + M1*TO
            CALL PHIADD (KK,JJ,II,T(IP3),TO(IP3),T(IP3),M0,M01,M1)
#ifdef _SCALTRANSDIAGNOSE_
          CALL PHIADD (KK,JJ,II,QCTE(IP3),OCTE(IP3),QCTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QCTW(IP3),OCTW(IP3),QCTW(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QCTN(IP3),OCTN(IP3),QCTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QCTS(IP3),OCTS(IP3),QCTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QCTT(IP3),OCTT(IP3),QCTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QCTB(IP3),OCTB(IP3),QCTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTE(IP3),ODTE(IP3),QDTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTW(IP3),ODTW(IP3),QDTW(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTN(IP3),ODTN(IP3),QDTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTS(IP3),ODTS(IP3),QDTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTT(IP3),ODTT(IP3),QDTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTB(IP3),ODTB(IP3),QDTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,QDTC(IP3),ODTC(IP3),QDTC(IP3),M0,M01,M1)
#endif
#ifdef _MPI_
         ENDIF
#endif
#ifdef _DECONVOLVESCA_
      CALL DECONVOLVSCA(KK,JJ,II,T(IP3),H3D1(IP3),H3D2(IP3),
     $        H3D3(IP3),HILF3D4(IP3),HILF3D5(IP3),
     $        FTI(IP3),FTJ(IP3),FTK(IP3),
     $        DZ(IP1), DX(IP1), DY(IP1),
     $        NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,NTOPSCA,IGRID,
     $        TFX(IP1),TFY(IP1))
#endif
      ENDDO
      ENDDO
C                             BELEGEN DES FRONT-BUFFERS
C
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN
CTBC                   HERE APPLIED TO T ONLY
         CALL SETBACKOLD(KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                   U(IP3),V(IP3),W(IP3),TBA(IBB),T(IP3),1)     

C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C
C     DEIBI, DEICI NOT YET IMPLEMENTED FOR SCALAR T
C             IF(LDIEIB) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (UNFOR-
CC                                 MATIERT AUF KANAL 11)
CC
C                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF(LDIEIC) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (FORMATIERT
CC                                 AUF KANAL 13)
CC
C
C                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPRSCA (KK,JJ, 2,KK,JJ, 2,
     $                         TFR(IBB),Y(IP1),Z(IP1),DZ(IP1),
     $                         TIMEPH,DT,IGRID)
C             ENDIF
C
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif        

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
     $                   ,T,AT,TFR,1)
            
         ENDIF

#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN
      STOP 
     $'FIXED/FLUCTUATION BOUNDARY AT BOTTOM NOT IMPLEMENTED FOR SCALAR'

C           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
C                  CALL SV3D (JJ,II, 2,JJ,II, 2,
C     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
C     $                 GBO(IBB),HILF(IBB),
C     $                   Z(IP1),  X(IP1),  Y(IP1),
C     $                  DZ(IP1), DX(IP1), DY(IP1),
C     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
C     $                 VCON,WCON,
C     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
C     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
C     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
C     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
C     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
C     $                 TIMEPH,DT,0)
C             ENDIF
C           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif
         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
             STOP                                                     
     $'FLUCTUATION/RECYCLING BOUNDARY AT BOTTOM NOT IMPL. FOR SCALAR' 
C            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
C     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
C     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
C     $                    NBND,IGRID,ITSTEP,1,NBOT)
C            
         ENDIF

      ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
CCCCCCCCCCCCC FINE GRID PROCESSING NOT YET IMPLEMENTED FOR SCALAR T
C
CTBA  END SCALAR TRANSPORT FIRST INTERMEDIATE RUNGE KUTTA TIME STEP CCCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C-----------------------------------------------------------------------
C    NOW SCALAR TRANSPORT ON FINE GRID IF LSCAI = TRUE 1st RK STEP
C-----------------------------------------------------------------------
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)

           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD1(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD2(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD3(IP3))
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD1(IP3),
     $                     FELD1(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'U')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD2(IP3),
     $                     FELD2(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'V')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD3(IP3),
     $                     FELD3(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'W')
#ifdef _MPI_
       ENDIF
#endif
       ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

            CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              FELD1,FELD2,FELD3,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )

#ifdef _MPI_
        ENDIF
#endif

        ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)

           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                  FELD1(IP3),FELD2(IP3),FELD3(IP3),T(IP3),TO(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3),
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART,TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif                 
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,OCTE(IP3),OCTW(IP3),OCTN(IP3),OCTS(IP3),
     $                 OCTT(IP3),OCTB(IP3),ODTE(IP3),ODTW(IP3),
     $                 ODTN(IP3),ODTS(IP3),ODTT(IP3),ODTB(IP3),ODTC(IP3)
#endif 
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))

            M0 = 0.0
            M01 = 1.0
            M1 = (1.0/3.0)*DT
            CALL PHIADD (KK,JJ,II,T(IP3),TO(IP3),T(IP3),M0,M01,M1)

#ifdef _MPI_
         ENDIF
#endif

        ENDDO
      ENDDO

#endif
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  Beginn zweiter Runge Kutta Schritt
C
#ifndef _DNS_

      IF (MTURB .EQ. 1) THEN

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

C
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
           CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C                                 GEWAEHRLEISTET SICHERES MIGRIEREN DER
C                                 RANDWERTE AUF NACHBARGITTER
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
C                                 BESTIMMUNG DES G-FELDES (INCL. R.B.)
#ifdef _DYNSGSM_
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))
#else	
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))     
#endif
#else
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))
#else
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))

#endif	
#endif
C
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO


CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           

C                                 SETZEN DER RANDBEDINGUNGEN
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO

      ENDIF

#endif

CCCCCCCCCCCCCCCCCCC ende #ifndef DNS

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif 
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

C
C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMERK,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
#ifdef _TAU_NN_
         CALL TAUNN(KK, JJ, II,
     $        X(IP1),Y(IP1),Z(IP1),
     $        DX(IP1),DY(IP1),DZ(IP1),
     $        DDX(IP1),DDY(IP1),DDZ(IP1),
     $        RDX(IP1),RDY(IP1),RDZ(IP1),
     $        RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $        U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $        DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $        DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $        TAU11(IP3),TAU12(IP3),TAU13(IP3),
     $        TAU21(IP3),TAU22(IP3),TAU23(IP3),
     $        TAU31(IP3),TAU32(IP3),TAU33(IP3))
#endif
C
C
CTBC               PRESET TEMPORARILY USED FELD-FIELDS BY ZERO AGAIN
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD1(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD2(IP3))
                   CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD3(IP3))
C                   
                   IDUZ = 2
                   CALL WIFAK  (ITSTEP,ITMIT,WPHI,WKON,WDIF,WSOR,IDUZ)
                   CALL TSTLE4 (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                           U(IP3), V(IP3), W(IP3),
     $                          FELD1(IP3),FELD2(IP3),FELD3(IP3),
     $                          WCU(IP3),WCV(IP3),WCW(IP3),
     $                          P(IP3),G(IP3),B(IP3),
#ifdef _FRED_BODY_
     $                          BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                          DT,
     $                          GRADPX(IGRID),ZTOT,NBUF,ITSTEP,
     $                          WPHI,WKON,WDIF,WSOR,IDUZ,
     $                          IC1(IGRID),IC2(IGRID),
     $                          JC1(IGRID),JC2(IGRID),
     $                          KC1(IGRID),KC2(IGRID),
     $                          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                       RSGS3(IP3),
#ifdef _FRED_BODY_
     $                       FAKTOR(IP3),
#else
     $                       FAKTOR(IP1),
#endif
     $                       FUI(IP3),FVI(IP3),FWI(IP3),
     $                       FUJ(IP3),FVJ(IP3),FWJ(IP3),
     $                       FUK(IP3),FVK(IP3),FWK(IP3),
#ifndef _FRED_BODY_
     $                       COEFFX(IP2),COEFFY(IP2),COEFFZ(IP2),
     $                       COEFDX(IP2),COEFDY(IP2),COEFDZ(IP2),
#else
     $                       COEFFX(CIP1),COEFFY(CIP1),
     $                       COEFFZ(CIP1),COEFDX(CIP1),
     $                       COEFDY(CIP1),COEFDZ(CIP1),
#endif
     $                       LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                       UZ(IP1),RSP(IP1),
     $                       H3D1(IP3),H3D2(IP3),H3D3(IP3)
#ifdef _TAU_NN_
     $        ,TAU11(IP3),TAU12(IP3),TAU13(IP3)
     $        ,TAU21(IP3),TAU22(IP3),TAU23(IP3)
     $        ,TAU31(IP3),TAU32(IP3),TAU33(IP3)
#endif
C#if defined _PREPROC_
C     $        ,HPX(IP3)
C#endif
     $                       )
 
            M0 = 0.0
            M01 = 1.0
            M1 = (-5.0/9.0)
            M2 = (15.0/16.0)*DT
CTBC  ADD M01*FELD1,2,3 + M1*UO,VO,WO TO FELD1,2,3
      CALL PHIADD (KK,JJ,II,FELD1(IP3),UO(IP3),FELD1(IP3),
     $      M0,M01,M1)
      CALL PHIADD (KK,JJ,II,FELD2(IP3),VO(IP3),FELD2(IP3),
     $      M0,M01,M1)       
      CALL PHIADD (KK,JJ,II,FELD3(IP3),WO(IP3),FELD3(IP3),
     $      M0,M01,M1)

#ifdef _TSCAL_
CTBC               STORE OLD U,V,W IN UO,VO,WO FOR 
CTBC               SECOND SCALAR RUNGE KUTTA TIME STEP
                   CALL COP3D(KK,JJ,II,U(IP3),UO(IP3)) 
                   CALL COP3D(KK,JJ,II,V(IP3),VO(IP3))
                   CALL COP3D(KK,JJ,II,W(IP3),WO(IP3))
#endif
CTBC       ADD M01*U,V,W + M2*FELD1,2,3 TO U,V,W
           CALL PHIADD (KK,JJ,II,U(IP3),FELD1(IP3),U(IP3),M0,M01,M2)
           CALL PHIADD (KK,JJ,II,V(IP3),FELD2(IP3),V(IP3),M0,M01,M2)
           CALL PHIADD (KK,JJ,II,W(IP3),FELD3(IP3),W(IP3),M0,M01,M2)
            TIMERK = TIMERK + 0.75*DT

#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
C                             BELEGEN DES FRONT-BUFFERS
C

C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN

      CALL SETBACKOLD   (KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                  U(IP3),V(IP3),W(IP3)
#ifdef _TSCAL_
     $                  ,TBA(IBB),T(IP3),0
#endif   
     $                  )     

C
C
C
C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN


             IF(LDIEIB) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (UNFOR-
C                                 MATIERT AUF KANAL 11)
C
                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
             END IF
             IF(LDIEIC) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (FORMATIERT
C                                 AUF KANAL 13)
C

                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
             END IF
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPR (KK,JJ, 2,KK,JJ, 2,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),
     $                     GFR(IBB),Y(IP1),Z(IP1),DZ(IP1),VCON,WCON,
     $                     YBANF(1,1,IGRID),YBEND(1,1,IGRID),
     $                     ZBANF(1,1,IGRID),ZBEND(1,1,IGRID),
     $                     FREQB(1,1,IGRID),ANIVEAU(1,1,IGRID),
     $                     AUB(1,1,IGRID),AVB(1,1,IGRID),AWB(1,1,IGRID),
     $                     TIMERK,DT,UBO,VBO,WBO)
             ENDIF

           ENDIF
        ENDIF
#ifdef _MPI_
       ENDIF
#endif         

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
#ifdef _TSCAL_
     $                   ,T,AT,TFR,0
#endif
     $                   )     
            
         ENDIF

#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
                  CALL SV3D (JJ,II, 2,JJ,II, 2,
     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
     $                 GBO(IBB),HILF(IBB),
     $                   Z(IP1),  X(IP1),  Y(IP1),
     $                  DZ(IP1), DX(IP1), DY(IP1),
     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
     $                 VCON,WCON,
     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
     $                 TIMERK,DT,0)
             ENDIF
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif         

         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NBOT)
            
         ENDIF

      ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFVPIT(ILEVEL)
           IGRID = IGRDOFVPIT(I,ILEVEL)
           IF (IPARENT(IGRID) .NE. 0) THEN
	   IPROCF = 0
	   IPROCC = 0
#ifdef _MPI_
           IPROCF = IDPROCOFGRD(IGRID)
           IPROCC = IDPROCOFGRD(IPARENT(IGRID))
       IF (MYID .EQ. IPROCF .OR. MYID .EQ. IPROCC)  THEN
#endif

          CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $         NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C
          IF ( LCHILD(IGRID) ) THEN
C
C                                 FRONT BUFFER
C
                  IF (      NFRO .EQ. 2 
     $                 .OR. NFRO .EQ. 11 
     $                 .OR. NFRO .EQ. 12 ) THEN

C                                 BEREITSTELLUNG DER POINTER
C                                 DIMENSIONIERUNGEN DES FEINGITTERS

                CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
                CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,
     $                        IBUC,IPARENT(IGRID))
                
                
                CALL MGBFTC (KK,JJ, 2 ,DX(IP1),DY(IP1),DZ(IP1),
     &               DDX(IP1),DDY(IP1),DDZ(IP1),UFR(IBB),
     &               KKC,JJC, 2 ,DX(IP1C),DY(IP1C),DZ(IP1C),
     &               DDX(IP1C),DDY(IP1C),DDZ(IP1C),UFR(IBBC),
     &               KPOSITION(IGRID),JPOSITION(IGRID),
     &               IPOSITION(IGRID),'U',IPROCF,IPROCC)

             ENDIF
C
C                                BOTTOM BUFFER
C
             IF (            NBOT .EQ. 2 
     $                  .OR. NBOT .EQ. 11 
     $                  .OR. NBOT .EQ. 12) THEN
          CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
          CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,IBUC,IPARENT(IGRID))
                CALL MGBFTC (JJ,II, 2 ,DZ(IP1),DX(IP1),DY(IP1),
     &               DDZ(IP1),DDX(IP1),DDY(IP1),WBO(IBB),
     &               JJC,IIC, 2 ,DZ(IP1C),DX(IP1C),DY(IP1C),
     &               DDZ(IP1C),DDX(IP1C),DDY(IP1C),WBO(IBBC),
     &               JPOSITION(IGRID),IPOSITION(IGRID),
     &               KPOSITION(IGRID),'U',IPROCF,IPROCC)
             ENDIF
          ENDIF
#ifdef _MPI_
       ENDIF
#endif          
      ENDIF
      ENDDO
      ENDDO
CCCCCCCCCCCCCCCCC  Ende zweiter Zwischenschritt fuer Runge Kutta

#ifdef _FRED_BODY_
c*************TEST*****************+
      DO ILEVEL = MINLEVEL,MAXLEVEL
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

         CALL COP3DZERO(KK,JJ,II,U(IP3),V(IP3),W(IP3),
     $        U(IP3),V(IP3),W(IP3),P(IP3),BP(IP3)
#ifdef _TSCAL_
     $        ,T(IP3)
#endif
     $        )

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'Y',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )


#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
#endif
c*********************TEST**************************
 

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR, 
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))


        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMERK,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             ) 

#ifdef _MPI_
       ENDIF
#endif         

        ENDDO
      ENDDO

                               DT = DT*0.75
                               WSOR = 1.0

#ifdef _POISSONITER_

         CALL MGPOISL1    (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                    X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                    RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                    U,V,W,P,DP,G,B,DIV,RES,
     $                    UFR,VFR,WFR,
     $                    UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                    WSOR,RHO,DIVG,IPRGRID,
     $                    MINLEVEL,MAXLEVEL,MAXLEVEL,TIMERK,
     $                    UBA,VBA,WBA,PBA,GBA,UBO,VBO,WBO,
     $                    PFR,GFR,
     $                    GSAW,GSAE,GSAN,GSAS,GSAT,GSAB,
     $                    BP,BU,BV,BW,SDIV
#ifdef _SIP_ITER_
     $                    ,GEOVP,SIPLW,SIPLS,
     $                    SIPLB,SIPLPR,SIPUE,SIPUN,SIPUT
#else
     $                    ,GSRAP
#endif
#ifdef _TSCAL_
     $                    ,T,TFR,TBA,TTO,TBO
#endif
     $                    )
#else
         CALL MGVPL1 (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                FPSFAK,FCOSMY,FCOSNY,
     $                IFFTX,IPERMUX,RFFTX,IFFTY,IPERMUY,RFFTY,     
     $                U,V,W,P,DP,G,B,BP,BU,BV,BW,SDIV,
     $                DIV,UFR,VFR,WFR,
     $                UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
     $                WSOR,RHO,DIVG,IPRGRID,
     $                MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                UBA,VBA,WBA,PBA,GBA,GEOVP,UBO,VBO,WBO,
     $                PFR,GFR
#ifdef _HITACHI_
     $   ,CXY,CTB,CWK,CHILF
#endif
#ifdef _TSCAL_
     $               ,T,TFR,TBA,TTO,TBO
#endif
     $                )
C
#endif 
                     DT = DTHELP
C                     
     
#ifdef _TSCAL_
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CTBA  SCALAR TRANSPORT SECOND INTERMEDIATE RUNGE KUTTA TIME STEP CCCCCCC
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN      	
#endif
           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C          GET ITYP OF SCALAR BOUNDARY CONDITION
           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)
C     
#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

#ifdef _RUNGEKUTTA3SCADELAYED_
C          SET NEW BOUNDARY CONDITIONS
           CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
     $             ,T,TFR,TBA,TTO,TBO
     $             )
CTBC       STORE NEW U,V,W IN UO,VO,WO FOR 
CTBC       DELAYED SECOND SCALAR RUNGE KUTTA TIME STEP
           CALL COP3D(KK,JJ,II,U(IP3),UO(IP3)) 
           CALL COP3D(KK,JJ,II,V(IP3),VO(IP3))
           CALL COP3D(KK,JJ,II,W(IP3),WO(IP3))
#endif
     
           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
CTBC                    OLD/NEW U,V,W STORED IN UO, VO, WO      
     $                  UO(IP3),VO(IP3),WO(IP3),T(IP3),FELDT(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3), 
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART, TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else 
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif       
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,FCTE(IP3),FCTW(IP3),FCTN(IP3),FCTS(IP3),
     $                 FCTT(IP3),FCTB(IP3),FDTE(IP3),FDTW(IP3),
     $                 FDTN(IP3),FDTS(IP3),FDTT(IP3),FDTB(IP3),FDTC(IP3)
#endif          
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))
CTBC      SET FELDT =  M01*FELDT + M1*TO
          CALL PHIADD (KK,JJ,II,FELDT(IP3),TO(IP3),FELDT(IP3),M0,M01,M1)
CTBC      SET T= M01*T + M2*FELDT
           CALL PHIADD (KK,JJ,II,T(IP3),FELDT(IP3),T(IP3),M0,M01,M2)
#ifdef _SCALTRANSDIAGNOSE_
          CALL PHIADD (KK,JJ,II,FCTE(IP3),OCTE(IP3),FCTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FCTW(IP3),OCTW(IP3),FCTW(IP3),M0,M01,M1)  
          CALL PHIADD (KK,JJ,II,FCTN(IP3),OCTN(IP3),FCTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FCTS(IP3),OCTS(IP3),FCTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FCTT(IP3),OCTT(IP3),FCTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FCTB(IP3),OCTB(IP3),FCTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTE(IP3),ODTE(IP3),FDTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTW(IP3),ODTW(IP3),FDTW(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTN(IP3),ODTN(IP3),FDTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTS(IP3),ODTS(IP3),FDTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTT(IP3),ODTT(IP3),FDTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTB(IP3),ODTB(IP3),FDTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,FDTC(IP3),ODTC(IP3),FDTC(IP3),M0,M01,M1)
          
          CALL PHIADD (KK,JJ,II,QCTE(IP3),FCTE(IP3),QCTE(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTW(IP3),FCTW(IP3),QCTW(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTN(IP3),FCTN(IP3),QCTN(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTS(IP3),FCTS(IP3),QCTS(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTT(IP3),FCTT(IP3),QCTT(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTB(IP3),FCTB(IP3),QCTB(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTE(IP3),FDTE(IP3),QDTE(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTW(IP3),FDTW(IP3),QDTW(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTN(IP3),FDTN(IP3),QDTN(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTS(IP3),FDTS(IP3),QDTS(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTT(IP3),FDTT(IP3),QDTT(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTB(IP3),FDTB(IP3),QDTB(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTC(IP3),FDTC(IP3),QDTC(IP3),M0,M01,M2)
#endif 
#ifdef _MPI_
         ENDIF
#endif
#ifdef _DECONVOLVESCA_
      CALL DECONVOLVSCA(KK,JJ,II,T(IP3),H3D1(IP3),H3D2(IP3),
     $        H3D3(IP3),HILF3D4(IP3),HILF3D5(IP3),
     $        FTI(IP3),FTJ(IP3),FTK(IP3),
     $        DZ(IP1), DX(IP1), DY(IP1),
     $        NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,NTOPSCA,IGRID,
     $        TFX(IP1),TFY(IP1))
#endif
      ENDDO
      ENDDO


C                             BELEGEN DES FRONT-BUFFERS
C

C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN
CTBC                   HERE APPLIED TO T ONLY
         CALL SETBACKOLD(KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                   U(IP3),V(IP3),W(IP3),TBA(IBB),T(IP3),1)     

C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C
C     DEIBI, DEICI NOT YET IMPLEMENTED FOR SCALAR T
C             IF(LDIEIB) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (UNFOR-
CC                                 MATIERT AUF KANAL 11)
CC
C                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF(LDIEIC) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (FORMATIERT
CC                                 AUF KANAL 13)
CC
C
C                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPRSCA (KK,JJ, 2,KK,JJ, 2,
     $                         TFR(IBB),Y(IP1),Z(IP1),DZ(IP1),
     $                         TIMEPH,DT,IGRID)
C             ENDIF
C
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif        

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
     $                   ,T,AT,TFR,1)
            
         ENDIF

#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN
      STOP 
     $'FIXED/FLUCTUATION BOUNDARY AT BOTTOM NOT IMPLEMENTED FOR SCALAR'

C           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
C                  CALL SV3D (JJ,II, 2,JJ,II, 2,
C     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
C     $                 GBO(IBB),HILF(IBB),
C     $                   Z(IP1),  X(IP1),  Y(IP1),
C     $                  DZ(IP1), DX(IP1), DY(IP1),
C     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
C     $                 VCON,WCON,
C     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
C     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
C     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
C     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
C     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
C     $                 TIMEPH,DT,0)
C             ENDIF
C           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif
         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
             STOP
     $'FLUCTUATION/RECYCLING BOUNDARY AT BOTTOM NOT IMPL. FOR SCALAR' 
C            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
C     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
C     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
C     $                    NBND,IGRID,ITSTEP,1,NBOT)
C            
         ENDIF

      ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
CCCCCCCCCCCCC FINE GRID PROCESSING NOT YET IMPLEMENTED FOR SCALAR T
C
CTBA  END SCALAR TRANSPORT SECOND INTERMEDIATE RUNGE KUTTA TIME STEP CCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C-----------------------------------------------------------------------
C    NOW SCALAR TRANSPORT ON FINE GRID IF LSCAI = TRUE 1st RK STEP
C-----------------------------------------------------------------------
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)

           CALL DPHI0(KK,JJ,II,KK,JJ,II,UO(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,VO(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,WO(IP3))
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),UO(IP3),
     $                     UO(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'U')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),VO(IP3),
     $                     VO(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'V')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),WO(IP3),
     $                     WO(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'W')
#ifdef _MPI_
       ENDIF
#endif
       ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

            CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              UO,VO,WO,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )

#ifdef _MPI_
        ENDIF
#endif

        ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)

           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                  UO(IP3),VO(IP3),WO(IP3),T(IP3),FELDT(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3), 
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART, TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else 
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif       
#ifdef _SCALTRANSDIAGNOSE_  
     $                ,FCTE(IP3),FCTW(IP3),FCTN(IP3),FCTS(IP3),
     $                 FCTT(IP3),FCTB(IP3),FDTE(IP3),FDTW(IP3),
     $                 FDTN(IP3),FDTS(IP3),FDTT(IP3),FDTB(IP3),FDTC(IP3)
#endif          
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))

            M0 = 0.0
            M01 = 1.0
            M1 = (-5.0/9.0)
            M2 = (15.0/16.0)*DT
          CALL PHIADD (KK,JJ,II,FELDT(IP3),TO(IP3),FELDT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,T(IP3),FELDT(IP3),T(IP3),M0,M01,M2)

#ifdef _MPI_
         ENDIF
#endif

        ENDDO
      ENDDO

#endif
C
C
C               REDUZIERUNG DES DRUCKNIVEAUS FUER GEWUENSCHTE GITTER    
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  Beginn letzter Runge Kutta Schritt
C
#ifndef _DNS_

      IF (MTURB .EQ. 1) THEN

      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

C
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
           CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

C                                 SETZEN DER RANDBEDINGUNGEN
C                                 GEWAEHRLEISTET SICHERES MIGRIEREN DER
C                                 RANDWERTE AUF NACHBARGITTER
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
C                                 BESTIMMUNG DES G-FELDES (INCL. R.B.)
#ifdef _DYNSGSM_
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))
#else	
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(IP2),HILF1(IP2),HILF2(IP2),HILF3(IP2),HILF4(IP2),
     $   HILF5(IP2),
     $   HILF6(IP2),
     $   LUX(IP2),LUY(IP2),LUZ(IP2),LVY(IP2),LVZ(IP2),LWZ(IP2),MUX(IP2),
     $   MUY(IP2),MUZ(IP2),MVY(IP2),MVZ(IP2),MWZ(IP2),
     $   FA11(IP2),FA12(IP2),FA13(IP2),FA21(IP2),FA22(IP2),FA23(IP2),
     $   FA31(IP2),FA32(IP2),FA33(IP2),
     $   DUDX3(IB3),DUDY3(IB3),DUDZ3(IB3),DVDX3(IB3),DVDY3(IB3),
     $   DVDZ3(IB3),
     $   DWDX3(IB3),DWDY3(IB3),DWDZ3(IB3),NORMS(IB3),SDUDX3(IB3),
     $   SDUDY3(IB3),SDUDZ3(IB3),
     $   SDVDY3(IB3),SDVDZ3(IB3),SDWDZ3(IB3),
     $   UC(IB3),VC(IB3),WC(IB3),UUC(IB3),UVC(IB3),UWC(IB3),VVC(IB3),
     $   VWC(IB3),WWC(IB3),CDELTA(IP1))     
#endif
#else
#ifdef _FRED_BODY_
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),BP(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))
#else
         CALL EFVISC (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                              U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $                              DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $                              DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $                              GMOL,RHO,UGRID,
     $                              IC1(IGRID),IC2(IGRID),
     $                              JC1(IGRID),JC2(IGRID),
     $                              KC1(IGRID),KC2(IGRID),
     $                              NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                              CONV1S(IP1),
     $   HILF0(1),HILF1(1),HILF2(1),HILF3(1),HILF4(1),
     $   HILF5(1),HILF6(1),
     $   LUX(1),LUY(1),LUZ(1),LVY(1),LVZ(1),LWZ(1),MUX(1),
     $   MUY(1),MUZ(1),MVY(1),MVZ(1),MWZ(1),
     $   FA11(1),FA12(1),FA13(1),FA21(1),FA22(1),FA23(1),
     $   FA31(1),FA32(1),FA33(1),
     $   DUDX3(1),DUDY3(1),DUDZ3(1),DVDX3(1),DVDY3(1),
     $   DVDZ3(1),
     $   DWDX3(1),DWDY3(1),DWDZ3(1),NORMS(1),SDUDX3(1),
     $   SDUDY3(1),SDUDZ3(1),
     $   SDVDY3(1),SDVDZ3(1),SDWDZ3(1),
     $   UC(1),VC(1),WC(1),UUC(1),UVC(1),UWC(1),VVC(1),
     $   VWC(1),WWC(1),CDELTA(1))

#endif	
#endif
C
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO


CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif           

C                                 SETZEN DER RANDBEDINGUNGEN
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     
#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO

      ENDIF

#endif

CCCCCCCCCCCCCCCCCCC ende #ifndef DNS
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

C
C                                 SETZEN DER RANDBEDINGUNGEN
C
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMERK,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C
#ifdef _TAU_NN_
         CALL TAUNN(KK, JJ, II,
     $        X(IP1),Y(IP1),Z(IP1),
     $        DX(IP1),DY(IP1),DZ(IP1),
     $        DDX(IP1),DDY(IP1),DDZ(IP1),
     $        RDX(IP1),RDY(IP1),RDZ(IP1),
     $        RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $        U(IP3),V(IP3),W(IP3),G(IP3),B(IP3),
     $        DUDY(IP2),DUDZ(IP2),DVDX(IP2),
     $        DVDZ(IP2),DWDX(IP2),DWDY(IP2),
     $        TAU11(IP3),TAU12(IP3),TAU13(IP3),
     $        TAU21(IP3),TAU22(IP3),TAU23(IP3),
     $        TAU31(IP3),TAU32(IP3),TAU33(IP3))
#endif
C
C
                CALL DPHI0(KK,JJ,II,KK,JJ,II,UO(IP3))
                CALL DPHI0(KK,JJ,II,KK,JJ,II,VO(IP3))
                CALL DPHI0(KK,JJ,II,KK,JJ,II,WO(IP3))              

                   IDUZ = 2
                   CALL WIFAK  (ITSTEP,ITMIT,WPHI,WKON,WDIF,WSOR,IDUZ)
                   CALL TSTLE4 (KK,JJ,II,KK,JJ,II,
     $                              X(IP1),Y(IP1),Z(IP1),
     $                              DX(IP1),DY(IP1),DZ(IP1),
     $                              DDX(IP1),DDY(IP1),DDZ(IP1),
     $                              RDX(IP1),RDY(IP1),RDZ(IP1),
     $                              RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                           U(IP3), V(IP3), W(IP3),
     $                          UO(IP3),VO(IP3),WO(IP3),
     $                          WCU(IP3),WCV(IP3),WCW(IP3),
     $                          P(IP3),G(IP3),B(IP3),
#ifdef _FRED_BODY_
     $                          BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                          DT,
     $                          GRADPX(IGRID),ZTOT,NBUF,ITSTEP,
     $                          WPHI,WKON,WDIF,WSOR,IDUZ,
     $                          IC1(IGRID),IC2(IGRID),
     $                          JC1(IGRID),JC2(IGRID),
     $                          KC1(IGRID),KC2(IGRID),
     $                          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                       RSGS3(IP3),
#ifdef _FRED_BODY_
     $                       FAKTOR(IP3),
#else
     $                       FAKTOR(IP1),
#endif
     $                       FUI(IP3),FVI(IP3),FWI(IP3),
     $                       FUJ(IP3),FVJ(IP3),FWJ(IP3),
     $                       FUK(IP3),FVK(IP3),FWK(IP3),
#ifndef _FRED_BODY_
     $                       COEFFX(IP2),COEFFY(IP2),COEFFZ(IP2),
     $                       COEFDX(IP2),COEFDY(IP2),COEFDZ(IP2),
#else
     $                       COEFFX(CIP1),COEFFY(CIP1),
     $                       COEFFZ(CIP1),COEFDX(CIP1),
     $                       COEFDY(CIP1),COEFDZ(CIP1),
#endif
     $                       LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                       UZ(IP1),RSP(IP1),
     $                       H3D1(IP3),H3D2(IP3),H3D3(IP3)
#ifdef _TAU_NN_
     $        ,TAU11(IP3),TAU12(IP3),TAU13(IP3)
     $        ,TAU21(IP3),TAU22(IP3),TAU23(IP3)
     $        ,TAU31(IP3),TAU32(IP3),TAU33(IP3)
#endif
C#if defined _PREPROC_
C     $        ,HPX(IP3)
C#endif
     $                       )
C
 
             M0 = 0.0
             M01 = 1.0
             M1 = (-153.0/128.0)
             M2 = (8.0/15.0)*DT

CTBC       ADD M01*UO,VO,WO + M1*FELD1,2,3 TO UO,VO,WO 
           CALL PHIADD (KK,JJ,II,UO(IP3),FELD1(IP3),UO(IP3),
     $      M0,M01,M1)
           CALL PHIADD (KK,JJ,II,VO(IP3),FELD2(IP3),VO(IP3),
     $      M0,M01,M1)       
           CALL PHIADD (KK,JJ,II,WO(IP3),FELD3(IP3),WO(IP3),
     $      M0,M01,M1)
#ifdef _TSCAL_
CTBC               STORE OLD U,V,W IN FELD1,2,3 FOR 
CTBC               THIRD SCALAR RUNGE KUTTA TIME STEP
                   CALL COP3D(KK,JJ,II,U(IP3),FELD1(IP3)) 
                   CALL COP3D(KK,JJ,II,V(IP3),FELD2(IP3))
                   CALL COP3D(KK,JJ,II,W(IP3),FELD3(IP3))
#endif
CTBC         ADD M01*U,V,W + M2*UO,VO,WO TO U,V,W
             CALL PHIADD (KK,JJ,II,U(IP3),UO(IP3),U(IP3),M0,M01,M2)
             CALL PHIADD (KK,JJ,II,V(IP3),VO(IP3),V(IP3),M0,M01,M2)
             CALL PHIADD (KK,JJ,II,W(IP3),WO(IP3),W(IP3),M0,M01,M2)


#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
C                             BELEGEN DES FRONT-BUFFERS
C
              TIMEPH     = TIMEPH + DT
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN

      CALL SETBACKOLD   (KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                  U(IP3),V(IP3),W(IP3)
#ifdef _TSCAL_
     $                  ,TBA(IBB),T(IP3),0
#endif   
     $                  )     

C
C
C
C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN


             IF(LDIEIB) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (UNFOR-
C                                 MATIERT AUF KANAL 11)
C
                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMEPH,DT)
             END IF
             IF(LDIEIC) THEN
C
C                                 EINLESEN DES G-PROFILS UND DER GESCHW.
C                                 PROFILE AM EINTRITTSRAND (FORMATIERT
C                                 AUF KANAL 13)
C

                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
     $                        ZTOT(1),YTOT(1),XTOT(1),
     $                        CIDEND,IIDEND,RIDEND,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
     $                        UGRID,ITSTEP,ITTOT,TIMEPH,DT)
             END IF
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPR (KK,JJ, 2,KK,JJ, 2,
     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),
     $                     GFR(IBB),Y(IP1),Z(IP1),DZ(IP1),VCON,WCON,
     $                     YBANF(1,1,IGRID),YBEND(1,1,IGRID),
     $                     ZBANF(1,1,IGRID),ZBEND(1,1,IGRID),
     $                     FREQB(1,1,IGRID),ANIVEAU(1,1,IGRID),
     $                     AUB(1,1,IGRID),AVB(1,1,IGRID),AWB(1,1,IGRID),
     $                     TIMEPH,DT,UBO,VBO,WBO)
             ENDIF

           ENDIF
           ENDIF
#ifdef _MPI_
       ENDIF
#endif        

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
#ifdef _TSCAL_
     $                   ,T,AT,TFR,0
#endif
     $                   )     
            
         ENDIF
         
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif         
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
                  CALL SV3D (JJ,II, 2,JJ,II, 2,
     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
     $                 GBO(IBB),HILF(IBB),
     $                   Z(IP1),  X(IP1),  Y(IP1),
     $                  DZ(IP1), DX(IP1), DY(IP1),
     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
     $                 VCON,WCON,
     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
     $                 TIMEPH,DT,0)
             ENDIF
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif
         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NBOT)
            
         ENDIF

      ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFVPIT(ILEVEL)
           IGRID = IGRDOFVPIT(I,ILEVEL)
           IF (IPARENT(IGRID) .NE. 0) THEN
	   IPROCF = 0
	   IPROCC = 0
#ifdef _MPI_
           IPROCF = IDPROCOFGRD(IGRID)
           IPROCC = IDPROCOFGRD(IPARENT(IGRID))
       IF (MYID .EQ. IPROCF .OR. MYID .EQ. IPROCC)  THEN
#endif	   

          CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $         NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C
          IF ( LCHILD(IGRID) ) THEN
C
C                                 FRONT BUFFER
C
                  IF (      NFRO .EQ. 2 
     $                 .OR. NFRO .EQ. 11 
     $                 .OR. NFRO .EQ. 12 ) THEN

C                                 BEREITSTELLUNG DER POINTER
C                                 DIMENSIONIERUNGEN DES FEINGITTERS

                CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
                CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,
     $                        IBUC,IPARENT(IGRID))
                
                
                CALL MGBFTC (KK,JJ, 2 ,DX(IP1),DY(IP1),DZ(IP1),
     &               DDX(IP1),DDY(IP1),DDZ(IP1),UFR(IBB),
     &               KKC,JJC, 2 ,DX(IP1C),DY(IP1C),DZ(IP1C),
     &               DDX(IP1C),DDY(IP1C),DDZ(IP1C),UFR(IBBC),
     &               KPOSITION(IGRID),JPOSITION(IGRID),
     &               IPOSITION(IGRID),'U',IPROCF,IPROCC)

             END IF
C
C                                BOTTOM BUFFER
C
             IF (            NBOT .EQ. 2 
     $                  .OR. NBOT .EQ. 11 
     $                  .OR. NBOT .EQ. 12) THEN
          CALL MGDIMS  (KKC,JJC,IIC,IPARENT(IGRID))
          CALL MGPOINT (IP3C,IP2C,IP1C,IBBC,IB3C,IBUC,IPARENT(IGRID))
                CALL MGBFTC (JJ,II, 2 ,DZ(IP1),DX(IP1),DY(IP1),
     &               DDZ(IP1),DDX(IP1),DDY(IP1),WBO(IBB),
     &               JJC,IIC, 2 ,DZ(IP1C),DX(IP1C),DY(IP1C),
     &               DDZ(IP1C),DDX(IP1C),DDY(IP1C),WBO(IBBC),
     &               JPOSITION(IGRID),IPOSITION(IGRID),
     &               KPOSITION(IGRID),'U',IPROCF,IPROCC)
             END IF
          END IF
#ifdef _MPI_
       ENDIF
#endif          
      ENDIF
      ENDDO
      ENDDO
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  Ende der Zeitintegration

#ifdef _FRED_BODY_
c*************TEST*****************+
      DO ILEVEL = MINLEVEL,MAXLEVEL
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

         CALL COP3DZERO(KK,JJ,II,U(IP3),V(IP3),W(IP3),
     $        U(IP3),V(IP3),W(IP3),P(IP3),BP(IP3)
#ifdef _TSCAL_
     $        ,T(IP3)
#endif
     $        )

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'Y',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )


#ifdef _MPI_
       ENDIF
#endif

      ENDDO
      ENDDO
#endif
c*********************TEST**************************


CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  TESTWEISE HIER HOCHTICKERN
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  DES ZEITSCHRITT-ZAEHLERS
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  FUER KORREKTE ANSTEUERUNG
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC  DER RANDBEDINGUNGEN

                   ITSTEP     = ITSTEP + 1
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                           IF BODY IS IN THE COMPUTATIONAL DOMAIN
C                           THE BOUNDARY CONDITIONS FOR IT ARE NOT SET
C                           BEFORE THE FIRST PRESSURE CORRECTION.
C                           BCUBMG IS NOT INCLUDED IF BOUNDMG
C                           IS CALLED WITH ITYP 'P' IN CASE OF 
C                           DEFINE DIRECTIVE '_AVOIDLOADIMBALANCE_'
C                           SO BOUNDMG HAS TO BE CALLED WITH ITYP 'T'.
C                           NOCH EINMAL WERDEN RANDBEDINGUNGEN FUER 
C                           GITTER GESETZT
C
C                             BOUND und BPARMG ZWEIMAL
C      DO ICOUNT =1,2
C
C                               FILL THE BOUNDARY BUFFER FOR LOCAL GRIDS
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
         CALL BPARMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VRI,WBO,DUDY,DUDZ,DVDX,
     $              UTO,VTO,WTO,PTO,GTO,UBA,VBA,WBA,PBA,GBA,
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL)
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO
#endif
     $             )     
      ENDDO



      DO ILEVEL = MINLEVEL,MAXLEVEL
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

            CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )    

#ifdef _MPI_
       ENDIF
#endif
 
         ENDDO
         ENDDO
C                             BOUND und BPARMG ZWEIMAL
C      ENDDO
C
C                                 IMPLIZITER TEIL UEBER ALLE GITTER
C                                 DRUCKKORREKTUR
C
                               WSOR = 1.0
#ifdef _POISSONITER_

         CALL MGPOISL1    (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                    X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                    RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                    U,V,W,P,DP,G,B,DIV,RES,
     $                    UFR,VFR,WFR,
     $                    UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                    WSOR,RHO,DIVG,IPRGRID,
     $                    MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                    UBA,VBA,WBA,PBA,GBA,UBO,VBO,WBO,
     $                    PFR,GFR,
     $                    GSAW,GSAE,GSAN,GSAS,GSAT,GSAB,
     $                    BP,BU,BV,BW,SDIV
#ifdef _SIP_ITER_
     $                    ,GEOVP,SIPLW,SIPLS,
     $                    SIPLB,SIPLPR,SIPUE,SIPUN,SIPUT
#else
     $                    ,GSRAP
#endif
#ifdef _TSCAL_
     $                    ,T,TFR,TBA,TTO,TBO
#endif
     $                    )
#else                               
         CALL MGVPL1 (IDIM3D,IDIM2D,IDIM1D,NBND,
     $                X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                RDX,RDY,RDZ,RDDX,RDDY,RDDZ,
     $                FPSFAK,FCOSMY,FCOSNY,
     $                IFFTX,IPERMUX,RFFTX,IFFTY,IPERMUY,RFFTY,     
     $                U,V,W,P,DP,G,B,BP,BU,BV,BW,SDIV,
     $                DIV,UFR,VFR,WFR,
     $                UTO,VTO,WTO,PTO,GTO,VRI,HILF,
     $                DUDY,DUDZ,DVDX,DVDZ,DWDX,DWDY,
     $                WSOR,RHO,DIVG,IPRGRID,
     $                MINLEVEL,MAXLEVEL,MAXLEVEL,TIMEPH,
     $                UBA,VBA,WBA,PBA,GBA,GEOVP,UBO,VBO,WBO,
     $                PFR,GFR
#ifdef _HITACHI_
     $   ,CXY,CTB,CWK,CHILF
#endif
#ifdef _TSCAL_
     $               ,T,TFR,TBA,TTO,TBO
#endif
     $                )              
C
#endif
C
C               REDUZIERUNG DES DRUCKNIVEAUS FUER GEWUENSCHTE GITTER
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (LPLEVEL(IGRID)) THEN
           CALL MGDIMS  (KK,JJ,II,IGRID)
           CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)
           CALL MGBASB  (NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
#ifdef _FRED_BODY_

           CALL PLEVEL  (KK,JJ,II,KK,JJ,II,P(IP3),BP(IP3),
     $                   DDX(IP1), DDY(IP1), DDZ(IP1),NFRO,NRGT,NBOT)
#else
           CALL PLEVEL  (KK,JJ,II,KK,JJ,II,P(IP3),B(IP3),
     $                   DDX(IP1), DDY(IP1), DDZ(IP1),NFRO,NRGT,NBOT)
#endif           
        ENDIF
#ifdef _MPI_
       ENDIF
#endif
      ENDDO
      ENDDO
C
#ifdef _TSCAL_
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
CTBA  SCALAR TRANSPORT THIRD FINAL RUNGE KUTTA TIME STEP CCCCCCCCCCCCCCC
C
                   ITSTEP     = ITSTEP - 1
C 
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN      	
#endif
           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)
C          GET ITYP OF SCALAR BOUNDARY CONDITION
           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)    
#ifdef _FRED_BODY_
          CIP1 = 12*3*(IP1-1)+1
#endif

#ifdef _RUNGEKUTTA3SCADELAYED_
C          SET NEW BOUNDARY CONDITIONS
           CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
     $             ,T,TFR,TBA,TTO,TBO
     $             ) 
CTBC       STORE NEW U,V,W IN FELD1,2,3 FOR 
CTBC       DELAYED THIRD SCALAR RUNGE KUTTA TIME STEP
           CALL COP3D(KK,JJ,II,U(IP3),FELD1(IP3)) 
           CALL COP3D(KK,JJ,II,V(IP3),FELD2(IP3))
           CALL COP3D(KK,JJ,II,W(IP3),FELD3(IP3))
#endif

           CALL DPHI0(KK,JJ,II,KK,JJ,II,TO(IP3))  
#ifdef _SCALTRANSDIAGNOSE_
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTE(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTW(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTN(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTS(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTT(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,OCTB(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTE(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTW(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTN(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTS(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTT(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTB(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,ODTC(IP3))
#endif                     
           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
CTBC                    OLD/NEW U,V,W STORED IN FELD1,2,3      
     $                  FELD1(IP3),FELD2(IP3),FELD3(IP3),T(IP3),TO(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3), 
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART, TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else 
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif      
#ifdef _SCALTRANSDIAGNOSE_
     $                ,OCTE(IP3),OCTW(IP3),OCTN(IP3),OCTS(IP3),
     $                 OCTT(IP3),OCTB(IP3),ODTE(IP3),ODTW(IP3),
     $                 ODTN(IP3),ODTS(IP3),ODTT(IP3),ODTB(IP3),ODTC(IP3)
#endif          
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))
CTBC       SET TO =  M01*TO + M1*FELDT  
           CALL PHIADD (KK,JJ,II,TO(IP3),FELDT(IP3),TO(IP3),M0,M01,M1)
CTBC       SET T = M01*T + M2*TO
           CALL PHIADD (KK,JJ,II,T(IP3),TO(IP3),T(IP3),M0,M01,M2)
CTBC       WRITE BACK TOLD TO TO FOR LATER DTMX CALCULATION
           CALL COP3D(KK,JJ,II,TOLD(IP3),TO(IP3))
#ifdef _SCALTRANSDIAGNOSE_                                              
          CALL PHIADD (KK,JJ,II,OCTE(IP3),FCTE(IP3),OCTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,OCTW(IP3),FCTW(IP3),OCTW(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,OCTN(IP3),FCTN(IP3),OCTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,OCTS(IP3),FCTS(IP3),OCTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,OCTT(IP3),FCTT(IP3),OCTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,OCTB(IP3),FCTB(IP3),OCTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTE(IP3),FDTE(IP3),ODTE(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTW(IP3),FDTW(IP3),ODTW(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTN(IP3),FDTN(IP3),ODTN(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTS(IP3),FDTS(IP3),ODTS(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTT(IP3),FDTT(IP3),ODTT(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTB(IP3),FDTB(IP3),ODTB(IP3),M0,M01,M1)
          CALL PHIADD (KK,JJ,II,ODTC(IP3),FDTC(IP3),ODTC(IP3),M0,M01,M1)
                                                                        
          CALL PHIADD (KK,JJ,II,QCTE(IP3),OCTE(IP3),QCTE(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTW(IP3),OCTW(IP3),QCTW(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTN(IP3),OCTN(IP3),QCTN(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTS(IP3),OCTS(IP3),QCTS(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTT(IP3),OCTT(IP3),QCTT(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QCTB(IP3),OCTB(IP3),QCTB(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTE(IP3),ODTE(IP3),QDTE(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTW(IP3),ODTW(IP3),QDTW(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTN(IP3),ODTN(IP3),QDTN(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTS(IP3),ODTS(IP3),QDTS(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTT(IP3),ODTT(IP3),QDTT(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTB(IP3),ODTB(IP3),QDTB(IP3),M0,M01,M2)
          CALL PHIADD (KK,JJ,II,QDTC(IP3),ODTC(IP3),QDTC(IP3),M0,M01,M2)
#endif
#ifdef _MPI_
         ENDIF
#endif
#ifdef _DECONVOLVESCA_
      CALL DECONVOLVSCA(KK,JJ,II,T(IP3),H3D1(IP3),H3D2(IP3),
     $        H3D3(IP3),HILF3D4(IP3),HILF3D5(IP3),
     $        FTI(IP3),FTJ(IP3),FTK(IP3),
     $        DZ(IP1), DX(IP1), DY(IP1),
     $        NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,NTOPSCA,IGRID,
     $        TFX(IP1),TFY(IP1))
#endif
      ENDDO
      ENDDO


C                             BELEGEN DES FRONT-BUFFERS
C

C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
      DO ILEVEL = MAXLEVEL,MINLEVEL,-1
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)

         CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $               NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)


#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

C                      SETBACKOLD BELEGT DIE FELDER UBA,VBA,WBA MIT DEN
C                      GESCHW. DER I-EBENEN IM1,IM2,IM3, DIE FUER DIE
C                      KONVEKTIVE FORMULIERUNG DER AUSSTROEMRANDBEDINGUNG
C                      BENOETIGT WERDEN
CTBC                   HERE APPLIED TO T ONLY
         CALL SETBACKOLD(KK,JJ,II,KK,JJ,II,UBA(IBB), VBA(IBB), WBA(IBB),
     $                   U(IP3),V(IP3),W(IP3),TBA(IBB),T(IP3),1)     

C
         IF ( NFRO .EQ. 2 .OR. NFRO .EQ. 11) THEN

           IF (IVPCHILD(IGRID).EQ.0) THEN
C
C     DEIBI, DEICI NOT YET IMPLEMENTED FOR SCALAR T
C             IF(LDIEIB) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (UNFOR-
CC                                 MATIERT AUF KANAL 11)
CC
C                CALL DEIBI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF(LDIEIC) THEN
CC
CC                                 EINLESEN DES G-PROFILS UND DER GESCHW.
CC                                 PROFILE AM EINTRITTSRAND (FORMATIERT
CC                                 AUF KANAL 13)
CC
C
C                CALL DEICI   (KMX(1),JMX(1),IMX(1),KMX(1),JMX(1),IMX(1),
C     $                        ZTOT(1),YTOT(1),XTOT(1),
C     $                        CIDEND,IIDEND,RIDEND,
C     $                     UFR(IBB),VFR(IBB),WFR(IBB),PFR(IBB),GFR(IBB),
C     $                        UI1,VI1,WI1,UI2,VI2,WI2,GI1,GI2,
C     $                        UGRID,ITSTEP,ITTOT,TIMERK,DT)
C             END IF
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
               CALL SVEIPRSCA (KK,JJ, 2,KK,JJ, 2,
     $                         TFR(IBB),Y(IP1),Z(IP1),DZ(IP1),
     $                         TIMEPH,DT,IGRID) 
C             ENDIF
C
           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif        

         IF ( NFRO .EQ. 11 .OR. NFRO .EQ. 12) THEN        	
            CALL MGSVFLU (U,V,W,P,G,AU,AV,AW,
     $                    HILF,UFR,VFR,WFR,PFR,GFR,X,Y,Z,
     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
     $                    NBND,IGRID,ITSTEP,1,NFRO
     $                   ,T,AT,TFR,1)
            
         ENDIF
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
C
C                             BELEGEN DES BOTTOM-BUFFERS
C                             BEI FOLGENDEN AUFRUFEN IST I MIT K VERTAUSCHT!
C
         IF ( NBOT .EQ. 2 .OR. NBOT .EQ. 11) THEN
      STOP 
     $'FIXED/FLUCTUATION BOUNDARY AT BOTTOM NOT IMPLEMENTED FOR SCALAR'

C           IF (IVPCHILD(IGRID).EQ.0) THEN
C                                            REGULAERES GITTER
C             IF((.NOT.LDIEIB).AND.(.NOT.LDIEIC)) THEN
C                  CALL SV3D (JJ,II, 2,JJ,II, 2,
C     $                 WBO(IBB),UBO(IBB),VBO(IBB),PBO(IBB),
C     $                 GBO(IBB),HILF(IBB),
C     $                   Z(IP1),  X(IP1),  Y(IP1),
C     $                  DZ(IP1), DX(IP1), DY(IP1),
C     $                 DDZ(IP1),DDX(IP1),DDY(IP1),
C     $                 VCON,WCON,
C     $                 YBANF(1,5,IGRID),YBEND(1,5,IGRID),
C     $                 XBANF(1,5,IGRID),XBEND(1,5,IGRID),
C     $                 ZBANF(1,5,IGRID),ZBEND(1,5,IGRID),
C     $                 FREQB(1,5,IGRID),ANIVEAU(1,5,IGRID),
C     $                 AUB(1,5,IGRID),AVB(1,5,IGRID),AWB(1,5,IGRID),
C     $                 TIMEPH,DT,0)
C             ENDIF
C           ENDIF
         ENDIF
#ifdef _MPI_
       ENDIF
#endif
         IF ( NBOT .EQ. 11 .OR. NBOT .EQ. 12) THEN
             STOP
     $'FLUCTUATION/RECYCLING BOUNDARY AT BOTTOM NOT IMPL. FOR SCALAR' 
C            CALL MGBOFLU (U,V,W,P,G,AU,AV,AW,
C     $                    HILF,UBO,VBO,WBO,PBO,GBO,X,Y,Z,
C     $                    IDIM3D,IDIM2D,IDIM1D,IDIMA,
C     $                    NBND,IGRID,ITSTEP,1,NBOT)
C            
         ENDIF

      ENDDO
      ENDDO

CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C-----------------------------------------------------------------------
C    NOW SCALAR TRANSPORT ON FINE GRID IF LSCAI = TRUE 1st RK STEP
C-----------------------------------------------------------------------
      DO ILEVEL = MINLEVEL,MAXLEVEL
C
        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)

           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD1(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD2(IP3))
           CALL DPHI0(KK,JJ,II,KK,JJ,II,FELD3(IP3))
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD1(IP3),
     $                     FELD1(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'U')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD2(IP3),
     $                     FELD2(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'V')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),FELD3(IP3),
     $                     FELD3(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'W')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),W(IP3),W(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'W')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),U(IP3),U(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'U')
           CALL COTOFINE3D(KK,JJ,II,KKC,JJC,IIC,DX(IP1),DY(IP1),DZ(IP1),
     $                     DX(IP1C),DY(IP1C),DZ(IP1C),V(IP3),V(IP3C),
     $                     H3D1(IP3),X(IP1),Y(IP1),Z(IP1),
     $                     X(IP1C),Y(IP1C),Z(IP1C),'V')

#ifdef _MPI_
       ENDIF
#endif
       ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

            CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              FELD1,FELD2,FELD3,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )
            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )
#ifdef _MPI_
        ENDIF
#endif

        ENDDO

        DO I = 1,NOFSCAI(ILEVEL)
           IGRID = IGRDOFSCAI(I,ILEVEL)

#ifdef _MPI_
         IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif
        IF (.NOT.LCHILD(IGRID)) THEN
           WRITE(6,*)'ERROR IN TST3RK, SCAI'
        ENDIF

           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $          NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

           CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $        NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,IPARENT(IGRID))

           CALL MGBASBSCA (NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,NBOTSCA,
     $                     NTOPSCA,NCUBSCA,IGRID)


           IDUZSCA = 2
           CALL WIFAK  (ITSTEP,ITMIT,
     $                  WPHISCA,WKONSCA,WDIFSCA,WSORSCA,IDUZSCA)
           CALL TSTSCA4(KK,JJ,II,KK,JJ,II,
     $                  X(IP1),Y(IP1),Z(IP1),
     $                  DX(IP1),DY(IP1),DZ(IP1),
     $                  DDX(IP1),DDY(IP1),DDZ(IP1),
     $                  RDX(IP1),RDY(IP1),RDZ(IP1),
     $                  RDDX(IP1),RDDY(IP1),RDDZ(IP1),
     $                  FELD1(IP3),FELD2(IP3),FELD3(IP3),T(IP3),TO(IP3),
     $                  P(IP3),G(IP3),B(IP3),DT,WCT(IP3), 
#ifdef _FRED_BODY_
     $                  BP(IP3),BU(IP3),BV(IP3),BW(IP3),
#endif
     $                  LTXSTART, TXSTART,NBUF,ITSTEP,
     $                  WKONSCA,WDIFSCA,WSORSCA,
     $                  IC1(IGRID),IC2(IGRID),
     $                  JC1(IGRID),JC2(IGRID),
     $                  KC1(IGRID),KC2(IGRID),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                  NFROSCA,NBACSCA,NRGTSCA,NLFTSCA,
     $                  NBOTSCA,NTOPSCA,NCUBSCA,
     $                  RSGS3(IP3),
#ifndef _FRED_BODY_
     $                  FAKTOR(IP1),
#else
     $                  FAKTOR(IP3),
#endif
     $                  FTI(IP3),
     $                  FTJ(IP3),
     $                  FTK(IP3),
#ifndef _FRED_BODY_
     $                  COEFTX(IP2),COEFTY(IP2),COEFTZ(IP2),
#else 
     $                  COEFTX(CIP1),COEFTY(CIP1),COEFTZ(CIP1),
#endif
     $                  LCOL(IP1),DIAG(IP1),RCOL(IP1),
     $                  UZ(IP1),RSP(IP1),IGRID,
     $                  PRTMAX(IGRID),
     $                  XPRTMAX(IGRID),YPRTMAX(IGRID),ZPRTMAX(IGRID),
     $                  PRTMIN(IGRID),
     $                  XPRTMIN(IGRID),YPRTMIN(IGRID),ZPRTMIN(IGRID)
#ifdef _SCALGRIDDIAGNOSE_
     $                 ,DDSPLUS(IP3),SMPLUS(IP3),SPLUS(IP3)
#endif      
#ifdef _SCALTRANSDIAGNOSE_
     $                ,OCTE(IP3),OCTW(IP3),OCTN(IP3),OCTS(IP3),
     $                 OCTT(IP3),OCTB(IP3),ODTE(IP3),ODTW(IP3),
     $                 ODTN(IP3),ODTS(IP3),ODTT(IP3),ODTB(IP3),ODTC(IP3)
#endif          
     $                 ,H3D1(IP3),H3D2(IP3),H3D3(IP3))

             M0 = 0.0
             M01 = 1.0
             M1 = (-153.0/128.0)
             M2 = (8.0/15.0)*DT

           CALL PHIADD (KK,JJ,II,TO(IP3),FELDT(IP3),TO(IP3),M0,M01,M1)
           CALL PHIADD (KK,JJ,II,T(IP3),TO(IP3),T(IP3),M0,M01,M2)
           CALL COP3D(KK,JJ,II,TOLD(IP3),TO(IP3))
#ifdef _MPI_
         ENDIF
#endif

        ENDDO
      ENDDO
C                                  LEVELS FROM FINE TO COARSE, IN
C                                  ORDER TO PROPAGATE BOUNDARY-COND.
C                                  FROM FINE TO COARSE GRIDS
CCCCCCCCCCCCC FINE GRID PROCESSING NOT YET IMPLEMENTED FOR SCALAR T
C
                   ITSTEP     = ITSTEP + 1
C
C                               FILL THE BOUNDARY BUFFER FOR LOCAL GRIDS
C
      DO ILEVEL = MINLEVEL,MAXLEVEL
         CALL BPARMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VRI,WBO,DUDY,DUDZ,DVDX,
     $              UTO,VTO,WTO,PTO,GTO,UBA,VBA,WBA,PBA,GBA,
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL)
     $             ,T,TFR,TBA,TTO
     $             )     
      ENDDO
C
CTBA  END SCALAR TRANSPORT THIRD FINAL RUNGE KUTTA TIME STEP CCCCCCCCCCC
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
#endif
C
C                           NOCH EINMAL WERDEN RANDBED. FUER ALLE 
C                           GITTER GESETZT
C

      DO ILEVEL = MINLEVEL,MAXLEVEL

C
C                                 BEI MESSAGE-PASSING, KOMMUNIKATION
C
         CALL CONNECTMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#else     
     $              U,V,W,P,G,B,UFR,VRI,WBO,HILF,UTO,VTO,WTO,PTO,GTO,
#endif 
     $              VFR,WFR,PFR,GFR,
     $              'T',ILEVEL,0,0,0,
     $              NOFTST(ILEVEL),IGRDOFTST(1,ILEVEL))

Cendif
        DO I = 1,NOFTST(ILEVEL)
           IGRID = IGRDOFTST(I,ILEVEL)
#ifdef _MPI_
       IF (MYID .EQ. IDPROCOFGRD(IGRID))  THEN
#endif

            CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)

            CALL BOUNDMG
     $             (IDIM3D,IDIM2D,IDIM1D,
     $              X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $              U,V,W,P,G,B,UFR,VFR,WFR,VRI,HILF,
     $                 UTO,VTO,WTO,PTO,GTO,
     $              'T',IGRID,0,0,0,TIMEPH,UBA,VBA,WBA,
     $              PBA,GBA,UBO,VBO,WBO,
     $              PFR,GFR
#ifdef _TSCAL_
     $             ,T,TFR,TBA,TTO,TBO
#endif
     $             )     

C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),20,IMX-1)
C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),21,IMX-2)
C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),22,IMX-3)
C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),30,2)
C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),31,3)
C      CALL WRITE3DDIAGX (KMX,JMX,IMX,T(IP3),32,4)
C      STOP 'TST3RK'

#ifdef _MPI_
       ENDIF
#endif
         ENDDO
         ENDDO


CCC TESTWEISE vor Aufruf TST1G in MLET GESCHALTET  TIMEPH     = TIMEPH + DT
CCC TESTWEISE vor Aufruf von MGSVFLU                   ITSTEP     = ITSTEP + 1
C                   TIMEPH     = TIMEPH + DT
                   ITTOT      = ITTOT  + 1
C
C                                 **************************************
C                                 VOLLSTAENDIGER ZEITSCHRITT ABGESCHLOSS
C                                 **************************************
                                
      RETURN
      END
