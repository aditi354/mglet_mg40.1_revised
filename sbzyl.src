      SUBROUTINE SBZYL (KK,JJ,II,KMX,JMX,IMX,
     $                  XB1,XB2,YB1,YB2,ZB1,ZB2,CDIR,
     $                  B,HILF,X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,BPAR)
C*STARLET***************************************************************
C        S B Z Y L      BELEGUNG DES WANDERKENNUNGSFELDES  
C                       FUER ZYLINDER 
C*STARLET***************************************************************
C
C PARAM: B              + WANDERKENNUNGSFELD FUER KOERPER IM BERECHNUNGS
C                       + GEBIET:
C
C                             B>0.0  ==> IM BERECHNUNGSGEBIET
C                             B=-1.0 ==> NOSLIP-WAND
C                             B=-2.0 ==>   SLIP-WAND
C
C        HILF           - HILFSFELD
C        KK,JJ,II       - ARRAYDIMENSIONEN
C        KMX,JMX,IMX    - GRENZEN DES BERECHNUNGSGEBIETS (MIT BOUND)
C
C        CDIR           - ZEIGT RICHTUNG DER ZYLINDERACHSE AN 
C        XB1,XB2        - AUSDEHNUNG IN X-RICHTUNG
C        YB1,YB2        - AUSDEHNUNG IN Y-RICHTUNG
C        ZB1,ZB2        - AUSDEHNUNG IN Z-RICHTUNG
C
C VERS:  23. 4.92 (MM)  - ORIGINAL
C
C UPROG                 : ERRR
C
C*STARLET***************************************************************
C
#include "konsta.h"
#include "conles.h"

      REAL        X(II),         Y(JJ),         Z(KK),
     $           DX(II),        DY(JJ),        DZ(KK),
     $          DDX(II),       DDY(JJ),       DDZ(KK),
     $            B(KK,JJ,II),HILF(KK,JJ,II)

      CHARACTER (LEN=1) CDIR

C
        IM1  = IMX-1
        IM2  = IMX-2
        IM3  = IMX-3
        JM1  = JMX-1
        JM2  = JMX-2
        JM3  = JMX-3
        KM1  = KMX-1
        KM2  = KMX-2
        KM3  = KMX-3
C
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                                   ACHSE IN X-RICHTUNG
C
      IF (CDIR.EQ.'X') THEN

       DO 72 I=3,IM2
       DO 72 J=3,JM2
       DO 72 K=3,KM2

           HILF(K,J,I) = 
C
C                            ELLYPSE IN Y-Z-EBENE
C
     $   (Y(J)-YB1)**2/YB2**2
     $  +(Z(K)-ZB1)**2/ZB2**2
     $  -1.0
C
C                            SPRUNGFUNKTIONEN IN X-RICHTUNG
C
     $   + SIGN(1.0,(XB1-X(I))+1.0)
     $   + SIGN(1.0,(X(I)-XB2)+1.0)

   72   CONTINUE

      ENDIF

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                                   ACHSE IN Y-RICHTUNG
C
      IF (CDIR.EQ.'Y') THEN

       DO 97 I=3,IM2
       DO 97 J=3,JM2
       DO 97 K=3,KM2

           HILF(K,J,I) = 
C
C                            ELLYPSE IN X-Z-EBENE
C
     $   (X(I)-XB1)**2/XB2**2
     $  +(Z(K)-ZB1)**2/ZB2**2
     $  -1.0
C
C                            SPRUNGFUNKTIONEN IN Y-RICHTUNG
C
     $   + SIGN(1.0,(YB1-Y(I))+1.0)
     $   + SIGN(1.0,(Y(I)-YB2)+1.0)

   97   CONTINUE

      ENDIF

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                                   ACHSE IN Z-RICHTUNG
C
      IF (CDIR.EQ.'Z') THEN 

       DO 122 I=3,IM2
       DO 122 J=3,JM2
       DO 122 K=3,KM2

           HILF(K,J,I) = 
C
C                            ELLYPSE IN X-Y-EBENE
C
     $   (X(I)-XB1)**2/XB2**2
     $  +(Y(J)-YB1)**2/YB2**2
     $  -1.0
C
C                            SPRUNGFUNKTIONEN IN X-RICHTUNG
C
     $   + SIGN(1.0,(ZB1-Z(K))+1.0)
     $   + SIGN(1.0,(X(K)-ZB2)+1.0)

  122   CONTINUE

      ENDIF

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                             HINZUFUEGEN DES NEUEN KOERPERS ZU 'B'
C
       DO 145 I=3,IM2
       DO 145 J=3,JM2
       DO 145 K=3,KM2

               B(K,J,I) = -BPAR    *(SIGN(0.5,HILF(K,J,I)) - 0.5)
     $                    +B(K,J,I)*(SIGN(0.5,HILF(K,J,I)) + 0.5)

  145   CONTINUE
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
        RETURN
        END
