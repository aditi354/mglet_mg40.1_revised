      SUBROUTINE BLESLI (KMX,JMX,IMX,
     $                    U,V,W,P,G,
     $                    ISTART,ISTOP,KSTART,KSTOP,ITYP
#ifdef _TSCAL_
     $                   ,T
#endif
     $                   )     
C*STARLET***************************************************************
C        B L E S L I    SETZEN DER RANDBEDINGUNGEN FUER DIE
C                         GESCHWINDIGKEITSFELDER AND SCALAR T.
C                         (LARGE-EDDY-SIMULATION)
C*STARLET***************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        V(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        W(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        T(KMX,JMX,IMX) + SCALAR T FIELD
C        P(KMX,JMX,IMX) - DRUCKFELD
C        G(KMX,JMX,IMX) - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:   8. 3.93 (MM)  : ORIGINAL
C                         AUS BLFTLE (BLFTL) ABGELEITET
C        28.02.03 (TB)  : SCALAR BOUNDARY TREATMENT IMPLEMENTED
C
C DEFINE-DIREKTIVEN     : QUD 
C
C*STARLET***************************************************************
C
#include "konsta.h"
C
      CHARACTER (LEN=1)  ITYP
C
      REAL
     $            U(KMX,JMX,IMX),   V(KMX,JMX,IMX),   W(KMX,JMX,IMX),
     $            P(KMX,JMX,IMX),   G(KMX,JMX,IMX)
C
#ifdef _TSCAL_
      REAL        T(KMX,JMX,IMX)
#endif
C
      JM1 = JMX-1
      JM2 = JMX-2
      JM3 = JMX-3
C
C                                 **************************************
C                                 REIBUNGSLOSE, UNDURCHLAESSIGE WAND
C                                 **************************************
C
C
         IF (ITYP.EQ.'T') THEN 
         DO I=ISTART,ISTOP
         DO K=KSTART,KSTOP

               U(K,JM1,I) = 0.0
               V(K,JM2,I) = 0.0
               W(K,JM1,I) = 0.0
               P(K,JM1,I) = 0.0
               G(K,JM1,I) = 2.0*SMALL
#ifdef _TSCAL_
               T(K,JM1,I) = T(K,JM2,I)
#endif

         ENDDO
         ENDDO


#ifdef _QUD_

         DO I=ISTART,ISTOP
         DO K=KSTART,KSTOP

               U(K,JMX,I) = 0.0
               V(K,JM1,I) = 0.0
               W(K,JMX,I) = 0.0
#ifdef _TSCAL_
               T(K,JMX,I) = T(K,JM2,I)
#endif

         ENDDO
         ENDDO

#endif
         ELSEIF (ITYP.EQ.'P') THEN
         DO I=ISTART,ISTOP
         DO K=KSTART,KSTOP
               V(K,JM2,I) = 0.0
         ENDDO
         ENDDO
         ENDIF
      RETURN
      END


