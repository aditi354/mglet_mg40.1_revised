#define _WRITE_PARTICLES_
      SUBROUTINE STRESS (NFAM, RR, RRRREE, DUPART, TAU, IT, DT, 
     $                   RMU0,RMU1,RMU2,RMU3,RMU4,GMOL,VOL_FRAC,LOUT)

      REAL DUPART(NFAM,3,3), RR(NFAM,3,3), RRRREE(NFAM,3,3) 


#ifdef _VPP_
      PARAMETER ( NFAM_MAX = 1000000 )

      REAL DRRRR(3,3), DRR(NFAM_MAX,3,3), RRD(NFAM_MAX,3,3), 
     $     D(NFAM_MAX,3,3), 
     $     D_RR(NFAM_MAX)

      REAL TAU(NFAM,3,3)

      REAL RMU0,RMU1,RMU2,RMU3,RMU4

      LOGICAL LOUT

C-------------------------------------------   CHECK FOR DIMENSION

      IF (NFAM .GT. NFAM_MAX) CALL ERRR (502,' STRESS ')


      DO IFAM = 1,NFAM
        D_RR(IFAM) = 0.0
      ENDDO

      DO J = 1,3
         DO I = 1,3
            DO IFAM = 1,NFAM

C------------------------------------------- SYMMETRIC PART OF GRADIENT
C                                            TENSOR

            D(IFAM,I,J) = 0.5*(DUPART(IFAM,I,J) + DUPART(IFAM,J,I))


C---------------------------------------- D:<RR>


            D_RR(IFAM) = D_RR(IFAM) + D(IFAM,I,J)*RR(IFAM,I,J)
C            ENDDO
C         ENDDO
C      ENDDO


C---------------------------------------- D:<RRRR> = RRRREE

C---------------------------------------- D*<RR> UND <RR>*D

C      DO J=1,3
C         DO I=1,3
C            DO IFAM = 1,NFAM
            DRR(IFAM,I,J) = D(IFAM,I,1)*RR(IFAM,1,J) + 
     $                      D(IFAM,I,2)*RR(IFAM,2,J) + 
     $                      D(IFAM,I,3)*RR(IFAM,3,J)
            RRD(IFAM,I,J) = RR(IFAM,I,1)*D(IFAM,1,J) +  
     $                      RR(IFAM,I,2)*D(IFAM,2,J) +  
     $                      RR(IFAM,I,3)*D(IFAM,3,J)
C            ENDDO
C         ENDDO
C      ENDDO



C---------------------------------------- SPANNUNGSTENSOR

C      DO J = 1,3
C         DO I = 1,3
C
C            DO IFAM = 1,NFAM

            TAU(IFAM,I,J) =   2.0*RMU0 * D(IFAM,I,J) 
     $                 + RMU2 * RRRREE(IFAM,I,J)
     $                 + 2.0*RMU3 * (DRR(IFAM,I,J) + RRD(IFAM,I,J))
     $                 + RMU4 * (3.0*RR(IFAM,I,J))

C            write (6,*) 'i,j,D(i,j)',i,j,d(i,j)
C            write (6,*) 'i,j,RRRREE(i,j)',i,j,RRRREE(i,j)
C            write (6,*) 'i,j,DRR(i,j),RRD',i,j,DRR(i,j),RRD(i,j)
C            write (6,*) 'i,j,RR(i,j)',i,j,RR(i,j)
            ENDDO
         ENDDO
      ENDDO
C            write (86,*) 'mu_0,...,D_RR',RMU0,RMU1,RMU2,RMU3,RMU4,D_RR
C      goto 1

C------------------------------------------- LOOP OVER ALL FAMILIES


      DO I = 1,3
      DO IFAM = 1,NFAM
         TAU(IFAM,I,I) = TAU(IFAM,I,I) + RMU1 * D_RR(IFAM)
     $                       - RMU4
      ENDDO

C1     continue
C--------------------------------------- FAMILLIES FINISHED
      ENDDO

C                        VECTOR VERSION FINISHED
#else
      REAL DRRRR(3,3), DRR(3,3), RRD(3,3), D(3,3)

      REAL TAU(NFAM,3,3)

      REAL RMU0,RMU1,RMU2,RMU3,RMU4

      LOGICAL LOUT

C      write (6,*)'stress',nfam,it,dt
C      write (6,*)'stress',RMU0,RMU1,RMU2,RMU3,RMU4,gmol


C------------------------------------------- LOOP OVER ALL FAMILIES
      DO IFAM = 1,NFAM
C      DO IFAM = 1,1

C------------------------------------------- SYMMETRIC PART OF GRADIENT
C                                            TENSOR

      DO J = 1,3
         DO I = 1,3
            D(I,J) = 0.5*(DUPART(IFAM,I,J) + DUPART(IFAM,J,I))
         ENDDO
      ENDDO

C---------------------------------------- D:<RR>

      D_RR = 0.0

      DO J = 1,3
         DO I = 1,3
            D_RR = D_RR + D(I,J)*RR(IFAM,I,J)
         ENDDO
      ENDDO


C---------------------------------------- D:<RRRR> = RRRREE

C---------------------------------------- D*<RR> UND <RR>*D

      DO J=1,3
         DO I=1,3
            DRR(I,J) = D(I,1)*RR(IFAM,1,J) + 
     $                 D(I,2)*RR(IFAM,2,J) + 
     $                 D(I,3)*RR(IFAM,3,J)
            RRD(I,J) = RR(IFAM,I,1)*D(1,J) +  
     $                 RR(IFAM,I,2)*D(2,J) +  
     $                 RR(IFAM,I,3)*D(3,J)
         ENDDO
      ENDDO



C---------------------------------------- SPANNUNGSTENSOR

      DO J = 1,3
         DO I = 1,3

            TAU(IFAM,I,J) =   2.0*RMU0 * D(I,J) 
     $                 + RMU2 * RRRREE(IFAM,I,J)
     $                 + 2.0*RMU3 * (DRR(I,J) + RRD(I,J))
     $                 + RMU4 * (3.0*RR(IFAM,I,J))

C            write (6,*) 'i,j,D(i,j)',i,j,d(i,j)
C            write (6,*) 'i,j,RRRREE(i,j)',i,j,RRRREE(i,j)
C            write (6,*) 'i,j,DRR(i,j),RRD',i,j,DRR(i,j),RRD(i,j)
C            write (6,*) 'i,j,RR(i,j)',i,j,RR(i,j)
         ENDDO
      ENDDO
C            write (86,*) 'mu_0,...,D_RR',RMU0,RMU1,RMU2,RMU3,RMU4,D_RR
C      goto 1

      DO I = 1,3
         TAU(IFAM,I,I) = TAU(IFAM,I,I) + RMU1 * D_RR
     $                       - RMU4
      ENDDO

C1     continue
C--------------------------------------- FAMILLIES FINISHED
      ENDDO

C                               SCALAR VERSION FINISHED
#endif

#ifdef _WRITE_PARTICLES_

      IFAM = 100

C      IF (LOUT) THEN
         WRITE (31,1000) IT*DT,
     $        TAU(IFAM,1,1),TAU(IFAM,1,2),TAU(IFAM,1,3),
     $        TAU(IFAM,2,2),TAU(IFAM,2,3),TAU(IFAM,3,3)
C      ENDIF
#endif


      RETURN
 1000 FORMAT (E12.5E3, 6(1X,E12.5E3))
      END
