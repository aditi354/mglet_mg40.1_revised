      SUBROUTINE BBACONBP (
     $     KMX,JMX,IMX,BP,
     $     KMXN,JMXN,IMXN,BPN,
     $     JSTA,JSTO,KSTA,KSTO,
     $     IPOS,JPOS,KPOS,
     $     IPROC,IPROCNBR)
C     *MGLET*****************************************************************
C     B B A C O N B P   SETZEN DER RANDBEDINGUNGEN FUER DIE
C     GESCHWINDIGKEITSFELDER. AUS NACHBARN
C     *MGLET*****************************************************************
C     
C  KREUZINGER UND MANHART TURBULENZ GmbH
C  JK      11. 8.2005
C  aus BBACON
C
C     PARAM: 
C     KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C     U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C     JSTART,JSTOP
C     KSTART,KSTOP   - BEREICH IN DEM RANDBEDINGUNG GESETZT WIRD
C     IPOS,JPOS,KPOS - POSITION IM NACHBARGITTER, AUF DER DER PUNKT
C     MIT DEN INDIZES (3,3,3) ZU LIEGEN KOMMT
C     
C     *STARLET***************************************************************
C     
#ifdef _MPI_
C     
C     MPI-INCLUDE
C     
#include "mgpar.h"
#include "colevel.h"
#include "compi.h"
#include "mpif.h"
#endif
C     
      REAL
     $     BP(KMX,JMX,IMX)
      REAL
     $     BPN(KMXN,JMXN,IMXN)
C     
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
#ifdef _MPI_
C     
C     MPI-VARIABLEN
C     
      INTEGER ISTATUS(MPI_STATUS_SIZE)
C     
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C     
C     MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C     
C     CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
C     CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
C     
      ISEND = IPROCNBR
      IRECV = IPROC

C     
#endif
C     
      IM1 = IMX-1
      IM2 = IMX-2
      IM3 = IMX-3
C     
C     IN = IM1 + IPOS - IM2
      IN = IPOS +1

#ifdef _MPI_
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC BEI MESSAGE-PASSING WIRD ABGEPRUEFT,
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCC OB GITTER AUF EINEM PROZESSOR
      IF (IPROC .EQ. IPROCNBR) THEN
C     IF (ISEND .EQ. IRECV) THEN
C     
C     ZU TESTZWECKEN SOLL ISEND NORMALE BELEGUNG DURCHLAUFEN 
C     IF (MYID .EQ. ISEND) THEN
C     
C     GITTER LIEGEN AUF EINEM PROZESSOR
C     
#endif

C     
         IF ((JSTA.NE.1).OR.(JSTO.NE.JMX)) STOP 'bbaconbp A'
         IF ((KSTA.NE.1).OR.(KSTO.NE.KMX)) STOP 'bbaconbp A'
C     
C     FUER ZEITSCHRITT
C     NORMALKOMPONENTE WIRD EINEN INDEX
C     AUSSERHALB  GESETZT

         DO J=JSTA,JSTO
            DO K=KSTA,KSTO

               JN = J + JPOS - 3
               KN = K + KPOS - 3

               BP(K,J,IM1) = BPN(KN,JN,IN)
               BP(K,J,IMX) = BPN(KN,JN,IN+1)

            ENDDO
         ENDDO
C     

#ifdef _MPI_

C     BIS HIER NUR SENDER

      ELSE
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C     
C     ARE THE GRIDS ON DIFFERENT PROCESSORS THE MESSAGE HAS 
C     TO BE SENT BY MPI
C     
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C     FUER ZEITSCHRITT
         DO IPLANE = 0,1
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCSEND-BUFFER
            IF (MYID .EQ. ISEND) THEN

               ICOUNT = 0

               DO J=JSTA,JSTO
                  DO K=KSTA,KSTO

                     JN = J + JPOS - 3
                     KN = K + KPOS - 3


                     SENDBUF(ICOUNT+1) = BPN(KN,JN,IN+IPLANE)
                     ICOUNT = ICOUNT+1

                  ENDDO
               ENDDO

               CALL MPI_SEND    ( SENDBUF , ICOUNT , 
     $              MPI_DOUBLE_PRECISION ,
     $              IRECV , ISEND ,
     $              MPI_COMM_WORLD , IERR)

            ENDIF

            IF (MYID .EQ. IRECV) THEN

               CALL MPI_RECV    ( RECVBUF , IDIM_MG_BUFS , 
     $              MPI_DOUBLE_PRECISION ,
     $              ISEND , ISEND ,
     $              MPI_COMM_WORLD , ISTATUS ,IERR)
C     
C     BELEGUNG DES RECV-BUFFERS
C     
               ICOUNT = 0
               DO J=JSTA,JSTO
                  DO K=KSTA,KSTO

                     JN = J + JPOS - 3
                     KN = K + KPOS - 3

                     BP(K,J,IM1+IPLANE) = RECVBUF(ICOUNT+1)
                     ICOUNT = ICOUNT + 1

                  ENDDO
               ENDDO

            ENDIF

         ENDDO


C     
      ENDIF
#endif

      RETURN
      END

