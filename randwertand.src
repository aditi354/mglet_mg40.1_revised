      SUBROUTINE RANDWERTAND (KK,K,DX,DDX,STAG,LCOL,DIAG,RCOL,RSIDE1,
     $                      RSIDE2,RSIDE3)
C*MGLET***************************************************************
C     R A N D W E R T A N D
C     UNTERPROGRAMM ZU BERECHNUNG DER KOEFFIZIENTEN AM RAND
C     HIER DIE WERTE FUER DEN     E I N S T R O E M R A N D !
C     BERECHNUNG DER E R S T E N  A B L E I T U N G ! ! ! ! !
C
C*MGLET***************************************************************
C
C
C DEFINE DIREKTIVEN     : KEINE
C
C UPROG                 : KEINE                                      
C                                                            
C 21.10.1996            : ADNAN MERI (ORIGINAL)
C 05.12.2002            : Flo Schwertfirm (Noslip -k)
C*MGLET***************************************************************
C
      LOGICAL STAG
      REAL LCOL,RCOL,DIAG,RSIDE1, RSIDE2,RSIDE3,
     $     alpha,beta,gamma,phi,h1,h2,h3,h4
       

      REAL a,b,c,d,e,f,g, h,q,l,DX(KK),DDX(KK),
     $     a1,a2,a3,a4,b1,b2,b3,b4,c1,c2,c3,c4 
     
C

CCCCCC Falls Rand gleich Noslip bestimmung mit cramers. regel

C  Fi+alpha*f(i-1/2)[h1]+beta*f(i+1/2)[h2]+gamma*F(i+1)[h3]+phi*f(i+3/2)[h4] = O**3
C  F unbekannt f bekannt. Taylorreihe -> Koeffizientenvergleich. 
C  Gleichungssystem mit Koeff. als Unbekannte. Loesung mit Cramerscher 
C  Regel


#if !defined _4TH_KOBAYASHI_ 

      IF (STAG) THEN
         h1 = DX(K-1)/2.0
         h2 = DX(K)/2.0
         h3 = DX(K)
         h4 = DX(K)+DX(K+1)/2.0
      ELSE
         h1 = DX(K-1)/2.0
         h2 = DX(K-1)/2.0
         h3 = DX(K-1)/2.0+DX(K)/2.0
         h4 = DX(K-1)/2.0+DX(K)
      ENDIF

        a1 = -h1 
	a2 = h2 
	a3 = 1 
	a4 = h4
        b1 = 0.5*h1**2 
        b2= 0.5*h2**2 
	b3 = h3 
	b4 = 0.5*h4**2
        c1 = -h1**3/6.0 
	c2 = h2**3/6.0 
	c3 = 0.5*h3**2 
	c4 = h4**3/6.0


      a = a1*b3*c2-a1*b2*c3+a2*b1*c3-a2*c1*b3-b1*a3*c2+a3*b2*c1 -
     $ a1*b3*c4+a1*b4*c3+b1*a3*c4-b1*a4*c3-a3*c1*b4+c1*a4*b3 +
     $ a2*b3*c4-a2*b4*c3-a3*b2*c4+a3*c2*b4+b2*a4*c3-a4*b3*c2
      b = b2*c3 - b3*c2 + b3*c4 - b4*c3
      c = c1*b3 - b1*c3 - b3*c4 + b4*c3
      d = b1*c2 - b2*c1 - b1*c4 + c1*b4 + b2*c4 - c2*b4
      e = b1*c3 - c1*b3 - b2*c3 + b3*c2
    
      alpha = -b/a
      beta = -c/a
      gamma = d/a
      phi  = -e/a

C      ELSE
CC
C      a = 0.5 * DX(K)   
C      b = (DX(K) + 0.5 * DX(K+1))
C      c = (DX(K) + DX(K+1) + (0.5 * DX(K+2)))
CC 
C      d = - 2.0 * DX(K) * a + (a**2.)
C      e = - 2.0 * DX(K) * b + (b**2.)
C      f = - 2.0 * DX(K) * c + (c**2.)
CC
C      g = -3.0 * (DX(K)**2.) * a + (a**3.)
C      h = -3.0 * (DX(K)**2.) * b + (b**3.)
C      q = -3.0 * (DX(K)**2.) * c + (c**3.)
C
C
C
C      PHI = DDX(K)*(2.0 * DX(K)*(h-g) - 3.0 * (DX(K)**2) 
C     $      *(e-d)) / ((f-d)*(h-g) - (q-g)*(e-d))
C      GAMA= (2.0 * DX(K) * DDX(K) - (f-d) * PHI)/(e - d)
C      BETA= - GAMA - PHI
C      ALFA= (- DDX(K) -c*PHI -b*GAMA -a*BETA)/DDX(K)
CC
C      ENDIF
C
c
c*******************************************************************
c
      LCOL = 0.0
      DIAG = 1.0
      RCOL = gamma            
      RSIDE1 = alpha 
      RSIDE2 = beta
      RSIDE3 = phi  
c
c*******************************************************************
c

#else

      IF (STAG) THEN
      
      a = DX(K)
      b = DX(K+1)+a 
      c = DDX(K-1)/2.0
            
      ELSE
      
      a = DDX(K)
      b = DDX(K+1)+a 
      c = DX(K-1)/2.0
      
      ENDIF
	
      
      d = ((-3.0*a**2.0*c**2.0-4.0*c**3.0*a+a**2.0*b**2.0-
     $      4.0*c**3.0*b-3.0*a*b*c**2.0-3.0*b**2.0*c**2.0)*b)/144.0
      e = ((a**3-6*a*c**2-4*c**3)*a)/24.0
      f = ((a**2+a*b-b**2)*a*b)/24.0
      h = -(b/144.0)*
     $	(3.0*a**3.0*b+8.0*c**3.0*a-4.0*c**3.0*b+6.0*a**3.0*c+
     $ 6.0*a**2.0*c*b+15.0*a**2.0*c**2.0-3.0*a*b*c**2.0-
     $ 2.0*a**2.0*b**2.0-3.0*b**2.0*c**2.0-6.0*b**2.0*c*a)		
      LCOL = 0.0 
      DIAG = 1.0
      RCOL = d/h
      RSIDE1 = f/h
      RSIDE3 = e/h 
      RSIDE2 = -(RSIDE1+RSIDE3)

C      LCOL = 0.0 
C      DIAG = 1.0
C      RCOL = 0.0
C      RSIDE3 = 0.0 
C      RSIDE2 = 1/a
C      RSIDE1 = -1/a


#endif
      RETURN
      END
