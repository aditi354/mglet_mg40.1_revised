         CALL INTLIN  (ARZOYZ ,KKZL,JJ2L,ILIMXP,  2  ,ILINTZ )
      ENDIF
      IF(ISELEP(1,280) .EQ. 1 .OR. ISELEP(1,280) .EQ. 2) THEN
         CALL MAMILI  (ARZOZZ , 2 ,KKZL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTZ )
         CALL INTLIN  (ARZOZZ ,KKZL,JJ2L,ILIMXP,  2  ,ILINTZ )
