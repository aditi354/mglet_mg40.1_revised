         CALL INTLIN  (ARYUW  ,KKYL,JJ2L,ILIMXP,  2  ,ILINTY )
      ENDIF
      IF(ISELEP(1,224) .EQ. 1 .OR. ISELEP(1,224) .EQ. 2) THEN
         CALL MAMILI  (ARYVW  , 2 ,KKYL,JJ2L,ILIMXP,
