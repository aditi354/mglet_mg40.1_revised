      IF(ISELEP(1,310) .EQ. 1 .OR. ISELEP(1,310) .EQ. 2) THEN
         CALL MAMILI  (AHOYOX , 1 ,KH0L,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  2  ,  2  ,ILINT0 )
