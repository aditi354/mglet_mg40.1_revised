      IF(ISELEP(1,272) .EQ. 1 .OR. ISELEP(1,272) .EQ. 2) THEN
         CALL MAMILI  (ARZOXY , 2 ,KKZL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTZ )
         CALL INTLIN  (ARZOXY ,KKZL,JJ2L,ILIMXP,  2  ,ILINTZ )
