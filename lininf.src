         CALL INTLIN  (ARXUV  ,KKXL,JJ2L,ILIMXP,  2  ,ILINTX )
      ENDIF
      IF(ISELEP(1,212) .EQ. 1 .OR. ISELEP(1,212) .EQ. 2) THEN
         CALL MAMILI  (ARYUV  , 2 ,KKYL,JJ2L,ILIMXP,
