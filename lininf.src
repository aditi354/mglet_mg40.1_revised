         CALL INTLIN  (ARZUU  ,KKZL,JJ2L,ILIMXP,  2  ,ILINTZ )
      ENDIF
      IF(ISELEP(1, 20) .EQ. 1 .OR. ISELEP(1, 20) .EQ. 2) THEN
         CALL MAMILI  (ASXUU  , 1 ,KSXL,JJ1L,ILIMXP,
