      ENDIF
      IF(ISELEP(1,286) .EQ. 1 .OR. ISELEP(1,286) .EQ. 2) THEN
         CALL MAMILI  (ASXOZZ , 1 ,KSXL,JJ1L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTX )
      ENDIF
      IF(ISELEP(1,288) .EQ. 1 .OR. ISELEP(1,288) .EQ. 2) THEN
         CALL MAMILI  (ASYOXX , 1 ,KSYL,JJ1L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTY )
