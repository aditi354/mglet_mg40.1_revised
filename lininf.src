         CALL MAMILI  (ARXUW  , 2 ,KKXL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTX )
         CALL INTLIN  (ARXUW  ,KKXL,JJ2L,ILIMXP,  2  ,ILINTX )
      ENDIF
      IF(ISELEP(1,218) .EQ. 1 .OR. ISELEP(1,218) .EQ. 2) THEN
         CALL MAMILI  (ARYUW  , 2 ,KKYL,JJ2L,ILIMXP,
