      IF(ISELEP(1,306) .EQ. 1 .OR. ISELEP(1,306) .EQ. 2) THEN
         CALL MAMILI  (AHOZOY , 1 ,KH0L,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  2  ,  2  ,ILINT0 )
      ENDIF
      IF(ISELEP(1,308) .EQ. 1 .OR. ISELEP(1,308) .EQ. 2) THEN
         CALL MAMILI  (AHOZOX , 1 ,KH0L,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  2  ,  2  ,ILINT0 )
