         CALL INTLIN  (ARYOZZ ,KKYL,JJ2L,ILIMXP,  2  ,ILINTY )
      ENDIF
      IF(ISELEP(1,270) .EQ. 1 .OR. ISELEP(1,270) .EQ. 2) THEN
         CALL MAMILI  (ARZOXX , 2 ,KKZL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTZ )
         CALL INTLIN  (ARZOXX ,KKZL,JJ2L,ILIMXP,  2  ,ILINTZ )
