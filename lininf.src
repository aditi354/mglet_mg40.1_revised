      IF(ISELEP(1,264) .EQ. 1 .OR. ISELEP(1,264) .EQ. 2) THEN
         CALL MAMILI  (ARYOYY , 2 ,KKYL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTY )
         CALL INTLIN  (ARYOYY ,KKYL,JJ2L,ILIMXP,  2  ,ILINTY )
