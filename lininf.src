      IF(ISELEP(1,262) .EQ. 1 .OR. ISELEP(1,262) .EQ. 2) THEN
         CALL MAMILI  (ARYOXZ , 2 ,KKYL,JJ2L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTY )
         CALL INTLIN  (ARYOXZ ,KKYL,JJ2L,ILIMXP,  2  ,ILINTY )
