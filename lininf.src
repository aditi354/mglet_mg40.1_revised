      ENDIF
      IF(ISELEP(1, 74) .EQ. 1 .OR. ISELEP(1, 74) .EQ. 2) THEN
         CALL MAMILI  (ASZWW  , 1 ,KSZL,JJ1L,ILIMXP,
     $                 1   ,KEND,  1  ,  1  ,  2  ,ILINTZ )
      ENDIF
