C$    LIST(ALL=0)      
      SUBROUTINE RANDWERTW (KK,K,DX,DDX,STAG,LCOL,DIAG,RCOL,RSIDE1,
     $                      RSIDE2,RSIDE3)
C*MGLET***************************************************************
C
C     UNTERPROGRAMM ZU BERECHNUNG DER KOEFFIZIENTEN AM RAND
C     HIER DIE WERTE FUER DEN LEZTEN PUNKT, FALLS W A N D VORHANDEN
C
C*MGLET***************************************************************
C
C
C DEFINE DIREKTIVEN     : KEINE
C
C UPROG                 : KEINE                                      
C                                                            
C 15.10.1996            : ADNAN MERI (ORIGINAL)
C 22.01.2003            : FLORIAN SCHWERTFIRM
C
C*MGLET***************************************************************
C
      LOGICAL STAG
      REAL LCOL,RCOL,DIAG,RSIDE1, RSIDE2,RSIDE3,
     $     alpha,beta,gamma,phi

      REAL a,b,c,d,e,f,g,h,p,q,r,s,DX(KK),DDX(KK),
     $     h1,h2,h3,h4,a1,a2,a3,a4,b1,b2,b3,b4,
     $     c1,c2,c3,c4,l


#if !defined _4TH_KOBAYASHI_ 

C  Fi+alpha*f(i+1/2)[h1]+beta*f(i-1/2)[h2]+gamma*F(i-1)[h3]+phi*f(i-3/2)[h4] = O**3
C  F unbekannt f bekannt. Taylorreihe -> Koeffizientenvergleich. 
C  Gleichungssystem mit Koeff. als Unbekannte. Loesung mit Cramerscher 
C  Regel
      IF (STAG) THEN
         h1 = DX(K)/2.0
         h2 = DX(K-1)/2.0
         h3 = DX(K-1)
         h4 = DX(K-1)+DX(K-2)/2.0
      ELSE
         h1 = DX(K-1)/2.0
         h2 = DX(K-1)/2.0
         h3 = DX(K-1)/2.0 + DX(K-2)/2.0
         h4 = DX(K-1)/2.0 + DX(K-2)
      ENDIF

        a1 = h1;  a2 = -h2; a3 = -h3; a4 = -h4
        b1 = 0.5*h1**2; b2 = 0.5*h2**2; b3 = 0.5*h3**2; b4 = 0.5*h4**2
        c1 =h1**3/6.0; c2 =-h2**3/6.0; c3 = -h3**3/6.0; c4 = -h4**3/6.0 

        a = a1*b3*c2 - a1*b2*c3 + a2*b1*c3 - a2*c1*b3 - b1*a3*c2 
     $   + a3*b2*c1 + a1*b2*c4 - a1*c2*b4 - a2*b1*c4 + a2*c1*b4 
     $   + b1*a4*c2 - b2*c1*a4 - a1*b3*c4 + a1*b4*c3 + b1*a3*c4 
     $   - b1*a4*c3 - a3*c1*b4 + c1*a4*b3 + a2*b3*c4 - a2*b4*c3
     $   - a3*b2*c4 + a3*c2*b4 + b2*a4*c3 - a4*b3*c2

        b = a2*b4*c3-a2*b3*c4+a3*b2*c4-a3*c2*b4-b2*a4*c3+a4*b3*c2
        c = a1*b3*c4-a1*b4*c3-b1*a3*c4+b1*a4*c3+a3*c1*b4-c1*a4*b3
        d = a1*c2*b4-a1*b2*c4+a2*b1*c4-a2*c1*b4-b1*a4*c2+b2*c1*a4
        e = a1*b2*c3-a1*b3*c2-a2*b1*c3+a2*c1*b3+b1*a3*c2-a3*b2*c1

        alpha = -b/a
        beta = -c/a
        gamma = d/a
        phi = -e/a

C******************   BILDUNG DER MATRIX ***************************
C
      LCOL = gamma
      DIAG = 1.0
      RCOL = 0.0          
      RSIDE1 = alpha 
      RSIDE2 = beta
      RSIDE3 = phi 

c
c*******************************************************************
c

#else

      IF(STAG) THEN
      
      b = -DX(K-1)
      c = -DX(K-2)+b
      a = -DDX(K)/2.0
        
      
      ELSE 
	      
      b =  -DDX(K-1)
      c =  -DDX(K-2)+b	
      a =  -DX(K)/2.0

      ENDIF
      

      l = 4.0*a*a+3.0*a*c+2.0*b*a+b*c
     
      LCOL = (a*c*(l+b*(a+c)))/( (a+b)*(c-b)*l)
      DIAG = 1.0
      RCOL = 0.0
      RSIDE1 = (b*b*c)/((a+b)*l)
      RSIDE3 = 2.0*b**2.0*a*(2.0*a+b)/
     $        ((3.0*a*c+b*c+4.0*a**2.0+2.0*a*b)*c*(c-b))
      RSIDE2 = 1.0+LCOL-RSIDE1-RSIDE3



#endif

      RETURN
      END
