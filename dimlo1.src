         CALL AMULT2  (ASZUU  ,KSZL,JJ1L,ILIMXP,
     $                 RASDUI , 1 ,KSZL-LINFB, 1 , 1 , 2 ,ILINTZ )
      ENDIF
C
C                                 STATIST. GROESSEN DER V-KOMPONENTE
