            CALL STMNEW  (KKA,JJA,IIA,KMXA,JMXA,IMXA,NPROLD,NPRRUN,
     $                    DREAD,DCONT,NPRNEU,FPRNEU,ADUDY2 ,SDUDY2 )
         ENDIF
         ISAMPA(  132) = NPROLD
         ISAMPP(  132) = ISAMPP(  132) + NPROLD
      ENDIF
C                                  U_KOMPONENTE IN Z_RICHTUNG
