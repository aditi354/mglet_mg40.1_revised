      IF(ISELEP(1, 57) .EQ. 1 .OR. ISELEP(1, 57) .EQ. 2) THEN
         NPROLD = ISAMPA(   57)
         IF(ISAMPP(   57) .GT. 0) THEN
            NPRRUN = ISAMPP(   57)
