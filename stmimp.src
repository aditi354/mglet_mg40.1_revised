      ENDIF
      IF(ISELEP(1, 87) .EQ. 1 .OR. ISELEP(1, 87) .EQ. 2) THEN
         NPROLD = ISAMPA(   87)
         IF(ISAMPP(   87) .GT. 0) THEN
