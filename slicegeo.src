         SUBROUTINE SLICEGEO (DDX,DDY,DDZ,DX,DY,DZ,X,Y,Z,B,HILF,
     $              IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,IDIMA,IDIM1L,IDIM2L,
     $              IGRID)
C
C--MGLET----------------------------------------------------------------
C
C                   SETZEN DER GEOMETRIE EINES GITTERS AUS 
C                   GEBIETSZERLEGUNG
C
C               IGRID: TEILGITTER
C
C        26. 5.95 (MM)  : ORIGINAL, AUS INISLICE ABGELEITET
C
C--MGLET----------------------------------------------------------------


#include "mgpar.h"
#include "comgrid.h"
#include "colevel.h"
#include "cogrdpro.h"
#include "cogrdcon.h"
#include "cobody.h"
#include "cophyspar.h"
#ifdef _MPI_
C
C               MPI-INCLUDE
C
#include "compi.h"
#include "mpif.h"
#endif

C
      REAL    
     $            B(IDIM3D),
     $            X(IDIM1D),     Y(IDIM1D),     Z(IDIM1D),
     $           DX(IDIM1D),    DY(IDIM1D),    DZ(IDIM1D),
     $          DDX(IDIM1D),   DDY(IDIM1D),   DDZ(IDIM1D)
C
#ifdef _MPI_
C
C                 MPI-VARIABLEN
C
      INTEGER ISTATUS(MPI_STATUS_SIZE)
C
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                 MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C                 
C     CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
C     CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
#endif
C
C
C                                 BEREITSTELLUNG DER POINTER
C                                 DIMENSIONIERUNGEN
C
           CALL MGDIMS (KK,JJ,II,IGRID)
C050696           CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
C050696     $                   NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)

       IP1 = IP1D(IGRID)
C
C
C
       CALL MGDIMS  (KKSLP,JJSLP,IISLP,ISLPAR(IGRID))
       IP1SLP = IP1D(ISLPAR(IGRID))
C050696       CALL MGPOINT (IP3SLP,IP2SLP,IP1SLP,IBBSLP,IBUSLP,ISLPAR(IGRID))
C
C                ZUERST ZERLEGT DER PROZESSOR 0 DIE GEOMETRIE
C
#ifdef _MPI_
      IF (MYID .EQ. 0) THEN
#endif

       CALL SLICE1D(IISLP,  X(IP1SLP),II,  X(IP1),ISLPOS(IGRID),'X','I')
       CALL SLICE1D(IISLP, DX(IP1SLP),II, DX(IP1),ISLPOS(IGRID),'X','I')
       CALL SLICE1D(IISLP,DDX(IP1SLP),II,DDX(IP1),ISLPOS(IGRID),'X','I')

       CALL SLICE1D(JJSLP,  Y(IP1SLP),JJ,  Y(IP1),JSLPOS(IGRID),'Y','J')
       CALL SLICE1D(JJSLP, DY(IP1SLP),JJ, DY(IP1),JSLPOS(IGRID),'Y','J')
       CALL SLICE1D(JJSLP,DDY(IP1SLP),JJ,DDY(IP1),JSLPOS(IGRID),'Y','J')

       CALL SLICE1D(KKSLP,  Z(IP1SLP),KK,  Z(IP1),KSLPOS(IGRID),'Z','K')
       CALL SLICE1D(KKSLP, DZ(IP1SLP),KK, DZ(IP1),KSLPOS(IGRID),'Z','K')
       CALL SLICE1D(KKSLP,DDZ(IP1SLP),KK,DDZ(IP1),KSLPOS(IGRID),'Z','K')
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C
#ifdef _MPI_
C
       ENDIF
C
C                             JETZT MUSS DIE GEOMETRIE DEN ANDEREN
C                             PROZESSOREN ZUGAENGLICH GEMACHT WERDEN
C
      CALL MPI_BCAST (  X(IP1),II,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST (  Y(IP1),JJ,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST (  Z(IP1),KK,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST ( DX(IP1),II,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST ( DY(IP1),JJ,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST ( DZ(IP1),KK,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST (DDX(IP1),II,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST (DDY(IP1),JJ,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)
      CALL MPI_BCAST (DDZ(IP1),KK,
     $ MPI_DOUBLE_PRECISION,0,MPI_COMM_WORLD,IERR)

C
#endif
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

      RETURN
      END


