     $                    XHOMOG,YHOMOG,ZHOMOG)
         ISELEP(2, 49) = ISELEP(2, 49) + NZERON
      ENDIF
C
C                                 STATIST. GROESSEN DER W-KOMPONENTE
C                                 ----------------------------------
