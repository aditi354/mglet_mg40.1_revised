      IF(ISELEP(1,248) .GE. 1) THEN
         CALL KO2VAR  (OXFG  ,AOXRG ,  1  ,  1  ,  0  ,
     $                 OYFG  ,AOYRG ,  1  ,  0  ,  1  ,
     $                 ARXOXY,SRXOXY,KKXL,JJ2L,JJ1L,ILIMXP,
     $                 'R X             ',KK,JJ,II,
     $                 KMX,JMX,IMX,X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                 KKA,JJA,IIA,ILIMX,ISLINP,ISLIDI,RKOMXP,
     $                 NBND,LINFB,NXGRAE,NYGRAE,NZGRAE)
