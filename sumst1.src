     $                 ARXOXZ,SRXOXZ,KKXL,JJ2L,JJ1L,ILIMXP,
     $                 'R X             ',KK,JJ,II,
     $                 KMX,JMX,IMX,X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
