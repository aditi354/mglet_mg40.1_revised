     $                 'S Z             ',KK,JJ,II,
     $                 KMX,JMX,IMX,X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                 ILIMX,ISLINP,ISLIDI,FVT,IDIMF,NBND,
