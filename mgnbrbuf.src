      SUBROUTINE MGNBRBUF (II,JJ,BUF,IA,IE,JA,JE,ICOMPLETE)
C
C--MGLET----------------------------------------------------------------
C
C                    PRUEFT NACH, OB DER BUFFER, DER EINE RANDFLAECHE
C                    EINES GITTERS DARSTELLT VOELLIG GEFUELLT IST
C                    DAMIT WIRD FESTGESTELLT, OB FUER DIE ENTSPRECHENDE
C                    RANDFLAECHE GENUEGEND RANDBED. INFORMATION
C                    BESTEHT
C                  
C       II,JJ:       DIMENSIONIERUNG
C       IA,JA:       ANFANGSINDIZES DER RANDBED.
C       IE,JE:       ENDINDIZES DER RANDBED.
C
C       ICOMPLETE:   1 -->  RANDBED. GENUEGEND
C                    0 -->     ""     UNVOLLSTAENDIG
C
C        17. 2.94 (MM)  : ORIGINAL
C
C--MGLET----------------------------------------------------------------
C
C
      REAL     BUF(II,JJ)
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                                      PUNKTE WERDEN GUPDATET

      DO I=IA,IE
      DO J=JA,JE

         BUF(I,J) = 1.0

      ENDDO
      ENDDO

C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
C                                     PRUEFUNG, OB ALLE PUNKTE DER 
C                                     RANDFLAECHE BELEGT

      RCOMP = 1.0

      DO I=1,II
      DO J=1,JJ

         RCOMP = MIN(RCOMP,BUF(I,J))

      ENDDO
      ENDDO

      ICOMPLETE = 0

      IF (RCOMP .GT. 0.5) ICOMPLETE = 1


       
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

      RETURN
      END


