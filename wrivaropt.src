      SUBROUTINE READVAROPT(VAROPT,IDIM2D,NDIMVAROPT)
      REAL VAROPT(2,IDIM2D*8)
#include "mgpar.h"
#include "cobound.h"
      READ(72,*,ERR=10,END=10) NDIMVAROPT
     +            ,TIMEALT,XRTALT1,XRTALT2,FREQOPT
     +            ,PERIODE,ITALT,FREQALT1
     +            ,XRMIN,FXRMIN,NXRMIN
      DO I=1,NDIMVAROPT
        READ(72,*)  VAROPT(1,I),VAROPT(2,I)
      ENDDO
   10 CONTINUE
      RETURN
      END

