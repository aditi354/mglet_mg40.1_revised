#undef _OUTPUT_
       SUBROUTINE CONTOPAR (KMX,JMX,IMX,X,Y,Z,DX,DY,DZ,DDX,DDY,DDZ,
     $                   U,V,W,P,G,H2D1,H2D2,UTO,VTO,WTO,PTO,GTO,
     $                   KMXN,JMXN,IMXN,
     $                   XN,YN,ZN,DXN,DYN,DZN,DDXN,DDYN,DDZN,
     $                   UN,VN,WN,PN,GN,HN,
     $                   ISTA,ISTO,JSTA,JSTO,
     $                   IPOS,JPOS,KPOS,ITYP,IRB,JRB,KRB,
     $                   IPROC,IPROCNBR
#ifdef _TSCAL_
     $                  ,T,TTO,TN
#endif
     $                  )     
C*MGLET*****************************************************************
C     C O N T O P A R    SETZEN DER RANDBEDINGUNGEN FUER DIE
C                         GESCHWINDIGKEITSFELDER. AUS PARENT-Gitter
C*MGLET*****************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        V(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        W(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        T(KK,JJ,II)    + SCALAR T FIELD
C        P(KMX,JMX,IMX) - DRUCKFELD
C        G(KMX,JMX,IMX) - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        ...N           - ENTSPRECHENDE GROESSE AUS DEM NACHBARGITTER
C        JSTART,JSTOP
C        KSTART,KSTOP   - BEREICH IN DEM RANDBEDINGUNG GESETZT WIRD
C        IPOS,JPOS,KPOS - POSITION IM NACHBARGITTER, AUF DER DER PUNKT
C                         MIT DEN INDIZES (3,3,3) ZU LIEGEN KOMMT
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C            IRB                  - INTEGER-KENNZAHL I-RICHTUNG RED-BLACK
C            JRB                  - INTEGER-KENNZAHL J-RICHTUNG RED-BLACK
C            KRB                  - INTEGER-KENNZAHL K-RICHTUNG RED-BLACK
C
C VERS:  27.07.95 (MM)  : ORIGINAL AUS BBOPAR ABGELEITET
C        28.02.03 (TB)  : SCALAR BOUNDARY TREATMENT IMPLEMENTED
C
C DEFINE-DIREKTIVEN     : QUD 
C
C*STARLET***************************************************************

C
      CHARACTER (LEN=1)  ITYP
C
      REAL
     $     U(KMX,JMX,IMX),  V(KMX,JMX,IMX),    W(KMX,JMX,IMX),
     $     P(KMX,JMX,IMX),  G(KMX,JMX,IMX),      
     $       H2D1(JMX,IMX),  H2D2(JMX,IMX),
     $       UTO(JMX,IMX,2),    VTO(JMX,IMX,2),    WTO(JMX,IMX,2),
     $       PTO(JMX,IMX,2),    GTO(JMX,IMX,2),
     $       X(IMX),            Y(JMX),            Z(KMX),
     $      DX(IMX),           DY(JMX),           DZ(KMX),
     $     DDX(IMX),          DDY(JMX),          DDZ(KMX)

      REAL
     $    UN(KMXN,JMXN,IMXN),  VN(KMXN,JMXN,IMXN),  WN(KMXN,JMXN,IMXN),
     $    PN(KMXN,JMXN,IMXN),  GN(KMXN,JMXN,IMXN),  HN(     JMXN,IMXN),
     $       XN(IMXN),            YN(JMXN),            ZN(KMXN),
     $      DXN(IMXN),           DYN(JMXN),           DZN(KMXN),
     $     DDXN(IMXN),          DDYN(JMXN),          DDZN(KMXN)

#ifdef _TSCAL_
      REAL     T(KMX,JMX,IMX),TTO(KMX,JMX,2),TN(KMXN,JMXN,IMXN)
#endif

      REAL I3DO2,I2DO2
       CHARACTER (LEN=16) CIDREC
C

#ifdef _MPI_
C               MPI-INCLUDE
C

#include "mgpar.h"
#include "colevel.h"
#include "compi.h"
#include "mpif.h"
C
#endif
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C                                 TEST OF DEFINE-DIRECTIVES
#if ! defined _INT_ORDER_2_
#define _INT_ORDER_1_
#endif
#if ! defined _P_INT_ORDER_2_
#define _P_INT_ORDER_1_
#endif

CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
      NBND = 2
CRED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-
      IF (IRB .EQ. 0) THEN
         ISTART = 1
         ISTOP  = IMX
      ELSEIF (IRB .EQ. 1) THEN
         ISTART = NBND + 1
         ISTOP  = IMX/2
      ELSEIF (IRB .EQ. 2) THEN
         ISTART = IMX/2 + 1
         ISTOP  = IMX - NBND
      ELSE
         CALL ERRR (504,'IRB BTOPAR')
      ENDIF   
C
      IF (JRB .EQ. 0) THEN
         JSTART = 1
         JSTOP  = JMX
      ELSEIF (JRB .EQ. 1) THEN
         JSTART =   2  + 1
         JSTOP  = JMX/2
      ELSEIF (JRB .EQ. 2) THEN
         JSTART = JMX/2 + 1
         JSTOP  = JMX -   2 
      ELSE
         CALL ERRR (504,'JRB BTOPAR')
      ENDIF   
CRED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-RED-BLACK-

C
C                         FINE-GRID: K-INDEX=KMX -1  (TOP)
               KF = KMX - 1
C                         K-INDEX OF COARSE-GRID
C                                   (=PARENT, CALLED NEIGHBOUR)
            KC = KPOS - 1 + (KF-1)/2
C
C
C                                     ORDNUNG DER INTERPOLATION
C
          IORDER = 1
#ifdef _INT_ORDER_2_
          IORDER = 2
#endif
C
C
          IORDER_P = 1
#ifdef _P_INT_ORDER_2_
          IORDER_P = 2
#endif
          IORDER = 1

#ifdef _OUTPUT_
 6050     FORMAT (6(E12.5E3,1X))
 6060     FORMAT (4(I9,1X))
          open  (61,form='FORMATTED')
          write (61,'(A)') 'KMG27'
          write (61,'(A)') '   X   '
          write (61,6050 ) (xn(i),i=3,imxn-2)
          write (61,'(A)') '   Y   '
          write (61,6050 ) (yn(i),i=3,jmxn-2)
          write (61,'(A)') '   Z   '
          write (61,6050 ) (zn(i),i=18,18)
          write (61,'(A)') ' IARR '
          write (61,6060 ) (i,i=3,imxn-2)
          write (61,'(A)') ' JARR '
          write (61,6060 ) (i,i=3,jmxn-2)
          write (61,'(A)') ' IARR '
          write (61,6060 ) (i,i=18,18)
          write (61,'(A)') ' NTREC'
          write (61,6060 ) 1

          open  (63,form='FORMATTED')
          write (63,'(A)') 'KMG27'
          write (63,'(A)') '   X   '
          write (63,6050 ) (xn(i),i=3,imxn-2)
          write (63,'(A)') '   Y   '
          write (63,6050 ) (y(i),i=3,jmx-2)
          write (63,'(A)') '   Z   '
          write (63,6050 ) (z(i),i=18,18)
          write (63,'(A)') ' IARR '
          write (63,6060 ) (i,i=3,imxn-2)
          write (63,'(A)') ' JARR '
          write (63,6060 ) (i,i=3,jmx-2)
          write (63,'(A)') ' IARR '
          write (63,6060 ) (i,i=18,18)
          write (63,'(A)') ' NTREC'
          write (63,6060 ) 1

          open  (65,form='FORMATTED')
          write (65,'(A)') 'KMG27'
          write (65,'(A)') '   X   '
          write (65,6050 ) (x(i),i=3,imx-2)
          write (65,'(A)') '   Y   '
          write (65,6050 ) (y(i),i=3,jmx-2)
          write (65,'(A)') '   Z   '
          write (65,6050 ) (z(i),i=18,18)
          write (65,'(A)') ' IARR '
          write (65,6060 ) (i,i=3,imx-2)
          write (65,'(A)') ' JARR '
          write (65,6060 ) (i,i=3,jmx-2)
          write (65,'(A)') ' IARR '
          write (65,6060 ) (i,i=18,18)
          write (65,'(A)') ' NTREC'
          write (65,6060 ) 1
C
          open  (62,form='UNFORMATTED')
          cidrec = 'KMG27'
          write (62) CIDREC
          write (62) 1.0

          open  (64,form='UNFORMATTED')
          cidrec = 'KMG27'
          write (64) CIDREC
          write (64) 1.0

          open  (66,form='UNFORMATTED')
          cidrec = 'KMG27'
          write (66) CIDREC
          write (66) 1.0

#endif
C
C                                 FUER ZEITSCHRITT
      IF (ITYP.EQ.'T') THEN

#ifdef _MPI_
         IF (MYID .EQ. IPROCNBR) THEN
#endif
      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               UN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,0,1)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,UTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,1,IORDER)
#ifdef _OUTPUT_
          write (62) ((hn(j,i),j=3,jmxn-2),i=3,imxn-2)
          write (64) ((H2D1(j,i),j=3,jmx-2),i=3,imxn-2)
          write (66) ((uto(j,i,1),j=3,jmx-2),i=3,imx-2)
#endif
#ifdef _MPI_
      ENDIF
         IF (MYID .EQ. IPROCNBR) THEN
#endif
      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               VN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,0,1)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,1,IORDER)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,VTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER)

#ifdef _OUTPUT_
          write (62) ((hn(j,i),j=3,jmxn-2),i=3,imxn-2)
          write (64) ((H2D1(j,i),j=3,jmx-2),i=3,imxn-2)
          write (66) ((vto(j,i,1),j=3,jmx-2),i=3,imx-2)
#endif
#ifdef _MPI_
      ENDIF
         IF (MYID .EQ. IPROCNBR) THEN
#endif

      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               WN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
#ifdef _TOPAR_FIXED_
     $               IPOS,JPOS,KPOS,-1,1)
#else
     $               IPOS,JPOS,KPOS, 1,1)
#endif
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,WTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)

#ifdef _OUTPUT_
          write (62) ((hn(j,i),j=3,jmxn-2),i=3,imxn-2)
          write (64) ((H2D1(j,i),j=3,jmx-2),i=3,imxn-2)
          write (66) ((wto(j,i,1),j=3,jmx-2),i=3,imx-2)
#ifndef _TSCAL_
          stop 'contopar!' 
#endif

#endif
C-----------------------------------------------------------------------
C                                  SCALAR T
#ifdef _TSCAL_
#ifdef _MPI_
      ENDIF
         IF (MYID .EQ. IPROCNBR) THEN
#endif
      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               TN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,0,1)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,1,IORDER)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,TTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER)

#ifdef _OUTPUT_
          write (62) ((hn(j,i),j=3,jmxn-2),i=3,imxn-2)
          write (64) ((H2D1(j,i),j=3,jmx-2),i=3,imxn-2)
          write (66) ((tto(j,i,1),j=3,jmx-2),i=3,imx-2)
          stop 'contopar!'          
#endif
#endif
C-----------------------------------------------------------------------
#ifdef _MPI_
      ENDIF
         IF (MYID .EQ. IPROCNBR) THEN
#endif
C
C---- ------------------------------------------------------------------
C                                  Druck ausserhalb des lokalen Gitters


      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               PN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,0,IORDER_P)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER_P)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,PTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER_P)
#ifdef _MPI_
      ENDIF
#endif
#ifdef _TOPAR_CORRECT_INTERFACE_VELOCITY_
C
C---- ------------------------------------------------------------------
C                            Druck in letzter Zelle des lokalen Gitters
#ifdef _MPI_
         IF (MYID .EQ. IPROCNBR) THEN
#endif

      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               PN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,-1,IORDER_P)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER_P)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,PTO(1,1,2),H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,IORDER_P)
#ifdef _MPI_
      ENDIF
#endif
#endif

#ifdef _MPI_
         IF (MYID .EQ. IPROCNBR) THEN
#endif

      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN,
     $               GN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,0,1)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,GTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)
#ifdef _MPI_
      ENDIF
#endif

#ifdef _QUD_
         CALL ERRR (578,'BTOPAR')

               U(K,J,  1) = U(K,J,IN-1)
               V(K,J,  1) = V(K,J,IN-1)
               W(K,J,  1) = W(K,J,IN-1)
               P(K,J,  1) = P(K,J,IN-1)
               G(K,J,  1) = G(K,J,IN-1)
#endif

C                                 FUER DRUCKKORREKTUR
C                                 NUR NORMALKOMPONENTE MUSS GESETZT
C                                 WERDEN

       ELSEIF (ITYP.EQ.'P') THEN

#ifdef _TOPAR_FIXED_
#ifdef _MPI_
         IF (MYID .EQ. IPROCNBR) THEN
#endif
      CALL XTRACTXY (KMXN,JMXN,IMXN,KMX,Z,DZ,DDZ,ZN,DZN,DDZN, 
     $               WN,HN,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,KPOS,-1,IORDER)
#ifdef _MPI_
         ENDIF
            CALL COPYREGION(JMXN,IMXN,1,HN,
     $           IPROCNBR,1,JMXN,1,IMXN,1,1,
     $           JMXN,IMXN,1,HN,IPROC,
     $           0,0,0,
     $           H2D1,MYID)
            IF (MYID .EQ. IPROC ) THEN
#endif
      CALL PROLONG1 (JMX,IMXN,JMXN,NBND,Y,DY,DDY,YN,DYN,DDYN,
     $               HN,H2D1,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)
      CALL PROLONG2 (JMX,IMX,IMXN,NBND,X,DX,DDX,XN,DXN,DDXN,
     $               H2D1,WTO,H2D2,
     $               ISTA,ISTO,JSTA,JSTO,
     $               IPOS,JPOS,0,1)
#ifdef _MPI_
      ENDIF
#endif

#else
C                   NORMAL-KOMPONENT MUST NOT BE SET
C                   BECAUSE PRESSURE IN THE BOUNDARY-CELLS
C                   IS NOT MODIFIED, SO NORMAL-KOMPONENTS MUST
C                   BE ABLE TO DEVELOP FREELY

               RETURN

#endif
C
       ELSE
                CALL ERRR (501,' BTOPAR')
       ENDIF
C
C	write (0,*)'CONTOPAR.................'
C	do i=1,imx
C	write (0,*) 'i: ',i,'   UTO: ',UTO(3,i,1)
C	enddo
      RETURN
      END











