      SUBROUTINE BTONOS (KMX,JMX,IMX,
     $                    U,V,W,P,G,
     $                    ISTART,ISTOP,JSTART,JSTOP,ITYP)
C*STARLET***************************************************************
C        B T O N O S   SETZEN DER RANDBEDINGUNGEN FUER DIE
C                         GESCHWINDIGKEITSFELDER.
C                         (LARGE-EDDY-SIMULATION)
C*STARLET***************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        V(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        W(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        P(KMX,JMX,IMX) - DRUCKFELD
C        G(KMX,JMX,IMX) - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:   8. 3.93 (MM)  : ORIGINAL
C                         AUS BTOPLE (BTOPL) ABGELEITET
C        11.08.03 (TB)  : SIPITER IMPLEMENTED
C
C DEFINE-DIREKTIVEN     : QUD 
C
C*STARLET***************************************************************
C
#include "konsta.h"
C
      CHARACTER (LEN=1)  ITYP
C
      REAL
     $            U(KMX,JMX,IMX),   V(KMX,JMX,IMX),   W(KMX,JMX,IMX),
     $            P(KMX,JMX,IMX),   G(KMX,JMX,IMX)
C
      KM1 = KMX-1
      KM2 = KMX-2
      KM3 = KMX-3
      KM4 = KMX-4
C
C
C                                 **************************************
C                                 REIBUNGSBEHAFTETE, UNDURCHLAESSIGE WAN
C                                 **************************************
C
C
C
C                                 FUER ZEITSCHRITT
      IF (ITYP.EQ.'T') THEN

         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP

               U(KM1,J,I) = 0.0
               V(KM1,J,I) = 0.0
               W(KM2,J,I) = 0.0
#ifdef _POISSONITER_
               P(KM1,J,I) = P(KM2,J,I)
#else
               P(KM1,J,I) = 0.0
#endif
               G(KM1,J,I) = -SMALL

         ENDDO
         ENDDO

#ifdef _QUD_

         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP

               U(KMX,J,I) = 0.0
               V(KMX,J,I) = 0.0
               W(KM1,J,I) = 0.0

         ENDDO
         ENDDO

#endif

C                                 FUER DRUCKKORREKTUR
C                                 NUR NORMALKOMPONENTE MUSS 
C                                 GESETZT WERDEN
       ELSEIF (ITYP.EQ.'P') THEN

         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP

               W(KM2,J,I) = 0.0

         ENDDO
         ENDDO

 
       ELSE
                CALL ERRR (501,' BTONOS')
       ENDIF


      RETURN
      END

