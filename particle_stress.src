      SUBROUTINE PARTICLE_STRESS (KK,JJ,II,X,Y,Z,DX,DY,DZ,
     $                          RDDX,RDDY,RDDZ,
     $                          TAU11,TAU12,TAU13,
     $                          TAU21,TAU22,TAU23,
     $                          TAU31,TAU32,TAU33,
     $                          SAMPLES,HX,HY,HZ,
     $                          NPART,XPART,YPART,ZPART,
     $                          IINDEX,JINDEX,KINDEX,TAU)
C------------------------------------------------------------
C
C     INTERPOLATES PARTICLE STRESSES ON EULERIAN GRID
C
C     020502 (MM)  ORIGINAL
C
C------------------------------------------------------------

      REAL 
     $     TAU11(KK,JJ,II),TAU12(KK,JJ,II),TAU13(KK,JJ,II),
     $     TAU21(KK,JJ,II),TAU22(KK,JJ,II),TAU23(KK,JJ,II),
     $     TAU31(KK,JJ,II),TAU32(KK,JJ,II),TAU33(KK,JJ,II),
     $     SAMPLES(KK,JJ,II)

      REAL    X(II),    Y(II),    Z(II),
     $       DX(II),   DY(JJ),   DZ(KK),
     $     RDDX(II), RDDY(JJ), RDDZ(KK),
     $       HX(II),   HY(JJ),   HZ(KK)


      REAL XPART(NPART), YPART(NPART), ZPART(NPART)
      REAL TAU(NPART,3,3)
      
      INTEGER IINDEX(NPART), JINDEX(NPART), KINDEX(NPART)

      real nverteilung(0:99)
#ifdef _HITACHI_TEST
C------------------------------------------------------------
C
C                                      LOOP OVER ALL PARTICLES
C
C------------------------------------------------------------
      
      DO IPART = 1,NPART

         K=KINDEX(IPART)
         J=JINDEX(IPART)
         I=IINDEX(IPART)


C----  ---------------------------------------------   point k  ,j  ,i

         WEIGHT = 1.0

      TAU11(K,J,I) = TAU11(K,J,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J,I) = TAU12(K,J,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J,I) = TAU13(K,J,I) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K,J,I) = TAU22(K,J,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J,I) = TAU23(K,J,I) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K,J,I) = TAU33(K,J,I) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K,J,I) = SAMPLES(K,J,I) + WEIGHT

#else
#ifdef _HITACHI_
C------------------------------------------------------------
C
C                                      LOOP OVER ALL PARTICLES
C
C------------------------------------------------------------
      
      DO IPART = 1,NPART

         K=KINDEX(IPART)
         J=JINDEX(IPART)
         I=IINDEX(IPART)


C---- ----------------------- LIEGT XPART LINKS ODER 
C                             RECHTS VON X(IINDEX(IPART))

         ISHIFT = INT(SIGN(0.5, XPART(IPART) - X(I)))
         JSHIFT = INT(SIGN(0.5, YPART(IPART) - Y(J)))
         KSHIFT = INT(SIGN(0.5, ZPART(IPART) - Z(K)))

         I = I - ISHIFT
         J = J - JSHIFT
         K = K - KSHIFT



C----- --------------------- JETZT LIEGT XPART ZWISCHEN X(I) UND X(I+1)
C------------------------------------------------------------
C                     DETERMINATION OF WEIGHTING FACOTRS
C                     WE ASSUME LINEAR WEIGHTING

C                                     X-DIRECTION
         XW = X(I    )
         XE = X(I + 1)
         FW = (XE - XPART(IPART)) / (XE - XW)
         FE = 1.0 - FW
         
C                                     Y-DIRECTION
         YS = Y(J    )
         YN = Y(J + 1)
         FS = (YN - YPART(IPART)) / (YN - YS)
         FN = 1.0 - FS

C                                     K-DIRECTION
         ZB = Z(K    )
         ZT = Z(K + 1)
         FB = (ZT - ZPART(IPART)) / (ZT - ZB)
         FT = 1.0 - FB

C----  ---------------------------------------------   point k  ,j  ,i

         WEIGHT = FW*FS*FB

      TAU11(K,J,I) = TAU11(K,J,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J,I) = TAU12(K,J,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J,I) = TAU13(K,J,I) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K,J,I) = TAU22(K,J,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J,I) = TAU23(K,J,I) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K,J,I) = TAU33(K,J,I) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K,J,I) = SAMPLES(K,J,I) + WEIGHT

      ENDDO
C----  ---------------------------------------------   point k+1,j  ,i

      DO IPART = 1,NPART

         K=KINDEX(IPART)
         J=JINDEX(IPART)
         I=IINDEX(IPART)


C---- ----------------------- LIEGT XPART LINKS ODER 
C                             RECHTS VON X(IINDEX(IPART))

         ISHIFT = INT(SIGN(0.5, XPART(IPART) - X(I)))
         JSHIFT = INT(SIGN(0.5, YPART(IPART) - Y(J)))
         KSHIFT = INT(SIGN(0.5, ZPART(IPART) - Z(K)))

         I = I - ISHIFT
         J = J - JSHIFT
         K = K - KSHIFT



C----- --------------------- JETZT LIEGT XPART ZWISCHEN X(I) UND X(I+1)
C------------------------------------------------------------
C                     DETERMINATION OF WEIGHTING FACOTRS
C                     WE ASSUME LINEAR WEIGHTING

C                                     X-DIRECTION
         XW = X(I    )
         XE = X(I + 1)
         FW = (XE - XPART(IPART)) / (XE - XW)
         FE = 1.0 - FW
         
C                                     Y-DIRECTION
         YS = Y(J    )
         YN = Y(J + 1)
         FS = (YN - YPART(IPART)) / (YN - YS)
         FN = 1.0 - FS

C                                     K-DIRECTION
         ZB = Z(K    )
         ZT = Z(K + 1)
         FB = (ZT - ZPART(IPART)) / (ZT - ZB)
         FT = 1.0 - FB

C----  ---------------------------------------------   point k  ,j  ,i
         WEIGHT = FW*FS*FT

      TAU11(K+1,J,I) = TAU11(K+1,J,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K+1,J,I) = TAU12(K+1,J,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K+1,J,I) = TAU13(K+1,J,I) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K+1,J,I) = TAU22(K+1,J,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K+1,J,I) = TAU23(K+1,J,I) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K+1,J,I) = TAU33(K+1,J,I) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K+1,J,I) = SAMPLES(K+1,J,I) + WEIGHT

C----  ---------------------------------------------   point k  ,j+1,i

         WEIGHT = FW*FN*FB

      TAU11(K,J+1,I) = TAU11(K,J+1,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J+1,I) = TAU12(K,J+1,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J+1,I) = TAU13(K,J+1,I) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K,J+1,I) = TAU22(K,J+1,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J+1,I) = TAU23(K,J+1,I) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K,J+1,I) = TAU33(K,J+1,I) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K,J+1,I) = SAMPLES(K,J+1,I) + WEIGHT

C----  ---------------------------------------------   point k+1,j+1,i

         WEIGHT = FW*FN*FT

      TAU11(K+1,J+1,I) = TAU11(K+1,J+1,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K+1,J+1,I) = TAU12(K+1,J+1,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K+1,J+1,I) = TAU13(K+1,J+1,I) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K+1,J+1,I) = TAU22(K+1,J+1,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K+1,J+1,I) = TAU23(K+1,J+1,I) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K+1,J+1,I) = TAU33(K+1,J+1,I) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K+1,J+1,I) = SAMPLES(K+1,J+1,I) + WEIGHT


C----  ---------------------------------------------   point k  ,j  ,i+1

         WEIGHT = FE*FS*FB

      TAU11(K,J,I+1) = TAU11(K,J,I+1) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J,I+1) = TAU12(K,J,I+1) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J,I+1) = TAU13(K,J,I+1) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K,J,I+1) = TAU22(K,J,I+1) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J,I+1) = TAU23(K,J,I+1) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K,J,I+1) = TAU33(K,J,I+1) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K,J,I+1) = SAMPLES(K,J,I+1) + WEIGHT

C----  ---------------------------------------------   point k+1,j  ,i+1

         WEIGHT = FE*FS*FT

      TAU11(K+1,J,I+1) = TAU11(K+1,J,I+1) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K+1,J,I+1) = TAU12(K+1,J,I+1) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K+1,J,I+1) = TAU13(K+1,J,I+1) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K+1,J,I+1) = TAU22(K+1,J,I+1) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K+1,J,I+1) = TAU23(K+1,J,I+1) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K+1,J,I+1) = TAU33(K+1,J,I+1) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K+1,J,I+1) = SAMPLES(K+1,J,I+1) + WEIGHT

C----  ---------------------------------------------   point k  ,j+1,i+1

         WEIGHT = FE*FN*FB

      TAU11(K,J+1,I+1) = TAU11(K,J+1,I+1) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J+1,I+1) = TAU12(K,J+1,I+1) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J+1,I+1) = TAU13(K,J+1,I+1) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K,J+1,I+1) = TAU22(K,J+1,I+1) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J+1,I+1) = TAU23(K,J+1,I+1) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K,J+1,I+1) = TAU33(K,J+1,I+1) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K,J+1,I+1) = SAMPLES(K,J+1,I+1) + WEIGHT

C----  ---------------------------------------------   point k+1,j+1,i+1

         WEIGHT = FE*FN*FT

      TAU11(K+1,J+1,I+1) = TAU11(K+1,J+1,I+1) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K+1,J+1,I+1) = TAU12(K+1,J+1,I+1) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K+1,J+1,I+1) = TAU13(K+1,J+1,I+1) + TAU(IPART, 1, 3)*WEIGHT

      TAU22(K+1,J+1,I+1) = TAU22(K+1,J+1,I+1) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K+1,J+1,I+1) = TAU23(K+1,J+1,I+1) + TAU(IPART, 2, 3)*WEIGHT

      TAU33(K+1,J+1,I+1) = TAU33(K+1,J+1,I+1) + TAU(IPART, 3, 3)*WEIGHT

      SAMPLES(K+1,J+1,I+1) = SAMPLES(K+1,J+1,I+1) + WEIGHT

#else
C------------------------------------------------------------
C
C                                      LOOP OVER ALL PARTICLES
C
C------------------------------------------------------------
      
      DO IPART = 1,NPART

         K=KINDEX(IPART)
         J=JINDEX(IPART)
         I=IINDEX(IPART)

C------------------------------------------------------------
C                     DETERMINATION OF WEIGHTING FACOTRS
C                     WE ASSUME LINEAR WEIGHTING 
C                     WE DON T KNOW, IF XPART IS LEFT OR RIGTH FROM
C                     XP -- THEREFORE, WE TEST BOTH DIRECTIONS AND 
C                     SWITCH BY E.G. (FW = 0.5*(ABS(FW) + FW))
C                     WHICH IS ZERO, IF FW IS NEGATIVE


C                                     X-DIRECTION (WEST -- POINT -- EAST)

         XW = X(I - 1)
         XP = X(I    )
         XE = X(I + 1)

         FW = (XP - XPART(IPART)) / (XP - XW)
         FW = 0.5*(ABS(FW) + FW)

         FE = (XPART(IPART) - XP) / (XE - XP)
         FE = 0.5*(ABS(FE) + FE)

         FPX = 1.0 - FW - FE

C                                     Y-DIRECTION (SOUTH -- POINT -- NORTH)

         YS = Y(J - 1)
         YP = Y(J    )
         YN = Y(J + 1)

         FS = (YP - YPART(IPART)) / (YP - YS)
         FS = 0.5*(ABS(FS) + FS)

         FN = (YPART(IPART) - YP) / (YN - YP)
         FN = 0.5*(ABS(FN) + FN)

         FPY = 1.0 - FS - FN

C                                     K-DIRECTION (BOTTOM -- POINT -- TOP)

         ZB = Z(K - 1)
         ZP = Z(K    )
         ZT = Z(K + 1)

         FB = (ZP - ZPART(IPART)) / (ZP - ZB)
         FB = 0.5*(ABS(FB) + FB)

         FT = (ZPART(IPART) - ZP) / (ZT - ZP)
         FT = 0.5*(ABS(FT) + FT)

         FPZ = 1.0 - FB - FT

C------------------------------------------------------------
C              WEIGHTING STRESS TENSOR TO DIFFERENT POINTS IN SPACE
         

C----  point k-1,j-1,i-1

         WEIGHT = FW*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J-1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j-1,i-1

         WEIGHT = FW*FS*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J-1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j-1,i-1

         WEIGHT = FW*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J-1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j  ,i-1

         WEIGHT = FW*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J  ,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j  ,i-1

         WEIGHT = FW*FPY*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J  ,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j  ,i-1

         WEIGHT = FW*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J  ,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j+1,i-1

         WEIGHT = FW*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J+1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j+1,i-1

         WEIGHT = FW*FN*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J+1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j+1,i-1

         WEIGHT = FW*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J+1,I-1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j-1,i

         WEIGHT = FPX*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J-1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j-1,i

         WEIGHT = FPX*FS*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J-1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j-1,i

         WEIGHT = FPX*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J-1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j  ,i

         WEIGHT = FPX*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J  ,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j  ,i

         WEIGHT = FPX*FPY*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J  ,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j  ,i

         WEIGHT = FPX*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J  ,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j+1,i

         WEIGHT = FPX*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J+1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j+1,i

         WEIGHT = FPX*FN*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J+1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j+1,i

         WEIGHT = FPX*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J+1,I  ,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)


C----  point k-1,j-1,i+1

         WEIGHT = FE*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J-1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j-1,i+1

         WEIGHT = FE*FS*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J-1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j-1,i+1

         WEIGHT = FE*FS*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J-1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j  ,i+1

         WEIGHT = FE*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J  ,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j  ,i+1

         WEIGHT = FE*FPY*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J  ,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j  ,i+1

         WEIGHT = FE*FPY*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J  ,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k-1,j+1,i+1

         WEIGHT = FE*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K-1,J+1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k  ,j+1,i+1

         WEIGHT = FE*FN*FPZ

         CALL SWEIGHT (KK,JJ,II,NPART,K  ,J+1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

C----  point k+1,j+1,i+1

         WEIGHT = FE*FN*FB

         CALL SWEIGHT (KK,JJ,II,NPART,K+1,J+1,I+1,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)


#endif
#endif
C------------------------------------------------------------
C                      LOOP OVER PARTICLES FINISHED

      ENDDO



      RETURN

C                   AB HIER NUR DIAGNOSE
C------------------------------------------------------------
      write (6,*) 'particle_stress,',
     $  'tau13,tau31',tau13(5,5,5),tau31(5,5,5),samples(5,5,5)
      write (6,*) 'particle_stress,',
     $  'tau23,tau32',tau23(5,5,5),tau32(5,5,5),samples(5,5,5)
      write (6,*) 'particle_stress,',
     $  'tau12,tau21',tau12(5,5,5),tau21(5,5,5),samples(5,5,5)

      do i=1,ii
      write (6,1000) 'tau22',i,tau22(5,5,i),samples(5,5,i)
      enddo

 1000  FORMAT (A5,I6,2(1X,E12.5E3,1X))
      RN= 0
      N= 0

      do i=0,99
        nverteilung(i) = 0
      enddo

      DO I=2,II-1
       DO J=2,JJ-1
        DO K=2,KK-1

           RN = RN + SAMPLES(K,J,I)
           N = N + int(SAMPLES(K,J,I))

           iv = int(SAMPLES(K,J,I))
           nverteilung(iv) = nverteilung(iv) + 1.0
C           nverteilung(SAMPLES(K,J,I)) = nverteilung(SAMPLES(K,J,I)) + 1

        ENDDO
       ENDDO
      ENDDO

      write (6,*)'gesamtanzahl in particle_stress',rn,n
      do i=0,99
         write (6,*) 'nvert',i,nverteilung(i)
      enddo
C------------------------------------------------------------


      RETURN
      END

         SUBROUTINE SWEIGHT (KK,JJ,II,NPART,K,J,I,IPART,WEIGHT,
     $        TAU11,TAU12,TAU13,TAU22,TAU23,TAU33,TAU,SAMPLES)

      REAL 
     $     TAU11(KK,JJ,II),TAU12(KK,JJ,II),TAU13(KK,JJ,II),
     $                     TAU22(KK,JJ,II),TAU23(KK,JJ,II),
     $                                     TAU33(KK,JJ,II),
     $     SAMPLES(KK,JJ,II)

      REAL TAU(NPART,3,3)

      TAU11(K,J,I) = TAU11(K,J,I) + TAU(IPART, 1, 1)*WEIGHT
      TAU12(K,J,I) = TAU12(K,J,I) + TAU(IPART, 1, 2)*WEIGHT
      TAU13(K,J,I) = TAU13(K,J,I) + TAU(IPART, 1, 3)*WEIGHT
      
      TAU22(K,J,I) = TAU22(K,J,I) + TAU(IPART, 2, 2)*WEIGHT
      TAU23(K,J,I) = TAU23(K,J,I) + TAU(IPART, 2, 3)*WEIGHT
      
      TAU33(K,J,I) = TAU33(K,J,I) + TAU(IPART, 3, 3)*WEIGHT
      
      SAMPLES(K,J,I) = SAMPLES(K,J,I) + WEIGHT

      RETURN
      END
