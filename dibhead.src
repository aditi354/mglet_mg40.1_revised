      SUBROUTINE DIBHEAD (CIDENT,IIDENT,RIDENT,
     $                    ISELEA,ISAMPA,ISLINA,ISLIDI)
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C          LIEST HEADERINFORMATION VON ERGEBNISFILE EIN
C          BINAER
C
C
C     16. 5.93 (MM) : ORIGINAL
C     26. 5.95 (MM) : MPI EINGEFUEHRT
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C

#include "mgpar.h"
#include "comgrid.h"
#include "costrles.h"
#include "cogrdold.h"
#include "cobodold.h"
#if defined _MPI_ | defined _MPI_PARTICLES_
C
C               MPI-INCLUDE
#include "mpif.h"
C
C                 MPI-VARIABLEN
      INTEGER ISTATUS(MPI_STATUS_SIZE)
#endif

      CHARACTER (LEN=8) CIDENT(10)
      INTEGER     IIDENT(100)
#ifdef _C3820_
      INTEGER*8   IIDENT8(100)
      INTEGER*8   KKO8,JJO8,IIO8
#endif
      REAL        RIDENT(100)

      INTEGER     ISELEA(2*752)    ,ISLINA(ISLIDI),
     $            ISAMPA(752*MAXGRIDS)
#if defined _MPI_ | defined _MPI_PARTICLES_
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C                 MPI-ROUTINEN ZUR UEBERGABE VON PARAMETERN
C                 
      CALL MPI_COMM_RANK (MPI_COMM_WORLD,MYID,IERR)
      CALL MPI_COMM_SIZE (MPI_COMM_WORLD,NUMPROCS,IERR)
C
C                               HEADER WIRD NUR VOM MASTER EINGELESEN
      IF (MYID .EQ. 0) THEN
C
#endif
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C
      
      READ(1,END=10000) CIDENT
#ifdef _C3820_
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC   MLET ODER MGLET ??
      IF (VERS(1:4) .EQ. 'MLET') THEN

        READ(1,END=10001) IIDENT8
        DO I=1,100
           IIDENT(I) = IIDENT8(I)
        ENDDO
      ELSE
        READ(1,END=10001) IIDENT
      ENDIF
#else
        READ(1,END=10001) IIDENT
#endif

      READ(1,END=10002) RIDENT
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC   MLET ODER MGLET ??
      IF (IIDENT(5).GT.8) THEN
C                                                    HIER: MGLET	
         READ(1,END=10003) NGRDOLD,NBODOLD,NAUFOLD
      DO I=1,NGRDOLD
         READ(1,END=10004)   IMXOLD(I),   JMXOLD(I),    KMXOLD(I)
         READ(1,END=10007) LEVELOLD(I),LCHILDOLD(I),IPARENTOLD(I)
         READ(1,END=10010)  IPOSOLD(I),  JPOSOLD(I),   KPOSOLD(I)
         READ(1,END=10013)  XTOTOLD(I),  YTOTOLD(I),   ZTOTOLD(I)

         IF (IIDENT(5).GE.34) THEN

            READ(1,END=10015) (NBOCOLD(J,I),J=1,7)

            READ(1,END=10016) ( FRONTOLD(J,I),J=1, NBOCOLD(1,I))
            READ(1,END=10016) (  BACKOLD(J,I),J=1, NBOCOLD(2,I))
            READ(1,END=10016) ( RIGHTOLD(J,I),J=1, NBOCOLD(3,I))
            READ(1,END=10016) (  LEFTOLD(J,I),J=1, NBOCOLD(4,I))
            READ(1,END=10016) (BOTTOMOLD(J,I),J=1, NBOCOLD(5,I))
            READ(1,END=10016) (   TOPOLD(J,I),J=1, NBOCOLD(6,I))
            READ(1,END=10016) (  CUBEOLD(J,I),J=1, NBOCOLD(7,I))

            READ(1,END=10017)
            READ(1,END=10017)
            READ(1,END=10017)
            READ(1,END=10017)
            READ(1,END=10017)
            READ(1,END=10017)

C           READ(1,END=10017) (IFRNBROLD(J,I),J=1, NBOCOLD(1,I))
C           READ(1,END=10017) (IBANBROLD(J,I),J=1, NBOCOLD(2,I))
C           READ(1,END=10017) (IRINBROLD(J,I),J=1, NBOCOLD(3,I))
C           READ(1,END=10017) (ILENBROLD(J,I),J=1, NBOCOLD(4,I))
C           READ(1,END=10017) (IBONBROLD(J,I),J=1, NBOCOLD(5,I))
C           READ(1,END=10017) (IBONBROLD(J,I),J=1, NBOCOLD(6,I))

            DO ID = 1,7
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)
              READ(1,END=10017)

C             READ(1,END=10017) (IBPOSOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (JBPOSOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (KBPOSOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (IBANFOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (JBANFOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (KBANFOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (IBENDOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (JBENDOLD(J,ID,I),J=1, NBOCOLD(ID,I))
C             READ(1,END=10017) (KBENDOLD(J,ID,I),J=1, NBOCOLD(ID,I))
            ENDDO
         ELSE

            READ(1,END=10016) 
     $          FRONTOLD(1,I),BACKOLD(1,I),RIGHTOLD(1,I),
     $          LEFTOLD(1,I),BOTTOMOLD(1,I), TOPOLD(1,I), CUBEOLD(1,I)
             
         ENDIF

         READ(1,END=10023) XHOMOGOLD(I),YHOMOGOLD(I),ZHOMOGOLD(I)
         READ(1) LPLEVELOLD(I)
      ENDDO

      DO I=1,NBODOLD
         READ(1,END=10030) CTYPO(I)
         READ(1,END=10031)
     $        IB1O(I),IB2O(I),JB1O(I),JB2O(I),KB1O(I),KB2O(I)
         READ(1,END=10032) 
     $        XB1O(I),XB2O(I),YB1O(I),YB2O(I),ZB1O(I),ZB2O(I)
         READ(1,END=10033) 
     $        NCOUNO(I),XMITO(I),HEIGHTO(I),ALPHAO(I),CDIRO(I)
      ENDDO


      READ(1,END=10050)  (ISELEA(I),I=1,2*752)
      READ(1,END=10050)  (ISAMPA(I),I=1,752*NGRDOLD)
      READ(1,END=10060)  (ISLINA(N),N=1,NAUFOLD)

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72

      ELSE
C                                 EINLESEN EINES MLET - ERGEBNISFILES
C
         WRITE (6,*) 
     &   'DIBHEAD DIBHEADDIBHEAD DIBHEADDIBHEAD DIBHEADDIBHEAD DIBHEAD'
         WRITE (6,*) 
     &   'DAS ERGEBNISFILE SCHEINT MIT MLET ERZEUGT ZU SEIN !!!'
         WRITE (6,*) 
     &   'DIBHEAD DIBHEADDIBHEAD DIBHEADDIBHEAD DIBHEADDIBHEAD DIBHEAD'

         NGRDOLD = 1
         NBODOLD = 0
         NAUFOLD = 0

         READ(1,END=10004)   KKO8,JJO8,IIO8

         KMXOLD(1) = KKO8
         JMXOLD(1) = JJO8
         IMXOLD(1) = IIO8


      ENDIF

#if defined _MPI_ | defined _MPI_PARTICLES_
C                    EINLESEN FERTIG, JETZT WERDEN INFORMATIONEN VERSCHICKT
      ENDIF

      CALL MPI_BCAST(NGRDOLD,1,MPI_INTEGER,0,MPI_COMM_WORLD,IERR)   
#ifndef _T3E_
      CALL MPI_BCAST(CIDENT,1,MPI_BYTE,0,MPI_COMM_WORLD,IERR)   
#endif
      CALL MPI_BCAST(IIDENT, 100         , MPI_INTEGER , 0 ,    
     $                                        MPI_COMM_WORLD , IERR)
      CALL MPI_BCAST ( RIDENT , 100         , 
     $ MPI_DOUBLE_PRECISION  , 0 ,     
     $                                        MPI_COMM_WORLD , IERR)
      CALL MPI_BCAST ( ISELEA , 2*752       , MPI_INTEGER  , 0 ,  
     $                                        MPI_COMM_WORLD , IERR)
      CALL MPI_BCAST ( ISAMPA , 752*MAXGRIDS, MPI_INTEGER , 0 ,   
     $                                        MPI_COMM_WORLD , IERR)
      CALL MPI_BCAST ( ISLINA , ISLIDI      , MPI_INTEGER , 0 ,   
     $                                        MPI_COMM_WORLD , IERR)
#endif
 
      RETURN

CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C                                    FEHLERBEHANDLUNG

10000 STOP 'EOF BEIM BINAEREN EINLESEN VON CIDENT AUF KANAL 1'
10001 STOP 'EOF BEIM BINAEREN EINLESEN VON IIDENT AUF KANAL 1'
10002 STOP 'EOF BEIM BINAEREN EINLESEN VON RIDENT AUF KANAL 1'
10003 STOP 'EOF BEIM BINAEREN EINLESEN VON NGRDOLD,NAUFOLD AUF KANAL 1'
10004 STOP 'EOF BEIM BINAEREN EINLESEN VON IMXOLD AUF KANAL 1'
10005 STOP 'EOF BEIM BINAEREN EINLESEN VON JMXOLD AUF KANAL 1'
10006 STOP 'EOF BEIM BINAEREN EINLESEN VON KMXOLD AUF KANAL 1'
10007 STOP 'EOF BEIM BINAEREN EINLESEN VON LEVEL AUF KANAL 1'
10008 STOP 'EOF BEIM BINAEREN EINLESEN VON LCHILD AUF KANAL 1'
10009 STOP 'EOF BEIM BINAEREN EINLESEN VON IPARENT AUF KANAL 1'
10010 STOP 'EOF BEIM BINAEREN EINLESEN VON IPOSITION AUF KANAL 1'
10011 STOP 'EOF BEIM BINAEREN EINLESEN VON JPOSITION AUF KANAL 1'
10012 STOP 'EOF BEIM BINAEREN EINLESEN VON KPOSITION AUF KANAL 1'
10013 STOP 'EOF BEIM BINAEREN EINLESEN VON XTOT AUF KANAL 1'
10014 STOP 'EOF BEIM BINAEREN EINLESEN VON YTOT AUF KANAL 1'
10015 STOP 'EOF BEIM BINAEREN EINLESEN VON ZTOT AUF KANAL 1'
10016 STOP 'EOF BEIM BINAEREN EINLESEN VON FRONT AUF KANAL 1'
10017 STOP 'EOF BEIM BINAEREN EINLESEN DER NACHBARN AUF KANAL 1'
10018 STOP 'EOF BEIM BINAEREN EINLESEN VON RIGHT AUF KANAL 1'
10019 STOP 'EOF BEIM BINAEREN EINLESEN VON LEFT AUF KANAL 1'
10020 STOP 'EOF BEIM BINAEREN EINLESEN VON BOTTOM AUF KANAL 1'
10021 STOP 'EOF BEIM BINAEREN EINLESEN VON TOP AUF KANAL 1'
10022 STOP 'EOF BEIM BINAEREN EINLESEN VON CUBE AUF KANAL 1'
10023 STOP 'EOF BEIM BINAEREN EINLESEN VON XHOMOG AUF KANAL 1'
10024 STOP 'EOF BEIM BINAEREN EINLESEN VON YHOMOG AUF KANAL 1'
10025 STOP 'EOF BEIM BINAEREN EINLESEN VON ZHOMOG AUF KANAL 1'

10030 STOP 'EOF BEIM BINAEREN EINLESEN VON CTYP(IBODY) AUF KANAL 1'
10031 STOP 'EOF BEIM BINAEREN EINLESEN VON IB1..KB2 AUF KANAL 1'
10032 STOP 'EOF BEIM BINAEREN EINLESEN VON XB1..ZB2 AUF KANAL 1'
10033 STOP 'EOF BEIM BINAEREN EINLESEN VON NCOUN..ZDIR AUF KANAL 1'

10050 STOP 'EOF BEIM BINAEREN EINLESEN VON ISELEA AUF KANAL 1'
10060 STOP 'EOF BEIM BINAEREN EINLESEN VON ISLINA AUF KANAL 1'


      END
