      SUBROUTINE BFRBLO (KMX,JMX,IMX,    
     $                      U,V,W,P,G,
     $                      JSTART,JSTOP,KSTART,KSTOP,
     $                      FREQ,AU,AV,AW,ANIV,TIMEPHYS,     
     $                      X,Y,Z,FLOWTYP,UFR,VFR,WFR
#ifdef _TSCAL_
     $                      ,T,TSCA
#endif
     $                   )     
C*STARLET***************************************************************
C        B F R B L O   SETZEN DER RANDBEDINGUNGEN FUER DIE STROEMUNGS-
C                      MANIPULATION DURCH EINEN JETSTRAHL
C
C*STARLET***************************************************************
C
C PARAM: 
C        U(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        V(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        W(KMX,JMX,IMX) + GESCHWINDIGKEITSFELD
C        T(KMX,JMX,IMX) + SCALAR T FIELD
C        P(KMX,JMX,IMX) - DRUCKFELD
C        G(KMX,JMX,IMX) - EFFEKTIVE DYNAMISCHE VISKOSITAET (= MUE)
C        AUB            - AMPLITUDE DES STRAHLS IN X-RICHTUNG
C        AVB            - AMPLITUDE DES STRAHLS IN Y-RICHTUNG
C        AWB            - AMPLITUDE DES STRAHLS IN Z-RICHTUNG
C        ANIV      - GIBT DAS NULLNIVEAU AN UM DAS DER COSINUS SCHWINGT
C        NUMJET         - NUMBER OF JETS
C        FREQB          - EINSTROEMFREQUENZ 
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:  25.02.94 (RK)  : ORIGINAL
C VERS:  28.09.94 (AO)  : TOTALLY NEW VERSION AND ADAPTED TO MGLET
C VERS:  04.02.97 (AM)  : NEU INLET BOUNDARY CONDITION
C        28.02.03 (TB)  : SCALAR BOUNDARY TREATMENT IMPLEMENTED
C
C
C*STARLET***************************************************************
C
C
C
C
#include "cophyspar.h"
C
      REAL
     $            U(KMX,JMX,IMX),   V(KMX,JMX,IMX),   W(KMX,JMX,IMX),
     $            P(KMX,JMX,IMX),   G(KMX,JMX,IMX),   TIMEPHYS,
     $            X(IMX),           Y(JMX),           Z(KMX),
     $        UFR(KMX,JMX,2),     VFR(KMX,JMX,2),      WFR(KMX,JMX,2) 
      REAL RANF,RWORK
      EXTERNAL RANF

      CHARACTER (LEN=16) FLOWTYP
C
#ifdef _TSCAL_
      REAL        T(KMX,JMX,IMX)
      REAL        TSCA
#endif
C
#ifdef _QUD_

C                               QUADRATIC UPSTREAM IST DEFINIERT
        DATA NQUD /1/
#else

C                               QUADRATIC UPSTREAM IST NICHT DEFINIERT
        DATA NQUD /0/
#endif



C                                 ***********************************
C                                 RECHTECKIGES EINSTROEMGEBIET FRONT 
C                                 ***********************************


C                               LOOP OVER EVERY FREQUENCY OF THE JET
C
	 IF (FLOWTYP.EQ.'UNIFORM') THEN
C        DO IFREQ = 1 , NUMFREQ

         VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
C	write (6,*) 
C     $        't:',timephys,' f:',freq,' v:',valuek,' sinus:',sinus
         VALUEU = ANIV + AU * SINUS
         VALUEV = ANIV + AV * SINUS
         VALUEW = ANIV + AW * SINUS
         VALUEG = GMOL


C----------- U - KOMPONENTE ------------------------------------------

         DO J = JSTART, JSTOP
         DO K = KSTART, KSTOP

         U(K,J  ,2  ) =     VALUEU

         ENDDO
         ENDDO


C----------- V - KOMPONENTE ------------------------------------------

         DO J = JSTART, JSTOP
         DO K = KSTART, KSTOP

C        V(K,J  ,2  ) = - V(K,J  ,3  )
         V(K,J  ,2  ) =   0.0

         ENDDO
         ENDDO

C----------- W - UND G - KOMPONENTE ----------------------------------

         DO J=JSTART,JSTOP
         DO K=KSTART,KSTOP

C       W(K,J  ,2  )     =                   VALUEW
C       W(K,J  ,2  )     =  - W(K,J  ,3  ) 
        W(K,J  ,2  )     =  0.0
        G(K,J  ,2  )     =  VALUEG
#ifdef _TSCAL_
        T(K,J,  2  )     =  TFRCON
#endif         

        ENDDO
        ENDDO

C     ENDDO
      ENDIF


      IF (FLOWTYP.EQ.'WAVE') THEN
C     DO IFREQ = 1 , NUMFREQ

	 XA = X(ISTART)
	 XB= X(ISTOP)


C----------- U - KOMPONENTE ------------------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         DO I = ISTART, ISTOP
	 ZETA = 2.0 * 3.1415927 * (X(I)-XA)/(XB-XA)
	 VWX =  SIN(ZETA) * (1-COS(ZETA))
         VALUEU = ANIV + AU * SINUS
         DO J = JSTART, JSTOP

            U(2,J  ,I  ) = - U(3,J  ,I  ) + 2.0  *  VALUEU * VWX

         ENDDO
         ENDDO

C----------- V - KOMPONENTE ------------------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         DO I=ISTART,ISTOP
	 ZETA = 2.0 * 3.1415927 * (X(I)-XA)/(XB-XA)
	 VWX = SIN(ZETA) * (1-COS(ZETA))
         VALUEV = ANIV + AV * SINUS
         DO J=JSTART,JSTOP

            V(2,J  ,I  ) = - V(3,J  ,I  ) + 2.0 *  VALUEV * VWX

         ENDDO
         ENDDO
 
C----------- W - UND G - KOMPONENTE ----------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         DO I=ISTART,ISTOP
	 ZETA = 2.0 * 3.1415927 * (X(I)-XA)/(XB-XA)
	 VWX = SIN(ZETA) * (1-COS(ZETA))
         VALUEW = ANIV + AW *  VWX * SINUS
         VALUEG = GMOL
         DO J=JSTART,JSTOP

            W(2,J  ,I  )     =                   VALUEW
            G(2,J  ,I  )     =                   VALUEG
#ifdef _TSCAL_
            T(2,J,  I) = TFRCON
#endif 
         ENDDO
         ENDDO
 
C     ENDDO
      ENDIF
C------------------RUNDER JET, PARABOLISCHES PROFIL----------------------------

      IF (FLOWTYP.EQ.'ROUNDJET') THEN


         VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         COSUS= COS(VALUEK)

         VALUEU = ANIV + AU * COSUS
         VALUEV = ANIV + AV * COSUS
         VALUEW = ANIV + AW * COSUS
         VALUEG = GMOL

         ZA = Z(KSTART)
         ZB= Z(KSTOP)
         YA = Y(JSTART)
         YB= Y(JSTOP)

         ZCENT = (ZB + ZA)/2.0
         ZR    = (ZB - ZA)/2.0
         YCENT = (YB + YA)/2.0
         YR    = (YB - YA)/2.0

C         write (0,*) 'Roundjet',istart,istop,jstart,jstop,kstart,kstop
C         write (0,*) '        ',xa,xb,xcent,xr
C         write (0,*) '        ',ya,yb,ycent,yr
C         write (0,*) '        ',valueu,valuev,valuew,valuek

         DO I = 2,2
           DO J = JSTART, JSTOP
              DO K = KSTART, KSTOP

                 R = SQRT((Z(K) - ZCENT)**2 + (Y(J) - YCENT)**2)

                 R = R/ZR

                 U (K,J,I) = U(K,J,I) + MAX(VALUEU * (1.0 - R**2), 0.0)
#ifdef _TSCAL_
                 IF (R .LE. 1.0)  T(K,J,  3  )     =  TSCA
#endif
              ENDDO
           ENDDO
        ENDDO

      ENDIF

C------------------ECKIGER JET, DUCT-ROFIL----------------------------

      IF (FLOWTYP.EQ.'SQUAREJET') THEN


         ZA = Z(KSTART)
         ZB= Z(KSTOP)
         YA = Y(JSTART)
         YB= Y(JSTOP)

C         write (0,*) 'SQUAREJET',AU,jstart,jstop,kstart,kstop
C         write (0,*) '        ',ya,yb
C         write (0,*) '        ',za,zb


         DO I = 2,2
           DO J = JSTART, JSTOP
              DO K = KSTART, KSTOP
                 RWORK = 0.0 
                 DO L = 0,4
                    DO M = 0,4
                       RWORK = RWORK+(SIN((2*L+1)*3.14*Y(J)/0.5)*
     $                         SIN((2*M+1)*3.14*Z(K)/1.0))/
     $                         ((2*L+1)*(2*M+1)*((2*L+1)**2+(2*M+1)**2))
                    ENDDO
                 ENDDO

                 U (K,J,I) = AU/0.2138*RWORK
#ifdef _TSCAL_
                 T(K,J,  2  )     =  TSCA
#endif
              ENDDO
           ENDDO
        ENDDO
C        OPEN(70)
C        DO J=JSTART,JSTOP
C           DO K=KSTART,KSTOP
C           WRITE(70,*)'U_PROF(Y):',K,J,U(K,J,2)
C        ENDDO
C        WRITE(70,*)
C      ENDDO
C      CLOSE(70)
C        STOP 'Warum haelt der Scheiss jetzt??'
      ENDIF
C------------------PARABELFOERMIGER JET----------------------------

      IF (FLOWTYP.EQ.'PARABEL') THEN
C     DO IFREQ = 1 , NUMFREQ

	 XA = X(ISTART)
	 XB= X(ISTOP)


C----------- U - KOMPONENTE ------------------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         VALUEU = ANIV + AU * SINUS
         DO I = ISTART, ISTOP
           DO J = JSTART, JSTOP
           U(2,J  ,I  ) = - U(3,J  ,I  ) + 2.0  *  VALUEU
           ENDDO
         ENDDO


C----------- V - KOMPONENTE ------------------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         VALUEV = ANIV + AV * SINUS
         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP
            V(2,J  ,I  ) = - V(3,J  ,I  ) + 2.0 *  VALUEV
         ENDDO
         ENDDO
 
C----------- W - UND G - KOMPONENTE ----------------------------------

	 VALUEK = 2.0 * 3.1415927 * FREQ * TIMEPHYS
         SINUS= SIN(VALUEK)
         DO I=ISTART,ISTOP
	 VWX =(((XA-XB)/2)**2-(X(I)-(XB+XA)/2)**2)/((XA-XB)/2)**2
         VALUEW = ANIV + AW *  VWX * SINUS
         VALUEG = GMOL
         DO J=JSTART,JSTOP

            W(2,J  ,I  )     =                   VALUEW
            G(2,J  ,I  )     =                   VALUEG
#ifdef _TSCAL_
            T(2,J,  I)       =                   TFRCON
#endif 
         ENDDO
         ENDDO
 
      ENDIF

C--------RANDOM GENERATOR UNIFORM OVER A SPECIFIED SCALE ----------

      IF (FLOWTYP.EQ.'RANDOM') THEN


C----------- U - KOMPONENTE ------------------------------------------

         DO I = ISTART, ISTOP
         DO J = JSTART, JSTOP

         VALUEU = ANIV + AU * RANF()

         U(2,J  ,I  ) = - U(3,J  ,I  ) + 2.0  *  VALUEU

         ENDDO
         ENDDO

         DO J=JSTART,JSTOP
         VALUEU = ANIV + AU * RANF()
         U(2,J,ISTART-1)=-U(3,J,ISTART-1)+2.0*VALUEU
         U(2,J,ISTOP   )=-U(3,J,ISTOP   )+2.0*VALUEU
         ENDDO

C----------- V - KOMPONENTE ------------------------------------------

         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP-1

         VALUEV = ANIV + AV * RANF()
         V(2,J  ,I  ) = - V(3,J  ,I  ) + 2.0 *  VALUEV

         ENDDO
         ENDDO
         DO I=ISTART,ISTOP
         VALUEV = ANIV + AV * RANF()
         V(2,JSTART-1,I) =  - V(3,JSTART-1,I) + 2.0 *  VALUEV
         V(2,JSTOP   ,I) =  - V(3,JSTOP   ,I) + 2.0 *  VALUEV
         ENDDO

C----------- W - UND G - KOMPONENTE ----------------------------------

         VALUEG = GMOL
         DO I=ISTART,ISTOP
         DO J=JSTART,JSTOP
         VALUEW = ANIV + AW * RANF()

        W(2,J  ,I  )     =                   VALUEW
        G(2,J  ,I  )     =                   VALUEG
#ifdef _TSCAL_
        T(2,J,  I)       =                   TFRCON
#endif 
        ENDDO
        ENDDO

C     ENDDO
      ENDIF
      

      RETURN
      END

