C#ifdef _TSCAL_
      SUBROUTINE BBASCA (KMX,JMX,IMX,
     $                    T,TSCABA,
     $                    JSTART,JSTOP,KSTART,KSTOP,ITYP)
C*STARLET***************************************************************
C        B B A S C A    SETTING SCALAR BOUNDARY CONDITION FIXED-SCALAR
C*STARLET***************************************************************
C
C PARAM: 
C        KMX, JMX, IMX  - DIMENSIONEN DES GITTERS 
C        T(KMX,JMX,IMX) + SCALAR T FIELD
C        ITYP           - HOLLERITH-KONSTANTE:
C                         'P'  VOR DER DRUCKKORREKTUR
C                         'T'  VOR DEM ZEITSCHRITT
C
C VERS:  28.02.03 (TB)  : ORIGINAL
C
C
C*STARLET***************************************************************
C
#include "konsta.h"
C
      CHARACTER (LEN=1)  ITYP
C
      REAL  T(KMX,JMX,IMX)
C
C
C                                 **************************************
C                                 FIXED SCALAR-CONDITION AT BACK
C                                 **************************************
C
C
C
      IF ( ITYP .EQ. 'T' ) THEN

       
         DO J=JSTART,JSTOP
         DO K=KSTART,KSTOP

            T(K,J,  IMX-1) = TSCABA

         ENDDO
         ENDDO

      ENDIF

      RETURN
      END
C#endif
