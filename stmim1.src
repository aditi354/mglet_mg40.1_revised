            NPRRUS = ISELEP(2, 14)
            CALL STMNLI  (ARXUU  ,JJ2L,SRXUU  ,JJ1L,KKXL,ILIMXP,
     $                    2  ,ILINTX, 1 , 1 , 1 ,KKXL-LINFB,
     $                    NPROLD,NPRRUS,DREAD,DCONT,NPRNEU)
         ENDIF
         ISELEA(2, 14) = NPROLD
