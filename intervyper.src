      SUBROUTINE INTERVY_PER(KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,RSGS,V,VINJ,LCOL,DIAG,RCOL,UZ,RSP) 
C*MGLET***************************************************************
C        I N T E R V Y P E R
C                  = =
C        INTERPOLIERT V IN Y-RICHTUNG (VINJ) PERIODISCHE RB
C*MGLET***************************************************************
C
C PARAM: V(K,J,I)         - ZU INTERPOLIERENDE GROESSE(V)
C      : VINJ(K,J,I)      - INTERPOLIERTE V IN J(Y)-RICHTUNG
C
C DEFINE DIREKTIVEN     : KEINE 
C
C UPROG                 : TRIZYK3DJ
C
C VERS:  07.10.97 (AM)  : ORIGINAL        (KOMPAKT 4. ORDNUNG)
C
C*MGLET***************************************************************
C
      IMPLICIT NONE

      INTEGER KK,JJ,II,K,J,I,KSTART,JSTART,ISTART,KSTOP,JSTOP,ISTOP

      REAL    LCOL(JJ),DIAG(JJ),RCOL(JJ),UZ(JJ),RSP(JJ),
     $         V(KK,JJ,II), VINJ(KK,JJ,II), RSGS(KK,JJ,II)
C
C
C
#if defined _KOMYK_

#if !defined _6TH_KOBAYASHI_ 

#if !defined _4TH_KOBAYASHI_ 

      DO J = JSTART+1, JSTOP

         LCOL(J) = 1./6.
         DIAG(J) = 1.
         RCOL(J) = 1./6.
         UZ (J)  = 1./6.
         RSP(J)  = 1./6.

      ENDDO

      DO I = ISTART,ISTOP
         DO J = JSTART+1, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) = (2./3.)* (V(K,J,I) + V(K,J-1,I))
            ENDDO
         ENDDO
      ENDDO

      CALL TRIZYK3DJ (KK,JJ,II,KSTART,KSTOP,JSTART+1,JSTOP,
     &     ISTART,ISTOP,LCOL,DIAG,RCOL,UZ,RSP,RSGS,VINJ)

      DO I = ISTART,ISTOP
         DO K = KSTART, KSTOP
            VINJ (K,JSTART,I)  = VINJ (K,JSTOP,I)
            VINJ (K,JSTOP+1,I) = VINJ (K,JSTART+1,I)
         ENDDO
      ENDDO

#else

      DO J = JSTART+1, JSTOP

         LCOL(J) = 1./4.
         DIAG(J) = 1.
         RCOL(J) = 1./4.
         UZ (J)  = 1./4.
         RSP(J)  = 1./4.

      ENDDO

      DO I = ISTART,ISTOP
         DO J = JSTART+1, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) = (3./4.)* (V(K,J,I) + V(K,J-1,I))
            ENDDO
         ENDDO
      ENDDO

      CALL TRIZYK3DJ (KK,JJ,II,KSTART,KSTOP,JSTART+1,JSTOP,
     &     ISTART,ISTOP,LCOL,DIAG,RCOL,UZ,RSP,RSGS,VINJ)

      DO I = ISTART,ISTOP
         DO K = KSTART, KSTOP
            VINJ (K,JSTART,I)  = VINJ (K,JSTOP,I)
            VINJ (K,JSTOP+1,I) = VINJ (K,JSTART+1,I)
         ENDDO
      ENDDO

#endif
#endif




#endif



#ifndef _KOMYK_
#if defined _ZEN4O_

       DO I = ISTART,ISTOP
          DO  J = 3,JJ-1
             DO  K = KSTART, KSTOP

                VINJ (K,J,I)  =
     $               0.5625 * (V(K,J  ,I) + V(K,J-1,I))
     $             - 0.0625 * (V(K,J+1,I) + V(K,J-2,I))

             ENDDO
          ENDDO
       ENDDO
#else

       WRITE(6,*)'NOT IMPLEMENTED IN INTERVYPER.SRC'
       STOP
#endif
#endif
#if defined _KOMXK6O_
C
       WRITE(6,*)'KOMYK60 NICHT AUF 3D AUFGEBOHRT'
       STOP
C       DO  K = KSTART, KSTOP
C       V(K,JSTART-1) = V(K,JSTOP-1 )
C       V(K,JSTOP+1 ) = V(K,JSTART+1)
C       ENDDO

C       DO 40 J = JSTART+1, JSTOP

C         LCOL(J) = 3./10.
C         DIAG(J) = 1.
C         RCOL(J) = 3./10.
C         UZ (J)  = 3./10.
C         RSP(J)  = 3./10.

C         DO 30 K = KSTART, KSTOP

C         RSGS(K,J) = (3./4.) * (V(K,J) + V(K,J-1)) +
C     $               (1./20.)* (V(K,J+1) + V(K,J-2))

C   30    CONTINUE
C   40  CONTINUE
CC
C       CALL TRIZYK (KK,JJ,KSTART,KSTOP,JSTART+1,JSTOP,LCOL,DIAG,RCOL,
C     $              UZ,RSP,RSGS,VINJ)
CC
C       DO 400 K = KSTART, KSTOP
C       VINJ (K,JSTART)  = VINJ (K,JSTOP)
C       VINJ (K,JSTOP+1) = VINJ (K,JSTART+1)
C  400  CONTINUE
C
#endif
C
C                                ACHTER  ORDNUNG !!!!!!!!!!
#if defined _KOMYK8O_
C
       WRITE(6,*)'KOMYK80 NICHT AUF 3D AUFGEBOHRT'
       STOP
C       DO  K = KSTART, KSTOP
C       V(K,JSTART-1) = V(K,JSTOP-1 )
C       V(K,JSTART-2) = V(K,JSTOP-2 )
C       V(K,JSTOP+1 ) = V(K,JSTART+1)
C       V(K,JSTOP+2 ) = V(K,JSTART+2)
C       ENDDO
CC
C       DO 40 J = JSTART+1, JSTOP
CC
C         LCOL(J) = 5./14.
C         DIAG(J) = 1.
C         RCOL(J) = 5./14.
C         UZ (J)  = 5./14.
C         RSP(J)  = 5./14.
CC
C         DO 30 K = KSTART, KSTOP
CC
C         RSGS(K,J) = (12.5/16.) * (V(K,J) + V(K,J-1)) +
C     $               (17.5/224.)* (V(K,J+1) + V(K,J-2)) -
C     $               (1./448.)  * (V(K,J+2) + V(K,J-3))
CC
C   30    CONTINUE
C   40  CONTINUE
CC
CC
C       CALL TRIZYK (KK,JJ,KSTART,KSTOP,JSTART+1,JSTOP,LCOL,DIAG,RCOL,
C     $              UZ,RSP,RSGS,VINJ)
CC
C       DO 400 K = KSTART, KSTOP
C       VINJ (K,JSTART)  = VINJ (K,JSTOP)
C       VINJ (K,JSTOP+1) = VINJ (K,JSTART+1)
C  400  CONTINUE
C
#endif
C
C*MGLET***************************************************************
C
       RETURN
       END

