      SUBROUTINE DIGRID (CIDENT,IIDENT,RIDENT,
     $                   DDX,DDY,DDZ,DX,DY,DZ,X,Y,Z,
#ifdef _TSCAL_
     $              U,V,W,T,P,G,B,BP,BU,BV,BW,BT,
#else
     $              U,V,W,P,G,B,BP,BU,BV,BW,	
#endif	
     $              ITSTEP,ITTOT,TIMEPH,
     $              IDIMF,NGRP1, NGRP3, IGRHF, GRX0, GRX1, HILF,
     $              IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,IDIMA,IDIM1L,IDIM2L,
     $              IGRID,CONV1S)
C**** MGLET ************************************************************
C           D I G R I D
C                           LIEST EIN GITTER EIN
C
C        18. 5.93 (MM) :   ORIGINAL  (AUS INIGRID ABGELEITET)
C        26. 5.95 (MM) :   KOPF UM HILFSFELD ERWEITERT, FUER MPI
C        16.09.96 (A.O.):  B-FIELD IS NOT WEIGHTED WITH SUBGRIDSCALE
C                          CONSTANT ANYMORE. THEREFORE IT HAS TO BE SET
C                          AGAIN IF SOLUTION OF OLDER VERSION IS READ.
C        04.02.03 (TB) :   SCALAR TRANSPORT VARIABLE T ADDED
C
C**** MGLET ************************************************************

#include "mgpar.h"
#include "comgrid.h"
#include "colevel.h"
#include "cogrdpro.h"
#include "cobound.h"
#include "costrles.h"
#include "cophyspar.h"
#include "cobody.h"
#include "cogrdcon.h"
#include "clinou.h"
#if defined _MPI_ | defined _MPI_PARTICLES_
C
C               MPI-INCLUDE
C
#include "compi.h"
#include "mpif.h"
#endif


      CHARACTER (LEN=8)    CIDENT(10)
C
      INTEGER IIDENT(100)

      REAL    RIDENT(100),
     $            X(IDIM1D),     Y(IDIM1D),     Z(IDIM1D),
     $           DX(IDIM1D),    DY(IDIM1D),    DZ(IDIM1D),
     $          DDX(IDIM1D),   DDY(IDIM1D),   DDZ(IDIM1D),
#ifdef _TSCAL_
     $      U( IDIM3D ), V( IDIM3D ), W( IDIM3D ),T( IDIM3D ),
     $      P( IDIM3D ), G( IDIM3D ), B( IDIM3D ), HILF( IDIM3D ),
     $      BP( IDIM3D ),BU( IDIM3D ),BV( IDIM3D ),BW( IDIM3D ),
     $      BT( IDIM3D )
#else
     $      U( IDIM3D ), V( IDIM3D ), W( IDIM3D ),
     $      P( IDIM3D ), G( IDIM3D ), B( IDIM3D ), HILF( IDIM3D ),
     $      BP( IDIM3D ),BU( IDIM3D ),BV( IDIM3D ),BW( IDIM3D )	
#endif
C
C          SUBGRIDSCALE CONSTANT CONV1S DEPENDENT OF X
      REAL    CONV1S(IDIM1D)


#ifdef _MPI_
C
C                 MPI-VARIABLEN
C
      INTEGER ISTATUS(MPI_STATUS_SIZE)
C
#endif

C
C                                 BEREITSTELLUNG DER POINTER
C                                 BASIS-RANDBEDINGUNGEN
C                                 DIMENSIONIERUNGEN
C
      CALL MGDIMS  (KK,JJ,II,IGRID)
      CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,IGRID)
      CALL MGBASB  (NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,IGRID)



C     READ DATA FROM BINARY RESULT FILE (KANAL1)
      IF(LDIB  ) THEN
         CALL DIB    (CIDENT,IIDENT,RIDENT,KK,JJ,II,KK,JJ,II,NBND,
     $        DDX(IP1),DDY(IP1),DDZ(IP1),
     $        DX(IP1),DY(IP1),DZ(IP1),X(IP1),Y(IP1),Z(IP1),
#ifdef _TSCAL_
     $        NVARI,U,V,W,T,
#else
     $        NVARI,U,V,W,
#endif
     $        P,G,B,TK,TE,HILF,IGRID,IDIM3D)
      END IF
C     READ DATA FROM FORMATTED RESULT FILE (KANAL3)
      IF(LDIC  ) THEN
         CALL DIC    (CIDENT,IIDENT,RIDENT,KK,JJ,II,KK,JJ,II,NBND,
     $        DDX(IP1),DDY(IP1),DDZ(IP1),
     $        DX(IP1),DY(IP1),DZ(IP1),X(IP1),Y(IP1),Z(IP1),
#ifdef _TSCAL_
     $        NVARI,U,V,W,T,
#else
     $        NVARI,U,V,W,
#endif
     $        P,G,B,TK,TE,HILF,IGRID,IDIM3D)
      END IF

C------------------------------------------ TREATING OF B-FIELD
C------------------------------------------ FOR IGRID OR FOR
C------------------------------------------ SUBGRIDS THAT ARISE
C------------------------------------------ FROM SLICING

      DO ISUB = 1,MAX(1,NOFSLCHILDS(IGRID))

         IF (LSLICE(IGRID)) THEN
            I = IGRDOFSLCHILD(ISUB,IGRID)
         ELSE
            I = IGRID
         ENDIF


C                                 BEREITSTELLUNG DER POINTER
C                                 BASIS-RANDBEDINGUNGEN
C                                 DIMENSIONIERUNGEN
C
         CALL MGDIMS  (KK,JJ,II,I)
         CALL MGPOINT (IP3,IP2,IP1,IBB,IB3,IBU,I)
         CALL MGBASB  (NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
C
C
         IF (LSLICE(IGRID)) THEN

C                        VERSENDEN DER GEOMETRIEINFORMATION AN DIE
C                        SUB-GITTER DER GEBIETSZERLEGUNG
C
            CALL SLICEGEO (DDX,DDY,DDZ,DX,DY,DZ,X,Y,Z,B,HILF,
     $           IDIM3D,IDIM2D,IDIM1D,NBUF,NBND,IDIMA,IDIM1L,
     $           IDIM2L,I)

C                       SUCHEN DER PARENTGITTER
C

            CALL PARSET (DDX,DDY,DDZ,DX,DY,DZ,X,Y,Z,HILF(1),
     $               IDIM1D,IDIMF,NBND,I)

         ENDIF

#ifdef _MPI_
         IPROC  = IDPROCOFGRD(I)
       IF (IPARENT(I) .GT. 0) THEN
         IPPAR  = IDPROCOFGRD(IPARENT(I))
       ENDIF
#endif
C
C----------------------------------------------------------------
C                 IF VERSIONNUMBER OF READ SOLUTION IS OLDER THEN
C                 40 THEN B-FIELD HAS TO BE SET AGAIN. B-FIELD
C                 WILL ALSO BE SET IF DCONT .EQ. FALSE. OBSTACLE
C                 GEOMETRIES CAN BE CHANGED DURING A PRODUCTION RUN:
C----------------------------------------------------------------
#ifndef _FRED_BODY_
         IF (.NOT. DCONT .OR. IIDENT(5) .LT. 40) THEN
#endif
            WRITE(6,*) "B-FIELD IS SET AGAIN BECAUSE INPUT DATA ",
     $           "  ARE CALCULATED BY AN OLDER VERSION OF MGLET",
     $           " OR DCONT .EQ. .FALSE." 
C
C------------------------- GET B-FIELD FROM COARSE GRID IF IGRID IS CHILD
C
            IF (LCHILD(I)) THEN


#ifdef _MPI_
               IF ( (MYID .EQ. IPROC) .OR. (MYID .EQ. IPPAR)) THEN
#endif
C                               VARIABLE WERDEN AUS PARENT-GITTER
C                               INTERPOLIERT ("PROLONGIERT")
C
C--------------------------------------------------------------------072
                  CALL MGDPB (KKC,JJC,IIC,IP3C,IP2C,IP1C,IBBC,IBUC,
     $                 NFROC,NBACC,NRGTC,NLFTC,NBOTC,NTOPC,NCUBC,
     $                 IPARENT(I))

                  CALL MGCTOF (KK,JJ,II,DX(IP1),DY(IP1),DZ(IP1),
     &                 DDX(IP1),DDY(IP1),DDZ(IP1),B(IP3),
     &                 KKC,JJC,IIC,DX(IP1C),DY(IP1C),DZ(IP1C),
     &                 DDX(IP1C),DDY(IP1C),DDZ(IP1C),B(IP3C),
     &                 IPOSITION(I),JPOSITION(I),KPOSITION(I),
     &                 'B',IPROC,IPPAR)

#ifdef _MPI_
               ENDIF
#endif
C--------------------------------------------------------------------072

            ELSE


#ifdef _MPI_
               IF (MYID .EQ. IPROC) THEN
#endif

                  CALL MGDPB (KK,JJ,II,IP3,IP2,IP1,IBB,IBU,
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                 I)

                  CALL IBFIELD (KK,JJ,II,KK,JJ,II,NBND,
     $                 DDX(IP1),DDY(IP1),DDZ(IP1),
     $                 DX(IP1),DY(IP1),DZ(IP1),
     $                 X(IP1),Y(IP1),Z(IP1),
     $                 B(IP3),BP(IP3),BU(IP3),BV(IP3),BW(IP3),
     $                 IDIMF,NGRP3,HILF,ZCUB,NCUB,I
#ifdef _TSCAL_
     $                ,BT(IP3)
#endif 
     $                 )
C
C                                 BELEGUNG DER GRENZEN DER BOUNDING-BOX
C
#ifdef _FRED_BODY_
                  CALL SBBC12 (KK,JJ,II,KK,JJ,II,BP(IP3),
     $                 KC1(I),KC2(I),JC1(I),JC2(I),IC1(I),IC2(I),
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
#else
                  CALL SBBC12 (KK,JJ,II,KK,JJ,II,B(IP3),
     $                 KC1(I),KC2(I),JC1(I),JC2(I),IC1(I),IC2(I),
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
#endif
C     
C
C                                 BELEGUNG VON B MIT LAENGENMASS
C
                  CALL DMIXLE (KK,JJ,II,KK,JJ,II,B(IP3),HILF(IP3),
     $                 X(IP1),Y(IP1),Z(IP1),
     $                 DX(IP1),DY(IP1),DZ(IP1),
     $                 DDX(IP1),DDY(IP1),DDZ(IP1),
     $                 IC1(I),IC2(I),JC1(I),JC2(I),KC1(I),KC2(I),
     $                 NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,
     $                 GRADPX(I),RHO,GMOL,
     $                 CONV1S(IP1),CONV1SANF(I),CONV1SEND(I),
     $                 TRANSLES1(I),TRANSLES2(I),U(IP3))
C
#ifdef _MPI_
               ENDIF
#endif

            ENDIF
#ifndef _FRED_BODY_
         ENDIF
#endif
#ifdef _MPI_
         IF (MYID .EQ. IPROC) THEN
#endif
C
C                                 BELEGUNG DER GRENZEN DER BOUNDING-BOX
C
#ifdef _FRED_BODY_
       CALL SBBC12 (KK,JJ,II,KK,JJ,II,BP(IP3),
     $              KC1(I),KC2(I),JC1(I),JC2(I),IC1(I),IC2(I),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
#else
       CALL SBBC12 (KK,JJ,II,KK,JJ,II,B(IP3),
     $              KC1(I),KC2(I),JC1(I),JC2(I),IC1(I),IC2(I),
     $                  NFRO,NBAC,NRGT,NLFT,NBOT,NTOP,NCUB,I)
#endif
C
#ifdef _MPI_
       ENDIF
#endif
      ENDDO
C
CCCCC CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC72
C     
      RETURN
      END


