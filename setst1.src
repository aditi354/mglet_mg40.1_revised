      IF(ISELEP(1,210) .GE. 1) THEN
         IF(ISELEA(1,210) .EQ. 0  .OR.  ISELEA(1,210) .EQ. 3) THEN
            CALL DPHI0   (KKXL,JJ2L,ILIMXP,KKXL,JJ2L,ILIMXP,ARXUV  )
         ELSE
