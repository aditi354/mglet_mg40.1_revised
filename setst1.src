      IF(ISELEP(1,213) .GE. 1) THEN
            CALL DPHI0   (KKYL,JJ1L,ILIMXP,KKYL,JJ1L,ILIMXP,SRYUV  )
      ENDIF
      IF(ISELEP(1,216) .GE. 1) THEN
         IF(ISELEA(1,216) .EQ. 0  .OR.  ISELEA(1,216) .EQ. 3) THEN
            CALL DPHI0   (KKXL,JJ2L,ILIMXP,KKXL,JJ2L,ILIMXP,ARXUW  )
         ELSE
            CT = CH1680  (' R_U"W"(X)      ')
