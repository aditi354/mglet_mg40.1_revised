
      SUBROUTINE COPYREGION (KK1,JJ1,II1,FELD1,IPROC1,
     $                       KA,KE,JA,JE,IA,IE,
     $                       KK2,JJ2,II2,FELD2,IPROC2,
     $                       KSHIFT,JSHIFT,ISHIFT,HILF,MYID)
C-MGLET---------------------------------------------------------------72
C
C                  COPYING OF A SUB-AREA FROM FIELD 1 INTO FIELD 2
C
C
C        25.10.95 (MM)  : ORIGINAL
C
C-MGLET---------------------------------------------------------------72

      REAL FELD1(KK1,JJ1,II1)
      REAL FELD2(KK2,JJ2,II2)
      REAL HILF (KK1*JJ1*II1)

#ifdef _MPI_
#include "mpif.h"

CCCCCCADDED FOR CORRECTION BY TB, 280503 CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C                 MPI-VARIABLEN
C
      INTEGER ISTATUS(MPI_STATUS_SIZE)
      
#endif

C-MGLET--------------- FIELD ON SAME PROCESSORS ----------------------72

#ifdef _MPI_
      IF (IPROC1 .EQ. IPROC2) THEN
         IF (MYID .EQ. IPROC1) THEN
#endif
            
            DO I1=IA,IE
                     I2=I1+ISHIFT
               DO J1=JA,JE
                     J2=J1+JSHIFT
                  DO K1=KA,KE

                     K2=K1+KSHIFT

                     FELD2(K2,J2,I2) = FELD1(K1,J1,I1)
                     
                  ENDDO
               ENDDO
            ENDDO
            
#ifdef _MPI_
         ENDIF

C-MGLET-------------------- FIELDS ON DIFFERENT PROOCESSORS ----------72

      ELSE
         IF (MYID .EQ. IPROC1) THEN

            ICOUNT = 0

            DO I1=IA,IE
                     I2=I1+ISHIFT
               DO J1=JA,JE
                     J2=J1+JSHIFT
                  DO K1=KA,KE
                     K2=K1+KSHIFT
                     
                     ICOUNT = ICOUNT + 1
                     
                     HILF(ICOUNT) = FELD1(K1,J1,I1)
C                     FELD2(K2,J2,I2) = FELD1(K1,J1,I1)
                     
                  ENDDO
               ENDDO
            ENDDO
            
            CALL MPI_SSEND ( HILF , ICOUNT , 
     $ MPI_DOUBLE_PRECISION ,
     $           IPROC2 , IPROC1 ,
     $           MPI_COMM_WORLD , IERR)
            
         ELSE
            
				 ILENGTH = (IE-IA+1)*(JE-JA+1)*(KE-KA+1)
            CALL MPI_RECV ( hilf , ILENGTH , 
     $ MPI_DOUBLE_PRECISION ,
     $           IPROC1 , IPROC1 ,
     $           MPI_COMM_WORLD , ISTATUS , IERR)
            
            izl = 0

            do i1=ia,ie
               i2=i1+ISHIFT
               do j1=ja,je
                  j2=j1+JSHIFT
                  do k1=ka,ke
                  k2=k1+KSHIFT

                  izl = izl+1
C----------------------------------- Dummyzeil fuer IBM-SP2 notwendig:
#ifdef _SP2_
                  ihi = k2+(j2-1)*kk2+(i2-1)*kk2*jj2   
#endif
                  feld2(k2,j2,i2) = hilf(izl)
                     
                  ENDDO
               ENDDO
            ENDDO

            
         ENDIF
      ENDIF
#endif
         





C-MGLET---------------------------------------------------------------72
      RETURN
      END

