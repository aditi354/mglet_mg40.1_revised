      SUBROUTINE FDERFOVWX(KK,JJ,II,KSTART,JSTART,ISTART,
     $     KSTOP,JSTOP,ISTOP,DX,DDX,COEFDX,RSGS,FAKTOR,
     $     F,FIN,FD,NFRO,NBAC,LCOL,DIAG,RCOL
#ifdef _FRED_BODY_
     $     ,BP,GI,GJ,GK
#endif
     $     )
C*MGLET***************************************************************
C        F D E R F O V W X  (First DERive Fourth Order)
C        BERECHNUNG DER ERSTEN ABLEITUNG (DV/DX,DW/DX)                    
C*MGLET***************************************************************
C
C PARAM: F(K,J,I)       - BEKANNTE GROESSE AN DEN GITTERKANTEN
C      : FIN(K,J,I)     - INTERPOLIERTE GROESSE
C                         ZWISCHEN DEN BEIDEN KANTEN       
C      : FD (K,J,I)     - ERSTE ABLEITUNG, FIRST DERINATIVE:
C                         DV/DX,DW/DX
C      : LCOL           - ENTHAELT KOEFFIZIENTEN DER "LINKEN SPALTE"
C                         PARALLEL ZUR HAUPTDIAGONALEN
C      : DIAG           - ENTHAELT KOEFFIZIENTEN DER HAUPTDIAGONALEN
C      : RCOL           - ENTHAELT KOEFFIZIENTEN DER "RECHTEN SPALTE"
C                         PARALLEL ZUR HAUPTDIAGONALEN
C
C DEFINE DIREKTIVEN     : KEINE 
C
C UPROG                 :  THOMASI     THOMAS-ALGORITHMUS IN X-RICHTUNG
C
C VERS:  08.01.97(AM)  : ORIGINAL        (KOMPAKT 4. ORDNUNG)
C
C*MGLET***************************************************************

      IMPLICIT NONE

      INTEGER KK,JJ,II,K,J,I,KSTART,JSTART,ISTART,KSTOP,JSTOP,ISTOP,
     $        IA,IE,NFRO,NBAC,PART

      REAL    DX(II),DDX(II),LCOL(II),DIAG(II),RCOL(II),
     $        F(KK,JJ,II),FIN(KK,JJ,II),FD(KK,JJ,II),RSGS(KK,JJ,II)
#ifndef _FRED_BODY_
      REAL    COEFDX(II,12),FAKTOR(II)
#else
      REAL    COEFDX(II,12*3),FAKTOR(KK,JJ,II),A,B,C,D,
     $        GI(KK,JJ,II),GJ(KK,JJ,II),GK(KK,JJ,II),BP(KK,JJ,II)
#endif


      IF (NFRO .EQ. 5 .OR. NFRO .EQ. 11) THEN
         IA = 3
      ELSEIF(NFRO .EQ.7) THEN
         IA = 3
      ELSE
         WRITE(6,*) 'RB NFRO IN FDERFOVWX NICHT IMPLEMENTIERT',NFRO
         STOP
      ENDIF

      IF (NBAC .EQ. 5) THEN
         IE = II-1
      ELSEIF(NBAC .EQ.7) THEN
         IE = II-1
      ELSEIF (NBAC .EQ. 3) THEN
         IE = II-2
      ELSE
         WRITE(6,*) 'RANDBEDINGUNG IN FDERFOVWX NICHT IMPLEMENTIERT'
         STOP
      ENDIF

C                                    ERSTER PHYSIKALISCHER PUNKT
      I = IA

#ifndef _FRED_BODY_
      LCOL(I) = COEFDX(I,7)
      DIAG(I) = COEFDX(I,8)
      RCOL(I) = COEFDX(I,9)
#else
      DO J = JSTART,JSTOP
         DO K = KSTART,KSTOP
            GI(K,J,I) = COEFDX(I,7)
            GJ(K,J,I) = COEFDX(I,8)
            GK(K,J,I) = COEFDX(I,9)
         ENDDO
      ENDDO
#endif

      IF(NFRO.EQ.5 ) THEN
         DO J = JSTART, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) =  COEFDX(I,10) * FIN(K,J,I  )
     $                      + COEFDX(I,11) * F  (K,J,I  )
     $                      + COEFDX(I,12) * F  (K,J,I+1)
            ENDDO
         ENDDO

      ELSEIF (NFRO.EQ.11) THEN

         DO J = JSTART, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) =  COEFDX(I,10) * F  (K,J,I-1)
     $                      + COEFDX(I,11) * F  (K,J,I  )
     $                      + COEFDX(I,12) * F  (K,J,I+1)
            ENDDO
         ENDDO

      ELSE
         WRITE(6,*)'BC NOT IMPLEMENTED IN FDERFVWX'
      ENDIF


C                                     LETZTER PHYSIKALISCHER PUNKT
      I = IE

#ifndef _FRED_BODY_
      LCOL(I) = COEFDX(I,7)
      DIAG(I) = COEFDX(I,8)
      RCOL(I) = COEFDX(I,9)
#else
      DO J = JSTART,JSTOP
         DO K = KSTART,KSTOP
            GI(K,J,I) = COEFDX(I,7)
            GJ(K,J,I) = COEFDX(I,8)
            GK(K,J,I) = COEFDX(I,9)
         ENDDO
      ENDDO
#endif

      IF (NBAC.EQ.5) THEN
         DO J = JSTART, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) =  COEFDX(I,10) * FIN(K,J,I  )
     $                      + COEFDX(I,11) * F  (K,J,I-1)
     $                      + COEFDX(I,12) * F  (K,J,I-2)
            ENDDO
         ENDDO
      ELSEIF (NBAC.EQ.3) THEN
         DO J = JSTART, JSTOP
            DO K = KSTART, KSTOP
               RSGS(K,J,I) =  COEFDX(I,10) * F(K,J,I  )
     $                      + COEFDX(I,11) * F(K,J,I-1)
     $                      + COEFDX(I,12) * F(K,J,I-2)
            ENDDO
         ENDDO
      ENDIF

C---------------Compact differentiaion for inner domain-------

C                                      IM BERECHNUNGSGEBIET

C      DO I = IA+1 , IE-1
C
C#ifndef _FRED_BODY_
C         LCOL(I) = COEFDX(I,7)
C         DIAG(I) = COEFDX(I,8)
C         RCOL(I) = COEFDX(I,9)
C#endif
C
C      ENDDO

      DO I = IA+1 , IE-1

#ifndef _FRED_BODY_
         LCOL(I) = COEFDX(I,7)
         DIAG(I) = COEFDX(I,8)
         RCOL(I) = COEFDX(I,9)
#endif

         DO J = JSTART,JSTOP
            DO K = KSTART,KSTOP

#ifndef _FRED_BODY_
#if !defined _4TH_KOBAYASHI_
               RSGS(K,J,I) = (COEFDX(I,10) * F  (K,J,I  )
     $                      + COEFDX(I,11) * FIN(K,J,I  )
     $                      + COEFDX(I,12) * F  (K,J,I-1)) * DX(I-1)
#else
               RSGS(K,J,I) = (COEFDX(I,10) * F  (K,J,I-1  )
     $                      + COEFDX(I,11) * FIN(K,J,I  )
     $                      + COEFDX(I,12) * F  (K,J,I)) 

#endif

#else

C          A =    BP(K,J,I)
C          B = (1-BP(K,J,I))*    BP(K,J,I+1)
C          C = (1-BP(K,J,I))*    BP(K,J,I-1)
C          D = (1-BP(K,J,I))* (1-BP(K,J,I-1))* (1-BP(K,J,I+1))
          A =    BP(K,J,I-1) *   BP(K,J,I)
          B = (1-BP(K,J,I-1))*   BP(K,J,I)
          C = (1-BP(K,J,I  ))*   BP(K,J,I-1)
          D = (1-BP(K,J,I  ))*(1-BP(K,J,I-1))


          GI(K,J,I) =  COEFDX(I,7)    * A 
     $               + COEFDX(I,12+7) * B
     $               + COEFDX(I,24+7) * C
          GJ(K,J,I) =  COEFDX(I,8)    * A 
     $               + COEFDX(I,12+8) * B
     $               + COEFDX(I,24+8) * C
     $               + 1.0            * D
          GK(K,J,I) =  COEFDX(I,9)    * A
     $               + COEFDX(I,12+9) * B
     $               + COEFDX(I,24+9) * C

c                RSGS(K,J,I) =
c     $   (COEFDX(I,10)    * F(K,J,I)+
c     $    COEFDX(I,11)    * FIN(K,J,I)+
c     $    COEFDX(I,12)    * F(K,J,I-1))*DDX(I-1) * A
c     $ + (COEFDX(I,12+10) * FIN(K,J,I)+
c     $    COEFDX(I,12+11) * F(K,J,I)+
c     $    COEFDX(I,12+12) * F(K,J,I+1)) *        B
c     $ + (COEFDX(I,24+10) * FIN(K,J,I)+
c     $    COEFDX(I,24+11) * F(K,J,I-1)+
c     $    COEFDX(I,24+12) * F(K,J,I-2)) *        C

c bessere Divergenz
                RSGS(K,J,I) =
     $   (COEFDX(I,10)    * F(K,J,I)+
     $    COEFDX(I,11)    * FIN(K,J,I)+
     $    COEFDX(I,12)    * F(K,J,I-1))*DX(I-1) * A
     $ + (COEFDX(I,12+10) * F(K,J,I-1)+
     $    COEFDX(I,12+11) * F(K,J,I)+
     $    COEFDX(I,12+12) * F(K,J,I+1)) *        B
     $ + (COEFDX(I,24+10) * F(K,J,I)+
     $    COEFDX(I,24+11) * F(K,J,I-1)+
     $    COEFDX(I,24+12) * F(K,J,I-2)) *        C


#endif

            ENDDO
         ENDDO
      ENDDO

      CALL THOMASI(KK,JJ,II,KSTART,KSTOP,JSTART,JSTOP,IA,IE,
     $     LCOL,DIAG,RCOL,RSGS,FAKTOR,FD
#ifdef _FRED_BODY_
     $     ,BP,GI,GJ,GK
#endif
     $     )


C*********************  EXTRAPOLATION   *******************************

      IF (NBAC.EQ.3) THEN
         I = IE+1
         DO J = JSTART,JSTOP
            DO K = KSTART,KSTOP
               FD(K,J,I) = - COEFDX(I,7 ) * FD(K,J,I-1)
     $                     + COEFDX(I,10) * F (K,J,I-1)
     $                     + COEFDX(I,11) * F (K,J,I-2)
     $                     + COEFDX(I,12) * F (K,J,I-3)
            ENDDO
         ENDDO
      ENDIF

C*********************   E  N  D       *******************************
       RETURN
       END

